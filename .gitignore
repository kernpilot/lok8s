# secrets / credentials
.env
.secrets/*
!.secrets/.gitignore
!.secrets/Secret.*.enc

# example projects (examples/<driver>/): credentials + per-run derived state.
# The cluster.lok8s.yaml configs ARE committed; everything generated is not.
examples/*/.secrets/
examples/*/.kustomize/
examples/*/.provider/
examples/*/clusters/*/.containerd/
examples/*/clusters/*/.registries.json
examples/*/clusters/*/.oidc/
.kubeconfig/
.tilt.*
**/clusters/.active
# The single rendered artifact embeds plaintext Secrets — never committable.
# The split-mode layout (build::split) IS committable by design: per-resource
# files with Secrets sops-encrypted, so artifacts/ is only ignored for its
# legacy per-target subdirs; split files + the generated .gitignore pass.
# (Consumer repos that predate split mode may carry their own broader ignore —
# relax it like this when adopting spec.build.artifacts: split.)
**/clusters/*/artifacts/*/
**/clusters/*/artifacts/.cache-queue
**/clusters/*/artifacts/kustomization.yaml
**/clusters/*/artifacts/capi.yaml
**/clusters/*/.artifacts-stage.*/
**/clusters/*/artifacts.yaml
**/clusters/*/.kubeconfig/
**/clusters/*/.containerd/
**/clusters/*/.kubeone/
**/clusters/*/.docker.sock
**/clusters/*/.provider/
# generated registry slot-plan (written by `lo`); never commit per-cluster state
**/clusters/*/.registries.json
# test scratch: tests that set PATH_CLUSTERS=tests/fixtures/ drop a
# stray .registries.json here — keep it out of git status
tests/fixtures/.registries.json

# service overrides (user content under clusters/) — but NOT the test fixtures,
# which the suite copies in (a gitignored fixture passes locally, fails in CI).
services.*.yaml
!tests/fixtures/services.*.yaml

# dependencies
node_modules/

# claude — the whole agent-tooling tree is internal (planning/handoff/feedback +
# the cuite subtree); kept local, never published. Root CLAUDE.md/AGENTS.md stay.
.claude/
CLAUDE.local.md

# kustomize plugin build outputs (source of truth: kustomize/cmd/<name>/
# for in-repo plugins, b-managed for vendored plugins like khelm)
.kustomize/secrets.lok8s.dev/v1/secret/Secret
.kustomize/khelm.mgoltzsche.github.com/v2/chartrenderer/ChartRenderer
kustomize/dist/
kustomize/coverage.out

# ignore
.backlog/
# VitePress build output
docs/.vitepress/dist/
docs/.vitepress/cache/

# VitePress dev cache (vitepress dev run from repo root)
.vitepress/cache/

# local artifacts
lint.log
tests/e2e/*/.secrets/

# Go build output (make build)
/bin/
coverage.out

# argsh native builtin — `argsh builtins install` / some `lo` runs drop this
# binary in the cwd. It belongs in .bin/ (fetched by `b`); never commit a stray.
argsh.so

# generated addon index (built by docs/.vitepress/build-addons-index.sh in the
# Deploy Docs workflow; never commit a locally-generated copy)
docs/public/addons-index.json
