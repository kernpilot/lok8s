#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# lo-up — the lok8s installer. Bootstraps or updates a project's lok8s env.
#
#   curl -fsSL https://get.lok8s.io | sh           # interactive if a TTY is present
#   curl -fsSL https://get.lok8s.io | sh -s -- -y  # unattended (CI)
#
# It detects whether the target directory already carries a lok8s env: if so it
# UPDATES (b install), otherwise it BOOTSTRAPS (b env add <profile> + b install).
# It installs `b` (the binary manager) when missing and copies itself into the
# project's .bin (PATH_BIN) so a later `lo-up` can update in place.
#
# Distributed as a single self-contained script (argsh bundled) via the
# install/lo-up.min.tmpl template — see install/build.

# Upstream + endpoints. Overridable via env for forks / local testing.
: "${LOUP_REPO:=github.com/kernpilot/lok8s}"
: "${LOUP_URL:=https://get.lok8s.io}"
: "${LOUP_B_INSTALL_URL:=https://get.binary.help}"

# ── output (self-contained; no lok8s libs are bundled) ───────────────────────
_say()  { printf '%b\n' "${*}" >&2; }
_info() { _say "  \033[36m•\033[0m ${*}"; }
_ok()   { _say "  \033[32m✓\033[0m ${*}"; }
_warn() { _say "  \033[33m!\033[0m ${*}"; }
_die()  { _say "  \033[31m✗\033[0m ${*}"; exit 1; }

# Interactive iff not --non-interactive AND a controlling terminal exists. Under
# `curl … | sh` stdin is the script, so prompts read from /dev/tty.
loup::interactive() { (( non_interactive )) && return 1; [[ -e /dev/tty ]]; }

# loup::confirm <prompt> — Y/n gate; auto-yes when non-interactive.
loup::confirm() {
  loup::interactive || return 0
  local ans
  read -r -p "  ${1} [Y/n] " ans </dev/tty || return 0
  [[ -z "${ans}" || "${ans}" =~ ^[Yy] ]]
}

# loup::detect_mode <dir> — "update" if a lok8s env is already present, else
# "bootstrap". A vendored .lok8s/ or a b.yaml that references the lok8s repo both
# count as an existing env.
loup::detect_mode() {
  local d="${1}"
  [[ -d "${d}/.lok8s" ]] && { echo update; return; }
  [[ -f "${d}/.bin/b.yaml" ]] && grep -q "${LOUP_REPO#*/}" "${d}/.bin/b.yaml" 2>/dev/null \
    && { echo update; return; }
  echo bootstrap
}

# loup::ensure_b — make `b` available, installing it into PATH_BIN if missing.
loup::ensure_b() {
  command -v b &>/dev/null && return 0
  [[ -x "${PATH_BIN}/b" ]] && { export PATH="${PATH_BIN}:${PATH}"; return 0; }
  command -v curl &>/dev/null || _die "curl is required to install b"
  _info "installing b (binary manager) → ${PATH_BIN}"
  mkdir -p "${PATH_BIN}"
  B_INSTALL_DIR="${PATH_BIN}" sh -c "$(curl -fsSL "${LOUP_B_INSTALL_URL}")" \
    || _die "failed to install b from ${LOUP_B_INSTALL_URL} (install it manually: https://binary.help)"
  export PATH="${PATH_BIN}:${PATH}"
  command -v b &>/dev/null || _die "b is still not on PATH after install"
  _ok "b installed"
}

# loup::verify_registered — assert `b env add` actually recorded the env.
#
# `b` has shipped more than one silent rc-0 no-op: a subcommand --version that
# was mistaken for the root's version banner (fentas/b#180) printed the banner
# and exited 0 without registering anything, and an env sync can print a full
# add plan while writing no files (fentas/b#184). Both leave a fresh machine
# with an "installed" env that has nothing in it, and the failure only surfaces
# much later as a missing binary. Check the artefact, not the exit code.
# NOTE: `.bin/b.yaml` is cwd-relative on purpose, NOT ${PATH_BIN}-relative. `b`
# resolves its config as <cwd>/.bin/b.yaml regardless of where it installs
# binaries, so PATH_BIN is right for verify_materialised and wrong here.
loup::verify_registered() {
  [[ -f "${PWD}/.bin/b.yaml" ]] \
    || _die "no ${PWD}/.bin/b.yaml — the env was never registered (run: b env add ${LOUP_REPO}#${profile} --version ${git_ref})"
  # Match on LOUP_REPO's org/repo, not a hardcoded one: a fork pointed here via
  # LOUP_REPO would otherwise register fine and then be told to run the very
  # command that just succeeded.
  grep -q "${LOUP_REPO#*/}" "${PWD}/.bin/b.yaml" 2>/dev/null \
    || _die ".bin/b.yaml registered no lok8s env — nothing here can update (run: b env add ${LOUP_REPO}#${profile} --version ${git_ref})"
}

# loup::verify_materialised — assert `b install` actually produced a usable env:
# the vendored framework, the `lo` entrypoint, and the binaries `lo` shells out
# to on every command. Anything missing here means a later `lo use` fails with a
# far less obvious error.
# The bin directory as the user sees it in a message — ".bin", not the full
# path. Strip a trailing slash BEFORE taking the basename: with
# PATH_BIN=".../.bin/" a bare ${PATH_BIN##*/} is EMPTY, so the missing-binary
# line read "/argsh". One helper because the display was written twice and only
# one copy had the fix (issue #112 part 4).
loup::bin_dir() {
  local dir="${PATH_BIN%/}"
  echo "${dir##*/}"
}

loup::verify_materialised() {
  local -a missing=()
  [[ -d "${PWD}/.lok8s" ]] || missing+=(".lok8s/ (vendored framework)")
  [[ -f "${PWD}/.lok8s/lo" ]] || missing+=(".lok8s/lo (CLI entrypoint)")

  local bin_dir; bin_dir="$(loup::bin_dir)"

  # envsubst is in this list because leaving it out made the check LIE: `b
  # install` renders every manifest through it (b.yaml's core group maps
  # renvsubst→envsubst), so without it templating breaks on the first `lo use`
  # while lo-up reports a clean install. A verification that passes on a broken
  # env is worse than no verification — it is the reason nobody looks. This
  # list is the every-command subset of b.yaml's `core` group (core also ships
  # sops, ssh-to-age and bats, which `lo` does not need on every invocation and
  # are deliberately not checked here); keep the subset in sync when core's
  # runtime needs change. libs/doctor checks the same binary for the same reason.
  local bin
  for bin in argsh kubectl jq yq envsubst; do
    [[ -x "${PATH_BIN}/${bin}" ]] || command -v "${bin}" &>/dev/null \
      || missing+=("${bin_dir}/${bin}")
  done

  (( ${#missing[@]} == 0 )) || _die "b install reported success but the env is incomplete — missing: ${missing[*]}
    Re-run with 'b install --force', or check 'b env status' and 'b install --dry-run'."
}

# loup::install_self — persist lo-up into PATH_BIN so a later run updates in place.
# Re-fetches the canonical bundle (under `curl | sh` there is no local file).
loup::install_self() {
  local dest="${PATH_BIN}/lo-up"
  mkdir -p "${PATH_BIN}"
  if command -v curl &>/dev/null && curl -fsSL "${LOUP_URL}" -o "${dest}" 2>/dev/null; then
    chmod +x "${dest}" 2>/dev/null || true
    _ok "lo-up → ${dest#"${PWD}/"}"
  else
    _warn "couldn't persist lo-up into ${dest} (continuing)"
  fi
}

main() {
  # Declared empty so `:args` populates them from flags; defaults applied AFTER
  # parsing (a pre-set value flag is NOT overridden by `:args`).
  local non_interactive=0 profile git_ref dir
  local -a args=(
    'non-interactive|y:+'  'Run without prompts (CI / unattended)'
    'profile|p'            'b env profile: core|kustomize|local|capi|kubeone (default: local)'
    'git-ref|r'            'lok8s git ref/tag to pin (default: main)'
    'dir|d'                'Target directory (default: current directory)'
  )
  :args "lo-up — install or update a lok8s project environment" "${@}"
  profile="${profile:-local}"; git_ref="${git_ref:-main}"; dir="${dir:-${PWD}}"

  [[ -d "${dir}" ]] || _die "directory not found: ${dir}"
  cd "${dir}" || _die "cannot enter ${dir}"
  export PATH_BASE="${PWD}"
  export PATH_BIN="${PATH_BIN:-${PWD}/.bin}"

  local mode; mode="$(loup::detect_mode "${PWD}")"
  _say ""
  _say "  \033[1;36mlo-up\033[0m  \033[2m${mode} · ${PWD}\033[0m"

  loup::ensure_b

  if [[ "${mode}" == "bootstrap" ]]; then
    loup::confirm "Bootstrap a lok8s '${profile}' env here (${LOUP_REPO}#${profile}@${git_ref})?" \
      || _die "aborted"
    _info "adding profile '${profile}' from ${LOUP_REPO}#${git_ref}"
    b env add "${LOUP_REPO}#${profile}" --version "${git_ref}" || _die "b env add failed"
  else
    _info "updating the lok8s env (${LOUP_REPO})"
  fi
  # BOTH paths: detect_mode calls a bare vendored .lok8s/ an "update", so a
  # checkout with the framework but no b.yaml entry would skip registration
  # entirely, `b install` would no-op, and the binaries check would pass on
  # whatever is already on PATH — reporting a ready env that can never update.
  loup::verify_registered

  loup::install_self

  _info "installing binaries + syncing the framework (b install)…"
  b install || _die "b install failed"
  loup::verify_materialised

  _ok "lok8s env ready"
  _say ""
  _say "  Next:"
  _say "    \033[2m$(loup::bin_dir)/lo-up\033[0m   \033[2m# re-run anytime to update\033[0m"
  _say "    \033[2mlo use <domain> && lo up\033[0m"
  _say ""
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main "${@}"
