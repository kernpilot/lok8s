#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# secrets — secret cache management with SOPS/age encryption
#
# The lok8s secret plugin generates values into $PATH_SECRETS as
# plaintext cache files (Secret.<name>.<ns>.<key>). This module adds
# SOPS/age encryption so those cache files can be committed safely.
#
# Layout (single-instance project — flat store):
#   .secrets/Secret.myapp.default.PASSWORD       ← plaintext (gitignored)
#   .secrets/Secret.myapp.default.PASSWORD.enc   ← SOPS-encrypted (committed)
#   .secrets/tls/                                ← mkcert certs (gitignored)
#
# Per-INSTANCE isolation (multi-domain repos): a domain keeps its OWN secrets
# under clusters/<domain>/secrets/, and the CLI + `lo build` use only that store
# for that domain. This is the secure default for anything serving multiple
# environments — dev/prod never share a generated value, and SOPS creation_rules
# can encrypt each domain's store to DIFFERENT recipients so a dev/CI key cannot
# decrypt prod. There is deliberately NO shared tier: a value needed in two
# instances is a manual copy (the operator consenting to that exposure), never a
# silent fallback. See docs/guide/secrets.md.
#   clusters/kubehz.dev/secrets/Secret.app.default.PASSWORD{,.enc}
#   clusters/kubehz.cloud/secrets/Secret.app.default.PASSWORD{,.enc}
#
# .gitignore (per store):
#   *
#   !.gitignore
#   !Secret.*.enc
#
# Encryption uses age keys derived from SSH keys via ssh-to-age.
# No new key ceremony — your existing ~/.ssh/id_ed25519 is your
# encryption identity.

: "${LOK8S_SSH_KEY:=${HOME}/.ssh/id_ed25519}"

import ^utils/types
import ^utils/verbose

# ── CLI entry ────────────────────────────────────────────

main::secrets() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  local -a usage=(
    'init|i@idempotent'     'Initialize SOPS/age encryption from SSH key'
    'add-key@destructive'   'Add an age recipient and re-key the store'
    'set|s@destructive'     'Write a literal value into the secret cache'
    'encrypt|e@idempotent'  'Encrypt plaintext cache files for commit'
    'decrypt|d@idempotent'  'Decrypt .enc files into plaintext cache'
    'allow|a@destructive'   'Approve bash: generators (re-compute .sha + .bash-allow)'
    'list|l@readonly'       'List secrets'
    'print|p@readonly'      'Print secret(s)'
    'env@readonly'          'Emit export KEY=value lines for a cached secret'
    'path@readonly'         'Resolve the secrets path for the current context'
  )
  :usage "Manage secrets" "${@}"
  "${usage[@]}"
}

# ── Path helpers ─────────────────────────────────────────

# shellcheck disable=SC2120
# Resolve the secrets store for the current context. A domain with its own
# clusters/<domain>/secrets/ uses THAT store exclusively (per-instance isolation,
# no flat fallback for it); otherwise the flat PATH_SECRETS store (single-instance
# projects). `lo build` mirrors this — see build::_export_secrets_path.
secrets::path() {
  :args "Resolve the secrets path for the current context" "${@}"
  if [[ -n "${domain}" && -d "${PATH_CLUSTERS}/${domain}/secrets" ]]; then
    echo "${PATH_CLUSTERS}/${domain}/secrets"
  else
    echo "${PATH_SECRETS:-${PATH_BASE}/.secrets}"
  fi
}

# Scaffold a domain's per-domain store so a WRITE lands there (not the flat
# fallback) even on the very first command — secrets::path only returns the
# per-domain path once the dir exists, so create it first when --domain is given.
# `if` (not `&&`) keeps it a set -e-safe no-op when no domain is in context.
secrets::_ensure_store() {
  if [[ -n "${domain}" && -d "${PATH_CLUSTERS}/${domain}" ]]; then
    mkdir -p "${PATH_CLUSTERS}/${domain}/secrets"
  fi
}

# ── Init ─────────────────────────────────────────────────

secrets::init() {
  local ssh_key="${LOK8S_SSH_KEY}"
  local -a args=(
    'ssh-key|k'  'Path to SSH public key'
    "${args[@]:-}"
  )
  :args "Initialize SOPS/age encryption" "${@}"

  command -v ssh-to-age &>/dev/null || {
    error "ssh-to-age not found — install via: b install"
    return 1
  }
  command -v sops &>/dev/null || {
    error "sops not found — install via: b install"
    return 1
  }

  [[ -f "${ssh_key}" ]] || {
    error "SSH public key not found: ${ssh_key}"
    error "Generate one with: ssh-keygen -t ed25519"
    return 1
  }

  local age_pubkey
  age_pubkey=$(ssh-to-age < "${ssh_key}") || {
    error "Failed to derive age public key from ${ssh_key}"
    error "Only ed25519 SSH keys are supported"
    return 1
  }

  local sops_config="${PATH_BASE}/.sops.yaml"

  if [[ -f "${sops_config}" ]]; then
    # Check if this key is already present
    if grep -qF "${age_pubkey}" "${sops_config}"; then
      echo "age key already configured in .sops.yaml"
      return 0
    fi
    warn ".sops.yaml exists but doesn't contain this key"
    warn "Add it with: lo secrets add-key ${ssh_key}"
    echo "Your age public key: ${age_pubkey}"
    return 0
  fi

  cat > "${sops_config}" <<YAML
# SOPS encryption config for lok8s secret cache files.
# Recipients are age public keys derived from SSH keys via ssh-to-age.
# Add team members with: lo secrets add-key <ssh-pubkey-path|age1…>
creation_rules:
  - path_regex: 'Secret\..*'
    age: '${age_pubkey}'
YAML

  echo "Created ${sops_config}"
  echo "Age public key: ${age_pubkey}"
  echo "Derived from: ${ssh_key}"

  # Ensure secrets directory exists with a .gitignore that blocks
  # everything except SOPS-encrypted .enc files.
  secrets::_ensure_store
  local secrets_dir
  secrets_dir=$(secrets::path)
  mkdir -p "${secrets_dir}"
  secrets::_ensure_gitignore "${secrets_dir}"
}

# ── Add key ──────────────────────────────────────────────

# secrets::add-key <ssh-pubkey-path|age-pubkey>
#
# Add a recipient to .sops.yaml and re-key every cache file so they can actually
# read it. Both halves are required: appending the key alone leaves the new
# recipient unable to decrypt ANYTHING, because sops only rewrites a file's
# recipients when that file is re-encrypted.
#
# This existed as instructions before it existed as code: `secrets::init` printed
# "use: lo secrets add-key" and the generated .sops.yaml header said the same,
# for a subcommand that was never implemented (issue #73). Doing it by hand meant
# editing .sops.yaml, `touch`ing every plaintext twin — because secrets::encrypt
# skips files whose .enc is newer, so a recipient change re-encrypts nothing —
# and then running encrypt per domain.
#
# FAILS CLOSED on an orphan: an `.enc` with no decrypted twin cannot be re-keyed
# here, and silently leaving it behind is the worst outcome — the new recipient
# would appear to be added while some secrets stayed unreadable to them. Decrypt
# first, or pass --skip-orphans to accept the gap knowingly.
secrets::add-key() {
  local key="" all=0 skip_orphans=0
  local -a args=(
    'key'              'SSH public key path, or an age public key (age1…)'
    'all|a:+'          'Re-key every domain store, not just the current one'
    'skip-orphans|:+'  'Proceed even if some .enc files have no decrypted twin'
    "${args[@]:-}"
  )
  :args "Add an age recipient and re-key the secret store" "${@}"

  command -v sops &>/dev/null || { error "sops not found — install via: b install"; return 1; }

  # Accept an age key directly, or derive one from an SSH public key.
  local age_pubkey=""
  if [[ "${key}" == age1* ]]; then
    age_pubkey="${key}"
  else
    [[ -f "${key}" ]] || {
      error "not an age key and not a readable file: ${key}"
      error "pass an age public key (age1…) or the path to an ed25519 SSH public key"
      return 1
    }
    command -v ssh-to-age &>/dev/null || { error "ssh-to-age not found — install via: b install"; return 1; }
    # 2>/dev/null: ssh-to-age echoes its ENTIRE input on failure, which for a
    # mistakenly-passed PRIVATE key would print the key material (see
    # tests/unit/secret_material_containment_test.bats).
    age_pubkey=$(ssh-to-age < "${key}" 2>/dev/null) || {
      error "could not derive an age key from ${key}"
      error "only ed25519 SSH keys are supported, and it must be the PUBLIC key"
      return 1
    }
  fi

  # bech32 age public key. Validated because a typo here is silent: sops accepts
  # the config and every later encrypt writes a recipient nobody holds.
  [[ "${age_pubkey}" =~ ^age1[023456789acdefghjklmnpqrstuvwxyz]{58}$ ]] || {
    error "not a valid age public key: ${age_pubkey}"
    return 1
  }

  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "${sops_config} not found — run: lo secrets init"
    return 1
  }

  if grep -qF "${age_pubkey}" "${sops_config}"; then
    echo "recipient already present in .sops.yaml — nothing to add"
    echo "  ${age_pubkey}"
    return 0
  fi

  # Append to every creation rule's age list (comma-separated, sops' own format).
  local before after
  before=$(grep -c "age:" "${sops_config}")
  sed -i -E "s|^([[:space:]]*age:[[:space:]]*')([^']*)(')|\1\2,${age_pubkey}\3|" "${sops_config}"
  after=$(grep -cF "${age_pubkey}" "${sops_config}")
  (( after >= 1 )) || {
    error "failed to add the recipient to ${sops_config} — is the age: line quoted with '?"
    return 1
  }
  echo "added recipient to .sops.yaml (${before} creation rule(s))"
  echo "  ${age_pubkey}"

  # Re-key the stores. Without this the recipient is listed but holds nothing.
  local -a stores=()
  if (( all )); then
    local d
    for d in "${PATH_CLUSTERS}"/*/secrets; do [[ -d "${d}" ]] && stores+=("${d}"); done
  else
    stores+=("$(secrets::path)")
  fi
  (( ${#stores[@]} )) || { error "no secret store found to re-key"; return 1; }

  local store orphans=0 rekeyed=0
  for store in "${stores[@]}"; do
    local enc
    for enc in "${store}"/Secret.*.enc; do
      [[ -e "${enc}" ]] || continue
      if [[ ! -f "${enc%.enc}" ]]; then
        warn "orphan (no decrypted twin, cannot re-key): ${enc#"${PATH_BASE}/"}"
        orphans=$((orphans + 1))
      fi
    done
  done
  if (( orphans > 0 )) && ! (( skip_orphans )); then
    error "${orphans} encrypted file(s) have no decrypted twin — they would keep the OLD"
    error "  recipient list while .sops.yaml claims the new key was added."
    error "  Run 'lo secrets decrypt' first, or re-run with --skip-orphans to accept it."
    return 1
  fi

  for store in "${stores[@]}"; do
    local plain
    for plain in "${store}"/Secret.*; do
      [[ -e "${plain}" && "${plain}" != *.enc ]] || continue
      # The freshness skip in secrets::encrypt is keyed on mtime, and a recipient
      # change does not touch the plaintext — so nudge it, which is exactly the
      # manual step this command exists to remove.
      touch "${plain}"
      rekeyed=$((rekeyed + 1))
    done
  done
  echo "re-keying ${rekeyed} cache file(s) across ${#stores[@]} store(s)…"
  # No --name on purpose: a re-key rewrote every cache file in every store, so
  # the whole store is exactly what must be re-encrypted here.
  # shellcheck disable=SC2119
  secrets::encrypt || return 1
  echo "done — commit .sops.yaml and the updated .enc files together"
}

# ── Set ──────────────────────────────────────────────────

secrets::set() {
  # value is pre-initialized (="") so argsh treats it as an OPTIONAL positional;
  # an uninitialized var would be required and reject a missing value BEFORE the
  # stdin/prompt fallback below could run (the "reads stdin if omitted" path).
  # The :~stdin type makes an explicit `-` read stdin too (argsh consumes it
  # during parsing). NOTE: the `-` form needs an argsh release with
  # arg-sh/argsh#176 (older parsers reject a bare `-`);
  # the omitted-value form works on any argsh. A literal `-` value can
  # always be stored via the pipe form: `printf %s - | lo secrets set … KEY`.
  #
  # encrypt is pre-init'd to 0 (a count flag, `:+`) so it is a proper boolean; the
  # spec's FIRST long token is canonical (--encrypt), the LAST is the short (-e),
  # and the MIDDLE token is an alias (--enc). -n is already --name, hence -e.
  local name namespace="default" key value="" encrypt=0
  local -a args=(
    'name|n'          'Secret name (metadata.name from the Secret spec)'
    'namespace|s'     'Secret namespace'
    'encrypt|enc|e:+' 'SOPS-encrypt only this file after writing (needs .sops.yaml)'
    'key'             'Cache key name (e.g. JWT_SECRET)'
    'value:~stdin'    'Value to write (omitted: tty prompt / piped stdin; a bare - reads stdin, needs argsh with arg-sh/argsh#176)'
    "${args[@]:-}"
  )
  :args "Write a literal value into the secret cache" "${@}"

  [[ -n "${name}" ]] || { error "Secret --name is required"; return 1; }
  [[ -n "${key}" ]] || { error "Key argument is required"; return 1; }

  if [[ -z "${value}" ]]; then
    if [[ -t 0 ]]; then
      echo -n "Enter value for ${name}/${key}: " >&2
      read -rs value
      echo >&2
    else
      value=$(cat)
    fi
  fi

  [[ -n "${value}" ]] || { error "Empty value"; return 1; }

  secrets::_ensure_store
  local secrets_dir
  secrets_dir=$(secrets::path)
  mkdir -p "${secrets_dir}"

  local cache_file="${secrets_dir}/Secret.${name}.${namespace}.${key}"
  printf '%s' "${value}" > "${cache_file}"
  chmod 0600 "${cache_file}"
  debug "Wrote ${cache_file}"

  local sops_config="${PATH_BASE}/.sops.yaml"

  if (( encrypt )); then
    # Encrypt ONLY this one file — never a whole-store sweep (a sweep would
    # re-encrypt every other plaintext entry, a documented staging hazard).
    # _encrypt_file errors + returns non-zero when .sops.yaml is absent.
    secrets::_encrypt_file "${cache_file}" || return 1
    secrets::_live_drift "${name}" "${namespace}" "${key}" "${value}"
    echo "Set + encrypted ${name}/${namespace}/${key}"
    return 0
  fi

  # Plaintext-only write. If encryption is configured (.sops.yaml present) the
  # freshly-written cache has no matching .enc — either none exists yet (a
  # first-time write) or the committed one is now stale. Either way it is not
  # committable as-is, so always warn (there is deliberately no quiet level to
  # gate this on). Silent when .sops.yaml is absent (encryption isn't set up).
  # The wording covers both cases (missing vs. stale) without asserting which.
  if [[ -f "${sops_config}" ]]; then
    warn "wrote plaintext cache only — no matching .enc for this value (missing or now stale); run 'lo secrets encrypt' or re-run with --encrypt/-e before committing"
  fi
  secrets::_live_drift "${name}" "${namespace}" "${key}" "${value}"
  echo "Set ${name}/${namespace}/${key}"
}

# ── Live-drift check ─────────────────────────────────────

# Warn when the LIVE cluster Secret still holds a different value than the one
# just written to the store.
#
# `lo secrets set` updates the CACHE only — the running workload keeps its old
# value until `lo build` + apply. The gap itself is by design; the SILENCE is
# the bug. An operator who sets a value and reads back `Set app/default/KEY`
# has no reason to suspect the cluster disagrees, and that assumption is what
# made the 2026-06-15 drift trap expensive to find.
#
# Advisory ONLY — every failure path returns 0. No kubectl, no current context,
# an unreachable cluster, an absent Secret or an absent key are all ordinary
# (the value may simply not be deployed yet) and must never fail a write that
# has already succeeded. `--request-timeout` is what keeps an unreachable
# cluster from hanging the CLI instead of just declining to answer.
#
# The comparison is base64-to-base64; the live side is never decoded. That
# keeps binary values out of shell variables, and it is what makes a
# trailing-newline difference VISIBLE: decoding the live value through a
# command substitution would strip its trailing newline, match it against a
# store value that never has one, and report "no drift" for a Secret that
# `lo build` + apply would genuinely rewrite. A false negative here is the
# expensive direction — it is the original silent trap wearing a green tick.
#
# The context is NAMED in the warning deliberately. A claim about "live" that
# silently refers to whichever cluster kubectl happens to point at is worse
# than no claim: it reads as authoritative while being about somewhere else.
# Usage: secrets::_live_drift <name> <namespace> <key> <value>
secrets::_live_drift() {
  local name="${1}" namespace="${2}" key="${3}" value="${4}"

  command -v kubectl >/dev/null 2>&1 || return 0

  local ctx
  ctx=$(kubectl config current-context 2>/dev/null) || return 0
  [[ -n "${ctx}" ]] || return 0

  # Bracket form: a key like `tls.crt` reads as a nested path in the bare
  # `{.data.tls.crt}` form and would silently return empty — i.e. "no drift".
  local live
  live=$(kubectl --request-timeout=5s get secret "${name}" \
           --namespace "${namespace}" \
           -o "jsonpath={.data['${key//./\\.}']}" 2>/dev/null) || return 0
  [[ -n "${live}" ]] || {
    debug "no live ${namespace}/${name} key ${key} on ${ctx} — nothing to compare"
    return 0
  }

  # `base64 | tr -d '\n'` rather than `base64 -w0`: BSD base64 has no -w.
  local want
  want=$(printf '%s' "${value}" | base64 | tr -d '\n') || return 0

  [[ "${live}" != "${want}" ]] || {
    debug "live ${namespace}/${name} key ${key} on ${ctx} already matches the store"
    return 0
  }

  warn "live Secret ${namespace}/${name} key ${key} on context '${ctx}' still holds the PREVIOUS value — the store is updated, the workload is NOT; run 'lo build' + apply (GitOps planes: commit and let Flux reconcile)"
  return 0
}

# ── Encrypt ──────────────────────────────────────────────

# Encrypt a single plaintext cache file to <file>.enc with SOPS. Gated on
# ${PATH_BASE}/.sops.yaml existing (its presence = "encryption is configured");
# errors + returns non-zero when it's absent. Shared by `secrets::encrypt` (the
# whole-store sweep) and `secrets::set --encrypt` (this one file only) so both go
# through the same .sops.yaml check + sops invocation.
# Usage: secrets::_encrypt_file <plaintext_path>
secrets::_encrypt_file() {
  local plaintext="${1}"
  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "No .sops.yaml found — run: lo secrets init"
    return 1
  }
  local enc_file="${plaintext}.enc"
  debug "Encrypting $(basename "${plaintext}")"
  # `--config "${sops_config}"` pins the SAME .sops.yaml the gate just checked:
  # without it sops discovers config by walking up from the FILE's path, so a
  # different .sops.yaml higher up (e.g. the repo root, or under Docker) could
  # silently supply other creation_rules/recipients than the one we validated.
  # (`--config` is a global flag, so it precedes the `encrypt` subcommand.)
  sops --config "${sops_config}" encrypt \
    --input-type binary \
    --output-type binary \
    --output "${enc_file}" \
    "${plaintext}" || {
    error "Failed to encrypt $(basename "${plaintext}")"
    return 1
  }
}

# Callers invoke this with NO arguments on purpose (the "stage everything" path
# in the re-key sweep above); --name is for the interactive single-Secret case.
# shellcheck disable=SC2120
secrets::encrypt() {
  # --name narrows the sweep to ONE Secret's cache files.
  #
  # Without it this walks the whole store and encrypts every plaintext whose
  # .enc is older — including entries the operator was mid-edit on, or values
  # they were only trying out. That is fine as the deliberate "stage everything"
  # move and wrong as the default for "I changed one secret", which is the
  # common case; committing an .enc for a value nobody meant to publish is not
  # something the store can walk back.
  local name=""
  local -a args=(
    'name|n' "Encrypt only this Secret's cache files (metadata.name); default is the whole store"
    "${args[@]:-}"
  )
  :args "Encrypt plaintext cache files for commit" "${@}"

  # The name lands in a glob under ${secrets_dir}; a slash or .. would let it
  # address files outside the store. Same charset the domain resolver enforces.
  if [[ -n "${name}" && ! "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    error "invalid --name '${name}' — a Secret name is [a-zA-Z0-9][a-zA-Z0-9._-]*"
    return 1
  fi

  local secrets_dir
  secrets_dir=$(secrets::path)

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Ensure .gitignore blocks plaintext before we create .enc files
  secrets::_ensure_gitignore "${secrets_dir}"

  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "No .sops.yaml found — run: lo secrets init"
    return 1
  }

  # Cache files are Secret.<name>.<namespace>.<key>, so --name anchors on the
  # second field. Unquoted on purpose: this must glob.
  local pattern="Secret.*"
  [[ -z "${name}" ]] || pattern="Secret.${name}.*"

  local count=0 skipped=0
  local plaintext
  # shellcheck disable=SC2231 # intentional glob; ${name} is charset-validated above
  for plaintext in "${secrets_dir}"/${pattern}; do
    [[ -f "${plaintext}" ]] || continue
    # Skip .enc files
    [[ "${plaintext}" != *.enc ]] || continue

    local enc_file="${plaintext}.enc"

    # Skip if .enc is newer than plaintext (already up to date)
    if [[ -f "${enc_file}" && "${enc_file}" -nt "${plaintext}" ]]; then
      skipped=$((skipped + 1))
      continue
    fi

    secrets::_encrypt_file "${plaintext}" || return 1
    count=$((count + 1))
  done

  if (( count > 0 )); then
    echo "Encrypted ${count} secret(s)"
  fi
  if (( skipped > 0 )); then
    debug "Skipped ${skipped} (already up to date)"
  fi
  if (( count == 0 && skipped == 0 )); then
    # A --name that matched nothing is a FAILURE, not a quiet no-op. The
    # operator asked for one specific Secret; a typo would otherwise print a
    # reassuring line, exit 0, and leave them committing whatever stale .enc is
    # already on disk. Without --name an empty store is genuinely nothing to do.
    if [[ -n "${name}" ]]; then
      error "no cache files for Secret '${name}' in ${secrets_dir}"
      error "  expected ${secrets_dir}/Secret.${name}.<namespace>.<key>; check the name or run without --name to see the store"
      return 1
    fi
    echo "No plaintext secrets found in ${secrets_dir}"
  fi
}

# ── Allow ────────────────────────────────────────────────

secrets::allow() {
  :args "Approve bash: generators after review" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Collect the per-entry hashes from existing .sha files.
  local -a sha_files=()
  local -a hashes=()
  for sha_file in "${secrets_dir}"/*.sha; do
    [[ -f "${sha_file}" ]] || continue
    sha_files+=("${sha_file}")
    local h
    h=$(cat "${sha_file}" | tr -d '[:space:]')
    hashes+=("${h}")
  done

  if (( ${#hashes[@]} == 0 )); then
    echo "No bash: entries found (no .sha files)"
    return 0
  fi

  # Write the approved SET of per-entry hashes (one per line, sorted + unique).
  # The Go plugin treats .bash-allow as a set and requires every bash entry in a
  # (per-target) build to be a member — so a subset build still matches. (Was a
  # single hash-of-all-hashes, which a per-target build's subset could never
  # match — see kustomize/plugins/secret/generator/bash.go verifyBashAllow.)
  local allow_file="${secrets_dir}/.bash-allow"
  printf '%s\n' "${hashes[@]}" | sort -u > "${allow_file}"
  chmod 0600 "${allow_file}"

  echo "Approved ${#sha_files[@]} bash: entry/entries"
  for sf in "${sha_files[@]}"; do
    echo "  $(basename "${sf}")"
  done
}

# ── Decrypt ──────────────────────────────────────────────

secrets::decrypt() {
  local ssh_key="${LOK8S_SSH_KEY}"
  local -a args=(
    'ssh-key|k'  'Path to SSH private key'
    "${args[@]:-}"
  )
  :args "Decrypt .enc files into plaintext cache" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Resolve the age private key. Checked in order:
  #   1. SOPS_AGE_KEY env var (CI, explicit)
  #   2. SOPS_AGE_KEY_FILE (~/.config/sops/age/keys.txt, SOPS standard)
  #   3. ssh-to-age from SSH private key (only works without passphrase)
  local age_key="${SOPS_AGE_KEY:-}"
  if [[ -z "${age_key}" ]]; then
    local age_key_file="${SOPS_AGE_KEY_FILE:-${HOME}/.config/sops/age/keys.txt}"
    if [[ -f "${age_key_file}" ]]; then
      age_key=$(grep -v '^#' "${age_key_file}" | grep -m1 'AGE-SECRET-KEY-' || true)
    fi
  fi
  if [[ -z "${age_key}" ]]; then
    command -v ssh-to-age &>/dev/null || {
      error "Cannot find age private key. Options:"
      error "  1. Set SOPS_AGE_KEY env var"
      error "  2. Create ${HOME}/.config/sops/age/keys.txt via:"
      error "     ssh-to-age -private-key < ${ssh_key} > \${HOME}/.config/sops/age/keys.txt"
      error "  3. Install ssh-to-age (b install)"
      return 1
    }
    [[ -f "${ssh_key}" ]] || {
      error "SSH private key not found: ${ssh_key}"
      return 1
    }
    age_key=$(ssh-to-age -private-key < "${ssh_key}" 2>/dev/null) || {
      error "Failed to derive age key from ${ssh_key}"
      error "If your SSH key is passphrase-protected, derive once:"
      error "  mkdir -p ~/.config/sops/age"
      error "  ssh-to-age -private-key -i ${ssh_key} > ~/.config/sops/age/keys.txt"
      error "  chmod 600 ~/.config/sops/age/keys.txt"
      error "(you'll be prompted for the passphrase once)"
      return 1
    }
  fi

  local count=0 skipped=0
  local enc_file
  for enc_file in "${secrets_dir}"/Secret.*.enc; do
    [[ -f "${enc_file}" ]] || continue

    local plaintext="${enc_file%.enc}"

    # Skip if plaintext is newer than .enc (already decrypted)
    if [[ -f "${plaintext}" && "${plaintext}" -nt "${enc_file}" ]]; then
      skipped=$((skipped + 1))
      continue
    fi

    debug "Decrypting $(basename "${enc_file}")"
    SOPS_AGE_KEY="${age_key}" sops decrypt \
      --input-type binary \
      --output-type binary \
      --output "${plaintext}" \
      "${enc_file}" || {
      error "Failed to decrypt $(basename "${enc_file}")"
      return 1
    }
    chmod 0600 "${plaintext}"
    count=$((count + 1))
  done

  if (( count > 0 )); then
    echo "Decrypted ${count} secret(s)"
  fi
  if (( skipped > 0 )); then
    debug "Skipped ${skipped} (already up to date)"
  fi
  if (( count == 0 && skipped == 0 )); then
    echo "No encrypted secrets found in ${secrets_dir}"
  fi
}

# ── Helpers ──────────────────────────────────────────────

# Ensure the secrets dir has a .gitignore that blocks plaintext but
# allows .enc files. Creates the file if missing.
secrets::_ensure_gitignore() {
  local dir="${1}"
  local gitignore="${dir}/.gitignore"
  if [[ -f "${gitignore}" ]] && grep -qF '!Secret.*.enc' "${gitignore}"; then
    return 0
  fi
  cat > "${gitignore}" <<'GI'
# Auto-generated by lok8s — ignore everything except SOPS-encrypted
# secret cache files. Plaintext cache entries must never be committed.
*
!.gitignore
!Secret.*.enc
GI
  debug "Created ${gitignore}"
}

# Check if a file is SOPS-encrypted (binary format starts with specific bytes).
secrets::is_encrypted() {
  local file="${1}"
  [[ -f "${file}" ]] || return 1
  # SOPS binary-encrypted files contain the JSON envelope with "sops" metadata.
  # A simpler heuristic: the .enc file exists and is not empty.
  [[ -f "${file}.enc" ]] && [[ -s "${file}.enc" ]]
}

# Check for unencrypted secrets (used by lint).
# Returns 0 if all secrets are encrypted or no secrets exist.
# Returns 1 if any plaintext secret lacks a corresponding .enc file.
secrets::check_unencrypted() {
  local secrets_dir
  secrets_dir=$(secrets::path)
  [[ -d "${secrets_dir}" ]] || return 0

  local found=0
  for plaintext in "${secrets_dir}"/Secret.*; do
    [[ -f "${plaintext}" ]] || continue
    [[ "${plaintext}" != *.enc ]] || continue
    if [[ ! -f "${plaintext}.enc" ]]; then
      warn "Unencrypted secret: $(basename "${plaintext}") — run: lo secrets encrypt"
      found=1
    elif [[ "${plaintext}" -nt "${plaintext}.enc" ]]; then
      warn "Secret changed since last encrypt: $(basename "${plaintext}") — run: lo secrets encrypt"
      found=1
    fi
  done
  return "${found}"
}

# Check for deprecated flat-store shadows of a domain's per-domain secrets.
# A domain with its OWN store (clusters/<domain>/secrets/) must not ALSO keep the
# same Secret.<name>.<ns>.<key> in the flat store (${PATH_SECRETS:-${PATH_BASE}/.secrets}): the two
# diverge silently and different tools read different stores (lo build/Tilt →
# per-domain; a manual PATH_SECRETS=.../.secrets kustomize → flat), which can
# re-key a live cluster from the WRONG store (this orphaned a dev IdP's etcd
# encryption once). Per-domain is authoritative; the flat store keeps ONLY
# global, non-domain material (e.g. a shared registry/expose TLS cert that no
# per-domain store mirrors).
#
# Emits one line per shadow to stdout (lint wraps each as a warning); returns 1
# if any shadow exists, 0 otherwise. An identical copy is a stale duplicate; a
# DIFFERING copy is active drift — the dangerous case.
# Usage: secrets::check_flat_shadows <domain_dir>
secrets::check_flat_shadows() {
  local domain_dir="${1}"
  # Need a store root: short-circuit when neither is configured, else `flat` would
  # be a bogus "/.secrets" that could match an unrelated host directory.
  [[ -n "${PATH_SECRETS:-}" || -n "${PATH_BASE:-}" ]] || return 0
  # Resolve the flat store exactly as secrets::path does — PATH_SECRETS overrides
  # the default ${PATH_BASE}/.secrets — so a custom PATH_SECRETS is honored (else
  # this check would inspect the wrong dir and miss the very case it targets). The
  # guard above means PATH_BASE is set whenever that default is evaluated, so the
  # bare ${PATH_BASE} is safe under `set -u`.
  local flat="${PATH_SECRETS:-${PATH_BASE}/.secrets}"
  local store="${domain_dir}/secrets"
  local dname
  dname=$(basename "${domain_dir}")

  # Only meaningful when the domain has its OWN store, distinct from the flat one.
  [[ -d "${store}" && -d "${flat}" ]] || return 0
  [[ "${store}" -ef "${flat}" ]] && return 0

  local found=0 plaintext base flat_copy
  for plaintext in "${store}"/Secret.*; do
    [[ -f "${plaintext}" ]] || continue
    case "${plaintext}" in *.enc | *.sha) continue ;; esac
    base=$(basename "${plaintext}")
    flat_copy="${flat}/${base}"
    [[ -f "${flat_copy}" ]] || continue
    if cmp -s "${flat_copy}" "${plaintext}"; then
      echo "Flat-store shadow: ${base} is duplicated in the flat .secrets/ store — flat is deprecated for domain secrets; remove the flat copy (it keeps only global TLS like registries-tls)"
    else
      echo "Flat-store DRIFT: ${base} differs between the flat .secrets/ store and ${dname}/secrets/ — the stores diverged (a build from the wrong store can re-key a live cluster); reconcile to the per-domain value, then remove the flat copy"
    fi
    found=1
  done
  return "${found}"
}

# ── List / Print (preserved from original) ───────────────

secrets::list() {
  :args "List secrets" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)
  if [[ ! -d "${secrets_dir}" ]]; then
    warn "Secrets directory not found: ${secrets_dir}"
    return 0
  fi
  for secret in "${secrets_dir}"/Secret.*; do
    [[ -f "${secret}" ]] || continue
    [[ "${secret}" != *.enc ]] || continue
    local name
    name=$(basename "${secret}")
    if [[ -f "${secret}.enc" ]]; then
      echo "${name} (encrypted)"
    else
      echo "${name} (plaintext)"
    fi
  done
  # Also list .enc files without a plaintext counterpart (need decrypt)
  for enc in "${secrets_dir}"/Secret.*.enc; do
    [[ -f "${enc}" ]] || continue
    local plaintext="${enc%.enc}"
    [[ -f "${plaintext}" ]] || echo "$(basename "${enc}") (needs decrypt)"
  done
}

secrets::print() {
  local only_one copy
  local -a find args=(
    'only-one|o:+'  'Only print one secret (error if multiple matches)'
    'copy|c:+'      'Copy secret(s) to clipboard (--only-one is implied)'
    'find'          'match all arguments (regex)'
    "${args[@]:-}"
  )
  :args "Print secret(s)" "${@}"
  if (( copy )); then only_one=1; fi

  local secrets_dir
  secrets_dir=$(secrets::path)

  local -a matches=()
  local name
  for secret in "${secrets_dir}"/Secret.*; do
    [[ -f "${secret}" ]] || continue
    [[ "${secret}" != *.enc ]] || continue
    name="$(basename "${secret}")"
    local m=1
    for f in "${find[@]}"; do
      echo "${name}" | grep -iqE ".*${f}.*" || { m=0; break; }
    done
    (( m )) && matches+=("${secret}")
  done

  if (( only_one )) && [[ ${#matches[@]} != 1 ]]; then
    error "Multiple matches found:"
    for match in "${matches[@]}"; do
      echo -e "${GREEN}${match}${NC}"
    done
    return 1
  fi

  (( ${#matches[@]} )) || { error "No matches found"; return 1; }

  if (( copy )); then
    for cp in "pbcopy" "xclip -selection clipboard" "xsel --clipboard --input" "clip.exe"; do
      command -v "$(echo "${cp}" | cut -d' ' -f1)" &>/dev/null && {
        ${cp} < "${matches[0]}"
        return
      }
    done
    error "No clipboard tool found"
    return 1
  fi

  if [[ ${#matches[@]} == 1 ]]; then
    cat "${matches[0]}"
    return
  fi

  for match in "${matches[@]}"; do
    echo -e "${GREEN}$(basename "${match}")${NC}"
    cat "${match}"
    echo
    echo
  done
}

# ── Env ──────────────────────────────────────────────────

# Emit `export KEY=value` lines for every key of a cached secret, so
# provisioning-time credentials live in the managed (SOPS-encrypted, per-domain)
# store instead of a loose plaintext env file. Each cache KEY becomes the exported
# variable name — name the keys after the vars you want (e.g. HCLOUD_TOKEN). Load
# them with:  eval "$(lo secrets --domain <domain> env --name hetzner)"
# Read-only; values are shell-quoted with %q so the eval is injection-safe.
secrets::env() {
  local name namespace="default"
  local -a args=(
    'name|n'       'Secret name whose keys to export'
    'namespace|s'  'Secret namespace'
    "${args[@]:-}"
  )
  :args "Emit export lines for a cached secret" "${@}"
  [[ -n "${name}" ]] || { error "Secret --name is required"; return 1; }

  local secrets_dir
  secrets_dir=$(secrets::path)
  local f base key found=0
  for f in "${secrets_dir}/Secret.${name}.${namespace}".*; do
    [[ -f "${f}" ]] || continue
    [[ "${f}" != *.enc && "${f}" != *.sha ]] || continue
    base="${f##*/}"
    key="${base#"Secret.${name}.${namespace}."}"
    printf 'export %s=%q\n' "${key}" "$(cat "${f}")"
    found=1
  done
  (( found )) || { error "No cached keys for ${name}/${namespace} in ${secrets_dir}"; return 1; }
}

