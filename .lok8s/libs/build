#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# build — kustomize build pipeline (domain-based)
# Renders the DOMAIN kustomization (clusters/<domain>/kustomization.yaml) —
# which composes the domain's targets — into ONE clusters/<domain>/artifacts.yaml.

import ^utils/types
import ^utils/verbose

main::build() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local cluster_override
  local -a args=(
    'domain|:^~domain'   'Domain to use'
    'cluster-override|'  'Override cluster domain for kubeconfig resolution'
    "${args[@]:-}"
  )
  :args "Build the domain kustomization into one artifacts.yaml" "${@}"

  _resolve_kubeconfig_for_domain
  build::artifacts "${domain}"
}

# Resolve the control-plane API endpoint from the domain's kubeconfig and export
# LOK8S_USER_API_{HOST,PORT} so ${LOK8S_USER_API_*} in target manifests (e.g. the
# host-firewall ccnp) resolve at envsubst time. Best-effort: the kubeconfig may not
# exist yet for a deploy domain (resolved secret not fetched). MUST be called
# directly (not in a subshell) so the exports persist for the envsubst whitelist.
build::_resolve_api() {
  local domain_dir="${1}"
  local _kcfg="${KUBECONFIG:-}"
  if [[ -z "${_kcfg}" || ! -f "${_kcfg}" ]]; then
    # Deploy domains (deploy.lok8s.yaml + clusterRef) have NO cluster.lok8s.yaml.
    # Guard the read: a bare yq on a missing file exits non-zero and, under
    # set -euo pipefail, would abort the whole build. Read only when present.
    local _cn=""
    if [[ -f "${domain_dir}/cluster.lok8s.yaml" ]]; then
      _cn=$(yq -r '.metadata.name // ""' "${domain_dir}/cluster.lok8s.yaml" 2>/dev/null) || _cn=""
    fi
    [[ -n "${_cn}" && -f "${PATH_BASE}/.kubeconfig/${_cn}.yaml" ]] && _kcfg="${PATH_BASE}/.kubeconfig/${_cn}.yaml"
  fi
  local _api=""
  if [[ -f "${_kcfg}" ]]; then
    _api=$(yq -r '.clusters[0].cluster.server // ""' "${_kcfg}" 2>/dev/null) || _api=""
  fi
  _api="${_api#http*://}"
  if [[ -n "${_api}" ]]; then
    export LOK8S_USER_API_HOST="${_api%%:*}"
    local _ap="${_api##*:}"; [[ "${_ap}" != "${_api}" && -n "${_ap}" ]] || _ap="6443"
    export LOK8S_USER_API_PORT="${_ap}"
  fi
}

# Per-instance secret isolation. The kustomize secrets plugin reads $PATH_SECRETS;
# when a domain keeps its own secrets (clusters/<domain>/secrets/) point the plugin
# there so each instance generates + reads ONLY its own secrets — never a shared
# flat store, so dev secrets can't bleed into prod (and vice versa). A domain opts
# in simply by having that dir (the `lo secrets --domain <d> …` commands write it).
# Without it, the inherited flat $PATH_SECRETS is used (single-instance projects).
# Mirrors libs/secrets `secrets::path`; see docs/guide/secrets.md.
# MUST run un-subshelled so the export reaches the kustomize child.
build::_export_secrets_path() {
  local domain_dir="${1}"
  # `if` (not `&&`): a false `[[ … ]] && …` returns non-zero, which as the last
  # command would fail the caller under `set -e` when a domain has no own store.
  if [[ -d "${domain_dir}/secrets" ]]; then
    export PATH_SECRETS="${domain_dir}/secrets"
  fi
}

# Build the domain's composed artifact via kustomize alpha plugins.
#
# Renders the DOMAIN kustomization (clusters/<domain>/kustomization.yaml) — which
# composes the domain's targets (resources: [./targets/foo, ../../.targets/bar];
# local + shared) — into ONE file clusters/<domain>/artifacts.yaml.
#
# Same pipeline the CLI has always used: --enable-alpha-plugins with
# $KUSTOMIZE_PLUGIN_HOME (secrets/khelm), KHELM_TRUST_ANY_REPO=true, per-domain
# secret isolation (build::_export_secrets_path), API-endpoint resolution
# (build::_resolve_api), kubeconfig resolution for cluster-aware plugins (the
# khelm ChartRenderer kubeVersion check), and the LOK8S_* envsubst pass.
#
# There is no per-target loop and no artifacts/<target>/ output: target ordering
# and selection live in the domain kustomization the user authors. Selection at
# deploy time is `lo deploy --label <k=v>` (see libs/deploy).
#
# Usage: build::artifacts [<domain>]
build::artifacts() {
  local domain="${1:-${DOMAIN_NAME:-lok8s.dev}}"
  local domain_dir="${PATH_CLUSTERS}/${domain}"

  debug "Build artifacts via kustomize alpha plugins for ${domain}"

  # The domain composes its targets in its own kustomization.yaml. Without it
  # there is nothing to build — fail clearly with the fix.
  if ! _has_kustomization "${domain_dir}"; then
    error "domain ${domain} has no kustomization.yaml — compose its targets there, e.g. resources: [./targets/foo, ../../.targets/bar]"
    return 1
  fi

  # Per-domain secret isolation + API endpoint exports (LOK8S_USER_API_*), so
  # ${LOK8S_USER_*}/${LOK8S_SPEC_*} in target manifests resolve at envsubst time.
  # MUST run un-subshelled so the exports reach the kustomize child + whitelist.
  build::_export_secrets_path "${domain_dir}"
  build::_resolve_api "${domain_dir}"

  # Resolve kubeconfig (some targets need it for cluster-aware kustomize
  # plugins like the khelm ChartRenderer kubeVersion check).
  local kubeconfig="${PATH_BASE}/.kubeconfig/secret.${domain}.yaml"
  if [[ ! -f "${kubeconfig}" ]]; then
    local cluster_spec="${domain_dir}/cluster.lok8s.yaml"
    if [[ -f "${cluster_spec}" ]] && command -v yq &>/dev/null; then
      local cluster_name
      cluster_name=$(yq -r '.metadata.name // ""' "${cluster_spec}" 2>/dev/null)
      if [[ -n "${cluster_name}" ]] && [[ -f "${PATH_BASE}/.kubeconfig/${cluster_name}.yaml" ]]; then
        kubeconfig="${PATH_BASE}/.kubeconfig/${cluster_name}.yaml"
      fi
    fi
  fi

  # envsubst whitelist: rebuilt on every call so new LOK8S_SPEC_* vars in
  # lo::export_spec_envs are automatically picked up.
  local envsubst_whitelist
  envsubst_whitelist=$(template::envsubst_whitelist)

  # Clean stale per-target artifact dirs from the pre-domain-build era so
  # `lo status`/hooks don't read phantom outputs. Only framework-generated
  # subdirs (each held an artifacts.yaml) are removed; env's overlay
  # kustomization.yaml, capi.yaml and .cache-queue live as files directly
  # under artifacts/ and are preserved.
  if [[ -d "${domain_dir}/artifacts" ]]; then
    local _sd
    for _sd in "${domain_dir}"/artifacts/*/; do
      [[ -d "${_sd}" && -f "${_sd}artifacts.yaml" ]] && rm -rf "${_sd}"
    done
  fi

  # Render the whole domain (all composed targets) into one artifact. Directory
  # bases outside the domain root (../../.targets/*) are kustomize bases, allowed
  # under the default load restrictor; only raw-file refs would need relaxing.
  debug "Building domain kustomization: ${domain_dir}/kustomization.yaml"
  # Render to a temp file first, then promote on success. A direct
  # `> artifacts.yaml` truncates the target BEFORE the pipeline runs, so a
  # kustomize failure (surfaced under set -o pipefail) would leave a truncated /
  # empty artifact and clobber a prior good one. Only a fully successful build
  # is moved into place; a failure removes the temp and leaves the old artifact.
  local _tmp
  # -p "${domain_dir}": keep the temp on the SAME filesystem as the target so the
  # mv below is an atomic rename (a cross-fs mv is copy+unlink — non-atomic, and an
  # interrupted one can leave a partial artifacts.yaml).
  _tmp=$(mktemp -p "${domain_dir}")
  if KUBECONFIG="${kubeconfig}" \
     KHELM_TRUST_ANY_REPO=true \
       kustomize build --enable-alpha-plugins "${domain_dir}" \
       | envsubst "${envsubst_whitelist}" \
       > "${_tmp}"; then
    mv "${_tmp}" "${domain_dir}/artifacts.yaml"
  else
    rm -f "${_tmp}"
    error "kustomize build failed for ${domain}"
    return 1
  fi
}

# Helper: check if a directory has a kustomization file
_has_kustomization() {
  local dir="${1}"
  [[ -f "${dir}/kustomization.yaml" ]] \
    || [[ -f "${dir}/kustomization.yml" ]] \
    || [[ -f "${dir}/Kustomization" ]]
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::build "${@}"
