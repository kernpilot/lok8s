#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# status — cluster and domain status reporting
# Reports cluster health, node status, target build state,
# and Tilt status for a given domain.

import ^utils/types
import ^utils/domain
import ^utils/verbose
import ^utils/targets
import ^libs/provision

main::status() {
  local domain="${domain:-}"
  local -a args=(
    'domain|:^~domain'  'Domain to check (default: active domain)'
    "${args[@]:-}"
  )
  :args "Cluster status" "${@}"

  status::all "${domain}"
}

# ── Cluster status ──────────────────────────────────────
# Reports cluster phase from the driver contract.
# Usage: status::cluster <domain>
status::cluster() {
  local domain="${1}"

  echo "--- Cluster ---"
  provision::dispatch_status "${domain}" 2>&1 || true
  echo ""
}

# ── kubectl calls of the report ─────────────────────────
# After `lo down` the kubeconfig can point to an API server that does not
# answer. Each kubectl call of the report ends with --request-timeout=5s
# (Go twin: statusRequestTimeout). Without it, kubectl can wait about two
# minutes before it stops. But the flag bounds one request, not the whole
# call: a `kubectl get` can make discovery requests before the GET and
# retry them, and an exec credential plugin of the kubeconfig runs outside
# the flag. So status::all first sends one /readyz probe (no discovery).
# When the probe gets no HTTP answer, the report skips both reads
# (status::reachable). Else each read runs with a bound for the whole call.
# The probe has the same bound.
#
# The bound is timeout(1): status::_read_bound seconds, then SIGKILL 2 s
# after the SIGTERM (Go twin: statusReadBound and statusReadGrace). timeout
# signals its own process group, so a credential plugin stops too. Without
# timeout on PATH, each call has only the request timeout, as before.
#
# Each call gets an empty stdin (</dev/null). timeout runs kubectl in a
# process group that is not the foreground group of a terminal, so a
# credential plugin that reads the terminal would stop (SIGTTIN) until the
# bound. With an empty stdin it reads end of file at once.

# status::_read_bound — the bound of one kubectl call of the report, in
# seconds (Go: statusReadBound). A test makes it short.
status::_read_bound() { echo 10; }

# status::_kubectl <args...> — one kubectl call of the report: kubectl
# <args> --request-timeout=5s with an empty stdin, under timeout(1) when it
# is on PATH.
status::_kubectl() {
  if command -v timeout &>/dev/null; then
    timeout -k 2 "$(status::_read_bound)" kubectl "$@" --request-timeout=5s </dev/null
  else
    kubectl "$@" --request-timeout=5s </dev/null
  fi
}

# status::reachable — 0 when kubectl and the kubeconfig file are there and
# the API server gives an HTTP answer to the /readyz probe, of any status
# (Go: statusReachable). A 401, a 403 (a cluster that removed the
# system:public-info-viewer grant), a 404 (an older API server, or a proxy
# in front of it) or a 500 (an API server that is not ready) fails the
# probe, but the server answers, so the reads run, each with its bound.
# Only a probe with no HTTP answer skips the reads: a connection, DNS or
# TLS error, the request timeout, or the bound. The stderr of the probe
# goes to a file, not to a pipe: a credential plugin that left the process
# group of timeout(1) could keep a pipe open after the bound. When mktemp
# fails, the stderr goes to /dev/null, and each failed probe skips the
# reads.
# Usage: status::reachable
status::reachable() {
  command -v kubectl &>/dev/null || return 1
  [[ -f "${KUBECONFIG:-}" ]] || return 1
  local errfile rc=1
  errfile="$(mktemp 2>/dev/null)" || errfile=/dev/null
  if status::_kubectl get --raw /readyz >/dev/null 2>"${errfile}" ||
    status::_http_answer < "${errfile}"; then
    rc=0
  fi
  [[ "${errfile}" == /dev/null ]] || rm -f "${errfile}"
  return "${rc}"
}

# status::_http_answer — 0 when stdin, the stderr of a kubectl call that
# failed, holds the form that kubectl prints for an HTTP answer that is
# not 2xx (Go: statusHTTPAnswer). kubectl's StandardErrorMessage
# (k8s.io/kubectl/pkg/cmd/util) starts the line with "Error from server"
# for such an answer, and with "error: You must be logged in to the
# server" for a 401. An error with no HTTP answer has other forms:
# "Unable to connect to the server: ..." (DNS, TLS, the request timeout)
# and "The connection to the server ... was refused ...".
# Usage: status::_http_answer < <stderr file>
status::_http_answer() {
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    case "${line}" in
      "Error from server"* | "error: You must be logged in to the server"*) return 0 ;;
    esac
  done
  return 1
}

# ── Node status ─────────────────────────────────────────
# Reports node status via kubectl (if kubeconfig is available). With
# reachable not 1 (the /readyz probe of status::all got no HTTP answer),
# the section shows (not reachable) and kubectl does not read the nodes.
# Usage: status::nodes [reachable]
status::nodes() {
  local reachable="${1:-0}"
  if command -v kubectl &>/dev/null && [[ -f "${KUBECONFIG:-}" ]]; then
    echo "--- Nodes ---"
    if [[ "${reachable}" == 1 ]]; then
      status::_kubectl get nodes -o wide 2>/dev/null || echo "  (not reachable)"
    else
      echo "  (not reachable)"
    fi
    echo ""
  fi
}

# ── ClusterInventory ────────────────────────────────────
# Shows the in-cluster ClusterInventory (lok8s.dev/v1alpha1 singleton
# "cluster", written by lo at the end of provision/bootstrap) when the
# cluster is reachable and the CR exists. Read-only, fail-soft: silently
# skipped otherwise (also when reachable is not 1).
# Usage: status::inventory [reachable]
status::inventory() {
  [[ "${1:-0}" == 1 ]] || return 0
  command -v kubectl &>/dev/null || return 0
  command -v jq &>/dev/null || return 0
  [[ -f "${KUBECONFIG:-}" ]] || return 0

  local inv
  inv=$(status::_kubectl get clusterinventories.lok8s.dev cluster -o json 2>/dev/null) || return 0
  [[ -n "${inv}" ]] || return 0

  echo "--- Inventory (ClusterInventory/cluster) ---"
  jq -r '
    "  lok8s:      \(.spec.lok8sVersion // "?")",
    "  driver:     \(.spec.kind // "?")\(if .spec.provider then " · " + .spec.provider else "" end)",
    (if .spec.kubernetesVersion then "  kubernetes: \(.spec.kubernetesVersion)" else empty end),
    "  specHash:   \(.spec.specHash // "?" | .[0:12])…",
    "  renderedAt: \(.spec.renderedAt // "?")",
    "  addons:     \(.spec.addons // [] | length)",
    (.spec.addons // [] | .[] |
      "    \(.name)\(if .chartVersion then " " + .chartVersion else "" end)\(if .category then " (" + .category + ")" else "" end)"),
    (if .status.lastReported then "  agent:      last reported \(.status.lastReported)" else empty end)
  ' <<< "${inv}" 2>/dev/null || echo "  (unreadable inventory)"
  echo ""
}

# ── Target status ───────────────────────────────────────
# Lists the targets under clusters/<domain>/targets/ (enumeration only) and
# reports whether the domain has been built. Per-target build state is no longer
# tracked: `lo build` composes the domain kustomization into ONE
# clusters/<domain>/artifacts.yaml.
# Usage: status::targets <domain>
status::targets() {
  local domain="${1}"
  local domain_dir="${PATH_CLUSTERS}/${domain}"

  echo "--- Targets ---"
  local -a targets=()
  mapfile -t targets < <(targets::discover "${domain}")
  if (( ${#targets[@]} > 0 )); then
    local tname
    for tname in "${targets[@]}"; do
      [[ -n "${tname}" ]] || continue
      echo "  ${tname}"
    done
  else
    echo "  No targets directory"
  fi

  if [[ -f "${domain_dir}/artifacts.yaml" ]]; then
    echo "  artifacts.yaml: built"
  else
    echo "  artifacts.yaml: not built (run 'lo build')"
  fi
  echo ""
}

# ── Tilt status ─────────────────────────────────────────
# Reports whether the lok8s-managed Tilt session is running. Tilt is the
# local dev loop, so this is only meaningful for `lo` (kind) clusters —
# KubeOne/Capi/Kkp clusters have no local Tilt session and a status check
# there used to run `tilt status`, which is not even a tilt subcommand
# (`unknown command "status" for "tilt"`). Liveness comes from lok8s's own
# PID file (written by tilt::up), not a tilt API call.
# Usage: status::tilt <kind>
status::tilt() {
  local kind="${1:-}"
  [[ "${kind}" == "lo" ]] || return 0

  echo "--- Tilt ---"
  local pidfile="${PATH_BASE}/.tilt.pid" pid=""
  [[ -f "${pidfile}" ]] && pid="$(cat "${pidfile}" 2>/dev/null)"
  if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
    echo "  running (pid ${pid})"
  else
    echo "  (not running)"
  fi
}

# ── Run all status checks ──────────────────────────────
# Convenience function to report full status for a domain.
# Usage: status::all <domain>
status::all() {
  local domain="${1}"

  echo "=== Domain: ${domain} ==="
  echo ""

  # Resolve the driver kind so the Tilt section only runs for `lo` clusters.
  local kind=""
  kind=$(domain::spec_driver "${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml") || kind=""

  status::cluster "${domain}"
  # One /readyz probe for both kubectl reads.
  local reachable=0
  status::reachable && reachable=1
  status::nodes "${reachable}"
  status::inventory "${reachable}"
  status::targets "${domain}"
  status::tilt "${kind}"
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::status "${@}"
