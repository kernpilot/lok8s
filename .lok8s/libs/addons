#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2016,SC2034
# SC2016: single-quoted $ here is jq/yq/awk program text or a remote-script literal
# vim: set syntax=bash:
# addons — list and inspect framework-shipped bootstrap addons
#
# Lists addons from the shared .lok8s/addons/ tree, showing name, type
# (khelm / raw / base), and version (parsed from chart.yaml for khelm
# addons). Addons are framework-level and work with all drivers; the
# active domain's driver (cluster.lok8s.yaml `kind`) only selects which
# values overlay (values.<driver>.yaml) applies at bootstrap time.

import ^utils/types
import ^utils/domain
import ^utils/verbose
import ^utils/template

main::addons() {
  local domain="${domain:-${DOMAIN_NAME:-}}" detail=0
  local -a addons
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    'detail|:+'         'Inventory the addons THIS cluster deploys (spec.bootstrap) + category + how to configure'
    'addons'            'List and inspect specific addons'
    "${args[@]:-}"
  )
  :args "Manage cluster addons" "${@}"

  if is::set addons; then
    for ((i=0; i<${#addons[@]}; i++)); do
      addons::show "${addons[${i}]}"
      [[ ${i} -lt $((${#addons[@]} - 1)) ]] &&
        printf "\n---\n"
    done
    return 0
  fi

  if (( detail )); then
    addons::detail "${domain}"
    return 0
  fi

  addons::list
}

# Resolve the driver kind for the active domain.
# Usage: addons::_driver [domain]
# Echoes lowercase driver name. Falls back to "lo" if no spec found — but NOT
# if the spec declares a malformed one (domain::spec_driver rc 2). That is the
# reader's documented contract: rc 1 means "nothing to read" and takes the
# fallback, rc 2 means "present but not a bare driver name" and is never
# defaulted, because the value reaches a path we source and quietly replacing a
# crafted one with "lo" hides the crafting.
# shellcheck disable=SC2120 # optional [domain] arg; callers invoke it arg-less (active domain)
addons::_driver() {
  local target="${1:-${domain:-${DOMAIN_NAME:-lok8s.dev}}}"
  local spec="${PATH_CLUSTERS}/${target}/cluster.lok8s.yaml"
  local kind rc=0
  kind=$(domain::spec_driver "${spec}" lo) || rc=$?
  if (( rc )); then
    error "cluster spec for '${target}' declares a malformed kind (${spec}) — refusing to assume 'lo'"
    return 1
  fi
  echo "${kind}"
}

# Resolve the shared addons directory.
addons::_dir() {
  echo "${PATH_LOK8S}/addons"
}

# Classify an addon directory: khelm | raw | base | empty
addons::_type() {
  local dir="${1}"
  if [[ -f "${dir}/chart.yaml" ]]; then
    local kind
    kind=$(yq -r '.kind // ""' "${dir}/chart.yaml" 2>/dev/null)
    if [[ "${kind}" == "ChartRenderer" ]]; then
      echo "khelm"
      return
    fi
  fi
  if [[ -f "${dir}/kustomization.yaml" || -f "${dir}/kustomization.yml" ]]; then
    # Has kustomization but no chart.yaml → raw or composition
    echo "raw"
    return
  fi
  echo "empty"
}

# Get version for a khelm addon. Echoes "-" for non-khelm.
addons::_version() {
  local dir="${1}"
  if [[ -f "${dir}/chart.yaml" ]]; then
    yq -r '.version // "-"' "${dir}/chart.yaml" 2>/dev/null
  else
    echo "-"
  fi
}

# Get the chart repository URL for a khelm addon.
addons::_repo() {
  local dir="${1}"
  if [[ -f "${dir}/chart.yaml" ]]; then
    yq -r '.repository // "-"' "${dir}/chart.yaml" 2>/dev/null
  else
    echo "-"
  fi
}

# Get the chart name for a khelm addon.
addons::_chart() {
  local dir="${1}"
  if [[ -f "${dir}/chart.yaml" ]]; then
    yq -r '.chart // "-"' "${dir}/chart.yaml" 2>/dev/null
  else
    echo "-"
  fi
}

# addons::list — print a table of addons for the active driver.
addons::list() {
  local driver addons_dir
  driver=$(addons::_driver) || return 1
  addons_dir=$(addons::_dir)

  if [[ ! -d "${addons_dir}" ]]; then
    warn "No addons directory (${addons_dir})"
    return 0
  fi

  printf '%-20s  %-8s  %-12s  %s\n' "NAME" "TYPE" "VERSION" "CHART/REPO"
  printf '%-20s  %-8s  %-12s  %s\n' "----" "----" "-------" "----------"

  local had_entries=0
  local dir
  for dir in "${addons_dir}"/*/; do
    [[ -d "${dir}" ]] || continue
    local name type version chart repo
    name=$(basename "${dir}")
    type=$(addons::_type "${dir}")
    version=$(addons::_version "${dir}")
    chart=$(addons::_chart "${dir}")
    repo=$(addons::_repo "${dir}")
    local detail="-"
    if [[ "${chart}" != "-" ]]; then
      detail="${chart} (${repo})"
    fi
    printf '%-20s  %-8s  %-12s  %s\n' "${name}" "${type}" "${version}" "${detail}"
    had_entries=1
  done

  if (( ! had_entries )); then
    echo "  (no addons available)"
  fi
}

# addons::show — print detail for one or more addons.
# Usage: addons::show <name> [name...]
addons::show() {
  local name="${1}"
  [[ -n "${name}" ]] || { error "addon name required"; return 1; }

  local driver addons_dir
  driver=$(addons::_driver) || return 1
  addons_dir=$(addons::_dir)
  local dir="${addons_dir}/${name}"

  if [[ ! -d "${dir}" ]]; then
    error "addon '${name}' not found (${dir})"
    return 1
  fi

  echo "name:    ${name}"
  echo "driver:  ${driver}"
  echo "path:    ${dir}"
  echo "type:    $(addons::_type "${dir}")"
  local version chart repo
  version=$(addons::_version "${dir}")
  chart=$(addons::_chart "${dir}")
  repo=$(addons::_repo "${dir}")
  if [[ "${chart}" != "-" ]]; then
    echo "chart:   ${chart}"
    echo "version: ${version}"
    echo "repo:    ${repo}"
  fi
  echo ""
  echo "files:"
  local f
  for f in "${dir}"/*; do
    [[ -f "${f}" ]] || continue
    echo "  - $(basename "${f}")"
  done
}

# Read an addon's lok8s.dev/category label from its manifests. Echoes the
# category (infrastructure/networking/observability/storage/security/
# gitops/dev-tools) or "-".
addons::_category() {
  local dir="${1}" line cat=""
  # LC_ALL=C sort before head -1: grep -r traversal follows readdir order
  # (filesystem-dependent), and the category feeds deterministic artifacts
  # (ClusterInventory, addons-index.json) — pick a stable winner.
  line=$(grep -rhoE 'lok8s\.dev/category:[[:space:]]*[a-zA-Z0-9-]+' "${dir}" 2>/dev/null | LC_ALL=C sort | head -1)
  cat="${line##*:}"                 # drop everything up to the colon
  cat="${cat//[[:space:]]/}"        # trim surrounding whitespace
  echo "${cat:--}"
}

# addons::_config_hint <name> — a one-line "how to configure" pointer for a
# framework addon. This is the small in-repo config-help catalog: every addon
# under .lok8s/addons/ MUST have an entry here (a parity test fails on drift, so
# adding an addon without a hint breaks CI). Keep each hint to the handful of
# knobs users actually touch.
addons::_config_hint() {
  case "${1}" in
    autoscaler)                   echo "min/max nodes per MachineDeployment via cluster-autoscaler annotations";;
    ccm)                          echo "spec.bootstrap ccm.values.env: ROBOT_ENABLED / HCLOUD_NETWORK (hcloud CCM)";;
    cert-manager)                 echo "issue TLS via ClusterIssuer/Certificate CRs in a networking target";;
    cert-manager-webhook-hetzner) echo "needs the hetzner-dns token Secret; pair with a DNS-01 ClusterIssuer";;
    cilium)                       echo "encryption + policy mode (policyAuditMode) in cilium inline values / values.<driver>.yaml";;
    cnpg-operator)                echo "declare databases as CNPG Cluster CRs in a target";;
    envoy-gateway)                echo "define Gateway + HTTPRoutes in a networking target";;
    external-dns)                 echo "set the managed DNS zones via spec.dns.domainFilter";;
    fluxcd)                       echo "GitRepository + Kustomization are per-cluster glue; set them inline (extraObjects) or in a flux-system target";;
    gatus)                        echo "configure monitored endpoints in the gatus target/values";;
    local-path-provisioner)       echo "set as default StorageClass; values in addons/local-path-provisioner";;
    loki)                         echo "bootstrap AFTER monitoring; pin storageClass/retention inline; add the Grafana Loki datasource in the monitoring values";;
    mailpit)                      echo "expose via an HTTPRoute target (dev SMTP capture)";;
    metallb)                      echo "set the address pool via spec.loadBalancer.pool";;
    metrics-server)               echo "usually no config; values in addons/metrics-server";;
    monitoring)                   echo "Prometheus/Grafana scrape + OIDC config via the monitoring target values";;
    oidc-rbac)                    echo "spec.oidc.groupsClaim + the oidc group->cluster-role bindings";;
    promtail)                     echo "bootstrap AFTER loki (its push target); tolerates all taints so control-plane logs ship too";;
    redis-operator)               echo "declare Redis CRs in a target";;
    reflector)                    echo "annotate the source Secret/ConfigMap to mirror across namespaces";;
    rook-ceph)                    echo "CephCluster/pool/StorageClass in a target: replica count + device filter";;
    rook-ceph-csi-kms)            echo "opt-in after rook-ceph: restores the node plugin's Secret + ServiceAccount-token grants (KMS encryption, mounter=rbd-nbd)";;
    sso-gate)                     echo "patch issuer/clientID from a target + Secret sso-gate-client; label routes sso.lok8s.dev/protect";;
    system-upgrade-controller)    echo "declare upgrade Plans in a target (Rancher SUC)";;
    tempo)                        echo "configure trace storage/retention via the tempo values";;
    *)                            echo "";;
  esac
}

# addons::detail [domain] — inventory the addons THIS cluster DEPLOYS.
# Reads spec.bootstrap through the SAME shared parser the apply path uses
# (bootstrap::_resolve_entries / _parse_entry — so map-form entries stay intact),
# intersected with the .lok8s/addons/ tree, and prints each addon's category
# (lok8s.dev/category label) + a one-line config pointer. `./targets/*` (and
# absolute-path) entries are listed as per-cluster targets (glue), not framework
# addons. Read-only, cluster-free.
addons::detail() {
  local domain="${1:-${domain:-${DOMAIN_NAME:-}}}"

  # Reject a path-traversal / injected domain BEFORE it builds any filesystem
  # path (same guard as bootstrap::dispatch / provision::resolve_spec /
  # audit::run_domain — rejects '/', '..', absolute and non-allowlisted names).
  if [[ ! "${domain}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    warn "Invalid domain name '${domain}' — nothing to inventory"
    return 0
  fi

  local spec="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local addons_dir
  addons_dir=$(addons::_dir)

  if [[ ! -f "${spec}" ]]; then
    warn "No cluster spec for '${domain}' (${spec}) — nothing to inventory"
    return 0
  fi
  # The bootstrap parser is loaded by the `lo` entrypoint before addons is used;
  # guard so a direct source without it fails loud instead of mis-parsing.
  if ! declare -f bootstrap::_resolve_entries &>/dev/null; then
    error "bootstrap parser not loaded — run via 'lo addons --detail'"
    return 1
  fi

  # `|| kind="lo"` here would default on rc 2 as well, which is exactly what
  # domain::spec_driver promises never to happen — the kind selects the
  # values.<driver>.yaml overlay and the driver's default entries, so a
  # malformed one must be reported, not guessed away.
  local kind
  kind=$(domain::spec_driver "${spec}" lo) || {
    error "cluster spec for '${domain}' declares a malformed kind (${spec})"
    return 1
  }

  local -a entries=()
  mapfile -t entries < <(bootstrap::_resolve_entries "${spec}" "${kind}" 2>/dev/null)

  printf 'Addons deployed by %s (kind=%s)\n\n' "${domain}" "${kind}"
  printf '%-24s  %-14s  %-8s  %-10s  %s\n' "NAME" "CATEGORY" "TYPE" "VERSION" "CONFIGURE"
  printf '%-24s  %-14s  %-8s  %-10s  %s\n' "----" "--------" "----" "-------" "---------"

  local e nm dr inl ev wt dp count=0
  for e in "${entries[@]+"${entries[@]}"}"; do
    [[ -n "${e}" ]] || continue
    nm=""; dr=""; inl=""; ev=""; wt=""; dp=""
    bootstrap::_parse_entry "${domain}" "${e}" nm dr inl ev wt dp 2>/dev/null || continue
    count=$(( count + 1 ))
    local base
    base=$(basename "${dr}")
    if [[ "${dr}" == "${addons_dir}/"* ]]; then
      # Framework addon.
      local cat type version hint
      cat=$(addons::_category "${dr}")
      type=$(addons::_type "${dr}")
      version=$(addons::_version "${dr}")
      hint=$(addons::_config_hint "${base}")
      [[ -n "${hint}" ]] || hint="see docs/guide/addons.md"
      printf '%-24s  %-14s  %-8s  %-10s  %s\n' "${nm}" "${cat}" "${type}" "${version}" "${hint}"
    else
      # Per-cluster target (glue) — a ./targets/* or /abs path entry.
      local tpath="${dr//\/.\//\/}"          # normalize the /./ from ./targets
      tpath="${tpath#"${PATH_BASE}/"}"
      printf '%-24s  %-14s  %-8s  %-10s  %s\n' \
        "${nm}" "target" "target" "-" "per-cluster glue in ${tpath}"
    fi
  done

  if (( count == 0 )); then
    echo "  (spec.bootstrap is empty — this cluster deploys no addons)"
  fi
  printf '\nConfigure an addon: edit its spec.bootstrap inline values, or its addons/<name>/values.<driver>.yaml — see docs/guide/addons.md.\n'
}

# ── lo bootstrap --dry-run: the render boundary ──────────────────────────
# The Go twin is internal/addons/dryrun.go (the texts are the same). A dry run
# renders IN PLACE, exactly as a real run does (the same project, HOME,
# credentials and CA). lo's own state writes are suppressed at their source
# (LOK8S_BOOTSTRAP_DRYRUN=1: the secrets plugin keeps new values in memory,
# the cert generator never writes CAROOT, .registries.json stays in memory),
# and executable addon code is refused where it would execute: kustomize runs
# with a plugin home that holds only lok8s' two built-in plugins, without
# --enable-exec (a KRM exec function never runs), and with refusing `docker`
# and `git` first on PATH (a KRM container function, a remote base).
# --allow-generators lifts that: the addon code runs as trusted, with the
# side effects of a real run. Every security-relevant name below carries the
# bootstrap_ prefix an entry's env: may not set.

# addons::dry_run_boundary <dir>
# Builds the boundary of one dry run in <dir> (a fresh directory the caller
# owns and removes): plugins/ links the project's Secret and ChartRenderer
# plugins (a plugin the project does not have is missing there too, as in a
# real run), bin/ holds the refusing docker and git, report is the secrets
# plugin's report file. A Secret plugin without the dry-run capability
# (`Secret --capabilities`) would write the secrets store: refused.
addons::dry_run_boundary() {
  local _dir="${1}" _home="${KUSTOMIZE_PLUGIN_HOME:-${PATH_BASE}/.kustomize}" _rel
  mkdir -p "${_dir}/plugins" "${_dir}/bin" && chmod 700 "${_dir}/plugins" "${_dir}/bin" || return 1
  for _rel in secrets.lok8s.dev/v1/secret/Secret khelm.mgoltzsche.github.com/v2/chartrenderer/ChartRenderer; do
    [[ -f "${_home}/${_rel}" ]] || continue
    mkdir -p "$(dirname "${_dir}/plugins/${_rel}")" && ln -s "${_home}/${_rel}" "${_dir}/plugins/${_rel}" || return 1
  done
  printf '#!/bin/sh\necho %s >&2\nexit 1\n' \
    "'lok8s dry-run: a KRM container function is not run in a dry run (pass --allow-generators to run it)'" > "${_dir}/bin/docker" || return 1
  printf '#!/bin/sh\necho %s >&2\nexit 1\n' \
    "'lok8s dry-run: a remote base is not fetched in a dry run (pass --allow-generators to fetch it)'" > "${_dir}/bin/git" || return 1
  chmod 700 "${_dir}/bin/docker" "${_dir}/bin/git" || return 1
  ( umask 077; : > "${_dir}/report" ) || return 1
  local _plugin="${_home}/secrets.lok8s.dev/v1/secret/Secret"
  if [[ -f "${_plugin}" ]] && ! "${_plugin}" --capabilities 2>/dev/null </dev/null | grep -qx 'dry-run'; then
    error "bootstrap dry-run: the Secret plugin ${_plugin#"${PATH_BASE}/"} does not support a dry run (it would write the secrets store) — run 'lo toolchain install' to install the plugin of this lo"
    return 1
  fi
  return 0
}

# addons::_within <root> <path>
# True when path (resolved) is root or below it.
addons::_within() {
  case "${2}" in
    "${1}"|"${1}"/*) return 0 ;;
  esac
  return 1
}

# addons::_dry_run_local_chart <addon_dir>
# Resolves a chart.yaml addon's local chart for a dry run. Prints nothing for
# a remote chart. Otherwise prints the containment root (the project, or the
# addon directory for an addon served outside the project), the resolved
# addon directory, and then one line per resolved chart directory (the chart
# and its file:// dependencies), and finally "deps" when khelm builds
# dependencies for one of them (it writes Chart.lock and charts/). A chart or
# a file:// dependency outside the root is an error (printed).
addons::_dry_run_local_chart() {
  local _addon="${1}" _repo _chart _path _real_addon _root _base
  _repo="$(yq -r '.repository // ""' "${_addon}/chart.yaml")" || return 1
  _chart="$(yq -r '.chart // ""' "${_addon}/chart.yaml")" || return 1
  [[ -z "${_repo}" && -n "${_chart}" ]] || return 0
  _path="${_chart}"
  [[ "${_path}" == /* ]] || _path="${_addon}/${_path}"
  [[ -d "${_path}" ]] || return 0
  _real_addon="$(realpath -e "${_addon}")" || return 1
  _root="${_real_addon}"
  if _base="$(realpath -e "${PATH_BASE}" 2>/dev/null)" && addons::_within "${_base}" "${_real_addon}"; then
    _root="${_base}"
  fi
  local -a _queue=("${_path}|chart ${_chart}") _dirs=()
  local -A _seen=()
  local _item _cur _what _real _deps=0 _n _dep _dname _drepo _depth=0
  while (( ${#_queue[@]} )); do
    _item="${_queue[0]}"; _queue=("${_queue[@]:1}")
    _cur="${_item%%|*}"; _what="${_item#*|}"
    _depth=$(( _depth + 1 ))
    (( _depth <= 200 )) || { error "addons::render: ${_addon}: local chart dependencies nest too deep"; return 1; }
    _real="$(realpath -e "${_cur}" 2>/dev/null)" || { error "addons::render: ${_addon}: ${_what}: no such directory: ${_cur}"; return 1; }
    if ! addons::_within "${_root}" "${_real}"; then
      error "addons::render: ${_addon}: ${_what} resolves outside the project (${_real}) — a dry run renders only charts inside the project"
      return 1
    fi
    [[ -z "${_seen[${_real}]:-}" ]] || continue
    _seen["${_real}"]=1
    _dirs+=("${_real}")
    [[ -f "${_real}/Chart.yaml" ]] || continue
    _n="$(yq -r '(.dependencies // []) | length' "${_real}/Chart.yaml" 2>/dev/null)" || continue
    [[ "${_n}" =~ ^[0-9]+$ ]] && (( _n > 0 )) || continue
    _deps=1
    while IFS=$'\t' read -r _dname _drepo; do
      [[ "${_drepo}" == file://* ]] || continue
      _dep="${_drepo#file://}"
      [[ "${_dep}" == /* ]] || _dep="${_real}/${_dep}"
      _queue+=("${_dep}|file:// dependency ${_dname}")
    done < <(yq -r '(.dependencies // [])[] | [(.name // ""), (.repository // "")] | @tsv' "${_real}/Chart.yaml" 2>/dev/null)
  done
  printf '%s\n' "${_root}" "${_real_addon}" "${_dirs[@]}"
  (( ! _deps )) || echo deps
}

# addons::_dry_run_mirror <tmp> <addon_dir> <root> <real_addon> <dir...>
# Copies the addon directory and the chart closure under tmp at their paths
# relative to root (every relative reference among them resolves as in the
# project), plus chart.yaml's local valueFiles; a symlink is copied as its
# target, so khelm never writes through one into the project. Prints the
# copy of the addon directory.
addons::_dry_run_mirror() {
  local _tmp="${1}" _addon="${2}" _root="${3}" _real_addon="${4}"; shift 4
  local -a _copied=()
  local _d _c _covered _rel _vf _real_vf
  for _d in "${_real_addon}" "${@}"; do
    _covered=0
    for _c in "${_copied[@]+"${_copied[@]}"}"; do addons::_within "${_c}" "${_d}" && { _covered=1; break; }; done
    (( _covered )) && continue
    _rel="${_d#"${_root}"}"; _rel="${_rel#/}"
    mkdir -p "${_tmp}/${_rel}" || return 1
    cp -rL "${_d}/." "${_tmp}/${_rel}/" 2>/dev/null || true
    _copied+=("${_d}")
  done
  while IFS= read -r _vf; do
    [[ -n "${_vf}" && "${_vf}" != *://* ]] || continue
    [[ "${_vf}" == /* ]] || _vf="${_addon}/${_vf}"
    _real_vf="$(realpath -e "${_vf}" 2>/dev/null)" || continue
    _covered=0
    for _c in "${_copied[@]}"; do addons::_within "${_c}" "${_real_vf}" && { _covered=1; break; }; done
    (( _covered )) && continue
    if ! addons::_within "${_root}" "${_real_vf}"; then
      error "addons::render: ${_addon}: valueFile ${_real_vf} resolves outside the project — a dry run cannot isolate this chart"
      return 1
    fi
    _rel="${_real_vf#"${_root}"/}"
    mkdir -p "$(dirname "${_tmp}/${_rel}")" && cp -L "${_real_vf}" "${_tmp}/${_rel}" || return 1
  done < <(yq -r '(.valueFiles // [])[]' "${_addon}/chart.yaml" 2>/dev/null)
  _rel="${_real_addon#"${_root}"}"; _rel="${_rel#/}"
  printf '%s\n' "${_tmp}/${_rel}"
}

# Render a framework addon to stdout via the canonical khelm path — the SINGLE
# render shared by the bootstrap engine and the KubeOne driver's pre-apply addon
# staging. Stacks values base < driver(kind) < provider < inline (later wins),
# rewrites the chart's valueFiles to the merged set, then
# `kustomize build --enable-alpha-plugins` + envsubst (LOK8S_USER_* placeholders
# the caller exported, e.g. cilium's k8sServiceHost).
#
# A dry run (bootstrap_dry_run, dynamically scoped from bootstrap::apply, with
# its boundary in bootstrap_dry_boundary) renders with the boundary (see
# above): the plugin home, no --enable-exec, the refusing docker/git, the
# report file; a local chart outside the project is an error, and a local
# chart khelm builds dependencies for renders from a copy in the boundary.
# Usage: addons::render <addon_dir> <kind> <provider_name> [inline_values]
addons::render() {
  local addon_dir="${1}" kind="${2}" provider_name="${3:-}" inline_values="${4:-}"
  local _dry=0 _tmp_root="${TMPDIR:-/tmp}"
  if (( ${bootstrap_dry_run:-0} )); then
    [[ -d "${bootstrap_dry_boundary:-}" ]] || { error "addons::render: a dry run needs its boundary"; return 1; }
    _dry=1
    _tmp_root="${bootstrap_dry_boundary}"
  fi
  local build_dir="${addon_dir}" _cleanup=""
  if [[ -f "${addon_dir}/chart.yaml" ]]; then
    # Stack values: base < driver < provider < inline (later wins). Facts
    # (provider env) beat preferences (driver flavor) beat chart defaults
    # (base); explicit caller intent (inline) beats all.
    local -a value_files=()
    [[ ! -f "${addon_dir}/values.yaml" ]] || value_files+=("${addon_dir}/values.yaml")
    [[ ! -f "${addon_dir}/values.${kind}.yaml" ]] || value_files+=("${addon_dir}/values.${kind}.yaml")
    [[ -z "${provider_name}" ]] || [[ ! -f "${addon_dir}/values.${provider_name}.yaml" ]] \
      || value_files+=("${addon_dir}/values.${provider_name}.yaml")
    # A dry run checks the local chart first: a chart or a file:// dependency
    # outside the project is an entry error.
    local -a _local=()
    if (( _dry )); then
      local _lc
      _lc="$(addons::_dry_run_local_chart "${addon_dir}")" || return 1
      [[ -z "${_lc}" ]] || mapfile -t _local <<< "${_lc}"
    fi
    if [[ -n "${inline_values}" ]] || (( ${#value_files[@]} > 0 )); then
      # Copy to a mktemp build dir when there's overlay stacking to do. A
      # chart that pins its OWN chart.yaml valueFiles — e.g. a target
      # referencing a cross-tree base `../../../../.lok8s/addons/<x>/values.yaml`
      # (monitoring, gatus) — must render IN PLACE: a copy breaks those
      # relative paths (they resolve from /tmp → /.lok8s, missing). Stacking
      # addons carry no cross-tree refs.
      build_dir=$(mktemp -d -p "${_tmp_root}" lok8s-addon-XXXXXXXX) || { error "addons::render: failed to create temp dir for ${addon_dir}"; return 1; }
      _cleanup="${build_dir}"
      # `/.` (not `/*`) so dotfiles (.helmignore, kustomize overlays, …) come too —
      # a glob drops them and a chart referencing a dotfile would fail to render.
      # A dry run copies a symlink as its target (cp -L), so khelm can never
      # write through one into the project.
      local -a _cp=(cp -r)
      (( ! _dry )) || _cp=(cp -rL)
      "${_cp[@]}" "${addon_dir}/." "${build_dir}/" \
        || { error "addons::render: failed to copy ${addon_dir} to temp dir"; rm -rf "${build_dir}"; return 1; }
      if [[ -n "${inline_values}" ]]; then
        printf '%s\n' "${inline_values}" > "${build_dir}/values.inline.yaml"
        value_files+=("${build_dir}/values.inline.yaml")
      fi
      if ! yq eval-all '. as $item ireduce ({}; . * $item)' "${value_files[@]}" \
             > "${build_dir}/values.merged.yaml"; then
        error "addons::render: failed to merge values for ${addon_dir}"
        rm -rf "${build_dir}"; return 1
      fi
      yq -i '.valueFiles = ["values.merged.yaml"]' "${build_dir}/chart.yaml" \
        || { error "addons::render: failed to set valueFiles in chart.yaml for ${addon_dir}"; rm -rf "${build_dir}"; return 1; }
    elif (( ${#_local[@]} > 3 )) && [[ "${_local[-1]}" == "deps" ]]; then
      # Dry run only: the real run renders this chart in place and khelm
      # writes Chart.lock and charts/ next to it. Render from a copy that
      # keeps the relative layout instead.
      local _mtmp
      _mtmp=$(mktemp -d -p "${_tmp_root}" lok8s-chart-XXXXXXXX) || { error "addons::render: failed to create temp dir for ${addon_dir}"; return 1; }
      _cleanup="${_mtmp}"
      build_dir="$(addons::_dry_run_mirror "${_mtmp}" "${addon_dir}" "${_local[0]}" "${_local[1]}" "${_local[@]:2:${#_local[@]}-3}")" \
        || { rm -rf "${_mtmp}"; return 1; }
    fi
  fi

  # KHELM_TRUST_ANY_REPO: chart repos are declared in our own version-controlled
  # chart.yaml (the trust boundary is code review), so trust them — no manual
  # `helm repo add`, versions stay pinned.
  # A real run passes --enable-exec (KRM exec functions); a dry run does not:
  # the built-in plugins are legacy exec plugins, which --enable-alpha-plugins
  # enables alone.
  local whitelist rc=0 out
  whitelist=$(template::envsubst_whitelist)
  local -a _kenv=(KHELM_TRUST_ANY_REPO=true) _kflags=(--enable-alpha-plugins --enable-exec)
  if (( _dry )); then
    _kenv+=(LOK8S_BOOTSTRAP_DRYRUN=1 "LOK8S_BOOTSTRAP_DRYRUN_REPORT=${bootstrap_dry_boundary}/report")
    if (( ${bootstrap_allow_generators:-0} )); then
      _kenv+=(LOK8S_BOOTSTRAP_ALLOW_GENERATORS=1)
    else
      _kflags=(--enable-alpha-plugins)
      _kenv+=("KUSTOMIZE_PLUGIN_HOME=${bootstrap_dry_boundary}/plugins" "PATH=${bootstrap_dry_boundary}/bin:${PATH}")
    fi
  fi
  # Container env `value`s MUST be strings (k8s schema). Helm coerces numeric
  # values (e.g. cilium's KUBERNETES_SERVICE_PORT from k8sServicePort) back to
  # ints and charts emit them unquoted → `kubectl apply` rejects them. Coerce
  # every container env value to a string; `valueFrom` entries (no `value`) are
  # left untouched.
  # The overlay is exported in the pipeline's own subshell: it reaches the
  # kustomize child (and a stub function in the tests), never this shell.
  out=$( { export "${_kenv[@]}"; kustomize build "${_kflags[@]}" "${build_dir}"; } \
          | template::envsubst "${whitelist}" \
          | yq eval '(.. | select(tag == "!!map" and has("env") and (.env | tag == "!!seq")) | .env[] | select(has("value")) | .value) |= tostring') || rc=$?
  [[ -z "${_cleanup}" ]] || rm -rf "${_cleanup}"
  # A successful build that yields nothing means the addon rendered no resources —
  # almost always a misconfig (wrong path, everything filtered out). Fail loud
  # rather than report success for an empty apply.
  if (( rc == 0 )) && [[ -z "${out}" ]]; then
    error "addons::render: empty output for ${addon_dir} (no resources rendered)"
    return 1
  fi
  (( rc == 0 )) && printf '%s\n' "${out}"
  return ${rc}
}
[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::addons "${@}"
