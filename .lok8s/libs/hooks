#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# hooks — dev-time lifecycle actions on rendered artifacts, selected by label.
#
# INTERNAL: driven by the Tilt `hooks:` wrapper (a local_resource cmd), not a
# user workflow. Acts on the live cluster + the domain's rendered artifacts to
# re-run/refresh a LABELLED subset when a watched file changes:
#   recreate — delete + apply the matched objects (immutable Jobs re-run)
#   restart  — rollout restart the matched workloads
#   apply    — re-apply the matched objects (no delete)
#
# Targeting is by LABEL — the same labels lok8s applies — passed kubectl-style:
#   lo hooks recreate --selector lok8s.dev/type=seed,lok8s.dev/name=zitadel
# The domain is the parent's resolved global arg (consumed via :^~domain), so the
# Tilt wrapper never has to pass it.
import ^utils/types
import ^utils/verbose
import ^utils/kapply
import ^utils/keysonly

main::hooks() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  # Driven by Tilt's local_resource — there is no controlling terminal. Force
  # non-interactive so kapply (and anything else) skip the /dev/tty progress UI +
  # confirm prompts, which fail with "No such device or address" here. (kapply's
  # `[[ -w /dev/tty ]]` check passes the permission bit but the device can't be
  # opened without a controlling tty.)
  export LOK8S_NONINTERACTIVE=1
  local -a usage=(
    'recreate@destructive'          'Delete + apply the selected objects (immutable Jobs re-run)'
    'restart@destructive'           'Rollout restart the selected workloads'
    'apply@destructive@idempotent'  'Re-apply the selected objects (no delete)'
  )
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  :usage "Dev hook actions on rendered artifacts (internal; Tilt hooks:)" "${@}"
  "${usage[@]}"
}

# hooks::_yq_filter <selector> — build a yq `select(...)` from a kubectl-style
# label selector (k=v,k2=v2). Validates each key/value to prevent yq injection.
hooks::_yq_filter() {
  local selector="${1:-}"
  [[ -n "${selector}" ]] || { error "hooks: --selector is required"; return 1; }
  local -a pairs=() clauses=()
  IFS=',' read -ra pairs <<< "${selector}"
  local pair key val
  for pair in "${pairs[@]}"; do
    [[ "${pair}" == *=* ]] || { error "hooks: selector clause '${pair}' must be key=value"; return 1; }
    key="${pair%%=*}"; val="${pair#*=}"
    if [[ ! "${key}" =~ ^[a-zA-Z0-9._/-]+$ ]] || [[ ! "${val}" =~ ^[a-zA-Z0-9._/-]+$ ]]; then
      error "hooks: invalid selector clause '${pair}' (key/value must be [a-zA-Z0-9._/-])"
      return 1
    fi
    clauses+=("(.metadata.labels.\"${key}\" == \"${val}\")")
  done
  (( ${#clauses[@]} )) || { error "hooks: empty --selector"; return 1; }
  local expr="${clauses[0]}" i
  for (( i = 1; i < ${#clauses[@]}; i++ )); do expr+=" and ${clauses[i]}"; done
  printf 'select(%s)\n' "${expr}"
}

# hooks::_select <domain> <selector> — emit the objects matching the label
# selector from the domain's rendered artifact. This is the same single
# clusters/<domain>/artifacts.yaml `lo deploy` applies; the Tilt reload keeps the
# upstream ConfigMaps current, so a recreated Job mounts the edited content.
# A missing artifact selects nothing. lo reads the artifact once, and that
# copy passes the apply guard of lo deploy (keysonly::read_checked_artifact):
# one with a keys-only Secret, or one that cannot be read or checked, is
# refused. yq selects from the copy that passed the check, not from a second
# read of the file; the copy reaches yq byte for byte through a pipe.
hooks::_select() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local domain="${1}" selector="${2}"
  local filter; filter="$(hooks::_yq_filter "${selector}")" || return 1
  local artifact="${PATH_CLUSTERS}/${domain}/artifacts.yaml"
  [[ -f "${artifact}" ]] || return 0
  local content
  content="$(keysonly::read_checked_artifact "${domain}" "${artifact}" && printf .)" || return 1
  content="${content%.}"
  printf '%s' "${content}" | yq "${filter}" - 2>/dev/null || true
}

# hooks::_overlay_images <live-images-json> — read ONE rendered object on stdin,
# emit it with each container's image replaced by the ref the CLUSTER is running
# for the container of the same name. Containers absent from the live object keep
# their rendered ref.
#
# WHY THIS EXISTS. `recreate` re-applies from the rendered artifact, which
# carries the DECLARED ref (e.g. `lok8s.local/<name>`). In a Tilt dev loop the
# running object carries Tilt's built-and-pushed ref
# (`<registry>/lok8s.local_<name>:tilt-<hash>`) — image injection happens on
# Tilt's deploy path, not in the YAML. Re-applying the declared ref therefore
# points the workload at an image nobody pushed, and it sits in
# ImagePullBackOff forever while Tilt still reports the resource ok, because
# TILT's last deploy did succeed — measured on a migrate Job whose DB migration
# sat blocked exactly this way since the hook last fired.
#
# Pure: the caller does the cluster lookup, so this half is unit-testable.
hooks::_overlay_images() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local live="${1:-[]}"
  # $live below is a YQ variable, bound by `as $live` inside the program — not a
  # shell expansion. The single quotes are load-bearing: the shell must not touch
  # it. (A shell `live` is also in scope two lines up, which is what makes this
  # read wrong at a glance.)
  # shellcheck disable=SC2016
  LOK8S_LIVE_IMAGES="${live}" yq '
    (strenv(LOK8S_LIVE_IMAGES) | from_json) as $live
    | (.spec.template.spec.containers[]?, .spec.template.spec.initContainers[]?) |=
        (. as $c | .image = (($live | map(select(.name == $c.name)) | .[0].image) // $c.image))
  '
}

# hooks::_live_images <kind> <name> <namespace> — the running object'"'"'s container
# images as a JSON array of {name, image}. Empty array when the object does not
# exist yet (a first-ever apply has nothing to preserve).
hooks::_live_images() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local kind="${1}" name="${2}" ns="${3}" live
  [[ -n "${kind}" && -n "${name}" ]] || { printf '[]'; return 0; }
  live="$(kubectl get "${kind}" "${name}" ${ns:+-n "${ns}"} -o json 2>/dev/null)" || { printf '[]'; return 0; }
  [[ -n "${live}" ]] || { printf '[]'; return 0; }
  printf '%s\n' "${live}" | yq -p=json -o=json -I=0 '
    [ (.spec.template.spec.containers[]?, .spec.template.spec.initContainers[]?)
      | {"name": .name, "image": .image} ]
  ' 2>/dev/null || printf '[]'
}

# hooks::_preserve_images — read the selected objects on stdin, emit them with
# live image refs overlaid (see hooks::_overlay_images).
hooks::_preserve_images() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local objs; objs="$(cat && printf .)"; objs="${objs%.}"
  local -a idx; mapfile -t idx < <(printf '%s' "${objs}" | yq 'documentIndex' 2>/dev/null)
  [[ ${#idx[@]} -gt 0 ]] || { printf '%s' "${objs}"; return 0; }
  local i doc kind name ns imgs first=1
  for i in "${idx[@]}"; do
    doc="$(printf '%s' "${objs}" | yq "select(documentIndex == ${i})" && printf .)"; doc="${doc%.}"
    kind="$(printf '%s' "${doc}" | yq -r '.kind // ""')"
    name="$(printf '%s' "${doc}" | yq -r '.metadata.name // ""')"
    ns="$(printf '%s' "${doc}" | yq -r '.metadata.namespace // ""')"
    imgs="$(hooks::_live_images "${kind}" "${name}" "${ns}")"
    if [[ "${imgs}" != '[]' ]]; then
      doc="$(printf '%s' "${doc}" | hooks::_overlay_images "${imgs}" && printf .)"; doc="${doc%.}"
    fi
    (( first )) || printf -- '---\n'
    first=0
    printf '%s' "${doc}"
  done
}

# hooks::_object_names — the metadata.name of every selected object, one per line.
hooks::_object_names() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  # yq prints a `---` between documents; left in, it becomes a bogus name, every
  # tilt::has_resource lookup for it fails, and _tilt_can_recreate silently says
  # "Tilt does not own this" for EVERY multi-object selection — disabling the
  # Tilt path exactly where it matters most. Caught by the unit test below.
  printf '%s\n' "${1}" | yq -r '.metadata.name // ""' 2>/dev/null | grep -vE '^(---)?$' || true
}

# hooks::_tilt_can_recreate — does the running Tilt session own EVERY selected
# object? All-or-nothing on purpose: recreating half a set through Tilt and half
# through kubectl would leave the two halves on different image refs, which is a
# subtler version of the bug this exists to avoid.
hooks::_tilt_can_recreate() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local objs="${1}" name any=0
  declare -F tilt::has_resource >/dev/null || return 1
  for name in $(hooks::_object_names "${objs}"); do
    any=1
    tilt::has_resource "${name}" || return 1
  done
  (( any ))
}

hooks::recreate() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local selector=''
  local -a args=(
    'selector|'  'Label selector (k=v,k2=v2)'
    "${args[@]:-}"
  )
  :args "Delete + apply selected objects (immutable Jobs re-run)" "${@}"
  _resolve_kubeconfig_for_domain
  local objs; objs="$(hooks::_select "${domain}" "${selector}" && printf .)" || return 1
  objs="${objs%.}"
  if ! printf '%s' "${objs}" | deploy::_has_objects; then
    warn "hooks recreate: no objects match '${selector}'"; return 0
  fi
  # Atomic-ish recreate: delete (tolerating not-found) THEN apply — chained with
  # `&&` so a real delete error stops before apply, and an apply failure surfaces
  # (no `|| true`), making a half-done recreate visible rather than silently
  # destructive. True one-shot atomicity isn't possible for an immutable Job.
  # UNDER TILT, LET TILT DO IT. The rendered artifact carries the DECLARED image
  # ref while the built-and-pushed image only exists under Tilt's content-hash
  # tag (full rationale at hooks::_overlay_images). Preserving the LIVE object's
  # refs (hooks::_preserve_images, below) fixes that only while something is
  # running: a Job that has completed and been cleaned up has nothing to
  # preserve, and the raw ref ships anyway — measured, a migration Job broke
  # again exactly this way after the preservation fix landed. Tilt is the only
  # party that knows the real ref in both cases, so when a Tilt session owns
  # this resource, hand the work to it.
  # `declare -F` rather than an import: the `lo` entrypoint loads libs/tilt
  # alongside this one, but hooks does not otherwise depend on it, and the unit
  # tests source hooks alone. Absent tilt helpers simply mean "no Tilt" and the
  # kubectl path below runs — the same answer as a stopped session.
  if declare -F tilt::running >/dev/null && tilt::running \
     && hooks::_tilt_can_recreate "${objs}"; then
    local name
    for name in $(hooks::_object_names "${objs}"); do
      tilt::trigger_resource "${name}" || {
        error "hooks recreate: tilt trigger failed for '${name}'"; return 1
      }
      debug "hooks: recreated '${name}' through Tilt (image injection preserved)"
    done
    return 0
  fi

  # No Tilt session (or it does not own these objects): fall back to delete +
  # apply, carrying over the live image refs where an object is still running.
  local applied; applied="$(printf '%s' "${objs}" | hooks::_preserve_images && printf .)"
  applied="${applied%.}"
  printf '%s' "${objs}" | kubectl delete --ignore-not-found -f - \
    && printf '%s' "${applied}" | kapply::apply --label "hook recreate ${selector}"
  debug "hooks: recreated objects matching '${selector}'"
}

hooks::apply() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local selector=''
  local -a args=(
    'selector|'  'Label selector (k=v,k2=v2)'
    "${args[@]:-}"
  )
  :args "Re-apply selected objects" "${@}"
  _resolve_kubeconfig_for_domain
  local objs; objs="$(hooks::_select "${domain}" "${selector}" && printf .)" || return 1
  objs="${objs%.}"
  if ! printf '%s' "${objs}" | deploy::_has_objects; then
    warn "hooks apply: no objects match '${selector}'"; return 0
  fi
  printf '%s' "${objs}" | kapply::apply --label "hook apply ${selector}"
  debug "hooks: applied objects matching '${selector}'"
}

hooks::restart() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }   # the objects can hold Secret values (utils/keysonly.sh)
  local selector=''
  local -a args=(
    'selector|'  'Label selector (k=v,k2=v2)'
    "${args[@]:-}"
  )
  :args "Rollout restart selected workloads" "${@}"
  _resolve_kubeconfig_for_domain
  local objs; objs="$(hooks::_select "${domain}" "${selector}" && printf .)" || return 1
  objs="${objs%.}"
  if ! printf '%s' "${objs}" | deploy::_has_objects; then
    warn "hooks restart: no workloads match '${selector}'"; return 0
  fi
  # Rollout-restart each matched Deployment/StatefulSet/DaemonSet by kind/name+ns.
  local kind name ns n=0
  while IFS=$'\t' read -r kind name ns; do
    [[ -n "${kind}" && -n "${name}" ]] || continue
    debug "rollout restart ${kind}/${name} -n ${ns:-default}"
    if kubectl -n "${ns:-default}" rollout restart "${kind,,}/${name}" 2>/dev/null; then
      n=$(( n + 1 ))
    else
      warn "hooks restart: ${kind}/${name} (-n ${ns:-default}) failed"
    fi
  done < <(printf '%s\n' "${objs}" | yq -r '
      select(.kind == "Deployment" or .kind == "StatefulSet" or .kind == "DaemonSet")
      | [.kind, .metadata.name, (.metadata.namespace // "default")] | @tsv' 2>/dev/null || true)
  if (( n > 0 )); then
    debug "hooks: restarted ${n} workload(s) matching '${selector}'"
  else
    warn "hooks restart: matched objects but none are restartable (Deployment/StatefulSet/DaemonSet) for '${selector}'"
  fi
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::hooks "${@}"
