#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-hosted — kubehz hosted cluster provisioning
# Handles creating/destroying clusters via the kubehz API for hosting: hosted mode.
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.

import ^utils/verbose
import ^utils/http

# ── Hosted provisioning ──────────────────────────────────

# Build the JSON payload for creating a hosted cluster via the kubehz API.
# Usage: kubehz::build_cluster_payload <cluster_yaml>
# Outputs: JSON string to stdout
kubehz::build_cluster_payload() {
  local cluster_yaml="${1}"
  local domain kind provider region k8s_version cp_replicas hosting access
  domain=$(yq -r '.spec.cluster.domain' "${cluster_yaml}")
  # NOT domain::spec_driver: this is a wire field, not a driver lookup. The
  # kubehz API receives the spec's kind in its ORIGINAL case ("KubeOne"), and
  # lowercasing it here would change a cross-repo contract (issue #89).
  kind=$(yq -r '.kind' "${cluster_yaml}")
  provider=$(yq -r '.spec.provider // "hetzner"' "${cluster_yaml}")
  region=$(yq -r '.spec.hcloud.region // .spec.aws.region // "fsn1"' "${cluster_yaml}")
  # An unset version (kubehz::_hosted_version prints "") is left out of
  # the payload. The bare read printed the word "null", which went out as
  # the version string "null" (issue #272). Go twin: buildClusterPayload.
  k8s_version=$(kubehz::_hosted_version "${cluster_yaml}")
  cp_replicas=$(yq -r '.spec.controlPlane.replicas // 1' "${cluster_yaml}")
  hosting=$(yq -r '.spec.kubehz.hosting // "self"' "${cluster_yaml}")
  access=$(yq -r '.spec.kubehz.access // "none"' "${cluster_yaml}")

  jq -n \
    --arg domain "${domain}" \
    --arg kind "${kind}" \
    --arg provider "${provider}" \
    --arg region "${region}" \
    --arg kubernetesVersion "${k8s_version}" \
    --argjson controlPlaneReplicas "${cp_replicas}" \
    --arg hosting "${hosting}" \
    --arg access "${access}" \
    '{domain: $domain, kind: $kind, provider: $provider, region: $region}
      + (if $kubernetesVersion != "" then {kubernetesVersion: $kubernetesVersion} else {} end)
      + {controlPlaneReplicas: $controlPlaneReplicas, hosting: $hosting, access: $access}'
}

# kubehz::_hosted_version <cluster_yaml>: spec.kubernetes.version on
# stdout, or "" when it is unset: no key, a YAML null, false or an empty
# string (`//` fires on null and on false). A number keeps its text ("0",
# "1.30"). kubehz::build_cluster_payload and the refusal in
# kubehz::provision_hosted use this one read. Go twin:
# specDoc.kubernetesVersion.
kubehz::_hosted_version() {
  yq -r '.spec.kubernetes.version // ""' "${1}"
}

# Wait for a hosted cluster to reach Running state.
# Polls the kubehz API at 10-second intervals up to a timeout.
# Usage: kubehz::wait_for_cluster <api_url> <cluster_id> [timeout_seconds]
kubehz::wait_for_cluster() {
  local api_url="${1}" cluster_id="${2}" timeout="${3:-600}"
  http::credential_ok KUBEHZ_TOKEN || return 1
  local elapsed=0 status_val

  debug "Waiting for hosted cluster ${cluster_id} to become ready (timeout: ${timeout}s)"

  while (( elapsed < timeout )); do
    # GET /api/clusters/{id} is an enveloped UI route ({ok,data,traceId}), so the
    # status is at .data.status; the // .status fallback tolerates a bare body.
    # -q first and the subshell with http::tls_log_vars_unset: curl reads no
    # config file of the user and gets no TLS log or trace control
    # (utils/http.sh).
    status_val=$(http::curl_config header "Authorization: Bearer ${KUBEHZ_TOKEN:-}" | (
      http::tls_log_vars_unset &&
        curl -q -K - -fsSL "${api_url}/api/clusters/${cluster_id}" 2>/dev/null
    ) | jq -r '.data.status // .status // "Unknown"') || status_val="Unknown"

    case "${status_val}" in
      Running|ready|Ready)
        debug "Hosted cluster ${cluster_id} is ready"
        return 0
        ;;
      Failed|Error)
        error "Hosted cluster ${cluster_id} failed: status=${status_val}"
        return 1
        ;;
    esac

    debug "Cluster ${cluster_id} status: ${status_val} (${elapsed}s / ${timeout}s)"
    sleep 10
    elapsed=$(( elapsed + 10 ))
  done

  error "Timed out waiting for hosted cluster ${cluster_id} after ${timeout}s"
  return 1
}

# Render a friendly, human-readable message for a capacity rejection (the
# kubehz-api "max mechanism": POST /api/clusters answers 503 AT_CAPACITY when the
# hosted control-plane pool for the requested plan is full). The api error body
# carries a structured `data.detail` { tier, used, limit, retryAfter } — surface
# it plainly so the operator knows WHY and WHAT to do, not a bare "request failed".
# The api origin for the "live availability" pointer comes from the module-global
# LOK8S_KUBEHZ_API_URL (set by kubehz::read_config), NOT the caller's locals.
# Usage: kubehz::render_capacity_rejection <error_body_json>
kubehz::render_capacity_rejection() {
  local body="${1}"
  local tier used limit retry
  tier=$(echo "${body}" | jq -r '.data.detail.tier // .detail.tier // "this plan"' 2>/dev/null) || tier="this plan"
  used=$(echo "${body}" | jq -r '.data.detail.used // .detail.used // empty' 2>/dev/null) || used=""
  limit=$(echo "${body}" | jq -r '.data.detail.limit // .detail.limit // empty' 2>/dev/null) || limit=""
  retry=$(echo "${body}" | jq -r '.data.detail.retryAfter // .detail.retryAfter // empty' 2>/dev/null) || retry=""

  local usage=""
  [[ -n "${used}" && -n "${limit}" ]] && usage=" (currently ${used}/${limit})"

  # Humanize the raw retryAfter seconds into a friendlier "~N min" / "~Ns" so
  # the operator doesn't have to divide by 60 in their head. Non-numeric / empty
  # -> no hint line at all.
  local retry_hint=""
  if [[ "${retry}" =~ ^[0-9]+$ ]]; then
    if (( retry >= 60 )); then
      retry_hint="~$(( (retry + 30) / 60 )) min"
    else
      retry_hint="~${retry}s"
    fi
  fi

  error "kubehz: the platform is at capacity for the '${tier}' plan right now${usage}."
  echo "  The hosted control-plane pool for this plan is full. You can:" >&2
  echo "    • retry later — capacity frees as clusters are torn down" >&2
  [[ -n "${retry_hint}" ]] && echo "    • suggested wait: ${retry_hint}" >&2
  # NOTE: the tier is chosen server-side (kubehz-api), not via a lok8s spec field
  # — there is no spec.kubehz.plan. Point at the real levers instead: check live
  # per-plan availability, or run self-hosted (spec.kubehz.hosting: self) now.
  echo "    • check live per-plan availability and retry when a slot opens:" >&2
  echo "        ${LOK8S_KUBEHZ_API_URL}/api/capacity" >&2
  echo "    • run a self-hosted cluster meanwhile (spec.kubehz.hosting: self)" >&2
  echo "    • still stuck? contact kubehz support with the tier + time above" >&2
}

# Provision a cluster via the kubehz hosted API.
# Creates the cluster, waits for it, and downloads the kubeconfig.
# A spec with no spec.kubernetes.version is refused first, before any
# request: the platform needs the version and refuses a create without it
# (HTTP 400, a missing field). Go twin: ProvisionHosted.
# Usage: kubehz::provision_hosted <domain> <cluster_yaml>
kubehz::provision_hosted() {
  local domain="${1}" cluster_yaml="${2}"
  local api_url="${LOK8S_KUBEHZ_API_URL}"
  local k8s_version
  k8s_version=$(kubehz::_hosted_version "${cluster_yaml}") || k8s_version=""
  if [[ -z "${k8s_version}" ]]; then
    error "kubehz: spec.kubernetes.version is not set in ${cluster_yaml}. A hosted cluster needs a Kubernetes version, so no cluster was created. Set it, then run the command again."
    return 1
  fi
  http::credential_ok KUBEHZ_TOKEN || return 1

  # The kubeconfig path is checked before the create: a path that the
  # write refuses (a link of another user, a link to nothing, a
  # directory, a directory that another user can write into) stops the
  # provision here, so a refusal creates no cluster
  # (kubehz::_private_target, the check of kubehz::_write_private). A
  # .kubeconfig directory that is not there yet passes: the write makes
  # it with mode 0700, and the second check accepts that mode, so the
  # second check refuses no directory that lo made.
  local kubeconfig_path="${PATH_BASE}/.kubeconfig/${domain}.yaml"
  kubehz::_private_target "${kubeconfig_path}" > /dev/null || return 1

  local payload
  payload=$(kubehz::build_cluster_payload "${cluster_yaml}")

  debug "Creating hosted cluster for ${domain}"

  # Capture BOTH the response body and the HTTP status. We deliberately drop
  # curl's -f (fail-silently-on-HTTP-error) here so a 503 AT_CAPACITY body is
  # available to render — the capacity envelope is the whole point. The status is
  # appended on its own trailing line via -w and split off.
  # -q first and the subshell with http::tls_log_vars_unset: curl reads no
  # config file of the user and gets no TLS log or trace control
  # (utils/http.sh).
  local raw response http_code
  raw=$(http::curl_config header "Authorization: Bearer ${KUBEHZ_TOKEN}" | (
    http::tls_log_vars_unset &&
      curl -q -K - -sSL -w $'\n%{http_code}' -X POST "${api_url}/api/clusters" \
        -H "Content-Type: application/json" \
        -d "${payload}"
  ) ) || {
    error "Failed to create hosted cluster via kubehz API (network error)"
    return 1
  }
  http_code="${raw##*$'\n'}"
  response="${raw%$'\n'*}"

  # Capacity rejection (the "max mechanism"): a structured 503 AT_CAPACITY.
  if [[ "${http_code}" == "503" ]] \
    && echo "${response}" | jq -e '(.data.code // .code) == "AT_CAPACITY"' >/dev/null 2>&1; then
    kubehz::render_capacity_rejection "${response}"
    return 1
  fi

  # Any other non-2xx: surface the api's own message + help when it carries them
  # (the {code,message,help} envelope — help is the actionable half).
  if [[ "${http_code}" != 2* ]]; then
    local msg help
    msg=$(echo "${response}" | jq -r '.data.message // .message // empty' 2>/dev/null) || msg=""
    help=$(echo "${response}" | jq -r '.data.help // .help // empty' 2>/dev/null) || help=""
    error "Failed to create hosted cluster via kubehz API (HTTP ${http_code})${msg:+: ${msg}}"
    [[ -n "${help}" ]] && echo "  ${help}" >&2
    return 1
  fi

  local cluster_id
  cluster_id=$(echo "${response}" | jq -r '.data.id // .id')

  if [[ -z "${cluster_id}" || "${cluster_id}" == "null" ]]; then
    error "kubehz API did not return a cluster ID"
    return 1
  fi

  debug "Hosted cluster created: ${cluster_id}"

  # Gate explicitly — this runs in the errexit-suppressed provision tree, so
  # an ungated wait lets a Failed hosted cluster "succeed" into the
  # kubeconfig download below.
  kubehz::wait_for_cluster "${api_url}" "${cluster_id}" || return 1

  # Download kubeconfig. kubehz::_write_private: a private temp file beside
  # the kubeconfig, renamed onto it only after a complete download. A
  # failed download leaves the old file as it was. The directory that
  # mkdir makes here gets mode 0700 whatever the umask (-m sets the mode
  # of the last directory), so the second check accepts it.
  mkdir -p -m 0700 "$(dirname "${kubeconfig_path}")"
  if ! kubehz::_write_private "${kubeconfig_path}" \
    kubehz::_hosted_kubeconfig_get "${api_url}" "${cluster_id}"; then
    error "Failed to download kubeconfig for hosted cluster ${cluster_id}"
    return 1
  fi

  debug "Hosted cluster ${domain} ready, kubeconfig at ${kubeconfig_path}"

  # provision::dispatch runs the shared bootstrap::apply AFTER this driver
  # returns, reading .kubeconfig/<metadata.name>.yaml — mirror the download
  # there when the spec's metadata.name differs from the domain, or the
  # dispatch tail fails on a missing kubeconfig right after a successful
  # hosted provision. (bootstrap::apply itself owns the hosted gates:
  # OIDC-kubeconfig reachability, Ready-worker check, platform-owned skips.)
  # The mirror is written in the same way as the download (a private temp
  # file and a rename), not with cp onto the old file.
  local cluster_name
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  if [[ -n "${cluster_name}" && "${cluster_name}" != "null" && "${cluster_name}" != "${domain}" ]]; then
    # Guarded: a pathological metadata.name must not fail a provision that
    # already succeeded — warn and leave the domain-keyed file as the source.
    if ! kubehz::_write_private "${PATH_BASE}/.kubeconfig/${cluster_name}.yaml" \
      cat -- "${kubeconfig_path}" 2>/dev/null; then
      echo "[kubehz] warning: could not mirror the kubeconfig to .kubeconfig/${cluster_name}.yaml — the bootstrap step will report it missing" >&2
    fi
  fi
}

# kubehz::_hosted_kubeconfig_get <api_url> <cluster_id>: the kubeconfig of
# a hosted cluster on stdout. -q first: an output line in a config file of
# the user would take the kubeconfig. The subshell with
# http::tls_log_vars_unset: curl gets no TLS log or trace control
# (utils/http.sh).
kubehz::_hosted_kubeconfig_get() {
  http::curl_config header "Authorization: Bearer ${KUBEHZ_TOKEN}" | (
    http::tls_log_vars_unset &&
      curl -q -K - -fsSL "${1}/api/clusters/${2}/kubeconfig"
  )
}

# kubehz::_write_private <dest> <command...>: run the command with its
# stdout in a new private file, and put that file at <dest> only when the
# command succeeds. The temp file is beside the file (the name
# <file>.XXXXXX), and one rename onto the exact path replaces the file
# (kubehz::_publish_private). So <dest> is the old file or the complete new
# one, never a part. A failed command or rename leaves the old file as it
# was and removes the temp file.
# The temp file is made and opened once (kubehz::_create_private): an
# exclusive create (noclobber, umask 077) into a descriptor, and a check
# of the open file through its path before the command runs. The command
# writes into that descriptor, not to the path: a link that another
# process puts at the temp path after the create does not get the
# content, and the rename refuses a temp path that is not the file of the
# descriptor.
# A <dest> that is a symlink is resolved (kubehz::_private_target): the
# temp file goes beside the file that the link names, and the rename
# replaces that file, so the link stays. A link to nothing, a link that
# cannot be resolved and a directory are refused (one error line).
# The threat model: a process of this user is trusted, because it can
# read the file anyway. Another user is not. Before the create, the call
# refuses a <dest> that is a link of another user, or that follows one
# (kubehz::_private_link_hops), and a directory of the file that another
# user can write into (kubehz::_private_dir_ok). Thus only this user and
# root can write into a directory without the sticky bit. In a directory
# with the sticky bit, another user cannot rename or remove a file of
# this user, and the call renames there only with mv -T. Under this
# model, these steps are safe:
# - The traps and a failed rename remove the temp file by its path after
#   a check: no other user can put another file at that path between the
#   check and the remove.
# - The create through a redirection and the check of the mode through
#   the path see the file of this run, for the same cause. A default ACL
#   of the directory comes from its owner, this user or root.
# - Between the check before the rename and the rename, no other user can
#   replace the temp file or put a directory at the file.
# What stays: a process of this user, an ACL that lets another user write
# into the directory (the check reads the mode bits only), and the
# parents of the directory. Another user who can write into a parent can
# put a directory of their own in its place.
# INT, TERM and HUP remove the temp file, then end the shell with that
# signal (kubehz::_write_private_trap). The traps are set before the temp
# file exists and read its path when they run, and they remove it only
# while it is the file of the descriptor (kubehz::_private_temp_ours).
# A signal before the rename keeps the old file. Just before the rename,
# the call clears the path that the traps read, and from there until the
# rename and its cleanup are done, a signal is only recorded: the call
# then ends the shell with it. So a signal during or after the rename
# removes nothing, also not a file that another process put at the old
# temp path, and it keeps the new file. After a failed rename, the call
# removes the temp file only while it is still the file of the
# descriptor (the rename did not move it).
# Each INT, TERM and HUP trap of the caller comes back when the function
# returns, and a signal that had no trap goes back to the default
# (kubehz::_restore_trap).
# Not covered: SIGKILL, which can leave the temp file (mode 0600, the name
# <file>.XXXXXX). A process of this user that writes into the directory of
# the file: a FIFO that it puts at the new name before the create makes
# the create wait for a reader, and a file that it puts at the temp path
# between the check before the rename and the rename is renamed onto the
# file. In a directory with the sticky bit, another user can make the
# write fail (a file or a FIFO at the name), but cannot replace a file of
# this user. A signal during the download takes effect when curl ends
# (the trap runs after the current command; the call sets no time limit).
# Status 0 when <dest> holds the new content, else 1.
kubehz::_write_private() {
  (( $# >= 2 )) || {
    error "kubehz::_write_private: it takes a file and a command (<dest> <command...>), not $# argument(s); it writes nothing"
    return 1
  }
  local dest="${1}" target sig trap_int trap_term trap_hup rc=0
  # The traps read these when they run: names of their own, so that no
  # local of the command (a function in this shell) hides them.
  # _kubehz_wp_tmp is the path that the traps remove (empty before the
  # create and from just before the rename on), _kubehz_wp_name the name
  # of the temp file for the steps after that, _kubehz_wp_fd its
  # descriptor, and _kubehz_wp_hold is 1 while a signal is only recorded
  # (in _kubehz_wp_sig).
  local _kubehz_wp_tmp="" _kubehz_wp_name="" _kubehz_wp_fd="" _kubehz_wp_hold="" _kubehz_wp_sig=""
  shift
  target=$(kubehz::_private_target "${dest}") || return 1
  trap_int=$(trap -p INT)
  trap_term=$(trap -p TERM)
  trap_hup=$(trap -p HUP)
  for sig in INT TERM HUP; do
    # shellcheck disable=SC2064 # the signal name now
    trap "kubehz::_write_private_trap ${sig}" "${sig}"
  done
  if ! kubehz::_create_private "${target}"; then
    rc=1
  elif ! "$@" >&"${_kubehz_wp_fd}"; then
    rc=1
  else
    _kubehz_wp_hold=1
    _kubehz_wp_tmp=""
    kubehz::_publish_private "${_kubehz_wp_name}" "${target}" "${dest}" "${_kubehz_wp_fd}" || rc=1
  fi
  if (( rc != 0 )) && [[ -n "${_kubehz_wp_name}" ]] \
    && kubehz::_private_temp_ours "${_kubehz_wp_name}" "${_kubehz_wp_fd}"; then
    rm -f -- "${_kubehz_wp_name}"
  fi
  _kubehz_wp_tmp=""
  if [[ -n "${_kubehz_wp_fd}" ]]; then
    exec {_kubehz_wp_fd}>&-
  fi
  _kubehz_wp_hold=""
  if [[ -n "${_kubehz_wp_sig}" ]]; then
    kubehz::_write_private_trap "${_kubehz_wp_sig}"
  fi
  kubehz::_restore_trap INT "${trap_int}"
  kubehz::_restore_trap TERM "${trap_term}"
  kubehz::_restore_trap HUP "${trap_hup}"
  return "${rc}"
}

# kubehz::_write_private_trap <signal>: the INT, TERM and HUP trap of
# kubehz::_write_private. While _kubehz_wp_hold is set (the rename), it
# only records the signal. Else it removes the temp file while that file
# is the file of the descriptor, and then ends the shell with the signal.
kubehz::_write_private_trap() {
  if [[ -n "${_kubehz_wp_hold:-}" ]]; then
    _kubehz_wp_sig="${1}"
    return 0
  fi
  if [[ -n "${_kubehz_wp_tmp:-}" ]] && kubehz::_private_temp_ours "${_kubehz_wp_tmp}" "${_kubehz_wp_fd:-}"; then
    rm -f -- "${_kubehz_wp_tmp}"
  fi
  trap - "${1}"
  kill -"${1}" "${BASHPID}"
}

# kubehz::_create_private <target>: make the temp file of
# kubehz::_write_private beside <target> and open it once, into the
# descriptor _kubehz_wp_fd. mktemp -u gives a new name only. The create is
# one open with noclobber under umask 077: noclobber opens a path that
# does not exist with O_EXCL, so the create fails on a file or a link that
# is at that name. The call sets _kubehz_wp_tmp before the open, so a
# signal just after it removes the new file (the traps remove only the
# file of the descriptor). Then the open file must be a regular file at
# the path, not a link, of this user, mode 0600, and the same file as the
# descriptor: a check through the path, once, before the command writes.
# The noclobber option and the umask of the caller come back after the
# open. One error line on each failure, status 1.
kubehz::_create_private() {
  local target="${1}" mask noclobber=0
  if ! _kubehz_wp_name=$(mktemp -u "${target}.XXXXXX" 2>/dev/null) || [[ -z "${_kubehz_wp_name}" ]]; then
    _kubehz_wp_name=""
    error "Cannot create a temp file beside ${target}"
    return 1
  fi
  mask=$(umask)
  [[ $- != *C* ]] || noclobber=1
  _kubehz_wp_tmp="${_kubehz_wp_name}"
  umask 077
  set -C
  { exec {_kubehz_wp_fd}>"${_kubehz_wp_name}"; } 2>/dev/null || _kubehz_wp_fd=""
  (( noclobber )) || set +C
  umask "${mask}"
  if [[ -z "${_kubehz_wp_fd}" ]]; then
    _kubehz_wp_tmp=""
    error "Cannot create a temp file beside ${target}"
    return 1
  fi
  if ! kubehz::_private_temp_ours "${_kubehz_wp_name}" "${_kubehz_wp_fd}" \
    || [[ ! -O "${_kubehz_wp_name}" ]] || ! kubehz::_mode_is_0600 "${_kubehz_wp_name}"; then
    error "The temp file ${_kubehz_wp_name} is not a new file of this user with mode 0600: nothing is written"
    return 1
  fi
}

# kubehz::_private_temp_ours <path> <fd>: status 0 when <path> is the file
# that the descriptor <fd> holds open: a regular file at <path>, not a
# link, and the same file (device and inode) as the descriptor. A regular
# file that the descriptor holds is the file that the create of this run
# made: noclobber never opens a regular file that exists.
kubehz::_private_temp_ours() {
  [[ -n "${2}" && -f "/dev/fd/${2}" && -f "${1}" && ! -L "${1}" && "/dev/fd/${2}" -ef "${1}" ]]
}

# kubehz::_mode_is_0600 <path>: status 0 when the mode of <path> is 0600
# (find -perm: the stat of GNU and of BSD take other options).
kubehz::_mode_is_0600() {
  local p="${1}"
  [[ "${p}" == /* ]] || p="./${p}"
  [[ "$(find "${p}" -prune -perm 600 -print 2>/dev/null)" == "${p}" ]]
}

# kubehz::_restore_trap <signal> <saved>: give <signal> the trap back that
# trap -p <signal> printed before (<saved>), or the default when <saved>
# is empty (the signal had no trap). The eval replaces the trap of
# kubehz::_write_private at once, so the trap of the caller is never the
# default in between.
kubehz::_restore_trap() {
  if [[ -n "${2}" ]]; then
    eval "${2}"
  else
    trap - "${1}"
  fi
}

# kubehz::_private_target <dest>: the file that a write of <dest> replaces,
# on stdout: <dest>, or for a symlink the file that it names (readlink -f).
# First, each link that the last name of <dest> follows must belong to
# this user or root (kubehz::_private_link_hops). A link to nothing, a
# link that cannot be resolved, a directory and a file in a directory
# that another user can write into (kubehz::_private_dir_ok) are refused
# with one error line, status 1.
kubehz::_private_target() {
  local dest="${1}" target="${1}"
  kubehz::_private_link_hops "${dest}" || return 1
  if [[ -L "${dest}" ]]; then
    target=""
    if [[ -e "${dest}" ]]; then
      target=$(readlink -f -- "${dest}" 2>/dev/null) || target=""
    fi
    [[ -n "${target}" ]] || {
      error "Cannot resolve the symlink ${dest}"
      return 1
    }
  fi
  [[ ! -d "${target}" ]] || {
    error "${dest} is a directory, not a file"
    return 1
  }
  kubehz::_private_dir_ok "$(dirname -- "${target}")" || return 1
  printf '%s\n' "${target}"
}

# kubehz::_private_link_hops <dest>: status 0 when each link that the last
# name of <dest> follows (the link at <dest>, then the link that it names,
# and so on) belongs to this user or root. In a directory with the sticky
# bit, another user can put a link at the name, to a file of this user:
# the rename would then replace that file. A link of another user, a link
# whose owner cannot be read and a chain of more than 8 links are refused
# with one error line, status 1. A relative link names a path from the
# directory of the link. A link to a directory on the way (not the last
# name) is not checked here. ls -ldn gives the owner of the link itself.
kubehz::_private_link_hops() {
  local dest="${1}" p="${1}" next line uid me hops=0
  me=$(id -u 2>/dev/null) || me=""
  while [[ -L "${p}" ]]; do
    if (( ++hops > 8 )); then
      error "Cannot resolve the symlink ${dest}"
      return 1
    fi
    line=$(LC_ALL=C ls -ldn -- "${p}" 2>/dev/null) || line=""
    uid=""
    read -r _ _ uid _ <<< "${line}"
    if [[ ! "${uid}" =~ ^[0-9]+$ ]]; then
      error "Cannot read the owner of the link ${p}: nothing is written"
      return 1
    fi
    if [[ "${uid}" != 0 && "${uid}" != "${me}" ]]; then
      error "The link ${p} belongs to uid ${uid}, not to this user or to root, so another user can point it at a file of this user: nothing is written. Remove the link, or use a path of your own."
      return 1
    fi
    if ! next=$(readlink -- "${p}" 2>/dev/null) || [[ -z "${next}" ]]; then
      error "Cannot resolve the symlink ${dest}"
      return 1
    fi
    if [[ "${next}" != /* ]]; then
      if [[ "${p}" == */* ]]; then
        next="${p%/*}/${next}"
      else
        next="./${next}"
      fi
    fi
    p="${next}"
  done
}

# kubehz::_private_dir_ok <dir>: status 0 when no other user can replace a
# file in <dir>. It refuses, with one error line and status 1:
# - a <dir> that is not there when its parent is not a directory that
#   this user can search (then the check cannot tell that <dir> is not
#   there), and a line of ls that the check cannot read;
# - a path that is there but is not a directory (also a link to nothing);
# - a directory that belongs to a user other than this user or root (that
#   user can change its mode);
# - without the sticky bit: a world-writable directory, and a
#   group-writable one whatever its group (a group can have other
#   members);
# - with the sticky bit, a directory that others can write into when mv
#   has no -T (kubehz::_mv_exact_ok). The sticky bit lets only the owner
#   of a file rename or remove it, but a mv without -T moves the file into
#   a directory that another user puts at its name.
# A directory that is not there passes when its parent can be searched:
# the write makes it with mode 0700, and the second check reads it. The
# check reads the mode bits only, not an ACL, and the directory only, not
# its parents (see kubehz::_write_private). ls -ldnL gives the mode, the
# uid and the gid in the same form on GNU and BSD (their stat takes other
# options), and it follows a link, as the create does.
kubehz::_private_dir_ok() {
  local dir="${1}" line="" mode="" uid="" gid="" me parent
  if [[ ! -e "${dir}" && ! -L "${dir}" ]]; then
    parent=$(dirname -- "${dir}")
    if [[ -d "${parent}" && -x "${parent}" ]]; then
      return 0
    fi
    error "Cannot read the owner and the mode of the directory ${dir}: nothing is written"
    return 1
  fi
  if [[ ! -d "${dir}" ]]; then
    error "The path ${dir} is not a directory: nothing is written"
    return 1
  fi
  line=$(LC_ALL=C ls -ldnL -- "${dir}" 2>/dev/null) || line=""
  read -r mode _ uid gid _ <<< "${line}"
  if [[ ! "${mode}" =~ ^d[-rwxsStT]{9} || ! "${uid}" =~ ^[0-9]+$ || ! "${gid}" =~ ^[0-9]+$ ]]; then
    error "Cannot read the owner and the mode of the directory ${dir}: nothing is written"
    return 1
  fi
  me=$(id -u 2>/dev/null) || me=""
  if [[ "${uid}" != 0 && "${uid}" != "${me}" ]]; then
    error "The directory ${dir} belongs to uid ${uid}, not to this user or to root, so another user can replace a file in it: nothing is written. Use a directory of your own."
    return 1
  fi
  if [[ "${mode:9:1}" == [tT] ]]; then
    if [[ "${mode:5:1}" == w || "${mode:8:1}" == w ]] && ! kubehz::_mv_exact_ok; then
      error "The directory ${dir} has the sticky bit and other users can write into it, but this mv has no -T, so another user can put a directory at the file before the rename: nothing is written. Use a directory of your own, or a mv that takes -T (GNU coreutils)."
      return 1
    fi
    return 0
  fi
  if [[ "${mode:8:1}" == w ]]; then
    error "The directory ${dir} is world-writable and has no sticky bit, so another user can replace a file in it: nothing is written. Run chmod o-w,g-w ${dir}, or use a directory of your own."
    return 1
  fi
  if [[ "${mode:5:1}" == w ]]; then
    error "The directory ${dir} is group-writable and has no sticky bit, so another user can replace a file in it: nothing is written. Run chmod o-w,g-w ${dir}, or use a directory of your own."
    return 1
  fi
}

# _KUBEHZ_MV_EXACT: 1 when mv takes -T (GNU coreutils and others: the
# rename goes onto the exact path and fails on a directory), 0 when it
# does not (the BSD mv of macOS). Empty until kubehz::_mv_exact_ok probes
# mv once, in a temp directory of its own.
_KUBEHZ_MV_EXACT=""

kubehz::_mv_exact_ok() {
  if [[ -z "${_KUBEHZ_MV_EXACT}" ]]; then
    local d
    _KUBEHZ_MV_EXACT=0
    if d=$(mktemp -d 2>/dev/null); then
      if : > "${d}/a" 2>/dev/null && mv -f -T -- "${d}/a" "${d}/b" 2>/dev/null \
        && [[ -f "${d}/b" && ! -e "${d}/a" ]]; then
        _KUBEHZ_MV_EXACT=1
      fi
      rm -rf -- "${d:?}"
    fi
  fi
  [[ "${_KUBEHZ_MV_EXACT}" == 1 ]]
}

# kubehz::_publish_private <tmp> <target> <dest> <fd>: rename <tmp> onto
# the exact path <target>. Just before the rename, <tmp> must still be the
# file of the descriptor <fd> (kubehz::_private_temp_ours): else another
# process replaced it, and the call renames nothing. With mv -T the rename
# fails when <target> is a directory (another operation can put one there
# during the download). A mv without -T would move <tmp> into a
# directory: there the call refuses a directory just before the rename.
# After the rename, <target> must be a regular file. If it is not, a
# directory (it can be a mount) can have taken its place between the
# check and the rename of a mv without -T: the error line names the path
# where the rename may have put the new file, and nothing is removed. One
# error line on each failure, status 1.
kubehz::_publish_private() {
  local tmp="${1}" target="${2}" dest="${3}" fd="${4}" moved=""
  kubehz::_private_temp_ours "${tmp}" "${fd}" || {
    error "The temp file ${tmp} is not the file that this run wrote: nothing is renamed to ${target}"
    return 1
  }
  if kubehz::_mv_exact_ok; then
    if ! mv -f -T -- "${tmp}" "${target}" 2>/dev/null; then
      if [[ -d "${target}" ]]; then
        error "${dest} is a directory, not a file"
      else
        error "Cannot rename the temp file to ${target}"
      fi
      return 1
    fi
  else
    [[ ! -d "${target}" ]] || {
      error "${dest} is a directory, not a file"
      return 1
    }
    moved="${target}/${tmp##*/}"
    mv -f -- "${tmp}" "${target}" 2>/dev/null || {
      error "Cannot rename the temp file to ${target}"
      return 1
    }
  fi
  if [[ -L "${target}" || ! -f "${target}" ]]; then
    if [[ -n "${moved}" ]]; then
      error "${target} is not a regular file after the rename: the rename may have moved the new file to ${moved}"
    else
      error "${target} is not a regular file after the rename"
    fi
    return 1
  fi
}

# Destroy a hosted cluster via the kubehz API.
# Resolves the cluster id from the tenant registry, then sends DELETE.
# Usage: kubehz::destroy_hosted <domain> <cluster_yaml>
kubehz::destroy_hosted() {
  local domain="${1}" cluster_yaml="${2}"
  local api_url="${LOK8S_KUBEHZ_API_URL}"

  # Same HTTPS guard as every other bearer-carrying kubehz call: a
  # misconfigured http:// apiUrl must not leak KUBEHZ_TOKEN in clear.
  http::require_https "${api_url}" "spec.kubehz.apiUrl" || return 1
  http::credential_ok KUBEHZ_TOKEN || return 1

  # Resolve through kubehz::resolve_cluster_id (client-side domain filter,
  # oldest-first). The old inline lookup GETed /api/clusters?domain=… — a
  # server filter the api does not guarantee — and took .data[0] from the
  # newest-first list: with more than one cluster on the tenant it deleted
  # the NEWEST cluster, not the named domain's. resolve rc 2 = the registry
  # answered without a row for the domain (already removed — destroy stays
  # idempotent); rc 1 = the lookup itself failed, and a delete on a guessed
  # id is the wrong-cluster bug again — refuse and delete nothing. Both
  # halves of issue #65 stay closed: a lookup failure is REPORTED, never
  # rendered as "nothing to destroy" while the cluster runs and bills.
  local cluster_id="" resolve_rc=0
  cluster_id=$(kubehz::resolve_cluster_id "${domain}" "${api_url}") || resolve_rc=$?
  if (( resolve_rc == 1 )); then
    error "kubehz: cannot read the cluster registry at ${api_url} — nothing was deleted for ${domain} and the local kubeconfigs are kept. Set KUBEHZ_TOKEN to a clusters:write token of the owning tenant, then retry."
    return 1
  fi

  if (( resolve_rc == 2 )); then
    echo "kubehz: no hosted cluster is registered for ${domain} — nothing to destroy on the platform."
  else
    # Status + body captured (the re-enroll idiom): a refused delete must
    # surface with the api's own message, not vanish into `curl -f`.
    # -q first and the subshell with http::tls_log_vars_unset: curl reads no
    # config file of the user and gets no TLS log or trace control
    # (utils/http.sh).
    local response http_code
    response=$(http::curl_config header "Authorization: Bearer ${KUBEHZ_TOKEN:-}" | (
      http::tls_log_vars_unset &&
        curl -q -K - -sSL -w $'\n%{http_code}' -X DELETE "${api_url}/api/clusters/${cluster_id}"
    ) ) || {
      error "kubehz: DELETE /api/clusters/${cluster_id} failed (network) — the hosted cluster can still exist and bill. Retry when ${api_url} is reachable."
      return 1
    }
    http_code="${response##*$'\n'}"
    if [[ "${http_code}" != 2* ]]; then
      local msg
      msg=$(jq -r '.data.message // .message // empty' <<<"${response%$'\n'*}" 2>/dev/null) || msg=""
      error "kubehz: delete refused for ${domain} (${cluster_id}) — HTTP ${http_code}${msg:+: ${msg}}. The hosted cluster can still exist and bill; check the dashboard."
      return 1
    fi
    debug "Hosted cluster ${domain} (${cluster_id}) destroyed"
  fi

  # Clean up local kubeconfigs — the domain-keyed download AND the
  # metadata.name mirror provision_hosted made for the dispatch tail. A
  # stale mirror is not cosmetic: libs/build PREFERS <metadata.name>.yaml
  # when present, so after destroy+reprovision it would silently feed
  # builds with the dead cluster's credentials.
  rm -f "${PATH_BASE}/.kubeconfig/${domain}.yaml"
  local _mirror_name
  _mirror_name=$(yq -r '.metadata.name // ""' "${cluster_yaml}" 2>/dev/null) || _mirror_name=""
  if [[ -n "${_mirror_name}" && "${_mirror_name}" != "null" && "${_mirror_name}" != "${domain}" ]]; then
    rm -f "${PATH_BASE}/.kubeconfig/${_mirror_name}.yaml"
  fi
}
