#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-handover — eject TARGET side of a control-plane handover
# (the receive side of the control-plane handover contract).
#
# `lo kubehz handover receive --bundle <path>` restores an exported hosted
# control plane onto THE NODE IT RUNS ON (kubeadm driver path): seed the
# exported PKI into /etc/kubernetes/pki, restore the etcd snapshot into
# /var/lib/etcd, then `kubeadm init` with
# --ignore-preflight-errors=DirAvailable--var-lib-etcd and the addon phases
# skipped (the restored state carries the source's DNS/proxy) against the
# pre-seeded state. kubeadm REUSES existing ca/sa/front-proxy files instead of minting
# new ones — that is what preserves the cluster identity (same CA, same SA
# signing keys, same secrets-at-rest encryption key).
#
# `lo kubehz handover preseed --bundle <path> --node <ip>` is the thin
# kubeone-driver variant: it ONLY places the PKI on node0 BEFORE
# `kubeone apply` (lo provision) runs — kubeone's kubeadm then initializes
# with the seeded CA files. Snapshot restore is not part of preseed.
#
# Bundle layout (contract §2 export Secret, one file per key):
#   ca.crt ca.key sa.pub sa.key front-proxy-ca.crt front-proxy-ca.key
#   encryption-key snapshot-location endpoint-dns
#
# Optional keys — the platform's own values, so the target does not have to
# hardcode platform constants. Absent means "use the default", which keeps
# bundles exported by older operators working:
#   encryption-provider  (default secretbox)
#   encryption-key-name  (default kubehz-key-1)
#   etcd-version         (default 3.5.21-0, the platform's etcd line)
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.
#
# Test seams (bats exercises every step against a sandbox):
#   KUBEHZ_HANDOVER_K8S_DIR   target /etc/kubernetes  (default)
#   KUBEHZ_HANDOVER_ETCD_DIR  target /var/lib/etcd    (default)
#   KUBEHZ_HANDOVER_WAIT      apiserver-ready timeout seconds (default 300)
#   KUBEHZ_HANDOVER_ETCD_IMAGE_TAG  etcd image tag for the target's static pod
#                             (overrides the bundle's etcd-version; default
#                             3.5.21-0 — the platform's source line)

import ^utils/verbose
import ^utils/http

# The contract §2 bundle keys. The six PKI files are what preseed places;
# receive additionally needs the restore artifacts.
KUBEHZ_HANDOVER_PKI_KEYS=(
  ca.crt ca.key sa.pub sa.key front-proxy-ca.crt front-proxy-ca.key
)
KUBEHZ_HANDOVER_BUNDLE_KEYS=(
  "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"
  encryption-key snapshot-location endpoint-dns
)
# The optional keys (see the header): read when they are there.
KUBEHZ_HANDOVER_OPTIONAL_KEYS=(
  encryption-provider encryption-key-name etcd-version
)
# The dirs on the path of the pki dir on the node, from the top, that
# preseed's stage call checks before it makes a staging file. The owner of
# such a dir (or a user who can write it) could rename or replace a dir
# below it, or put a link at a staging name between the mktemp and the scp,
# and scp would write the key through it. So each one must be a dir, not a
# link, with no write bit for the group or others. Root must own the dirs in
# KUBEHZ_HANDOVER_ROOT_DIRS, and root or the ssh user the others. The check
# trusts the mounts that root made: it does not read the type of a file
# system.
KUBEHZ_HANDOVER_TRUSTED_DIRS=(/ /etc /etc/kubernetes /etc/kubernetes/pki)
# The trusted dirs that only root may own.
KUBEHZ_HANDOVER_ROOT_DIRS=(/ /etc)

kubehz::handover() {
  local -a usage=(
    'receive|r@destructive'  'Restore an exported control plane onto THIS node (kubeadm path)'
    'preseed|p@destructive'  'Pre-seed exported PKI onto a kubeone node before kubeone apply'
  )
  :usage "Control-plane handover — eject target side" "${@}"
  "${usage[@]}"
}

# ── Bundle handling ──────────────────────────────────────

# The permission bits of a path in octal: GNU stat, then BSD stat (macOS).
handover::mode() {
  stat -c '%a' "${1}" 2>/dev/null || stat -f '%Lp' "${1}" 2>/dev/null
}

# Fail closed unless dir has mode 0700: the extracted bundle holds the cluster
# CA keys, the service-account key and the encryption key.
handover::require_private() {
  local dir="${1}" mode
  mode="$(handover::mode "${dir}")" || mode=""
  [[ "${mode}" == "700" ]] && return 0
  error "handover: ${dir} has mode ${mode:-unknown}, not 700, so other users could read the bundle's keys in it. Check the archive and the file system of TMPDIR, then retry."
  return 1
}

# Set dir to 0700 and check it. The leading zero also clears a set-group-ID
# bit that the dir got from its parent: GNU chmod keeps that bit on a
# directory for a plain `chmod 700`.
handover::make_private() {
  chmod 00700 "${1}" 2>/dev/null || {
    error "handover: cannot set ${1} to mode 700, so the bundle's keys would not be private in it. Check the file system of TMPDIR, then retry."
    return 1
  }
  handover::require_private "${1}"
}

# The number of names (hard links) of a file: GNU stat, then BSD stat.
handover::links() {
  stat -c '%h' "${1}" 2>/dev/null || stat -f '%l' "${1}" 2>/dev/null
}

# Remove a dir that can hold the bundle's keys. An archive can give a dir
# in it a mode without owner write or search (0500), and rm -rf then cannot
# remove the files in that dir. So chmod -R first gives the owner rwx on
# every dir (it does not follow a link). A removal that fails names the dir.
handover::remove_dir() {
  chmod -R u+rwX -- "${1}" 2>/dev/null || :
  rm -rf -- "${1}" 2>/dev/null && return 0
  error "handover: could not remove ${1}, which can hold the bundle's keys. Delete it yourself."
  return 1
}

# The RETURN trap command that removes dir (handover::remove_dir). printf %q
# quotes the path for the shell, so a TMPDIR with an apostrophe or a space
# still goes.
handover::cleanup_cmd() {
  local cmd
  printf -v cmd 'handover::remove_dir %q' "${1}"
  printf '%s\n' "${cmd}"
}

# Write stdin to dst with mode, through a new file in the dir of dst: mktemp
# makes it 0600, chmod sets the mode, and mv renames it over dst. Thus the
# bytes never land in a file with a wider mode, and an existing dst (a run
# with --force) is replaced: its own mode, a link there or a second name of
# it does not get the bytes. A dir at dst fails. On a failure the new file
# goes, and dst is as it was. A new file that cannot go is named: it can
# hold key bytes.
handover::install_file() {
  local dst="${1}" mode="${2}" tmp
  [[ ! -d "${dst}" ]] || return 1
  tmp="$(umask 077 && mktemp "${dst%/*}/.${dst##*/}.XXXXXXXXXX" 2>/dev/null)" || return 1
  if ! cat > "${tmp}" || ! chmod "${mode}" "${tmp}" 2>/dev/null || ! mv -f -- "${tmp}" "${dst}"; then
    rm -f -- "${tmp}" || error "handover: could not remove ${tmp}, which can hold key bytes. Delete it yourself."
    return 1
  fi
}

# Print the first path under dir that is not a directory or a regular file
# with one link (a hardlink gives a second name to one file). A find error
# fails: the caller then refuses the dir.
handover::first_odd_entry() {
  find "${1}" -mindepth 1 \( \( ! -type f ! -type d \) -o \( -type f -links +1 \) \) -print -quit
}

handover::refuse_entry_type() {
  error "handover: refusing ${1}: an archive entry is not a regular file or a directory (a link, a device or a FIFO)"
}

# Resolve --bundle into a directory: a directory is used as-is; a file (the
# api's one-time .tar.gz download) is unpacked into a private (0700) dir —
# inside the caller's workdir when one is given, so the caller's cleanup trap
# scrubs the extracted PKI + encryption key on every exit path (a direct call
# without a workdir owns the mktemp dir and must remove it itself).
# Outputs the bundle dir on stdout.
handover::resolve_bundle() {
  local bundle="${1}" workdir="${2:-}"
  if [[ -d "${bundle}" ]]; then
    echo "${bundle}"
    return 0
  fi
  if [[ -f "${bundle}" ]]; then
    local dir
    if [[ -n "${workdir}" ]]; then
      dir="${workdir}/bundle"
      mkdir -p "${dir}" || return 1
    else
      dir=$(mktemp -d) || return 1
    fi
    handover::make_private "${dir}" || { handover::remove_dir "${dir}"; return 1; }
    # Path-traversal guard: reject any archive entry that is absolute or
    # climbs out (`..` component) BEFORE extraction — a malicious bundle must
    # not write outside the private dir (GNU tar defends by default, bsdtar
    # historically did not; the listing check is tar-flavor-independent).
    local entry
    while IFS= read -r entry; do
      # Reject every position a `..` COMPONENT can take (sole, leading,
      # interior, trailing) + absolute paths. Component-anchored on purpose:
      # the old `*../*` also matched harmless names like `foo../bar` AND
      # shadowed the `../*` alternative entirely (SC2221/SC2222).
      case "${entry}" in
        /*|..|../*|*/../*|*/..)
          error "handover: refusing ${bundle} — archive entry escapes the bundle dir: ${entry}"
          handover::remove_dir "${dir}"
          return 1
          ;;
      esac
    done < <(tar -tzf "${bundle}" 2>/dev/null)
    # Only regular files and directories. A link entry can name a file
    # outside the bundle (ca.key -> /etc/shadow), and preseed would send
    # that file to the node. A symlink with an entry through it can write
    # outside the dir with a tar that follows links. So this listing check
    # runs before the unpack writes a byte: each `tar -tv` line starts with
    # the mode of its entry, and its first character is the type ("-" a
    # file, "d" a dir). bsdtar shows a hardlink as "-" with " link to ", and
    # busybox shows it with " -> ", so those words are refused too: a name
    # that holds them is refused as well (fail closed). LC_ALL=C keeps the
    # listing in the format that this parse reads. A name with a newline
    # adds a line. That line passes when it starts with "-" or "d", but this
    # is not a bypass: the first line of each entry starts with the type of
    # that entry, so a link entry fails on its own first line. The check
    # after the unpack reads the file system itself and catches what a
    # listing format can hide.
    local listing line
    if ! listing="$(LC_ALL=C tar -tvzf "${bundle}" 2>/dev/null)"; then
      error "handover: ${bundle} is neither a bundle directory nor a readable .tar.gz archive"
      handover::remove_dir "${dir}"
      return 1
    fi
    while IFS= read -r line; do
      [[ -n "${line}" ]] || continue
      case "${line}" in
        *" -> "* | *" link to "*) ;;
        [-d]*) continue ;;
      esac
      handover::refuse_entry_type "${bundle}"
      handover::remove_dir "${dir}"
      return 1
    done <<<"${listing}"
    # An archive made with `tar -C <dir> .` has a "./" entry, and tar gives
    # its mode to the private dir: 0755 with umask 022, the archive's own mode
    # for root. So the unpack runs with umask 077, --no-same-permissions and
    # --no-same-owner (root restores the archive's modes and owners without
    # them), and GNU tar also gets --no-overwrite-dir (it keeps the mode of the
    # existing dir). bsdtar (the macOS tar) refuses that option, so it gets
    # the other two only. The mode check after the unpack decides for every tar.
    local -a tar_opts=(--no-same-owner --no-same-permissions)
    local tar_version
    tar_version="$(tar --version 2>/dev/null)" || tar_version=""
    [[ "${tar_version}" != *"GNU tar"* ]] || tar_opts+=(--no-overwrite-dir)
    if ! (umask 077 && tar -xzf "${bundle}" -C "${dir}" "${tar_opts[@]}") 2>/dev/null; then
      error "handover: ${bundle} is neither a bundle directory nor a readable .tar.gz archive"
      handover::remove_dir "${dir}"
      return 1
    fi
    # The archive gives each dir in it its own mode. A dir without owner
    # search (0400) stops the find below, and one without owner write
    # (0500) keeps its files from rm. The owner gets rwx on every dir first
    # (chmod -R does not follow a link). It does not open the dir to other
    # users, so the mode check below still decides.
    chmod -R u+rwX -- "${dir}" 2>/dev/null || :
    # Fail closed: the unpack must not have opened the dir to other users,
    # and it must have made only directories and regular files.
    handover::require_private "${dir}" || { handover::remove_dir "${dir}"; return 1; }
    local odd
    odd="$(handover::first_odd_entry "${dir}" 2>/dev/null)" || odd="${dir}"
    if [[ -n "${odd}" ]]; then
      handover::refuse_entry_type "${bundle}"
      handover::remove_dir "${dir}"
      return 1
    fi
    echo "${dir}"
    return 0
  fi
  error "handover: bundle not found: ${bundle}"
  return 1
}

# Validate the bundle: every contract §2 key must exist and be non-empty,
# and every key that is there (an optional one too) must be a regular file
# with one name: not a link, and not a hard link. The handover reads and
# sends each key from the bundle itself, never from a path that a link
# names (ca.key -> /etc/shadow) or a second name of a file outside the
# bundle, for a .tar.gz and for a directory the user gives. The error NAMES
# the key.
handover::validate_bundle() {
  local dir="${1}" key path
  for key in "${KUBEHZ_HANDOVER_BUNDLE_KEYS[@]}" "${KUBEHZ_HANDOVER_OPTIONAL_KEYS[@]}"; do
    path="${dir}/${key}"
    if [[ -L "${path}" ]] || { [[ -e "${path}" ]] && [[ ! -f "${path}" ]]; }; then
      error "handover: bundle key ${key} is not a regular file (a link, a directory or a special file): ${path}"
      return 1
    fi
    # A link count that cannot be read fails too.
    if [[ -e "${path}" ]] && [[ "$(handover::links "${path}")" != 1 ]]; then
      error "handover: bundle key ${key} has more than one name (a hard link), so it can be a file outside the bundle: ${path}"
      return 1
    fi
  done
  for key in "${KUBEHZ_HANDOVER_BUNDLE_KEYS[@]}"; do
    if [[ ! -s "${dir}/${key}" ]]; then
      error "handover: bundle is incomplete — missing or empty key: ${key} (expected at ${dir}/${key})"
      return 1
    fi
  done
}

# ── Receive steps (each small + separately testable) ─────

# Seed the exported PKI into <k8s_dir>/pki. kubeadm init reuses EXISTING
# ca/sa/front-proxy files instead of minting new ones — the identity anchor.
# The pki dir is set to 0700 and checked before a key lands in it: kubeadm
# makes it 0755, and a dir of an earlier run can be open. Each file then
# goes in through handover::install_file (certs and sa.pub 0644, keys
# 0600). A failure removes the files that this call placed, or names the
# ones it could not remove.
handover::place_pki() {
  local bundle="${1}" k8s_dir="${2}" pki="${2}/pki" key done_key mode left=""
  local -a placed=()
  mkdir -p "${pki}" || return 1
  if ! chmod 00700 "${pki}" 2>/dev/null || [[ "$(handover::mode "${pki}")" != "700" ]]; then
    error "handover: cannot set ${pki} to mode 700, so the keys would not be private in it"
    return 1
  fi
  for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    case "${key}" in *.key) mode=600 ;; *) mode=644 ;; esac
    if ! handover::install_file "${pki}/${key}" "${mode}" < "${bundle}/${key}"; then
      error "handover: could not place ${key} into ${pki} with mode ${mode}"
      for done_key in "${placed[@]}"; do
        rm -f -- "${pki}/${done_key}" 2>/dev/null || left+=" ${pki}/${done_key}"
      done
      [[ -z "${left}" ]] || error "handover: could not remove the files that this step placed:${left}. Delete them yourself."
      return 1
    fi
    placed+=("${key}")
  done
}

# Obtain the etcd snapshot: an explicit --snapshot file wins; otherwise the
# bundle's snapshot-location is fetched BEST-EFFORT (s3:// needs an aws CLI on
# the node, https:// uses curl, an absolute path is used in place; kkp:// is a
# KKP-internal locator and always refused). Every failure names the fix:
# download it yourself and re-run with --snapshot. A download lands 0600
# inside the caller's private workdir (an etcd snapshot IS the full cluster
# state, secrets included) and is scrubbed by the caller's cleanup trap; a
# user-provided --snapshot or on-node absolute path is never touched.
# Outputs the local snapshot path.
handover::fetch_snapshot() {
  local bundle="${1}" override="${2:-}" workdir="${3:-}"
  if [[ -n "${override}" ]]; then
    [[ -f "${override}" ]] || { error "handover: --snapshot file not found: ${override}"; return 1; }
    echo "${override}"
    return 0
  fi
  if [[ -z "${workdir}" ]]; then
    workdir=$(mktemp -d) || return 1
    handover::make_private "${workdir}" || { rm -rf -- "${workdir}"; return 1; }
  fi
  local location out="${workdir}/kubehz-handover-snapshot.db"
  location=$(<"${bundle}/snapshot-location")
  case "${location}" in
    kkp://*)
      # kubehz-core writes kkp://<destination>/<clusterID>/<backupName> — a
      # KKP-internal locator naming the platform's backup destination, NOT a
      # fetchable URL from this node.
      error "handover: snapshot-location '${location}' is a KKP-internal locator (kkp://<destination>/<clusterID>/<backupName>) — it cannot be fetched from this node. Obtain the snapshot object via the platform (the tier2/api bundle download provides it) and re-run with --snapshot <file>"
      return 1
      ;;
    s3://*)
      command -v aws >/dev/null 2>&1 || {
        error "handover: the snapshot lives at ${location} but no aws CLI is on this node — download it with any s3 client against the platform's object store and re-run with --snapshot <file>"
        return 1
      }
      # 0600 BEFORE any bytes land, plus an umask guard for tools that write
      # a fresh file (aws downloads to a part-file, then renames over out).
      { : > "${out}" && chmod 600 "${out}"; } || return 1
      ( umask 077 && aws s3 cp "${location}" "${out}" >/dev/null ) || {
        error "handover: fetching ${location} via the aws CLI failed — download it yourself and re-run with --snapshot <file>"
        return 1
      }
      ;;
    https://*)
      { : > "${out}" && chmod 600 "${out}"; } || return 1
      # -q first: no config file of the user. An output line there would
      # take this URL, and the snapshot would go to that file and not to
      # out; a trace-ascii line would log the URL (with its signature) and
      # the snapshot. curl obeys -q only as its first argument.
      # In the subshell, http::tls_log_vars_unset clears the TLS log and
      # trace controls for curl only: SSLKEYLOGFILE, GNUTLS_KEYLOGFILE,
      # GNUTLS_DEBUG_LEVEL, SSLTRACE, SSLDEBUG and SSLDEBUGFILE (a key log,
      # GnuTLS debug output with key material, an NSS trace with plaintext;
      # the reasons are in utils/http.sh). Each could give away the URL with
      # its signature, or the snapshot. A readonly name in the list stops
      # the download before curl runs.
      ( http::tls_log_vars_unset && umask 077 && curl -q -fsSL "${location}" -o "${out}" ) || {
        # Without the query: a presigned URL carries its signature there
        # (as the Go twin's stripQuery).
        error "handover: downloading the snapshot from ${location%%\?*} failed — download it yourself and re-run with --snapshot <file>"
        return 1
      }
      ;;
    /*)
      [[ -f "${location}" ]] || {
        error "handover: snapshot-location points at ${location}, which does not exist on this node — re-run with --snapshot <file>"
        return 1
      }
      out="${location}"
      ;;
    *)
      error "handover: unsupported snapshot-location '${location}' (expected s3://, https:// or an absolute path) — re-run with --snapshot <file>"
      return 1
      ;;
  esac
  echo "${out}"
}

# Resolve the etcd member identity kubeadm's static pod will start with —
# the restore must rewrite membership to EXACTLY this or etcd refuses the
# data dir and crash-loops. Prints "<name> <peer-url>"; fails loudly when no
# advertise address can be derived (a silent localhost peer is the bug).
handover::member_identity() {
  local node_name node_ip peer_url
  # kubeadm lowercases the node name (nodeutil.GetHostname) — mirror it, or
  # an uppercase hostname reintroduces the exact identity mismatch.
  node_name="$(hostname | tr '[:upper:]' '[:lower:]')"
  # kubeadm advertises the default-route source address; mirror it (portable
  # awk, no GNU-grep -P).
  node_ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')"
  if [[ -n "${node_ip}" ]]; then
    peer_url="https://${node_ip}:2380"
  else
    # IPv6-only node: kubeadm advertises the v6 source — URL needs brackets.
    node_ip="$(ip -6 route get 2606:4700:4700::1111 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')"
    [[ -n "${node_ip}" ]] && peer_url="https://[${node_ip}]:2380"
  fi
  if [[ -z "${node_ip}" ]]; then
    error "handover: cannot determine this node's advertise address (no default route?) — etcd's member peer URL must match what kubeadm advertises; fix routing and re-run."
    return 1
  fi
  printf '%s %s\n' "${node_name}" "${peer_url}"
}

# Restore the snapshot into <etcd_dir>. etcdutl is the modern tool; etcdctl
# (ETCDCTL_API=3) is the fallback on older nodes. Both refuse an existing
# data dir, so an empty leftover dir is removed first.
#
# MEMBER IDENTITY must be rewritten at restore time: a default restore mints
# a member named "default" with localhost peer URLs, and kubeadm's etcd
# static pod then starts with --name <node> + the node-IP peer URL — etcd
# refuses the mismatched data dir and crash-loops (the receive's kubeadm
# init dies waiting for an apiserver that never gets its datastore). Restore
# with the SAME name + peer URL kubeadm will use, exactly like the upstream
# kubeadm disaster-recovery runbook.
handover::restore_snapshot() {
  local snapshot="${1}" etcd_dir="${2}"
  local node_name="${3}" peer_url="${4}"
  if [[ -e "${etcd_dir}" ]] && [[ -n "$(ls -A "${etcd_dir}" 2>/dev/null)" ]]; then
    error "handover: ${etcd_dir} is not empty — refusing to restore over existing etcd data"
    return 1
  fi
  [[ ! -d "${etcd_dir}" ]] || rmdir "${etcd_dir}" 2>/dev/null || true
  # --skip-hash-check: KKP's etcd-backup jobs STREAM the snapshot off a live
  # member, and streamed snapshots carry no sha256 trailer — the check can
  # only ever fail on a handover bundle (KKP's own EtcdRestore controller
  # skips it for the same reason). Integrity still holds end to end: the
  # snapshot rides the platform's authenticated channels, and a corrupt
  # restore fails loudly at etcd startup.
  if command -v etcdutl >/dev/null 2>&1; then
    etcdutl snapshot restore "${snapshot}" --data-dir "${etcd_dir}" --skip-hash-check=true \
      --name "${node_name}" \
      --initial-cluster "${node_name}=${peer_url}" \
      --initial-advertise-peer-urls "${peer_url}" || return 1
  elif command -v etcdctl >/dev/null 2>&1; then
    ETCDCTL_API=3 etcdctl snapshot restore "${snapshot}" --data-dir "${etcd_dir}" --skip-hash-check=true \
      --name "${node_name}" \
      --initial-cluster "${node_name}=${peer_url}" \
      --initial-advertise-peer-urls "${peer_url}" || return 1
  else
    error "handover: neither etcdutl nor etcdctl found on this node — install the etcd client tooling and re-run"
    return 1
  fi
}

# handover::bundle_value <bundle> <key> <default> — read an OPTIONAL bundle file.
# Missing or blank falls back to <default>. Trailing newlines are stripped: the
# operator writes these as Secret values and a stray newline would end up inside
# a YAML scalar or an image tag.
handover::bundle_value() {
  local bundle="${1}" key="${2}" default="${3}" value
  # printf, not echo: a value of exactly `-n`/`-e`/`-neE` would be eaten as an
  # echo flag, return empty, and fall back to the default IN SILENCE — which for
  # etcd-version means quietly reverting to the platform tag the warn above
  # exists to make loud.
  [[ -f "${bundle}/${key}" ]] || { printf '%s\n' "${default}"; return 0; }
  value="$(<"${bundle}/${key}")"
  # Trim SURROUNDING whitespace only. The operator writes these as Secret values
  # and a trailing newline would land inside a YAML scalar or an image tag.
  # Internal whitespace is left intact deliberately: stripping it could turn a
  # wrong value into a plausible one, whereas the per-value guards (the provider
  # allowlist, the key-name and image-tag grammars) reject it loudly.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  [[ -n "${value}" ]] || { printf '%s\n' "${default}"; return 0; }
  printf '%s\n' "${value}"
}

# Write the EncryptionConfiguration the restored apiserver needs: the bundle's
# encryption-key is the SAME key the source cluster encrypted its Secrets at
# rest with — without it the restored apiserver cannot decrypt them. 0600:
# the file embeds key material. Outputs the file path.
# handover::encryption_metadata <bundle> — resolve and VALIDATE the two
# EncryptionConfiguration values, echoing "<provider> <key-name>".
#
# Shared by the pre-flight block and write_encryption_config so a tampered
# bundle is refused BEFORE the node is touched. Rejecting inside the writer
# alone happens after place_pki and restore_snapshot have run, stranding seeded
# PKI and a restored member dir behind the non-empty guard — exactly what the
# fail-early contract in receive exists to avoid. The writer keeps calling it so
# it stays safe for direct callers.
# handover::encryption_key <bundle> — read and VALIDATE the base64 key, echoing
# it. Shared by the pre-flight block and write_encryption_config for the same
# reason as encryption_metadata: the key lands inside YAML this renders, and
# rejecting it from the writer alone happens after the node is already seeded.
handover::encryption_key() {
  local bundle="${1}" key
  key="$(<"${bundle}/encryption-key")"
  # Trim EDGES only — interior whitespace must fail the charset gate rather than
  # be silently welded together.
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"
  [[ "${key}" =~ ^[A-Za-z0-9+/=]+$ ]] || {
    error "handover: bundle encryption-key is not base64 — refusing to render the EncryptionConfiguration"
    return 1
  }
  printf '%s\n' "${key}"
}

handover::encryption_metadata() {
  local bundle="${1}" provider key_name
  provider="$(handover::bundle_value "${bundle}" encryption-provider secretbox)"
  key_name="$(handover::bundle_value "${bundle}" encryption-key-name kubehz-key-1)"
  # Allowlist: these are the apiserver's symmetric-key providers, and each takes
  # the same `keys: [{name, secret}]` shape write_encryption_config renders.
  # `kms` is a different structure entirely and cannot be substituted there.
  case "${provider}" in
    secretbox | aescbc | aesgcm) ;;
    *)
      error "handover: bundle encryption-provider '${provider:0:64}' is not one of secretbox/aescbc/aesgcm"
      return 1
      ;;
  esac
  # The name lands in YAML we generate; keep it to the charset Kubernetes accepts
  # for a provider key name so a tampered bundle cannot inject config.
  [[ "${key_name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$ ]] || {
    error "handover: bundle encryption-key-name '${key_name:0:64}' is not a plain name"
    return 1
  }
  echo "${provider} ${key_name}"
}

handover::write_encryption_config() {
  local bundle="${1}" k8s_dir="${2}"
  local out="${k8s_dir}/kubehz-encryption-config.yaml" key provider key_name meta
  key="$(handover::encryption_key "${bundle}")" || return 1
  meta="$(handover::encryption_metadata "${bundle}")" || return 1
  read -r provider key_name <<<"${meta}"
  mkdir -p "${k8s_dir}" || return 1
  # PROVIDER + KEY NAME must match what the SOURCE cluster encrypted with — the
  # stored values carry the "k8s:enc:<provider>:v1:<keyname>:" prefix and the
  # apiserver refuses anything else ("no matching prefix found" — proven on a
  # real target: a healthy apiserver booted but could not read a single
  # Secret). They come from the bundle so the target mirrors whatever the source
  # actually used; the defaults are the platform's own (kubehz-core
  # etcd_encryption.go etcdEncryptionKeyName) for bundles exported before the
  # operator carried them.
  # The file holds the key: handover::install_file writes it 0600 from the
  # first byte, also over a file of an earlier run.
  if ! handover::install_file "${out}" 600 <<EOF
apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
  - resources:
      - secrets
    providers:
      - ${provider}:
          keys:
            - name: ${key_name}
              secret: ${key}
      - identity: {}
EOF
  then
    error "handover: could not write ${out} with mode 600"
    return 1
  fi
  echo "${out}"
}

# Render the kubeadm ClusterConfiguration (v1beta4 — kubeadm >= v1.31): the
# exported endpoint DNS stays the apiserver endpoint ("keep" strategy repoints
# DNS at this node, so the serving cert must cover it) and the apiserver
# mounts the secrets-at-rest encryption config.
# etcd VERSION PIN ($4): the restored data comes from the platform's etcd
# line (KKP CE 2.30 ships 3.5.21); kubeadm's default etcd is often a major
# ahead (3.6.x), and etcd 3.6 PANICS applying the snapshot's member-attribute
# entries (RaftCluster.UpdateAttributes on a 3.5-origin restore — proven on a
# real target). Boot the SOURCE line first; upgrading etcd
# afterwards is the standard in-place path. The caller validates the tag
# (fail-before-touching-the-node contract).
# The InitConfiguration sets one value: a TTL of 1 h (kubeadm's default is
# 24 h) for the bootstrap token that kubeadm init creates. No later step of
# the handover uses that token: verify and the untaint use admin.conf, and
# --skip-token-print keeps it off the screen. No step of the handover joins a
# node: a join after it needs a token of its own (for example from `kubeadm
# token create --print-join-command` on this node), and lok8s does not run
# that command. The cluster-info ConfigMap and the bootstrap RBAC that joins
# need do not depend on this token, and init still creates them.
# kubeadm fills in the default groups and usages. A TTL of 0 means "never
# expires", so the value must stay above 0.
handover::write_kubeadm_config() {
  local bundle="${1}" k8s_dir="${2}" out="${3}"
  local enc="${k8s_dir}/kubehz-encryption-config.yaml" dns
  # ONE validated reader (handover::endpoint_dns) — dns is interpolated into
  # generated YAML and passed to kubectl, so the charset gate lives there.
  dns="$(handover::endpoint_dns "${bundle}")" || return 1
  local etcd_tag="${4}"
  cat > "${out}" <<EOF
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "${dns}:6443"
etcd:
  local:
    imageTag: "${etcd_tag}"
apiServer:
  certSANs:
    - "${dns}"
  extraArgs:
    - name: encryption-provider-config
      value: ${enc}
  extraVolumes:
    - name: kubehz-encryption-config
      hostPath: ${enc}
      mountPath: ${enc}
      readOnly: true
      pathType: File
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
bootstrapTokens:
  - ttl: 1h0m0s
EOF
}

# The init itself: /var/lib/etcd is pre-populated by the restore, which
# kubeadm's preflight would otherwise refuse — exactly the documented
# DirAvailable ignore from the contract.
handover::kubeadm_init() {
  local config="${1}"
  # --skip-phases addons: the restored state ALREADY carries the source
  # cluster's DNS and proxy configuration — kubeadm's stock addon templates
  # conflict with it instead of adopting it (proven on a real target: init
  # died at the last step on the restored CoreDNS Deployment's immutable
  # selector). Overwriting restored addons with kubeadm defaults is also
  # semantically wrong for a handover.
  # --skip-token-print: the join line that kubeadm prints at the end holds its
  # bootstrap token, and that output reaches the terminal (and a log). kubeadm
  # prints the line with the token withheld instead. No verbosity flag: kubeadm
  # at --v=8 or above can log the bodies of Secrets.
  kubeadm init --config "${config}" \
    --ignore-preflight-errors=DirAvailable--var-lib-etcd \
    --skip-phases=addon/coredns,addon/kube-proxy \
    --skip-token-print
}

# The bundle's endpoint DNS (also the apiserver cert's SAN) — used as the
# TLS server name when probing the apiserver on its local address.
handover::endpoint_dns() {
  local bundle="${1}" dns
  # Trim EDGES only (a trailing newline is normal); interior whitespace must
  # still fail the charset gate rather than be silently welded together.
  dns="$(< "${bundle}/endpoint-dns")"
  dns="${dns#"${dns%%[![:space:]]*}"}"
  dns="${dns%"${dns##*[![:space:]]}"}"
  # Same charset gate the kubeadm-config renderer applies — this value also
  # reaches kubectl as --tls-server-name, so a tampered bundle gets one
  # validated reader, not two.
  [[ "${dns}" =~ ^[a-zA-Z0-9.-]+$ ]] || {
    error "handover: bundle endpoint-dns '${dns}' is not a plain hostname"
    return 1
  }
  printf '%s' "${dns}"
}

# Post-init verification: the apiserver answers WITH the restored data, and
# the live CA is byte-identical to the bundle's — identity preserved, the
# whole point of the seeded restore. Never cut DNS over before this passes.
handover::verify() {
  local bundle="${1}" k8s_dir="${2}"
  local kubeconfig="${k8s_dir}/admin.conf"
  local waited=0 timeout="${KUBEHZ_HANDOVER_WAIT:-300}"
  # --server: admin.conf points at the cluster's ENDPOINT DNS, which still
  # resolves to the PLATFORM until the operator cuts over (that is the whole
  # point of the human gate). Verifying through it would either time out or —
  # worse — silently probe the old control plane. Talk to the local apiserver
  # and rely on the config's CA/credentials (the endpoint name stays in the
  # cert SANs, so we set --tls-server-name EXPLICITLY: --server alone blanks
  # the server name and the cert would be checked against 127.0.0.1).
  local local_api="https://127.0.0.1:6443" server_name
  server_name="$(handover::endpoint_dns "${bundle}")" || return 1
  until kubectl --kubeconfig "${kubeconfig}" --server "${local_api}" \
    --tls-server-name "${server_name}" \
    get ns kube-system >/dev/null 2>&1; do
    (( waited < timeout )) || {
      error "handover: the apiserver did not become ready within ${timeout}s (kubectl --kubeconfig ${kubeconfig} --server ${local_api} --tls-server-name ${server_name} get ns kube-system kept failing) — state left behind: ${k8s_dir}/pki holds the bundle PKI and the restored etcd data dir may be corrupt (a truncated snapshot restores 'successfully' under --skip-hash-check and only fails here). Clean up ('kubeadm reset') before retrying."
      return 1
    }
    sleep 5
    waited=$(( waited + 5 ))
  done

  local want got
  want=$(sha256sum "${bundle}/ca.crt" | cut -d' ' -f1)
  got=$(sha256sum "${k8s_dir}/pki/ca.crt" | cut -d' ' -f1)
  if [[ "${want}" != "${got}" ]]; then
    error "handover: CA hash mismatch after kubeadm init — ${k8s_dir}/pki/ca.crt is NOT the bundle's CA (identity was not preserved; do NOT cut over)"
    return 1
  fi
  echo "handover: verified — apiserver is up and the cluster CA matches the export bundle (sha256 ${got})"
}

# ── Subcommands ──────────────────────────────────────────

# `lo kubehz handover receive` — RUNS ON THE TARGET NODE (it writes
# /etc/kubernetes and /var/lib/etcd and calls kubeadm). Refuses a node that
# already carries Kubernetes state unless --force (and even then: run
# `kubeadm reset` yourself first on a previously-used node).
handover::receive() {
  # force: honor the INHERITED field when the dispatch chain already consumed
  # --force from argv (the #103 infra-gate made force inherited; a plain
  # `local force=0` here shadowed that dynamic-scope value and the flag never
  # reached the guards below).
  local bundle="" snapshot="" single_node=0 force="${force:-0}"
  local -a args=(
    'bundle|b:!'      'Export bundle: a directory or .tar.gz with the contract keys'
    'snapshot|s'      'Pre-downloaded etcd snapshot file (skips the snapshot-location fetch)'
    'single-node|:+'  'Untaint the control-plane node after init (single-node target)'
    'force|f:^:+'     'Proceed even when target dirs are not empty (DESTROYS existing etcd data)'
    "${args[@]:-}"
  )
  :args "Restore an exported control plane onto THIS node" "${@}"

  local k8s_dir="${KUBEHZ_HANDOVER_K8S_DIR:-/etc/kubernetes}"
  local etcd_dir="${KUBEHZ_HANDOVER_ETCD_DIR:-/var/lib/etcd}"

  # Private scratch (0700) for the bundle extraction + a downloaded snapshot —
  # PKI, the encryption key and the etcd snapshot must not linger on disk.
  # Scrubbed on EVERY exit path; a user-provided --bundle dir or --snapshot
  # file lives outside it and is never touched. Expand NOW (locals are out of
  # scope when the trap fires — the libs/build idiom); a re-fire on a caller
  # return is a harmless idempotent rm. handover::cleanup_cmd quotes the path.
  local workdir
  workdir=$(mktemp -d) || return 1
  # shellcheck disable=SC2064
  trap "$(handover::cleanup_cmd "${workdir}")" RETURN
  handover::make_private "${workdir}" || return 1

  local bundle_dir
  bundle_dir=$(handover::resolve_bundle "${bundle}" "${workdir}") || return 1
  handover::validate_bundle "${bundle_dir}" || return 1

  # "not empty" means REAL content: kubeadm's packages pre-create empty
  # skeleton dirs (manifests/, pki/) on every stock image, and `kubeadm
  # reset` leaves them behind too — refusing on those makes the documented
  # remedy unsatisfiable. Only files (or non-empty subtrees) block.
  local k8s_real="" k8s_find_rc=0
  if [[ -d "${k8s_dir}" ]]; then
    # ANY non-directory entry is content (files, symlinks, sockets, FIFOs) —
    # and a traversal error fails CLOSED: guessing "empty" before a
    # destructive receive is the one wrong direction.
    k8s_real="$(find "${k8s_dir}" ! -type d -print -quit 2>/dev/null)" || k8s_find_rc=$?
    if (( k8s_find_rc )) && [[ -z "${k8s_real}" ]] && ! (( force )); then
      error "handover: cannot inspect ${k8s_dir} (find exit ${k8s_find_rc}) — refusing to assume it is empty; fix permissions or re-run with --force."
      return 1
    fi
  fi
  if [[ -n "${k8s_real}" ]] && ! (( force )); then
    error "handover: ${k8s_dir} holds existing content (${k8s_real}) — either this node already runs (or ran) Kubernetes, or a previous receive attempt left its seeded state behind. Clean up first ('kubeadm reset' clears the seeded PKI and etcd data), then re-run — with --force if you really mean to overwrite what remains."
    return 1
  fi
  if [[ -d "${etcd_dir}" ]] && [[ -n "$(ls -A "${etcd_dir}" 2>/dev/null)" ]]; then
    if (( force )); then
      rm -rf "${etcd_dir}"
    else
      error "handover: ${etcd_dir} is not empty — refusing to restore over existing etcd data (re-run with --force to overwrite)."
      return 1
    fi
  fi

  # Fail before touching the node: resolve the snapshot AND the member
  # identity first (an identity failure after place_pki would strand seeded
  # PKI behind the non-empty guard).
  local snapshot_file member_identity node_name peer_url
  snapshot_file=$(handover::fetch_snapshot "${bundle_dir}" "${snapshot}" "${workdir}") || return 1
  member_identity="$(handover::member_identity)" || return 1
  read -r node_name peer_url <<<"${member_identity}"
  # Validate the etcd pin here too — a bad override must not strand seeded PKI.
  # Precedence: explicit env override > the bundle's own etcd line > the
  # platform default. The bundle value is what the SOURCE ran, which is what the
  # snapshot has to be replayed by — etcd 3.6 PANICS on a 3.5-origin restore.
  local etcd_tag="${KUBEHZ_HANDOVER_ETCD_IMAGE_TAG:-}" bundle_tag
  bundle_tag="$(handover::bundle_value "${bundle_dir}" etcd-version "")"
  if [[ -z "${etcd_tag}" ]]; then
    etcd_tag="${bundle_tag:-3.5.21-0}"
  elif [[ -n "${bundle_tag}" && "${bundle_tag}" != "${etcd_tag}" ]]; then
    # A stale override silently defeating the value the source exported is worth
    # saying out loud — it is the etcd-3.6-panics-on-a-3.5-snapshot trap.
    warn "handover: KUBEHZ_HANDOVER_ETCD_IMAGE_TAG '${etcd_tag}' overrides the bundle's etcd-version '${bundle_tag}'"
  fi
  # Docker tag grammar: alnum/underscore first char, then [alnum._-], ≤128.
  [[ "${etcd_tag}" =~ ^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$ ]] || {
    error "handover: etcd image tag '${etcd_tag:0:64}' is not a plain image tag — refusing before touching the node"
    return 1
  }

  # EVERY bundle-derived value is validated here, before the node is touched.
  # A rejection from inside write_encryption_config or write_kubeadm_config lands
  # after place_pki and restore_snapshot have run, stranding seeded PKI and a
  # restored member dir behind the non-empty guard — a `kubeadm reset` and a
  # --force re-run for what is only a malformed bundle. The individual writers
  # keep their own checks so they stay safe for direct callers.
  handover::encryption_metadata "${bundle_dir}" >/dev/null || return 1
  handover::encryption_key "${bundle_dir}" >/dev/null || return 1
  local endpoint_dns
  endpoint_dns="$(handover::endpoint_dns "${bundle_dir}")" || return 1

  handover::place_pki "${bundle_dir}" "${k8s_dir}" || return 1
  handover::restore_snapshot "${snapshot_file}" "${etcd_dir}" "${node_name}" "${peer_url}" || return 1
  handover::write_encryption_config "${bundle_dir}" "${k8s_dir}" >/dev/null || return 1
  local kubeadm_config="${k8s_dir}/kubehz-handover-kubeadm.yaml"
  handover::write_kubeadm_config "${bundle_dir}" "${k8s_dir}" "${kubeadm_config}" "${etcd_tag}" || return 1
  handover::kubeadm_init "${kubeadm_config}" || {
    error "handover: kubeadm init FAILED after the node was seeded — state left behind: ${k8s_dir}/pki holds the bundle PKI and ${etcd_dir} holds the restored snapshot. Clean up first ('kubeadm reset' removes both, or delete ${k8s_dir} and ${etcd_dir} yourself), then re-run receive with --force."
    return 1
  }
  handover::verify "${bundle_dir}" "${k8s_dir}" || return 1

  if (( single_node )); then
    # Pinned to the LOCAL apiserver for the same reason verify is: admin.conf's
    # endpoint DNS still resolves to the PLATFORM until cutover, and its CA is
    # the same identity — an unpinned call could untaint the WRONG cluster's
    # nodes and report success.
    kubectl --kubeconfig "${k8s_dir}/admin.conf" \
      --server "https://127.0.0.1:6443" --tls-server-name "${endpoint_dns}" \
      taint nodes --all node-role.kubernetes.io/control-plane- >/dev/null 2>&1 \
      || warn "handover: could not untaint the control-plane node — run: kubectl --server https://127.0.0.1:6443 --tls-server-name ${endpoint_dns} taint nodes --all node-role.kubernetes.io/control-plane-"
  fi

  echo "handover: receive complete. Next steps:"
  echo "  1. point the endpoint DNS (${endpoint_dns}) at this node"
  echo "  2. ack the cutover in the kubehz dashboard (the platform waits for a target-side heartbeat)"
  echo "  3. join workers / additional control planes as needed"
}

# Check that ssh recorded the node's host key in the known_hosts file that it
# uses (--known-hosts, else ssh's own user file): the later calls check the
# key against that record. ssh records a node in lowercase, and on a port
# other than 22 as [node]:port. `ssh-keygen -F` also finds a hashed entry
# (HashKnownHosts).
handover::host_key_recorded() {
  local host="${1,,}" port="${2}" file="${3}"
  [[ "${port}" == "22" ]] || host="[${host}]:${port}"
  ssh-keygen -F "${host}" -f "${file}" >/dev/null 2>&1 && return 0
  error "handover: the host key of ${host} is not in ${file} after the first contact, so the next calls could not check it. Make sure that ssh can write that file (or name the file with --known-hosts), then retry."
  return 1
}

# `lo kubehz handover preseed` — kubeone-driver variant, deliberately THIN:
# place the six PKI files on node0 over SSH before `kubeone apply`
# (lo provision) runs; kubeadm reuses existing CA files by design, so the
# provisioned cluster keeps the exported identity. No snapshot, no init here.
handover::preseed() {
  local bundle="" node="" user="root" port=22 ssh_key="" known_hosts="" accept_new_host_key=0
  local -a args=(
    'bundle|b:!'              'Export bundle: a directory or .tar.gz with the contract keys'
    'node|n:!'                'Target node address (kubeone node0) to place the PKI on'
    'user|u'                  'SSH user'
    'port|p:~int'             'SSH port'
    'ssh-key|i'               'SSH private key file'
    'known-hosts|'            "known_hosts file with the node's host key (default: ssh's own files); the file must exist, and an unknown or changed key fails"
    'accept-new-host-key|:+'  'Trust an unknown host key on the first contact and record it in the known_hosts file (trust on first use)'
    "${args[@]:-}"
  )
  :args "Pre-seed exported PKI onto a kubeone node before kubeone apply" "${@}"

  # ssh reads the value of `-o UserKnownHostsFile=<path>` in its config
  # language: it expands % tokens, ${VAR} and ~, it splits the value at
  # whitespace, and quotes and backslashes change the split. The file checks
  # here and ssh-keygen -f read the path as it is. So a path with such a
  # byte is refused before any ssh call. A relative path is made absolute
  # first (the working dir as it is, no link resolved), so the check reads
  # the path that ssh gets.
  [[ -z "${known_hosts}" || "${known_hosts}" == /* ]] || known_hosts="${PWD}/${known_hosts}"
  if handover::ssh_path_unsafe "${known_hosts}"; then
    error "handover: --known-hosts path must not hold %, \$, ~, \", ', \\, whitespace or a control byte, because ssh expands %, \$ and ~ in it and splits it at whitespace, quotes and backslashes: $(handover::quote "${known_hosts}" 0)"
    return 1
  fi
  # A missing path, /dev/null, a dir, a FIFO or a device holds no key to
  # check against, and ssh cannot record a key in it.
  if [[ -n "${known_hosts}" ]] && { [[ ! -f "${known_hosts}" ]] || [[ ! -r "${known_hosts}" ]]; }; then
    error "handover: --known-hosts must name an existing regular file that you can read: \"${known_hosts}\""
    return 1
  fi

  # Same scratch + cleanup contract as receive: an extracted .tar.gz bundle
  # (PKI + encryption key on disk) is scrubbed on every exit path. Expand NOW
  # (libs/build idiom); a trap re-fire is a harmless idempotent rm.
  # handover::cleanup_cmd quotes the path.
  local workdir
  workdir=$(mktemp -d) || return 1
  # shellcheck disable=SC2064
  trap "$(handover::cleanup_cmd "${workdir}")" RETURN
  handover::make_private "${workdir}" || return 1

  local bundle_dir
  bundle_dir=$(handover::resolve_bundle "${bundle}" "${workdir}") || return 1
  handover::validate_bundle "${bundle_dir}" || return 1

  # These calls carry the CA private keys, so each one checks the host key
  # (StrictHostKeyChecking=yes): an unknown or a changed key fails before a
  # key leaves this machine. With --accept-new-host-key, only the first call
  # (the mkdir, which sends no key) takes an unknown key and records it
  # (accept-new). The handover then checks that the key is in the known_hosts
  # file, and every later call uses yes. Never StrictHostKeyChecking=no or
  # UserKnownHostsFile=/dev/null here. The kubeone driver's node probes carry
  # no secret and keep their own options.
  # With --known-hosts, GlobalKnownHostsFile=/dev/null makes that file the
  # only known_hosts file: a key in the system files (/etc/ssh/
  # ssh_known_hosts) is then no trust source.
  # ControlMaster=no and ControlPath=none: a master connection that the
  # user's ssh config opens or shares (ControlMaster, ControlPath) would
  # carry these calls without a new host key check. ssh takes the first
  # value it gets for an option, so these win over the config.
  # NoHostAuthenticationForLocalhost=no: with yes, ssh skips the host key
  # check for a loopback address (a node behind a forwarded port), also with
  # StrictHostKeyChecking=yes. VerifyHostKeyDNS=no: with yes, ssh takes a key
  # from a DNS SSHFP record that is in no known_hosts file. UpdateHostKeys=no:
  # the node cannot add or remove keys in the known_hosts file.
  local -a ssh_opts=(-o IdentitiesOnly=yes -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=10
    -o ControlMaster=no -o ControlPath=none
    -o NoHostAuthenticationForLocalhost=no -o VerifyHostKeyDNS=no -o UpdateHostKeys=no)
  [[ -z "${known_hosts}" ]] || ssh_opts+=(-o "UserKnownHostsFile=${known_hosts}" -o GlobalKnownHostsFile=/dev/null)
  [[ -z "${ssh_key}" ]] || ssh_opts+=(-i "${ssh_key}")
  local first_contact=yes
  if (( accept_new_host_key )); then
    first_contact=accept-new
    warn "handover: --accept-new-host-key: the first contact trusts the host key that ${node} shows, without a check"
  fi

  # Each ssh and scp call captures its stdout and its stderr (in a file in
  # the private workdir), so no byte from the node reaches the terminal as
  # it is. On success preseed shows none of it, except the stderr of the
  # first call. On a failure it shows the lines of the call that failed
  # (handover::stream).
  local out="" err="" rc=0 errfile="${workdir}/stderr" first_call="the mkdir call on ${node}"
  # The pki dir is 0700 before any key lands in it: umask 077 makes a new
  # dir 0700, and chmod sets a dir that is there already (kubeadm makes it
  # 0755). A chmod that fails fails the call.
  out="$(ssh -o "StrictHostKeyChecking=${first_contact}" "${ssh_opts[@]}" -p "${port}" "${user}@${node}" \
    'umask 077 && mkdir -p /etc/kubernetes/pki && chmod 0700 /etc/kubernetes/pki' 2> "${errfile}")" || rc=$?
  err="$(< "${errfile}")"
  if (( rc )); then
    error "handover: cannot reach ${user}@${node} over SSH, or cannot set /etc/kubernetes/pki on it to mode 700"
    handover::streams "${first_call}" "${out}" "${err}" >&2
    if (( accept_new_host_key )); then
      error "handover: a changed host key also fails here; check the node and the known_hosts entry before you retry"
    else
      error "handover: an unknown or changed host key also fails here. Compare the fingerprints of \"ssh-keyscan -p ${port} ${node} | ssh-keygen -lf -\" with \"ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub\" on the node's console, and add the key to the known_hosts file if they match. Or retry with --accept-new-host-key to trust the first contact."
    fi
    return 1
  fi
  # The stderr of the first call can hold the line where ssh says that it
  # recorded the host key (accept-new).
  handover::stream "${first_call}" stderr "${err}" >&2
  if (( accept_new_host_key )); then
    handover::host_key_recorded "${node}" "${port}" "${known_hosts:-${HOME}/.ssh/known_hosts}" || return 1
  fi
  ssh_opts=(-o StrictHostKeyChecking=yes "${ssh_opts[@]}")
  local -a remote=(ssh "${ssh_opts[@]}" -p "${port}" "${user}@${node}")

  # scp writes into a file that is there already: a hard link at the
  # destination gives the key bytes to its other name too, and a symlink
  # sends them to its target. So each file goes to a new staging file in the
  # 0700 pki dir first. One call checks the dirs and makes the files (umask
  # 077 and mktemp: mode 0600) and prints their names, the scp calls fill
  # them, and one call sets each mode and renames each file over its
  # destination. A rename (mv -T) replaces a link or a file there and never
  # writes through it. A failure removes the staging files, or names them
  # when that fails too.
  # shown holds the lines of the call that failed.
  local install_cmd="" failed="" shown="" key i
  local -a lines=() staged=()
  rc=0
  out="$("${remote[@]}" "$(handover::stage_cmd)" 2> "${errfile}")" || rc=$?
  err="$(< "${errfile}")"
  [[ -z "${out}" ]] || mapfile -t lines <<< "${out}"
  # Only a name of the expected shape goes into a later command.
  if (( rc )); then
    failed="$(handover::stage_failure "${out##*$'\n'}" "${node}")"
  else
    failed="$(handover::stage_lines "${node}" "${lines[@]}")"
  fi
  if [[ -z "${failed}" ]]; then
    staged=("${lines[@]:${#KUBEHZ_HANDOVER_TRUSTED_DIRS[@]}+1}")
  else
    shown="$(handover::streams "the stage call on ${node}" "${out}" "${err}")"
    # The cleanup takes each line that is a staging name of some key.
    for i in "${!lines[@]}"; do
      for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
        handover::staging_name "${key}" "${lines[i]}" || continue
        staged+=("${lines[i]}")
        break
      done
    done
  fi

  if [[ -z "${failed}" ]]; then
    for i in "${!KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
      key="${KUBEHZ_HANDOVER_PKI_KEYS[i]}"
      rc=0
      out="$(scp "${ssh_opts[@]}" -q -P "${port}" "${bundle_dir}/${key}" "${user}@${node}:${staged[i]}" 2> "${errfile}")" || rc=$?
      err="$(< "${errfile}")"
      (( rc )) || continue
      failed="copying ${key} to ${node} failed"
      shown="$(handover::streams "the copy of ${key} to ${node}" "${out}" "${err}")"
      break
    done
  fi

  if [[ -z "${failed}" ]]; then
    install_cmd="$(handover::install_cmd "${staged[@]}")"
    rc=0
    out="$("${remote[@]}" "${install_cmd}" 2> "${errfile}")" || rc=$?
    err="$(< "${errfile}")"
    if (( rc )); then
      # ssh exits 255 on its own error, a lost connection too. The node can
      # then run steps after the last line that came back.
      failed="$(handover::install_failure "${out##*$'\n'}" "${rc}" "${node}")"
      shown="$(handover::streams "the install call on ${node}" "${out}" "${err}")"
    fi
  fi

  if [[ -n "${failed}" ]]; then
    error "handover: ${failed}"
    [[ -z "${shown}" ]] || printf '%s\n' "${shown}" >&2
    if (( ${#staged[@]} )); then
      rc=0
      out="$("${remote[@]}" "rm -f -- ${staged[*]}" 2> "${errfile}")" || rc=$?
      err="$(< "${errfile}")"
      if (( rc )); then
        error "handover: could not remove the staging files on ${node}; they can hold key bytes. Remove them yourself: ${staged[*]}"
        handover::streams "the cleanup call on ${node}" "${out}" "${err}" >&2
      fi
    fi
    return 1
  fi

  echo "handover: PKI pre-seeded on ${node}. Provision now (lo provision) — kubeone's kubeadm reuses the existing CA files, preserving cluster identity."
}

# Return 0 when name is the shape of a staging file that preseed's mktemp
# makes for key: /etc/kubernetes/pki/.<key>. and 10 ASCII letters or digits.
# The letters are listed, so the check does not depend on the locale.
handover::staging_name() {
  local key="${1}" name="${2}" rest
  local alnum=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789
  rest="${name#"/etc/kubernetes/pki/.${key}."}"
  [[ "${rest}" != "${name}" && ${#rest} -eq 10 && "${rest}" != *[!${alnum}]* ]]
}

# Print the find test of the owners that the trusted dir may have, then a
# tab, then the same owners in words.
handover::dir_owners() {
  local dir
  for dir in "${KUBEHZ_HANDOVER_ROOT_DIRS[@]}"; do
    [[ "${1}" == "${dir}" ]] || continue
    printf '%s\t%s\n' '-uid 0' root
    return 0
  done
  # shellcheck disable=SC2016  # the $( ) runs on the node, in the find of the stage call
  printf '%s\t%s\n' '\( -uid 0 -o -uid "$(id -u)" \)' 'root or the ssh user'
}

# Print the remote command of preseed's stage call. Before each check it
# prints "check <dir> <uid> <mode> <type>" (GNU stat), and after the checks
# "stage", so the last line of a failed call names the dir that failed. Then
# it makes one staging file per PKI key (umask 077 and mktemp: mode 0600)
# and prints its name.
handover::stage_cmd() {
  local cmd="umask 077" dir key owners
  for dir in "${KUBEHZ_HANDOVER_TRUSTED_DIRS[@]}"; do
    owners="$(handover::dir_owners "${dir}")"
    cmd+=" && echo \"check ${dir} \$(stat -c '%u %a %F' -- ${dir})\""
    cmd+=" && test -n \"\$(find ${dir} -maxdepth 0 -type d ! -perm /022 ${owners%%$'\t'*} -print)\""
  done
  cmd+=" && echo stage"
  for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    cmd+=" && mktemp /etc/kubernetes/pki/.${key}.XXXXXXXXXX"
  done
  printf '%s\n' "${cmd}"
}

# Print the cause of a failed stage call from the last line that it printed.
# A check line names the dir that failed its check and what stat showed.
handover::stage_failure() {
  local last="${1}" node="${2}" dir msg who
  for dir in "${KUBEHZ_HANDOVER_TRUSTED_DIRS[@]}"; do
    [[ "${last}" == "check ${dir} "* ]] || continue
    who="$(handover::dir_owners "${dir}")"
    msg="${dir} on ${node} must be a dir, not a link, that ${who#*$'\t'} owns, with no write bit for the group or others."
    msg+=" stat shows (uid, mode, type) $(handover::quote "${last#"check ${dir} "}"). No key was sent"
    printf '%s\n' "${msg}"
    return 0
  done
  printf '%s\n' "could not make the staging files /etc/kubernetes/pki/.<key>.XXXXXXXXXX on ${node}"
}

# Print the problem with the output lines of a stage call that passed, or
# nothing. They must be a check line per trusted dir, "stage", then one
# staging name per PKI key, in order.
handover::stage_lines() {
  local node="${1}" dir key i head n
  shift
  local -a lines=("${@}")
  for i in "${!KUBEHZ_HANDOVER_TRUSTED_DIRS[@]}"; do
    dir="${KUBEHZ_HANDOVER_TRUSTED_DIRS[i]}"
    [[ "${lines[i]:-}" == "check ${dir} "* ]] && continue
    printf '%s\n' "${node} printed $(handover::quote "${lines[i]:-}") where the stage call prints the check of ${dir}"
    return 0
  done
  head=${#KUBEHZ_HANDOVER_TRUSTED_DIRS[@]}
  if [[ "${lines[head]:-}" != stage ]]; then
    printf '%s\n' "${node} printed $(handover::quote "${lines[head]:-}") where the stage call prints \"stage\""
    return 0
  fi
  for i in "${!KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    key="${KUBEHZ_HANDOVER_PKI_KEYS[i]}"
    handover::staging_name "${key}" "${lines[head + 1 + i]:-}" && continue
    printf '%s\n' "${node} printed a staging name for ${key} that is not /etc/kubernetes/pki/.${key}. and 10 letters or digits: $(handover::quote "${lines[head + 1 + i]:-}")"
    return 0
  done
  n=$(( ${#lines[@]} - head - 1 ))
  (( n == ${#KUBEHZ_HANDOVER_PKI_KEYS[@]} )) ||
    printf '%s\n' "${node} printed ${n} lines for ${#KUBEHZ_HANDOVER_PKI_KEYS[@]} staging names"
}

# Print a line from the node, safe to print: its first 200 bytes in double
# quotes. A byte below 0x20, 0x7f and a byte from 0x80 shows as \xNN (so no
# terminal control, C1 controls too, reaches the terminal), a backslash as
# \\ and a double quote as \". A longer line also says how many bytes it
# has. A second argument sets the number of bytes to show; 0 shows every
# byte (a path that the user gave). LC_ALL=C makes each step one byte.
handover::quote() {
  local LC_ALL=C
  local s="${1}" limit="${2:-200}" out="" c hex i n
  n=${#s}
  (( limit > 0 && limit < n )) || limit=${n}
  for (( i = 0; i < limit; i++ )); do
    c="${s:i:1}"
    # shellcheck disable=SC1003  # '\' is one backslash, not an escaped quote
    case "${c}" in
      '\') out+='\\' ;;
      '"') out+='\"' ;;
      [[:print:]]) out+="${c}" ;;
      *)
        printf -v hex '%02x' "'${c}"
        out+="\\x${hex}"
        ;;
    esac
  done
  out="\"${out}\""
  (( limit == n )) || out+=" (the first ${limit} of ${n} bytes)"
  printf '%s\n' "${out}"
}

# Print the lines of one stream (stdout or stderr) of an ssh or scp call,
# safe to print. Each line is "handover: <call>, <stream>: " and the line
# through handover::quote, without one CR at its end (ssh ends its own
# messages with CR LF, so "Host key verification failed." stays readable).
# It prints at most 20 lines; the last one that it prints then also says how
# many lines it does not print.
handover::stream() {
  local call="${1}" stream="${2}" text="${3}" line i n more unit
  [[ -n "${text}" ]] || return 0
  local -a lines=()
  mapfile -t lines <<< "${text}"
  n=${#lines[@]}
  for (( i = 0; i < n && i < 20; i++ )); do
    line="handover: ${call}, ${stream}: $(handover::quote "${lines[i]%$'\r'}")"
    more=$(( n - 20 ))
    if (( i == 19 && more > 0 )); then
      unit=lines
      (( more != 1 )) || unit=line
      line+=" (${more} more ${unit})"
    fi
    printf '%s\n' "${line}"
  done
}

# Print the lines of the stdout and then of the stderr of an ssh or scp call
# (handover::stream).
handover::streams() {
  handover::stream "${1}" stdout "${2}"
  handover::stream "${1}" stderr "${3}"
}

# Return 0 when path holds a byte that ssh reads as syntax in the value of
# an -o option: % (a token), $ (an environment variable), ~ (the home dir), a
# quote or a backslash (they change how ssh splits the value), whitespace,
# or another control byte (below 0x20, and 0x7f). LC_ALL=C makes the classes
# bytes.
handover::ssh_path_unsafe() {
  local LC_ALL=C
  [[ "${1}" == *[[:cntrl:][:space:]%\$~\"\'\\]* ]]
}

# Print the remote command of preseed's install call for the staging names
# (one per PKI key, in order): first it sets the mode of each staging file
# (the keys 0600, the certs and sa.pub 0644), then it renames each over its
# destination. Before each step it prints the step, so the last line of a
# failed call names the step that failed.
handover::install_cmd() {
  local -a staged=("${@}")
  local cmd="" key mode i
  for i in "${!KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    key="${KUBEHZ_HANDOVER_PKI_KEYS[i]}"
    mode=0644
    [[ "${key}" != *.key ]] || mode=0600
    cmd+="${cmd:+ && }echo 'chmod ${key}' && chmod ${mode} ${staged[i]}"
  done
  for i in "${!KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    key="${KUBEHZ_HANDOVER_PKI_KEYS[i]}"
    cmd+=" && echo 'mv ${key}' && mv -f -T ${staged[i]} /etc/kubernetes/pki/${key}"
  done
  printf '%s\n' "${cmd}"
}

# Print the cause of a failed install call from the last line that it
# printed (handover::install_cmd) and its exit status. Exit 255 is an ssh
# error, a lost connection too: the node can run steps after the last line
# that came back, so the state is unknown whatever step that line names.
# Else the last line names the step that failed, and a mv failure names the
# files that went into place before it. A last line that names no step
# (text from the node's shell) also says that the state is unknown. An
# unknown state names each destination to check.
handover::install_failure() {
  local last="${1}" rc="${2}" node="${3}" key done_keys="" seen msg
  local dests="${KUBEHZ_HANDOVER_PKI_KEYS[*]/#//etc/kubernetes/pki/}"
  if (( rc == 255 )); then
    seen="no step arrived, but steps can have run"
    for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
      [[ "${last}" == "chmod ${key}" || "${last}" == "mv ${key}" ]] || continue
      seen="the last step that arrived is \"${last}\", and later steps can have run"
    done
    msg="the install call on ${node} ended with exit 255 (an ssh error, such as a lost connection), so the state of the install is UNKNOWN: ${seen}."
    printf '%s\n' "${msg} Check each of these files on ${node}: ${dests}"
    return 0
  fi
  for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    if [[ "${last}" == "chmod ${key}" ]]; then
      printf '%s\n' "could not set the mode of the staging file of ${key} on ${node}; no file was moved into place"
      return 0
    fi
    if [[ "${last}" == "mv ${key}" ]]; then
      printf '%s\n' "could not move the staging file of ${key} to /etc/kubernetes/pki/${key} on ${node}; in place before it: ${done_keys:-none}"
      return 0
    fi
    done_keys+="${done_keys:+ }${key}"
  done
  msg="the install call on ${node} failed, and its output names no step, so the state of the install is UNKNOWN."
  printf '%s\n' "${msg} Check each of these files on ${node}: ${dests}"
}
