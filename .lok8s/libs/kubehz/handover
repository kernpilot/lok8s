#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-handover — eject TARGET side of a control-plane handover
# (the cross-repo handover contract, §4 lok8s scope — kept verbatim with
# kubehz-cluster/docs/internal/handover-implementation.md).
#
# `lo kubehz handover receive --bundle <path>` restores an exported hosted
# control plane onto THE NODE IT RUNS ON (kubeadm driver path): seed the
# exported PKI into /etc/kubernetes/pki, restore the etcd snapshot into
# /var/lib/etcd, then `kubeadm init` with
# --ignore-preflight-errors=DirAvailable--var-lib-etcd and the addon phases
# skipped (the restored state carries the source's DNS/proxy) against the
# pre-seeded state. kubeadm REUSES existing ca/sa/front-proxy files instead of minting
# new ones — that is what preserves the cluster identity (same CA, same SA
# signing keys, same secrets-at-rest encryption key).
#
# `lo kubehz handover preseed --bundle <path> --node <ip>` is the thin
# kubeone-driver variant: it ONLY places the PKI on node0 BEFORE
# `kubeone apply` (lo provision) runs — kubeone's kubeadm then initializes
# with the seeded CA files. Snapshot restore is not part of preseed.
#
# Bundle layout (contract §2 export Secret, one file per key):
#   ca.crt ca.key sa.pub sa.key front-proxy-ca.crt front-proxy-ca.key
#   encryption-key snapshot-location endpoint-dns
#
# Optional keys — the platform's own values, so the target does not have to
# hardcode platform constants. Absent means "use the default", which keeps
# bundles exported by older operators working:
#   encryption-provider  (default secretbox)
#   encryption-key-name  (default kubehz-key-1)
#   etcd-version         (default 3.5.21-0, the platform's etcd line)
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.
#
# Test seams (bats exercises every step against a sandbox):
#   KUBEHZ_HANDOVER_K8S_DIR   target /etc/kubernetes  (default)
#   KUBEHZ_HANDOVER_ETCD_DIR  target /var/lib/etcd    (default)
#   KUBEHZ_HANDOVER_WAIT      apiserver-ready timeout seconds (default 300)
#   KUBEHZ_HANDOVER_ETCD_IMAGE_TAG  etcd image tag for the target's static pod
#                             (overrides the bundle's etcd-version; default
#                             3.5.21-0 — the platform's source line)

import ^utils/verbose

# The contract §2 bundle keys. The six PKI files are what preseed places;
# receive additionally needs the restore artifacts.
KUBEHZ_HANDOVER_PKI_KEYS=(
  ca.crt ca.key sa.pub sa.key front-proxy-ca.crt front-proxy-ca.key
)
KUBEHZ_HANDOVER_BUNDLE_KEYS=(
  "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"
  encryption-key snapshot-location endpoint-dns
)

kubehz::handover() {
  local -a usage=(
    'receive|r@destructive'  'Restore an exported control plane onto THIS node (kubeadm path)'
    'preseed|p@destructive'  'Pre-seed exported PKI onto a kubeone node before kubeone apply'
  )
  :usage "Control-plane handover — eject target side" "${@}"
  "${usage[@]}"
}

# ── Bundle handling ──────────────────────────────────────

# Resolve --bundle into a directory: a directory is used as-is; a file (the
# api's one-time .tar.gz download) is unpacked into a private (0700) dir —
# inside the caller's workdir when one is given, so the caller's cleanup trap
# scrubs the extracted PKI + encryption key on every exit path (a direct call
# without a workdir owns the mktemp dir and must remove it itself).
# Outputs the bundle dir on stdout.
handover::resolve_bundle() {
  local bundle="${1}" workdir="${2:-}"
  if [[ -d "${bundle}" ]]; then
    echo "${bundle}"
    return 0
  fi
  if [[ -f "${bundle}" ]]; then
    local dir
    if [[ -n "${workdir}" ]]; then
      dir="${workdir}/bundle"
      mkdir -p "${dir}" || return 1
    else
      dir=$(mktemp -d) || return 1
    fi
    chmod 700 "${dir}"
    # Path-traversal guard: reject any archive entry that is absolute or
    # climbs out (`..` component) BEFORE extraction — a malicious bundle must
    # not write outside the private dir (GNU tar defends by default, bsdtar
    # historically did not; the listing check is tar-flavor-independent).
    local entry
    while IFS= read -r entry; do
      # Reject every position a `..` COMPONENT can take (sole, leading,
      # interior, trailing) + absolute paths. Component-anchored on purpose:
      # the old `*../*` also matched harmless names like `foo../bar` AND
      # shadowed the `../*` alternative entirely (SC2221/SC2222).
      case "${entry}" in
        /*|..|../*|*/../*|*/..)
          error "handover: refusing ${bundle} — archive entry escapes the bundle dir: ${entry}"
          rm -rf "${dir}"
          return 1
          ;;
      esac
    done < <(tar -tzf "${bundle}" 2>/dev/null)
    if ! tar -xzf "${bundle}" -C "${dir}" 2>/dev/null; then
      error "handover: ${bundle} is neither a bundle directory nor a readable .tar.gz archive"
      rm -rf "${dir}"
      return 1
    fi
    echo "${dir}"
    return 0
  fi
  error "handover: bundle not found: ${bundle}"
  return 1
}

# Validate bundle completeness: every contract §2 key must exist and be
# non-empty. The error NAMES the missing key.
handover::validate_bundle() {
  local dir="${1}" key
  for key in "${KUBEHZ_HANDOVER_BUNDLE_KEYS[@]}"; do
    if [[ ! -s "${dir}/${key}" ]]; then
      error "handover: bundle is incomplete — missing or empty key: ${key} (expected at ${dir}/${key})"
      return 1
    fi
  done
}

# ── Receive steps (each small + separately testable) ─────

# Seed the exported PKI into <k8s_dir>/pki. kubeadm init reuses EXISTING
# ca/sa/front-proxy files instead of minting new ones — the identity anchor.
handover::place_pki() {
  local bundle="${1}" k8s_dir="${2}" key
  mkdir -p "${k8s_dir}/pki" || return 1
  for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    cp "${bundle}/${key}" "${k8s_dir}/pki/${key}" || {
      error "handover: could not place ${key} into ${k8s_dir}/pki"
      return 1
    }
  done
  chmod 644 "${k8s_dir}/pki/ca.crt" "${k8s_dir}/pki/front-proxy-ca.crt" "${k8s_dir}/pki/sa.pub"
  chmod 600 "${k8s_dir}/pki/ca.key" "${k8s_dir}/pki/front-proxy-ca.key" "${k8s_dir}/pki/sa.key"
}

# Obtain the etcd snapshot: an explicit --snapshot file wins; otherwise the
# bundle's snapshot-location is fetched BEST-EFFORT (s3:// needs an aws CLI on
# the node, https:// uses curl, an absolute path is used in place; kkp:// is a
# KKP-internal locator and always refused). Every failure names the fix:
# download it yourself and re-run with --snapshot. A download lands 0600
# inside the caller's private workdir (an etcd snapshot IS the full cluster
# state, secrets included) and is scrubbed by the caller's cleanup trap; a
# user-provided --snapshot or on-node absolute path is never touched.
# Outputs the local snapshot path.
handover::fetch_snapshot() {
  local bundle="${1}" override="${2:-}" workdir="${3:-}"
  if [[ -n "${override}" ]]; then
    [[ -f "${override}" ]] || { error "handover: --snapshot file not found: ${override}"; return 1; }
    echo "${override}"
    return 0
  fi
  if [[ -z "${workdir}" ]]; then
    workdir=$(mktemp -d) || return 1
    chmod 700 "${workdir}"
  fi
  local location out="${workdir}/kubehz-handover-snapshot.db"
  location=$(<"${bundle}/snapshot-location")
  case "${location}" in
    kkp://*)
      # kubehz-core writes kkp://<destination>/<clusterID>/<backupName> — a
      # KKP-internal locator naming the platform's backup destination, NOT a
      # fetchable URL from this node.
      error "handover: snapshot-location '${location}' is a KKP-internal locator (kkp://<destination>/<clusterID>/<backupName>) — it cannot be fetched from this node. Obtain the snapshot object via the platform (the tier2/api bundle download provides it) and re-run with --snapshot <file>"
      return 1
      ;;
    s3://*)
      command -v aws >/dev/null 2>&1 || {
        error "handover: the snapshot lives at ${location} but no aws CLI is on this node — download it with any s3 client against the platform's object store and re-run with --snapshot <file>"
        return 1
      }
      # 0600 BEFORE any bytes land, plus an umask guard for tools that write
      # a fresh file (aws downloads to a part-file, then renames over out).
      { : > "${out}" && chmod 600 "${out}"; } || return 1
      ( umask 077 && aws s3 cp "${location}" "${out}" >/dev/null ) || {
        error "handover: fetching ${location} via the aws CLI failed — download it yourself and re-run with --snapshot <file>"
        return 1
      }
      ;;
    https://*)
      { : > "${out}" && chmod 600 "${out}"; } || return 1
      ( umask 077 && curl -fsSL "${location}" -o "${out}" ) || {
        error "handover: downloading the snapshot from ${location} failed — download it yourself and re-run with --snapshot <file>"
        return 1
      }
      ;;
    /*)
      [[ -f "${location}" ]] || {
        error "handover: snapshot-location points at ${location}, which does not exist on this node — re-run with --snapshot <file>"
        return 1
      }
      out="${location}"
      ;;
    *)
      error "handover: unsupported snapshot-location '${location}' (expected s3://, https:// or an absolute path) — re-run with --snapshot <file>"
      return 1
      ;;
  esac
  echo "${out}"
}

# Resolve the etcd member identity kubeadm's static pod will start with —
# the restore must rewrite membership to EXACTLY this or etcd refuses the
# data dir and crash-loops. Prints "<name> <peer-url>"; fails loudly when no
# advertise address can be derived (a silent localhost peer is the bug).
handover::member_identity() {
  local node_name node_ip peer_url
  # kubeadm lowercases the node name (nodeutil.GetHostname) — mirror it, or
  # an uppercase hostname reintroduces the exact identity mismatch.
  node_name="$(hostname | tr '[:upper:]' '[:lower:]')"
  # kubeadm advertises the default-route source address; mirror it (portable
  # awk, no GNU-grep -P).
  node_ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')"
  if [[ -n "${node_ip}" ]]; then
    peer_url="https://${node_ip}:2380"
  else
    # IPv6-only node: kubeadm advertises the v6 source — URL needs brackets.
    node_ip="$(ip -6 route get 2606:4700:4700::1111 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')"
    [[ -n "${node_ip}" ]] && peer_url="https://[${node_ip}]:2380"
  fi
  if [[ -z "${node_ip}" ]]; then
    error "handover: cannot determine this node's advertise address (no default route?) — etcd's member peer URL must match what kubeadm advertises; fix routing and re-run."
    return 1
  fi
  printf '%s %s\n' "${node_name}" "${peer_url}"
}

# Restore the snapshot into <etcd_dir>. etcdutl is the modern tool; etcdctl
# (ETCDCTL_API=3) is the fallback on older nodes. Both refuse an existing
# data dir, so an empty leftover dir is removed first.
#
# MEMBER IDENTITY must be rewritten at restore time: a default restore mints
# a member named "default" with localhost peer URLs, and kubeadm's etcd
# static pod then starts with --name <node> + the node-IP peer URL — etcd
# refuses the mismatched data dir and crash-loops (the receive's kubeadm
# init dies waiting for an apiserver that never gets its datastore). Restore
# with the SAME name + peer URL kubeadm will use, exactly like the upstream
# kubeadm disaster-recovery runbook.
handover::restore_snapshot() {
  local snapshot="${1}" etcd_dir="${2}"
  local node_name="${3}" peer_url="${4}"
  if [[ -e "${etcd_dir}" ]] && [[ -n "$(ls -A "${etcd_dir}" 2>/dev/null)" ]]; then
    error "handover: ${etcd_dir} is not empty — refusing to restore over existing etcd data"
    return 1
  fi
  [[ ! -d "${etcd_dir}" ]] || rmdir "${etcd_dir}" 2>/dev/null || true
  # --skip-hash-check: KKP's etcd-backup jobs STREAM the snapshot off a live
  # member, and streamed snapshots carry no sha256 trailer — the check can
  # only ever fail on a handover bundle (KKP's own EtcdRestore controller
  # skips it for the same reason). Integrity still holds end to end: the
  # snapshot rides the platform's authenticated channels, and a corrupt
  # restore fails loudly at etcd startup.
  if command -v etcdutl >/dev/null 2>&1; then
    etcdutl snapshot restore "${snapshot}" --data-dir "${etcd_dir}" --skip-hash-check=true \
      --name "${node_name}" \
      --initial-cluster "${node_name}=${peer_url}" \
      --initial-advertise-peer-urls "${peer_url}" || return 1
  elif command -v etcdctl >/dev/null 2>&1; then
    ETCDCTL_API=3 etcdctl snapshot restore "${snapshot}" --data-dir "${etcd_dir}" --skip-hash-check=true \
      --name "${node_name}" \
      --initial-cluster "${node_name}=${peer_url}" \
      --initial-advertise-peer-urls "${peer_url}" || return 1
  else
    error "handover: neither etcdutl nor etcdctl found on this node — install the etcd client tooling and re-run"
    return 1
  fi
}

# handover::bundle_value <bundle> <key> <default> — read an OPTIONAL bundle file.
# Missing or blank falls back to <default>. Trailing newlines are stripped: the
# operator writes these as Secret values and a stray newline would end up inside
# a YAML scalar or an image tag.
handover::bundle_value() {
  local bundle="${1}" key="${2}" default="${3}" value
  # printf, not echo: a value of exactly `-n`/`-e`/`-neE` would be eaten as an
  # echo flag, return empty, and fall back to the default IN SILENCE — which for
  # etcd-version means quietly reverting to the platform tag the warn above
  # exists to make loud.
  [[ -f "${bundle}/${key}" ]] || { printf '%s\n' "${default}"; return 0; }
  value="$(<"${bundle}/${key}")"
  # Trim SURROUNDING whitespace only. The operator writes these as Secret values
  # and a trailing newline would land inside a YAML scalar or an image tag.
  # Internal whitespace is left intact deliberately: stripping it could turn a
  # wrong value into a plausible one, whereas the per-value guards (the provider
  # allowlist, the key-name and image-tag grammars) reject it loudly.
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  [[ -n "${value}" ]] || { printf '%s\n' "${default}"; return 0; }
  printf '%s\n' "${value}"
}

# Write the EncryptionConfiguration the restored apiserver needs: the bundle's
# encryption-key is the SAME key the source cluster encrypted its Secrets at
# rest with — without it the restored apiserver cannot decrypt them. 0600:
# the file embeds key material. Outputs the file path.
# handover::encryption_metadata <bundle> — resolve and VALIDATE the two
# EncryptionConfiguration values, echoing "<provider> <key-name>".
#
# Shared by the pre-flight block and write_encryption_config so a tampered
# bundle is refused BEFORE the node is touched. Rejecting inside the writer
# alone happens after place_pki and restore_snapshot have run, stranding seeded
# PKI and a restored member dir behind the non-empty guard — exactly what the
# fail-early contract in receive exists to avoid. The writer keeps calling it so
# it stays safe for direct callers.
# handover::encryption_key <bundle> — read and VALIDATE the base64 key, echoing
# it. Shared by the pre-flight block and write_encryption_config for the same
# reason as encryption_metadata: the key lands inside YAML this renders, and
# rejecting it from the writer alone happens after the node is already seeded.
handover::encryption_key() {
  local bundle="${1}" key
  key="$(<"${bundle}/encryption-key")"
  # Trim EDGES only — interior whitespace must fail the charset gate rather than
  # be silently welded together.
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key%"${key##*[![:space:]]}"}"
  [[ "${key}" =~ ^[A-Za-z0-9+/=]+$ ]] || {
    error "handover: bundle encryption-key is not base64 — refusing to render the EncryptionConfiguration"
    return 1
  }
  printf '%s\n' "${key}"
}

handover::encryption_metadata() {
  local bundle="${1}" provider key_name
  provider="$(handover::bundle_value "${bundle}" encryption-provider secretbox)"
  key_name="$(handover::bundle_value "${bundle}" encryption-key-name kubehz-key-1)"
  # Allowlist: these are the apiserver's symmetric-key providers, and each takes
  # the same `keys: [{name, secret}]` shape write_encryption_config renders.
  # `kms` is a different structure entirely and cannot be substituted there.
  case "${provider}" in
    secretbox | aescbc | aesgcm) ;;
    *)
      error "handover: bundle encryption-provider '${provider:0:64}' is not one of secretbox/aescbc/aesgcm"
      return 1
      ;;
  esac
  # The name lands in YAML we generate; keep it to the charset Kubernetes accepts
  # for a provider key name so a tampered bundle cannot inject config.
  [[ "${key_name}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$ ]] || {
    error "handover: bundle encryption-key-name '${key_name:0:64}' is not a plain name"
    return 1
  }
  echo "${provider} ${key_name}"
}

handover::write_encryption_config() {
  local bundle="${1}" k8s_dir="${2}"
  local out="${k8s_dir}/kubehz-encryption-config.yaml" key provider key_name meta
  key="$(handover::encryption_key "${bundle}")" || return 1
  meta="$(handover::encryption_metadata "${bundle}")" || return 1
  read -r provider key_name <<<"${meta}"
  mkdir -p "${k8s_dir}" || return 1
  # PROVIDER + KEY NAME must match what the SOURCE cluster encrypted with — the
  # stored values carry the "k8s:enc:<provider>:v1:<keyname>:" prefix and the
  # apiserver refuses anything else ("no matching prefix found" — proven on a
  # real target: a healthy apiserver booted but could not read a single
  # Secret). They come from the bundle so the target mirrors whatever the source
  # actually used; the defaults are the platform's own (kubehz-core
  # etcd_encryption.go etcdEncryptionKeyName) for bundles exported before the
  # operator carried them.
  cat > "${out}" <<EOF
apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
  - resources:
      - secrets
    providers:
      - ${provider}:
          keys:
            - name: ${key_name}
              secret: ${key}
      - identity: {}
EOF
  chmod 600 "${out}"
  echo "${out}"
}

# Render the kubeadm ClusterConfiguration (v1beta4 — kubeadm >= v1.31): the
# exported endpoint DNS stays the apiserver endpoint ("keep" strategy repoints
# DNS at this node, so the serving cert must cover it) and the apiserver
# mounts the secrets-at-rest encryption config.
# etcd VERSION PIN ($4): the restored data comes from the platform's etcd
# line (KKP CE 2.30 ships 3.5.21); kubeadm's default etcd is often a major
# ahead (3.6.x), and etcd 3.6 PANICS applying the snapshot's member-attribute
# entries (RaftCluster.UpdateAttributes on a 3.5-origin restore — proven on a
# real target). Boot the SOURCE line first; upgrading etcd
# afterwards is the standard in-place path. The caller validates the tag
# (fail-before-touching-the-node contract).
handover::write_kubeadm_config() {
  local bundle="${1}" k8s_dir="${2}" out="${3}"
  local enc="${k8s_dir}/kubehz-encryption-config.yaml" dns
  # ONE validated reader (handover::endpoint_dns) — dns is interpolated into
  # generated YAML and passed to kubectl, so the charset gate lives there.
  dns="$(handover::endpoint_dns "${bundle}")" || return 1
  local etcd_tag="${4}"
  cat > "${out}" <<EOF
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "${dns}:6443"
etcd:
  local:
    imageTag: "${etcd_tag}"
apiServer:
  certSANs:
    - "${dns}"
  extraArgs:
    - name: encryption-provider-config
      value: ${enc}
  extraVolumes:
    - name: kubehz-encryption-config
      hostPath: ${enc}
      mountPath: ${enc}
      readOnly: true
      pathType: File
EOF
}

# The init itself: /var/lib/etcd is pre-populated by the restore, which
# kubeadm's preflight would otherwise refuse — exactly the documented
# DirAvailable ignore from the contract.
handover::kubeadm_init() {
  local config="${1}"
  # --skip-phases addons: the restored state ALREADY carries the source
  # cluster's DNS and proxy configuration — kubeadm's stock addon templates
  # conflict with it instead of adopting it (proven on a real target: init
  # died at the last step on the restored CoreDNS Deployment's immutable
  # selector). Overwriting restored addons with kubeadm defaults is also
  # semantically wrong for a handover.
  kubeadm init --config "${config}" \
    --ignore-preflight-errors=DirAvailable--var-lib-etcd \
    --skip-phases=addon/coredns,addon/kube-proxy
}

# The bundle's endpoint DNS (also the apiserver cert's SAN) — used as the
# TLS server name when probing the apiserver on its local address.
handover::endpoint_dns() {
  local bundle="${1}" dns
  # Trim EDGES only (a trailing newline is normal); interior whitespace must
  # still fail the charset gate rather than be silently welded together.
  dns="$(< "${bundle}/endpoint-dns")"
  dns="${dns#"${dns%%[![:space:]]*}"}"
  dns="${dns%"${dns##*[![:space:]]}"}"
  # Same charset gate the kubeadm-config renderer applies — this value also
  # reaches kubectl as --tls-server-name, so a tampered bundle gets one
  # validated reader, not two.
  [[ "${dns}" =~ ^[a-zA-Z0-9.-]+$ ]] || {
    error "handover: bundle endpoint-dns '${dns}' is not a plain hostname"
    return 1
  }
  printf '%s' "${dns}"
}

# Post-init verification: the apiserver answers WITH the restored data, and
# the live CA is byte-identical to the bundle's — identity preserved, the
# whole point of the seeded restore. Never cut DNS over before this passes.
handover::verify() {
  local bundle="${1}" k8s_dir="${2}"
  local kubeconfig="${k8s_dir}/admin.conf"
  local waited=0 timeout="${KUBEHZ_HANDOVER_WAIT:-300}"
  # --server: admin.conf points at the cluster's ENDPOINT DNS, which still
  # resolves to the PLATFORM until the operator cuts over (that is the whole
  # point of the human gate). Verifying through it would either time out or —
  # worse — silently probe the old control plane. Talk to the local apiserver
  # and rely on the config's CA/credentials (the endpoint name stays in the
  # cert SANs, so we set --tls-server-name EXPLICITLY: --server alone blanks
  # the server name and the cert would be checked against 127.0.0.1).
  local local_api="https://127.0.0.1:6443" server_name
  server_name="$(handover::endpoint_dns "${bundle}")" || return 1
  until kubectl --kubeconfig "${kubeconfig}" --server "${local_api}" \
    --tls-server-name "${server_name}" \
    get ns kube-system >/dev/null 2>&1; do
    (( waited < timeout )) || {
      error "handover: the apiserver did not become ready within ${timeout}s (kubectl --kubeconfig ${kubeconfig} --server ${local_api} --tls-server-name ${server_name} get ns kube-system kept failing) — state left behind: ${k8s_dir}/pki holds the bundle PKI and the restored etcd data dir may be corrupt (a truncated snapshot restores 'successfully' under --skip-hash-check and only fails here). Clean up ('kubeadm reset') before retrying."
      return 1
    }
    sleep 5
    waited=$(( waited + 5 ))
  done

  local want got
  want=$(sha256sum "${bundle}/ca.crt" | cut -d' ' -f1)
  got=$(sha256sum "${k8s_dir}/pki/ca.crt" | cut -d' ' -f1)
  if [[ "${want}" != "${got}" ]]; then
    error "handover: CA hash mismatch after kubeadm init — ${k8s_dir}/pki/ca.crt is NOT the bundle's CA (identity was not preserved; do NOT cut over)"
    return 1
  fi
  echo "handover: verified — apiserver is up and the cluster CA matches the export bundle (sha256 ${got})"
}

# ── Subcommands ──────────────────────────────────────────

# `lo kubehz handover receive` — RUNS ON THE TARGET NODE (it writes
# /etc/kubernetes and /var/lib/etcd and calls kubeadm). Refuses a node that
# already carries Kubernetes state unless --force (and even then: run
# `kubeadm reset` yourself first on a previously-used node).
handover::receive() {
  # force: honor the INHERITED field when the dispatch chain already consumed
  # --force from argv (the #103 infra-gate made force inherited; a plain
  # `local force=0` here shadowed that dynamic-scope value and the flag never
  # reached the guards below).
  local bundle="" snapshot="" single_node=0 force="${force:-0}"
  local -a args=(
    'bundle|b:!'      'Export bundle: a directory or .tar.gz with the contract keys'
    'snapshot|s'      'Pre-downloaded etcd snapshot file (skips the snapshot-location fetch)'
    'single-node|:+'  'Untaint the control-plane node after init (single-node target)'
    'force|f:^:+'     'Proceed even when target dirs are not empty (DESTROYS existing etcd data)'
    "${args[@]:-}"
  )
  :args "Restore an exported control plane onto THIS node" "${@}"

  local k8s_dir="${KUBEHZ_HANDOVER_K8S_DIR:-/etc/kubernetes}"
  local etcd_dir="${KUBEHZ_HANDOVER_ETCD_DIR:-/var/lib/etcd}"

  # Private scratch (0700) for the bundle extraction + a downloaded snapshot —
  # PKI, the encryption key and the etcd snapshot must not linger on disk.
  # Scrubbed on EVERY exit path; a user-provided --bundle dir or --snapshot
  # file lives outside it and is never touched. Expand NOW (locals are out of
  # scope when the trap fires — the libs/build idiom); a re-fire on a caller
  # return is a harmless idempotent rm.
  local workdir
  workdir=$(mktemp -d) || return 1
  chmod 700 "${workdir}"
  # shellcheck disable=SC2064
  trap "rm -rf '${workdir}'" RETURN

  local bundle_dir
  bundle_dir=$(handover::resolve_bundle "${bundle}" "${workdir}") || return 1
  handover::validate_bundle "${bundle_dir}" || return 1

  # "not empty" means REAL content: kubeadm's packages pre-create empty
  # skeleton dirs (manifests/, pki/) on every stock image, and `kubeadm
  # reset` leaves them behind too — refusing on those makes the documented
  # remedy unsatisfiable. Only files (or non-empty subtrees) block.
  local k8s_real="" k8s_find_rc=0
  if [[ -d "${k8s_dir}" ]]; then
    # ANY non-directory entry is content (files, symlinks, sockets, FIFOs) —
    # and a traversal error fails CLOSED: guessing "empty" before a
    # destructive receive is the one wrong direction.
    k8s_real="$(find "${k8s_dir}" ! -type d -print -quit 2>/dev/null)" || k8s_find_rc=$?
    if (( k8s_find_rc )) && [[ -z "${k8s_real}" ]] && ! (( force )); then
      error "handover: cannot inspect ${k8s_dir} (find exit ${k8s_find_rc}) — refusing to assume it is empty; fix permissions or re-run with --force."
      return 1
    fi
  fi
  if [[ -n "${k8s_real}" ]] && ! (( force )); then
    error "handover: ${k8s_dir} holds existing content (${k8s_real}) — either this node already runs (or ran) Kubernetes, or a previous receive attempt left its seeded state behind. Clean up first ('kubeadm reset' clears the seeded PKI and etcd data), then re-run — with --force if you really mean to overwrite what remains."
    return 1
  fi
  if [[ -d "${etcd_dir}" ]] && [[ -n "$(ls -A "${etcd_dir}" 2>/dev/null)" ]]; then
    if (( force )); then
      rm -rf "${etcd_dir}"
    else
      error "handover: ${etcd_dir} is not empty — refusing to restore over existing etcd data (re-run with --force to overwrite)."
      return 1
    fi
  fi

  # Fail before touching the node: resolve the snapshot AND the member
  # identity first (an identity failure after place_pki would strand seeded
  # PKI behind the non-empty guard).
  local snapshot_file member_identity node_name peer_url
  snapshot_file=$(handover::fetch_snapshot "${bundle_dir}" "${snapshot}" "${workdir}") || return 1
  member_identity="$(handover::member_identity)" || return 1
  read -r node_name peer_url <<<"${member_identity}"
  # Validate the etcd pin here too — a bad override must not strand seeded PKI.
  # Precedence: explicit env override > the bundle's own etcd line > the
  # platform default. The bundle value is what the SOURCE ran, which is what the
  # snapshot has to be replayed by — etcd 3.6 PANICS on a 3.5-origin restore.
  local etcd_tag="${KUBEHZ_HANDOVER_ETCD_IMAGE_TAG:-}" bundle_tag
  bundle_tag="$(handover::bundle_value "${bundle_dir}" etcd-version "")"
  if [[ -z "${etcd_tag}" ]]; then
    etcd_tag="${bundle_tag:-3.5.21-0}"
  elif [[ -n "${bundle_tag}" && "${bundle_tag}" != "${etcd_tag}" ]]; then
    # A stale override silently defeating the value the source exported is worth
    # saying out loud — it is the etcd-3.6-panics-on-a-3.5-snapshot trap.
    warn "handover: KUBEHZ_HANDOVER_ETCD_IMAGE_TAG '${etcd_tag}' overrides the bundle's etcd-version '${bundle_tag}'"
  fi
  # Docker tag grammar: alnum/underscore first char, then [alnum._-], ≤128.
  [[ "${etcd_tag}" =~ ^[a-zA-Z0-9_][a-zA-Z0-9._-]{0,127}$ ]] || {
    error "handover: etcd image tag '${etcd_tag:0:64}' is not a plain image tag — refusing before touching the node"
    return 1
  }

  # EVERY bundle-derived value is validated here, before the node is touched.
  # A rejection from inside write_encryption_config or write_kubeadm_config lands
  # after place_pki and restore_snapshot have run, stranding seeded PKI and a
  # restored member dir behind the non-empty guard — a `kubeadm reset` and a
  # --force re-run for what is only a malformed bundle. The individual writers
  # keep their own checks so they stay safe for direct callers.
  handover::encryption_metadata "${bundle_dir}" >/dev/null || return 1
  handover::encryption_key "${bundle_dir}" >/dev/null || return 1
  local endpoint_dns
  endpoint_dns="$(handover::endpoint_dns "${bundle_dir}")" || return 1

  handover::place_pki "${bundle_dir}" "${k8s_dir}" || return 1
  handover::restore_snapshot "${snapshot_file}" "${etcd_dir}" "${node_name}" "${peer_url}" || return 1
  handover::write_encryption_config "${bundle_dir}" "${k8s_dir}" >/dev/null || return 1
  local kubeadm_config="${k8s_dir}/kubehz-handover-kubeadm.yaml"
  handover::write_kubeadm_config "${bundle_dir}" "${k8s_dir}" "${kubeadm_config}" "${etcd_tag}" || return 1
  handover::kubeadm_init "${kubeadm_config}" || {
    error "handover: kubeadm init FAILED after the node was seeded — state left behind: ${k8s_dir}/pki holds the bundle PKI and ${etcd_dir} holds the restored snapshot. Clean up first ('kubeadm reset' removes both, or delete ${k8s_dir} and ${etcd_dir} yourself), then re-run receive with --force."
    return 1
  }
  handover::verify "${bundle_dir}" "${k8s_dir}" || return 1

  if (( single_node )); then
    # Pinned to the LOCAL apiserver for the same reason verify is: admin.conf's
    # endpoint DNS still resolves to the PLATFORM until cutover, and its CA is
    # the same identity — an unpinned call could untaint the WRONG cluster's
    # nodes and report success.
    kubectl --kubeconfig "${k8s_dir}/admin.conf" \
      --server "https://127.0.0.1:6443" --tls-server-name "${endpoint_dns}" \
      taint nodes --all node-role.kubernetes.io/control-plane- >/dev/null 2>&1 \
      || warn "handover: could not untaint the control-plane node — run: kubectl --server https://127.0.0.1:6443 --tls-server-name ${endpoint_dns} taint nodes --all node-role.kubernetes.io/control-plane-"
  fi

  echo "handover: receive complete. Next steps:"
  echo "  1. point the endpoint DNS (${endpoint_dns}) at this node"
  echo "  2. ack the cutover in the kubehz dashboard (the platform waits for a target-side heartbeat)"
  echo "  3. join workers / additional control planes as needed"
}

# `lo kubehz handover preseed` — kubeone-driver variant, deliberately THIN:
# place the six PKI files on node0 over SSH before `kubeone apply`
# (lo provision) runs; kubeadm reuses existing CA files by design, so the
# provisioned cluster keeps the exported identity. No snapshot, no init here.
handover::preseed() {
  local bundle="" node="" user="root" port=22 ssh_key=""
  local -a args=(
    'bundle|b:!'    'Export bundle: a directory or .tar.gz with the contract keys'
    'node|n:!'      'Target node address (kubeone node0) to place the PKI on'
    'user|u'        'SSH user'
    'port|p:~int'   'SSH port'
    'ssh-key|i'     'SSH private key file'
    "${args[@]:-}"
  )
  :args "Pre-seed exported PKI onto a kubeone node before kubeone apply" "${@}"

  # Same scratch + cleanup contract as receive: an extracted .tar.gz bundle
  # (PKI + encryption key on disk) is scrubbed on every exit path. Expand NOW
  # (libs/build idiom); a trap re-fire is a harmless idempotent rm.
  local workdir
  workdir=$(mktemp -d) || return 1
  chmod 700 "${workdir}"
  # shellcheck disable=SC2064
  trap "rm -rf '${workdir}'" RETURN

  local bundle_dir
  bundle_dir=$(handover::resolve_bundle "${bundle}" "${workdir}") || return 1
  handover::validate_bundle "${bundle_dir}" || return 1

  # Same non-interactive SSH posture as the kubeone driver's node probes.
  local -a ssh_opts=(
    -o IdentitiesOnly=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
    -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=10
  )
  [[ -z "${ssh_key}" ]] || ssh_opts+=(-i "${ssh_key}")

  # umask 077 → the pki dir is 0700 from the start: even a file that lands
  # loose is unreachable while the transfer is in flight.
  ssh "${ssh_opts[@]}" -p "${port}" "${user}@${node}" \
    'umask 077 && mkdir -p /etc/kubernetes/pki' || {
    error "handover: cannot reach ${user}@${node} over SSH"
    return 1
  }

  # Per-file transfer with an IMMEDIATE per-key chmod (never one chmod at the
  # very end): private keys are 0600 even when a later copy dies mid-transfer.
  local key
  for key in "${KUBEHZ_HANDOVER_PKI_KEYS[@]}"; do
    scp "${ssh_opts[@]}" -P "${port}" "${bundle_dir}/${key}" \
      "${user}@${node}:/etc/kubernetes/pki/${key}" || {
      error "handover: copying ${key} to ${node} failed"
      return 1
    }
    case "${key}" in
      *.key)
        ssh "${ssh_opts[@]}" -p "${port}" "${user}@${node}" \
          "chmod 600 /etc/kubernetes/pki/${key}" || {
          error "handover: could not chmod 600 /etc/kubernetes/pki/${key} on ${node} — key material must not stay readable; fix the mode and re-run"
          return 1
        }
        ;;
    esac
  done

  echo "handover: PKI pre-seeded on ${node}. Provision now (lo provision) — kubeone's kubeadm reuses the existing CA files, preserving cluster identity."
}
