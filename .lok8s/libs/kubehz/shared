#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-shared — Spaces on the kubehz shared control plane (hosting: shared)
#
# A Space is one tenant's slice of a platform-operated control plane: the
# platform runs and secures the control plane, you bring the machines that run
# your workloads. `lo provision` creates (or adopts) the Space and mints
# single-node join tickets; `lo destroy` deregisters it. Access to your
# namespaces is through your kubehz login (OIDC) — there is no admin
# kubeconfig to download, by design.
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.

import ^utils/verbose
import ^utils/http
# node::assert_node_name (the join ticket's node name). node imports this
# lib too; argsh imports a file once, so the cycle is harmless.
import ^libs/kubehz/node

# ── Config reader ────────────────────────────────────────

# The three numbers a space is made of: the node ceiling, the namespace
# ceiling and the object cap (the size limit for one Secret or ConfigMap in
# the space's namespaces), under spec.kubehz.space.limits.
#
# lo does NOT carry the platform's policy. What an account may ask for differs
# per account, and extra resources are bought, so the platform is the only
# place that knows the ceiling. This CLI checks the SHAPE of a value (a whole
# number, 1 or more) and sends what the spec says; a value above the account's
# ceiling is the api's refusal to make, and the api's message carries the
# account's real numbers. A field the spec leaves out is not sent at all, so
# the api applies its own default.
LOK8S_SPACE_NUMBER_MIN=1

# Read one of the three numbers. A missing or null value prints NOTHING: the
# field is left out of the request and the api applies its own default.
# spec.kubehz.space.nodes is the machine-name list, so a list under
# limits.nodes is the two fields confused: name both.
# Usage: kubehz::space_number <cluster_yaml> <field>
# Outputs: the number to stdout, or nothing when the spec names none
kubehz::space_number() {
  local cluster_yaml="${1}" field="${2}"
  local type value
  type=$(yq -r ".spec.kubehz.space.limits.${field} | type" "${cluster_yaml}" 2>/dev/null) || type=""
  # Only a list and a map hold no single value to quote back. Every other
  # type is a scalar, so it falls through to the read below and the refusal
  # names what the spec says (2.5, true, two). The Go twin does the same.
  case "${type}" in
    ''|null|'!!null')
      return 0 ;;
    '!!seq')
      if [[ "${field}" == "nodes" ]]; then
        error "spec.kubehz.space.limits.nodes is a list: it is the node ceiling"
        echo "  Set spec.kubehz.space.limits.nodes to a whole number of 1 or more." >&2
        echo "  The machine names stay under spec.kubehz.space.nodes." >&2
      else
        error "invalid spec.kubehz.space.limits.${field}: expected a whole number of 1 or more"
      fi
      return 1 ;;
    '!!map')
      error "invalid spec.kubehz.space.limits.${field}: expected a whole number of 1 or more"
      return 1 ;;
  esac
  value=$(yq -r ".spec.kubehz.space.limits.${field}" "${cluster_yaml}") || return 1
  # No upper bound on the CEILING: a number the account may not have is the
  # api's refusal to make. The bound below is on the NUMBER ITSELF, and it is
  # the Go twin's strconv range, so both trees accept the same set.
  local number
  if ! [[ "${value}" =~ ^[0-9]+$ ]] || ! number=$(kubehz::space_number_value "${value}"); then
    error "invalid spec.kubehz.space.limits.${field}: ${value} (expected a whole number of 1 or more)"
    return 1
  fi
  echo "${number}"
}

# Turn a digits-only string into the number the Go twin parses, or fail.
# Leading zeros are dropped, so "008" is eight and never octal, and the value
# is printed the way the Go twin prints it. Fails on zero and on anything
# outside the int64 range strconv parses.
#
# The comparisons avoid (( )) on the value on purpose: bash arithmetic reads a
# leading zero as octal ("008" prints `value too great for base`) and wraps
# silently past int64, so both would disagree with the Go twin.
# Usage: kubehz::space_number_value <digits>
# Outputs: the number to stdout
kubehz::space_number_value() {
  local digits
  [[ "${1}" =~ ^0*([0-9]+)$ ]] || return 1
  digits="${BASH_REMATCH[1]}"
  [[ "${digits}" != "0" ]] || return 1
  # Same length makes a string compare a numeric one.
  if (( ${#digits} > 19 )); then
    return 1
  fi
  # A STRING comparison on purpose: both sides are 19 digits here, so it is
  # the numeric one, and it cannot overflow the way (( )) would.
  # shellcheck disable=SC2071
  if (( ${#digits} == 19 )) && [[ "${digits}" > "9223372036854775807" ]]; then
    return 1
  fi
  echo "${digits}"
}

# Read the three numbers of a space. Only the SHAPE is checked here: a whole
# number, 1 or more. There is no upper bound, because the ceiling belongs to
# the account and lives on the platform. A field the spec leaves out stays
# EMPTY and is not sent.
# Usage: kubehz::space_limits <cluster_yaml>
# Sets: LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
kubehz::space_limits() {
  local cluster_yaml="${1}"
  local plan_type
  # Space plans are retired. A spec that still carries one asks for a shape
  # the platform no longer has, so say so instead of ignoring it. The test is
  # the TYPE, not `// ""`: yq's `//` reads `plan: false` and `plan: ""` as
  # absent and would let those specs through unrefused. Any type that is not
  # null is a plan. The read keeps `|| return 1`, so a parse failure still
  # stops here instead of reading as "no plan".
  plan_type=$(yq -r '.spec.kubehz.space.plan | type' "${cluster_yaml}") || return 1
  if [[ "${plan_type}" != "!!null" && "${plan_type}" != "null" && -n "${plan_type}" ]]; then
    error "spec.kubehz.space.plan is not valid: space plans are retired"
    echo "  Set spec.kubehz.space.limits.nodes, spec.kubehz.space.limits.namespaces" >&2
    echo "  and spec.kubehz.space.limits.objectCapKiB instead." >&2
    return 1
  fi
  LOK8S_SPACE_MAX_NODES=$(kubehz::space_number "${cluster_yaml}" nodes) || return 1
  LOK8S_SPACE_MAX_NAMESPACES=$(kubehz::space_number "${cluster_yaml}" namespaces) || return 1
  LOK8S_SPACE_MAX_OBJECT_KIB=$(kubehz::space_number "${cluster_yaml}" objectCapKiB) || return 1
  export LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
}

# Read spec.kubehz.space from a cluster.lok8s.yaml. Everything is optional:
# the slug defaults to the first DNS label of the domain and the display name
# to the slug. A limit the spec leaves out stays empty and is not sent, so the
# api applies its own default. Node names listed under
# spec.kubehz.space.nodes[] get a join ticket minted at provision time.
# Usage: kubehz::space_config <domain> <cluster_yaml>
# Sets: LOK8S_SPACE_SLUG LOK8S_SPACE_NAME LOK8S_SPACE_REGION
#       LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
#       LOK8S_SPACE_NODES (array)
kubehz::space_config() {
  local domain="${1}" cluster_yaml="${2}"
  local default_slug="${domain%%.*}"

  # || return on every read: errexit is off on the provision path, and a
  # yq PARSE failure is not "no slug configured" — falling back to the
  # default here would let destroy_shared target the WRONG space.
  LOK8S_SPACE_SLUG=$(yq -r '.spec.kubehz.space.slug // ""' "${cluster_yaml}") || return 1
  [[ -n "${LOK8S_SPACE_SLUG}" ]] || LOK8S_SPACE_SLUG="${default_slug}"
  LOK8S_SPACE_NAME=$(yq -r '.spec.kubehz.space.name // ""' "${cluster_yaml}") || return 1
  [[ -n "${LOK8S_SPACE_NAME}" ]] || LOK8S_SPACE_NAME="${LOK8S_SPACE_SLUG}"
  LOK8S_SPACE_REGION=$(yq -r '.spec.kubehz.space.region // ""' "${cluster_yaml}") || return 1
  kubehz::space_limits "${cluster_yaml}" || return 1

  LOK8S_SPACE_NODES=()
  local node
  while IFS= read -r node; do
    [[ -n "${node}" && "${node}" != "null" ]] && LOK8S_SPACE_NODES+=("${node}")
  done < <(yq -r '.spec.kubehz.space.nodes[]?' "${cluster_yaml}" 2>/dev/null)

  export LOK8S_SPACE_SLUG LOK8S_SPACE_NAME LOK8S_SPACE_REGION
}

# ── API plumbing ─────────────────────────────────────────

# One call against the kubehz API with the envelope contract handled. The
# result travels in GLOBALS, never on stdout: a `$(...)` capture would run
# this in a subshell and the status/body the error paths need would die with
# it (the classic bash scope trap — the first version had exactly that bug
# and the unit suite caught it).
#   rc 0  → 2xx; body in KUBEHZ_SPACE_API_BODY
#   rc 2  → non-2xx; status + body in the globals for caller branching
#   rc 1  → transport failure (already rendered)
# Usage: kubehz::space_api <method> <path> [json_body] [mark-nul]
kubehz::space_api() {
  local rc=0
  kubehz::space_api_call "$@" || rc=$?
  # A curl failure, not the token check (that one says so itself).
  if (( rc == 1 )) && [[ -n "${KUBEHZ_SPACE_API_CURL_RC}" ]]; then
    error "kubehz API unreachable (${1} ${2})"
  fi
  return "${rc}"
}

# The bound of curl --max-time for the mint of a node join
# (kubehz::space_api_call mark-nul), in seconds: mintMaxTime of the Go
# twin. A function, so that a test can make it short.
kubehz::space_api_mint_max_time() { echo 150; }

# kubehz::space_api without the "unreachable" line: a caller that must tell
# a failure before the send from one after it (node::maintain) reads the
# curl exit code in KUBEHZ_SPACE_API_CURL_RC (empty when curl did not run or
# did not fail) and renders the failure itself. It is also 1 when a
# readonly name stopped http::tls_log_vars_unset before curl ran (the status
# of unset). curl's own 1 also means that it sent nothing, so
# node::curl_sent_nothing reads both correctly.
# With mark-nul, a NUL byte of the response becomes U+0001 before the
# capture: $(...) drops a NUL, and a body with a NUL could then pass as
# JSON. U+0001 is a control byte that jq refuses in JSON, as the Go twin
# refuses the NUL (parseJSON). The node join uses it; the other callers do
# not (the Go twin writes the body of a Space kubeconfig as it is).
# With mark-nul, curl also ends within --connect-timeout 30 and --max-time
# (kubehz::space_api_mint_max_time).
# Usage: kubehz::space_api_call <method> <path> [json_body] [mark-nul]
kubehz::space_api_call() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *[xa]* ]] || { local -; set +xa; }  # the bearer and the response (a join ticket)
  # +x: a local takes the export flag of an exported variable of the same
  # name, and a child would get the request body or the response (raw: no
  # child runs after its assignment today, but a later edit could add one).
  # +i: under shopt localvar_inherit (BASHOPTS in the environment can turn
  # it on), a local takes the attributes of a variable of the same name in
  # a caller scope, and an integer one (declare -i) would print the value
  # in an arithmetic error. A readonly name (also a readonly nameref) makes
  # the local fail, and an assignment would then go into the variable the
  # nameref names: the function stops before it reads a secret.
  local method="${1}" path="${2}"
  # Before the first refusal: a caller (node::maintain) must not read the
  # status, the curl code or the response of an earlier call (a response
  # can hold a join ticket). The response global is checked below.
  KUBEHZ_SPACE_API_STATUS=""
  KUBEHZ_SPACE_API_CURL_RC=""
  KUBEHZ_SPACE_API_BODY=""
  local +x +i body raw || { error "kubehz::space_api_call: a local cannot be declared (a readonly name or a nameref of the caller)"; return 1; }
  body="${3:-}"
  local nul="${4:-}"
  # A response can hold a join ticket: the global never goes to a child
  # (set -a, or an export before), and the caller unsets it.
  declare -g +x +i KUBEHZ_SPACE_API_BODY
  KUBEHZ_SPACE_API_BODY=""
  # The name the response goes to must now be a plain, empty string. declare
  # -g follows a nameref (a readonly one too), and the response would go
  # into the variable it names. A local of a caller with this name gets the
  # response instead of the global: as an integer or an export it would
  # print the response in an arithmetic error or give it to a child.
  [[ "$(declare -p KUBEHZ_SPACE_API_BODY 2>/dev/null)" == 'declare -- KUBEHZ_SPACE_API_BODY=""' ]] || {
    error "kubehz::space_api_call: KUBEHZ_SPACE_API_BODY is not a plain variable (a nameref, an integer or an export of the caller)"
    return 1
  }
  http::credential_ok KUBEHZ_TOKEN || return 1

  local -a extra=() bounds=()
  [[ -n "${body}" ]] && extra=(-H "Content-Type: application/json" -d "${body}")
  # mark-nul (the mint of a node join): curl ends within its bounds, as the
  # Go twin does (mintMaxTime, and its dialer gives up a connect after 30
  # seconds). The traps of the join are in place during the mint, and bash
  # runs a trap only after the command substitution ended: a signal sent
  # to lo alone waits for curl, and a second one does not cut that short.
  # The bound ends that wait. A Ctrl-C signals the process group: curl
  # gets it too and stops at once.
  [[ "${nul}" != mark-nul ]] || bounds=(--connect-timeout 30 --max-time "$(kubehz::space_api_mint_max_time)")

  # The bearer reaches curl in a config on stdin, never on argv. -q first:
  # curl then reads no config file of the user (.curlrc in CURL_HOME or
  # HOME, curlrc in XDG_CONFIG_HOME). A trace-ascii line there would log the
  # bearer and the answer, an output line would write the answer to another
  # file. curl obeys -q only as its first argument. In the subshell,
  # http::tls_log_vars_unset clears the TLS log and trace controls for curl
  # only: SSLKEYLOGFILE, GNUTLS_KEYLOGFILE, GNUTLS_DEBUG_LEVEL, SSLTRACE,
  # SSLDEBUG and SSLDEBUGFILE (a key log, GnuTLS debug output with key
  # material, an NSS trace with plaintext; the reasons are in
  # utils/http.sh). Each could give away the bearer or the answer. A
  # readonly name in the list stops the call before curl runs:
  # KUBEHZ_SPACE_API_CURL_RC then holds the status of unset (1), not a
  # status of curl. With mark-nul, tr maps the NUL after curl; the other
  # calls pass the answer through cat. The status is the one of the
  # subshell (curl, or 1 from the unset), with or without pipefail: the
  # writer of the config and the filter do not count.
  raw=$(http::curl_config header "Authorization: Bearer ${KUBEHZ_TOKEN:-}" | (
    http::tls_log_vars_unset &&
      curl -q -K - "${bounds[@]}" -sSL -w $'\n%{http_code}' -X "${method}" \
        "${LOK8S_KUBEHZ_API_URL}${path}" \
        "${extra[@]}"
  ) | if [[ "${nul}" == mark-nul ]]; then tr '\000' '\001'; else cat; fi
    exit "${PIPESTATUS[1]}") || {
    KUBEHZ_SPACE_API_CURL_RC=$?
    return 1
  }
  KUBEHZ_SPACE_API_STATUS="${raw##*$'\n'}"
  KUBEHZ_SPACE_API_BODY="${raw%$'\n'*}"

  [[ "${KUBEHZ_SPACE_API_STATUS}" == 2* ]] || return 2
}

# A jq def: a SERVER string without each code point of unshown
# (VERBOSE_JQ_UNSHOWN, utils/verbose.sh), except tab and newline: a status
# reason or a block of TSV rows can hold them. A compromised api could
# otherwise hide an ESC, a C1 CSI (U+009B), a bidi override or a line
# separator in a message and redraw or reorder the caller's terminal (worst
# under --print-only, where the printed output is read as truth). jq works
# on code points in any locale; tr -d works on bytes. The Go twin is scrub
# (internal/kubehz). Values that become argv do not come here: the join-line
# alphabet gate guards that side; this one is for display only.
KUBEHZ_SCRUB_JQ="${VERBOSE_JQ_UNSHOWN}"'def scrub: explode | map(select((unshown and . != 9 and . != 10) | not))
  | implode;'

# The string without the characters that the def scrub drops. The input goes
# to jq on stdin (no argv size limit). jq makes one U+FFFD of each sequence
# that is not UTF-8, where Go makes one per byte; the callers pass jq -r
# output, which is UTF-8 already. Each caller reads it with $(...), which
# drops the trailing newlines.
# Usage: kubehz::scrub <string>
kubehz::scrub() {
  jq -Rrs "${KUBEHZ_SCRUB_JQ}"' scrub' <<<"${1}"
}

# Bound and disarm a SERVER string before it reaches the terminal. The Go twin
# runs clip(scrub(...)) on the same strings, so the two steps run in the same
# order and produce the same bytes:
#
#   scrub   kubehz::scrub: drop each unshown character except tab and
#           newline.
#   clip    256 characters, then one ellipsis. A ceiling or an endpoint is a
#           few dozen characters; past that the rest is not information.
#
# A backslash stays: error() and a plain `echo` print it as it is, as the Go
# twin does, so a \033[2J in the string prints as text.
#
# Two known limits: the character count is the shell's, so it counts runes
# only in a UTF-8 locale (Go always counts runes), and `$(...)` drops a
# trailing newline the Go twin would keep.
# Usage: kubehz::space_bound_string <string>
kubehz::space_bound_string() {
  local s
  s=$(kubehz::scrub "${1}")
  (( ${#s} <= 256 )) || s="${s:0:256}…"
  echo "${s}"
}

# Print "<what>: <the api's message>", then the api's help. The fallback
# stands in for an api that sends the code alone, and states no number of its
# own. Both server strings are scrubbed and bounded.
# Usage: kubehz::space_api_reason <what> <fallback>
kubehz::space_api_reason() {
  local what="${1}" fallback="${2}" reason help
  reason=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.message // .message // empty' 2>/dev/null) || reason=""
  [[ -z "${reason}" ]] || reason=$(kubehz::space_bound_string "${reason}")
  [[ -n "${reason}" ]] || reason="${fallback}"
  error "${what}: ${reason}"
  help=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.help // .help // empty' 2>/dev/null) || help=""
  [[ -z "${help}" ]] || help=$(kubehz::space_bound_string "${help}")
  [[ -z "${help}" ]] || echo "  ${help}" >&2
}

# Name what the spec asked for, then let the api say why that is too much.
# Usage: kubehz::space_limits_refused <fallback>
kubehz::space_limits_refused() {
  kubehz::space_api_reason "kubehz refused the space limits ($(kubehz::space_limits_line))" "${1}"
}

# Render the message + help halves of a non-2xx envelope — the api's own words
# are almost always the actionable ones.
# Usage: kubehz::space_api_error <context>
kubehz::space_api_error() {
  local context="${1}"
  local msg help
  msg=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.message // .message // empty' 2>/dev/null) || msg=""
  help=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.help // .help // empty' 2>/dev/null) || help=""
  # Both halves are SERVER strings and this is the FIRST api call lo makes,
  # so an api that hides \033[2J\033[H in a message would clear the caller's
  # terminal before anything else is printed. Both are scrubbed and clipped
  # the same way: error() and the plain echo print them as they are.
  [[ -z "${msg}" ]] || msg=$(kubehz::space_bound_string "${msg}")
  [[ -z "${help}" ]] || help=$(kubehz::space_bound_string "${help}")
  error "${context} (HTTP ${KUBEHZ_SPACE_API_STATUS})${msg:+: ${msg}}"
  [[ -n "${help}" ]] && echo "  ${help}" >&2
  return 0
}

# Find a Space by slug. Result in KUBEHZ_SPACE_ROW (JSON, empty when absent).
# Usage: kubehz::space_lookup <slug>
kubehz::space_lookup() {
  local slug="${1}"
  KUBEHZ_SPACE_ROW=""
  kubehz::space_api GET "/api/spaces" || {
    (( $? == 2 )) && kubehz::space_api_error "Failed to list spaces"
    return 1
  }
  KUBEHZ_SPACE_ROW=$(echo "${KUBEHZ_SPACE_API_BODY}" \
    | jq -r --arg slug "${slug}" \
        '(.data? // .) | (if type=="array" then . else [.] end) | map(select(.slug == $slug)) | first // empty')
}

# ── Provision (create-or-adopt + join tickets) ───────────

# The local next step: a spec that names numbers gets them lowered, a spec
# that names none gets them set. Telling a reader to decrease values that are
# not there reads as nonsense.
# Usage: kubehz::space_limits_verb
kubehz::space_limits_verb() {
  if [[ -z "${LOK8S_SPACE_MAX_NODES}${LOK8S_SPACE_MAX_NAMESPACES}${LOK8S_SPACE_MAX_OBJECT_KIB}" ]]; then
    echo "Set"
  else
    echo "Decrease"
  fi
}

# Render the numbers the SPEC names, in a fixed order. A number the spec
# leaves out is not shown, because it was never sent.
# Usage: kubehz::space_limits_line
kubehz::space_limits_line() {
  local parts=() out="" p
  [[ -z "${LOK8S_SPACE_MAX_NODES}" ]] || parts+=("nodes ${LOK8S_SPACE_MAX_NODES}")
  [[ -z "${LOK8S_SPACE_MAX_NAMESPACES}" ]] || parts+=("namespaces ${LOK8S_SPACE_MAX_NAMESPACES}")
  [[ -z "${LOK8S_SPACE_MAX_OBJECT_KIB}" ]] || parts+=("object cap ${LOK8S_SPACE_MAX_OBJECT_KIB} KiB")
  if (( ${#parts[@]} == 0 )); then
    echo "the spec sets none"
    return 0
  fi
  for p in "${parts[@]}"; do
    [[ -n "${out}" ]] && out="${out}, ${p}" || out="${p}"
  done
  echo "${out}"
}

# Report a space whose limits differ from the spec. Adoption stays read-only:
# lo creates a space with the three numbers, and never changes the numbers of a
# space that exists. Without this note the edit in the spec would do nothing
# and say nothing.
# Usage: kubehz::space_note_limits_drift
kubehz::space_note_limits_drift() {
  # Only a number the SPEC names can drift. A field the spec leaves out was
  # never sent, so whatever the space holds for it is the api's own value and
  # is not a disagreement.
  local drift=0 entry key want live
  for entry in "maxNodes ${LOK8S_SPACE_MAX_NODES}" \
    "maxNamespaces ${LOK8S_SPACE_MAX_NAMESPACES}" \
    "maxObjectKiB ${LOK8S_SPACE_MAX_OBJECT_KIB}"; do
    key="${entry%% *}"
    want="${entry#* }"
    [[ -n "${want}" ]] || continue
    live=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r --arg k "${key}" '.[$k] // "" | tostring' 2>/dev/null) || return 0
    # An api that does not report the number gives nothing to compare.
    [[ -n "${live}" ]] || return 0
    [[ "${live}" == "${want}" ]] || drift=1
  done
  (( drift )) || return 0
  echo "  Note: this space keeps the limits it was created with."
  echo "  The spec asks for $(kubehz::space_limits_line)."
  echo "  lo does not change them. Change the limits in the kubehz dashboard."
}

# Create the Space, or adopt it when it already exists (idempotent
# re-provision — the same contract every lo driver honors).
# Result in KUBEHZ_SPACE_ID.
# Usage: kubehz::space_ensure <domain> <cluster_yaml>
kubehz::space_ensure() {
  local domain="${1}" cluster_yaml="${2}"
  KUBEHZ_SPACE_ID=""

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -n "${KUBEHZ_SPACE_ROW}" ]]; then
    debug "Space '${LOK8S_SPACE_SLUG}' already exists — adopting"
    KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
    [[ -n "${KUBEHZ_SPACE_ID}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
    kubehz::space_note_limits_drift
    return 0
  fi

  # A number the spec does not name is LEFT OUT of the body. Sending a
  # locally chosen default would make this CLI the author of a policy that
  # belongs to the platform, and would pin a value the account may later have
  # more of. The api's schema makes all three optional and applies its own
  # default to whatever is absent. `-c` and the key order match the Go twin's
  # compactJSON, so both trees put the SAME bytes on the wire (this tree used
  # to send the pretty form).
  local payload
  payload=$(jq -nc \
    --arg name "${LOK8S_SPACE_NAME}" \
    --arg slug "${LOK8S_SPACE_SLUG}" \
    --arg maxNodes "${LOK8S_SPACE_MAX_NODES}" \
    --arg maxNamespaces "${LOK8S_SPACE_MAX_NAMESPACES}" \
    --arg maxObjectKiB "${LOK8S_SPACE_MAX_OBJECT_KIB}" \
    --arg region "${LOK8S_SPACE_REGION}" \
    '{name: $name, slug: $slug}
      + (if $maxNodes != "" then {maxNodes: ($maxNodes | tonumber)} else {} end)
      + (if $maxNamespaces != "" then {maxNamespaces: ($maxNamespaces | tonumber)} else {} end)
      + (if $maxObjectKiB != "" then {maxObjectKiB: ($maxObjectKiB | tonumber)} else {} end)
      + (if $region != "" then {region: $region} else {} end)')

  local rc=0
  kubehz::space_api POST "/api/spaces" "${payload}" || rc=$?
  if (( rc == 1 )); then
    return 1
  elif (( rc == 2 )); then
    local code
    code=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.code // .code // empty' 2>/dev/null) || code=""
    case "${code}" in
      NO_SHARD_AVAILABLE)
        error "kubehz: no shared control plane has room for a new space right now."
        echo "  Capacity frees as spaces are removed and as new planes come online. You can:" >&2
        echo "    • retry later" >&2
        echo "    • run your own cluster meanwhile (spec.kubehz.hosting: self)" >&2
        return 1 ;;
      # The three space-limit codes all render the api's own words. The
      # account's ceiling differs per account and extra resources are bought,
      # so the platform holds the only true numbers; lo adds what the spec
      # asked for and the local next step.
      SPACE_LIMITS_ABOVE_FREE)
        kubehz::space_limits_refused "they are above what this account allows"
        echo "  $(kubehz::space_limits_verb) the values in spec.kubehz.space.limits, or raise the ceiling" >&2
        echo "  of the account in the kubehz dashboard." >&2
        return 1 ;;
      SPACE_LIMITS_ABOVE_SHARED)
        kubehz::space_limits_refused "they are above what this account may set on a shared control plane"
        echo "  $(kubehz::space_limits_verb) the values in spec.kubehz.space.limits, or use a hosted control" >&2
        echo "  plane: set spec.kubehz.hosting to hosted." >&2
        return 1 ;;
      SPACE_PLAN_RETIRED)
        kubehz::space_api_reason "kubehz refused the request" "space plans are retired"
        echo "  A space uses spec.kubehz.space.limits: nodes, namespaces and objectCapKiB." >&2
        echo "  Remove spec.kubehz.space.plan from the cluster spec. Then run" >&2
        echo "  lo provision again." >&2
        return 1 ;;
      *)
        # Lost a create race? The adopt path answers it — retry the lookup once.
        if [[ "${KUBEHZ_SPACE_API_STATUS}" == "409" ]]; then
          kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || true
          if [[ -n "${KUBEHZ_SPACE_ROW}" ]]; then
            debug "Space '${LOK8S_SPACE_SLUG}' appeared concurrently — adopting"
            KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
            [[ -n "${KUBEHZ_SPACE_ID}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
            return 0
          fi
        fi
        kubehz::space_api_error "Failed to create the space"
        return 1 ;;
    esac
  fi

  KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.id // .id')
}

# Wait for a Space to reach the Active phase (the platform materializes the
# namespace, quota, access bindings and network policy server-side).
# Usage: kubehz::space_wait_active <space_id> [timeout_seconds]
kubehz::space_wait_active() {
  local space_id="${1}" timeout="${2:-300}"
  local elapsed=0 phase

  while (( elapsed < timeout )); do
    kubehz::space_api GET "/api/spaces/${space_id}" 2>/dev/null || true
    # Fail FAST on the statuses that never heal within the window: an expired
    # token stays 401/403 for all 300s, and a 404 means the space was deleted
    # out from under us — looping to timeout buries the real cause.
    case "${KUBEHZ_SPACE_API_STATUS}" in
      401|403)
        error "kubehz API refused the token while waiting for space ${space_id} (HTTP ${KUBEHZ_SPACE_API_STATUS})"
        return 1 ;;
      404)
        error "space ${space_id} vanished while waiting for it to become Active"
        return 1 ;;
    esac
    # The api serves the observed `status` overlay, never `phase` — reading
    # phase kept this loop at "Unknown" until timeout.
    phase=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.status // .status // "Unknown"' 2>/dev/null) || phase="Unknown"
    case "${phase}" in
      Active)
        debug "Space ${space_id} is Active"
        return 0 ;;
      Failed|Error)
        error "Space ${space_id} failed: phase=${phase}"
        return 1 ;;
    esac
    debug "Space ${space_id} phase: ${phase} (${elapsed}s / ${timeout}s)"
    sleep 5
    elapsed=$(( elapsed + 5 ))
  done

  error "Timed out waiting for space ${space_id} to become Active after ${timeout}s"
  return 1
}

# The directory a join ticket goes under, as the Go twin's joinTempDir:
# TMPDIR (else /tmp), absolute (a relative TMPDIR is taken from PWD), with
# each symlink resolved (cd -P; TMPDIR=/ and // give /). Each part of the
# resolved path, from / down to the leaf, must belong to root or to this
# user, and must not be writable by others unless it has the sticky bit
# (/tmp passes). The walk goes top-down: each part is read (stat, no
# follow: a link is refused) before any part below it. A part that passes
# lets no other user rename or replace an entry in it (they cannot write
# it, or the sticky bit keeps them to their own entries), so each part
# that was checked stays the same up to the create below it. A bottom-up
# walk would let the owner of an ancestor that is not checked yet swap it
# for a prepared tree after the parts below it passed. "/"
# alone may also show the overflow uid (/proc/sys/kernel/overflowuid, else
# 65534): in a user namespace that does not map root, the host's "/" shows
# so; any other part with that owner can be any user of the host. A part
# of this user counts only while the uid of this user is not the overflow
# uid: in a namespace without a mapping for this user, this user and every
# other unmapped owner show that uid, so "ours" proves nothing there. The
# owner of a part could otherwise rename the fresh directory and put a
# FIFO or a link in place of the ticket or the script. Prints the resolved
# path. Returns 1 when TMPDIR cannot be resolved (silent: the caller
# reports the failed write), 2 when a part fails (the message is printed).
# Usage: kubehz::space_join_tmp_dir
kubehz::space_join_tmp_dir() {
  local dir="${TMPDIR:-/tmp}" real part rest meta uid mode why ovf="" unmapped
  [[ "${dir}" == /* ]] || dir="${PWD}/${dir}"
  real=$(cd -P -- "${dir}" 2>/dev/null && pwd -P) || return 1
  # pwd -P keeps a leading // (POSIX leaves it open); Go cleans it to /.
  while [[ "${real}" == //* ]]; do real="${real#/}"; done
  { read -r ovf < /proc/sys/kernel/overflowuid; } 2>/dev/null || ovf=""
  [[ "${ovf}" =~ ^[0-9]+$ ]] || ovf=65534
  # Top-down (see above): / first, then one name more for each turn.
  part=/ rest="${real#/}"
  while :; do
    why="" unmapped=0
    meta=$(stat -c '%u %a' -- "${part}" 2>/dev/null) || meta=""
    uid="${meta%% *}" mode="${meta#* }"
    if [[ -z "${meta}" ]]; then
      why="cannot be read"
    elif [[ -L "${part}" ]]; then
      why="is a symlink"
    elif ! { [[ "${uid}" == 0 ]] \
      || [[ "${uid}" == "${EUID}" && "${EUID}" != "${ovf}" ]] \
      || [[ "${part}" == / && "${uid}" == "${ovf}" ]]; }; then
      if [[ "${uid}" == "${EUID}" ]]; then
        # Ours, and refused: this user has the overflow uid.
        why="cannot be checked (uid ${uid})" unmapped=1
      else
        why="belongs to another user (uid ${uid})"
      fi
    elif (( (8#${mode} & 8#022) != 0 && (8#${mode} & 8#1000) == 0 )); then
      why="is writable by others and has no sticky bit"
    fi
    if [[ -n "${why}" ]]; then
      error "the temp dir for the join ticket is not safe: ${part} ${why}"
      if (( unmapped )); then
        echo "  The uid of this user is not mapped in the namespace, so the CLI cannot check who owns TMPDIR." >&2
        echo "  Run it where the uid of this user is mapped (unshare --map-current-user), or outside the namespace." >&2
      else
        echo "  Set TMPDIR to a directory of your own that only you can write (mode 0700)." >&2
      fi
      return 2
    fi
    [[ -n "${rest}" ]] || break
    part="${part%/}/${rest%%/*}"
    if [[ "${rest}" == */* ]]; then rest="${rest#*/}"; else rest=""; fi
  done
  printf '%s\n' "${real}"
}

# Write a join file to a FRESH private directory under the user's temp dir
# (kubehz::space_join_tmp_dir): <tmp>/kubehz-join-<random>/kubehz-join-<node><ext>,
# 0700 over 0600, as the Go twin writes it (writeJoinFile). The file holds
# the ticket: the ticket alone (ext .token, kubehz::space_write_join_ticket)
# or the kubeadm join config of `lo kubehz node join` (ext .yaml). mktemp -d picks a
# name nobody can plant in a shared /tmp. The directory is set to 0700 and
# must be 0700 before anything goes into it, as in the Go twin. The file is made empty first,
# under noclobber, and must then be a regular file of ours, not a link:
# noclobber lets a FIFO (or a link to one) through, and the check stops
# there before any byte of the ticket goes out. The umask 077 inside sets
# the modes, and chmod sets the mode of the empty file again (a default ACL
# on TMPDIR wins over the umask, as the Go twin's chmod through the handle
# does); that mode is checked before the write too. The node name is part
# of the path, so it is checked here.
# Prints the path. Returns 2 when the node name is refused (the message is
# printed), 1 when the write fails (or a local cannot be declared: nothing
# was written), 3 when the write fails and the removal of the file or the
# directory fails too. When the write fails, the first line on stdout is
# its cause (empty when a message was printed already); with 3, the second
# line is the directory, which may still hold a part of the ticket.
# The body runs in a subshell of its own, with traps for INT, TERM and HUP
# (kubehz::_join_write_signalled): a signal during the write removes the
# file and the directory, and the writer returns as a failed write does
# (1, or 3 with the directory), with the cause "the write was interrupted".
# (A caller runs the writer in a command substitution, whose subshell does
# not keep the traps of the caller: a Ctrl-C reaches it too.)
# Usage: kubehz::write_join_file <node_name> <ext> <content>
kubehz::write_join_file() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *[xa]* ]] || { local -; set +xa; }  # the ticket
  ( kubehz::_write_join_file "$@" )
}

# The body of kubehz::write_join_file (call that one: it holds the guard
# and the subshell that ends the traps of this function).
kubehz::_write_join_file() {
  # +x: a local takes the export flag of an exported variable of the same
  # name, and a child (mktemp, stat, chmod) would get the ticket. +i and the
  # refusal: as in kubehz::space_api_call (an integer of a caller would
  # print the ticket; a readonly nameref would take it).
  local +x +i node_name ext content dir priv path phase || { error "kubehz::write_join_file: a local cannot be declared (a readonly name or a nameref of the caller)"; return 1; }
  # Empty first: under localvar_inherit a local takes the value of a caller
  # too, and the trap removes what priv and path name. phase: empty while
  # the write runs; "failed" while kubehz::_join_write_failed cleans up,
  # "written" when the file holds the content, "interrupted" in the trap.
  # The trap acts only while it is empty (kubehz::_join_write_signalled).
  node_name="${1}" ext="${2}" content="${3}" dir="" priv="" path="" phase=""
  # Before the directory is made: a signal from here on removes what the
  # write made.
  trap 'kubehz::_join_write_signalled' INT TERM HUP
  node::assert_node_name "${node_name}" || return 2
  # rc 2: the check printed why (no cause); rc 1: TMPDIR cannot be resolved.
  dir=$(kubehz::space_join_tmp_dir) || {
    (( $? == 2 )) || printf '%s\n' "the temp dir (TMPDIR) cannot be resolved"
    return 1
  }
  priv=$(umask 077 && mktemp -d "${dir%/}/kubehz-join-XXXXXXXXXX" 2>/dev/null) || {
    printf '%s\n' "mktemp -d failed in ${dir}"
    return 1
  }
  path="${priv}/kubehz-join-${node_name}${ext}"
  # Each check before the write; `|| return` returns the status of the
  # cleanup (1 or 3), and keeps set -e of a caller from ending the shell.
  # In a setgid TMPDIR the fresh directory is 2700 (it takes the setgid
  # bit). GNU chmod keeps the setgid bit of a directory for a mode of three
  # or four digits (700, 0700); the fifth digit clears it, as the chmod of
  # the Go twin does.
  chmod 00700 -- "${priv}" 2>/dev/null \
    || { kubehz::_join_write_failed "${priv}" "${path}" "the mode of the directory cannot be set to 0700" || return; }
  [[ "$(stat -c '%a' -- "${priv}" 2>/dev/null)" == 700 ]] \
    || { kubehz::_join_write_failed "${priv}" "${path}" "not a private directory (mode 0700)" || return; }
  ( umask 077 && set -C && : > "${path}" ) 2>/dev/null \
    || { kubehz::_join_write_failed "${priv}" "${path}" "the file cannot be created (it exists, or the directory cannot be written)" || return; }
  [[ -f "${path}" && ! -L "${path}" && -O "${path}" ]] \
    || { kubehz::_join_write_failed "${priv}" "${path}" "not a private file" || return; }
  chmod 600 -- "${path}" 2>/dev/null \
    || { kubehz::_join_write_failed "${priv}" "${path}" "the mode of the file cannot be set to 0600" || return; }
  [[ "$(stat -c '%a' -- "${path}" 2>/dev/null)" == 600 ]] \
    || { kubehz::_join_write_failed "${priv}" "${path}" "not a private file" || return; }
  # printf is a builtin: the ticket is on no argv.
  ( printf '%s' "${content}" >> "${path}" ) 2>/dev/null \
    || { kubehz::_join_write_failed "${priv}" "${path}" "the write failed" || return; }
  phase=written
  printf '%s\n' "${path}"
}

# Write a join ticket, and a newline, to a fresh private file
# (kubehz::write_join_file, ext .token). Prints the path; the return codes
# and the lines on stdout are the ones of kubehz::write_join_file.
# Usage: kubehz::space_write_join_ticket <node_name> <token>
kubehz::space_write_join_ticket() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *[xa]* ]] || { local -; set +xa; }  # the ticket
  kubehz::write_join_file "${1}" .token "${2}"$'\n'
}

# The trap of a write that a signal stopped (kubehz::_write_join_file):
# prints the cause, removes the file and the fresh directory when the write
# made them (priv and path of the writer, through dynamic scope), and ends
# the subshell of the writer as kubehz::_join_write_failed returns: 1, or 3
# when the removal fails (the directory is then the second line). A signal
# that comes late does nothing (phase of the writer is set): during the
# cleanup of a failed write (its cause and its status stay), after the
# write (the file is the result, and the caller handles its own signal),
# and in this trap itself.
kubehz::_join_write_signalled() {
  [[ -z "${phase:-}" ]] || return 0
  phase=interrupted
  local rc=1
  printf '%s\n' "the write was interrupted" || :
  if [[ -n "${priv:-}" ]]; then
    if ! { [[ -z "${path:-}" ]] || rm -f -- "${path}" 2>/dev/null; } || ! rmdir -- "${priv}" 2>/dev/null; then
      printf '%s\n' "${priv}" || :
      rc=3
    fi
  fi
  exit "${rc}"
}

# The cleanup of a failed write of a join file (kubehz::write_join_file):
# prints the cause, removes the file and the fresh directory, and when that
# fails, prints the directory too (it may still hold a part of the ticket).
# Returns 1, or 3 when the removal failed. It sets phase of the writer
# (dynamic scope): a signal from here on keeps this cause and this status.
# Usage: kubehz::_join_write_failed <dir> <file> <cause>
kubehz::_join_write_failed() {
  phase=failed
  printf '%s\n' "${3}"
  if ! rm -f -- "${2}" 2>/dev/null || ! rmdir -- "${1}" 2>/dev/null; then
    printf '%s\n' "${1}"
    return 3
  fi
  return 1
}

# Mint a single-node join ticket and print the join block. The plaintext token
# is returned exactly once by the api and kept only in a private ticket file
# (kubehz::space_write_join_ticket), never on stdout: a terminal (scrollback,
# CI logs, a shared screen) is a copy nobody asked for. A lost ticket is
# re-minted, not recovered.
# The response, the ticket and the API token stay out of a trace (set -x)
# and out of the environment of a child (set -a): the guard lines (as in
# utils/keysonly.sh) turn both off, and the response global is unset before
# the options of the caller come back.
# Usage: kubehz::space_mint_join <space_id> <node_name>
kubehz::space_mint_join() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *[xa]* ]] || { local -; set +xa; }  # the response and the ticket
  local rc=0
  kubehz::_space_mint_join "$@" || rc=$?
  unset KUBEHZ_SPACE_API_BODY
  return "${rc}"
}

# The body of kubehz::space_mint_join (call that one: it holds the guard).
kubehz::_space_mint_join() {
  local space_id="${1}" node_name="${2}"
  # The names that hold the ticket, before the mint: a refusal here costs
  # no live ticket. +x: a local takes the export flag of an exported
  # variable of the same name, and a child (jq) would get the ticket. +i and
  # the refusal: as in kubehz::space_api_call.
  local +x +i token_json token expires || { error "kubehz::_space_mint_join: a local cannot be declared (a readonly name or a nameref of the caller)"; return 1; }
  # Before the mint: a refused name must not cost a live ticket.
  node::assert_node_name "${node_name}" || return 1
  # Nor a temp dir that fails the check (it printed why, rc 2). The writer
  # checks again: the directory can change in between. A TMPDIR that
  # cannot be resolved (rc 1) is left to the writer, as before.
  local tmp_rc=0
  kubehz::space_join_tmp_dir >/dev/null || tmp_rc=$?
  (( tmp_rc != 2 )) || return 1

  local payload rc=0
  payload=$(jq -n --arg nodeName "${node_name}" '{nodeName: $nodeName}')
  kubehz::space_api POST "/api/spaces/${space_id}/join-token" "${payload}" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && kubehz::space_api_error "Failed to mint a join ticket for '${node_name}'"
    return 1
  fi

  # The token as JSON text (jq -c): a control character in it stays an
  # escape, so a trailing newline, a CR or a NUL fails the shape check
  # below, as in the Go twin. $(jq -r ...) would strip a trailing newline
  # and drop a NUL.
  token_json=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -c '.data.token // .token // empty')
  expires=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.expiresAt // .expiresAt // empty')
  # A server string for a plain echo: scrubbed and clipped, as the Go twin
  # does. (The Go twin also prints an endpoint, next to the join script;
  # this tree has no join script, so it prints no endpoint.)
  [[ -z "${expires}" ]] || expires=$(kubehz::space_bound_string "${expires}")
  if [[ -z "${token_json}" || "${token_json}" == '""' ]]; then
    error "kubehz API did not return a join token for '${node_name}'"
    return 1
  fi
  # The kubeadm bootstrap-token shape (<6 id>.<16 secret>), as the Go twin's
  # joinTokenRe, in JSON quotes: anything else is not a ticket to hand to a
  # machine, and as a server string for the terminal it could inject. The
  # characters are spelled out: in a bash regex, a range like a-z follows
  # the locale (in en_US.UTF-8 it matches e with an accent).
  local tok_c='[abcdefghijklmnopqrstuvwxyz0123456789]'
  local tok_re="^\"${tok_c}{6}[.]${tok_c}{16}\"\$" ncm=0 shape=0
  # nocasematch would let an uppercase ticket through: off for the check.
  shopt -q nocasematch && ncm=1
  shopt -u nocasematch
  [[ "${token_json}" =~ ${tok_re} ]] && shape=1
  # The match left the ticket in BASH_REMATCH, a global: a trace after the
  # return (PS4 can name it) would print it. A match of '' replaces it.
  # shellcheck disable=SC2050 # a constant match on purpose: it empties BASH_REMATCH
  [[ '' =~ ^$ ]]
  (( ncm == 0 )) || shopt -s nocasematch
  if (( shape == 0 )); then
    error "kubehz API returned a join ticket for '${node_name}' in a shape this CLI does not recognise; nothing was written"
    return 1
  fi
  token="${token_json:1:${#token_json}-2}"

  echo ""
  echo "  Node '${node_name}' — join ticket (valid until ${expires:-<unknown>}, single use):"
  local path cause rc=0
  path=$(kubehz::space_write_join_ticket "${node_name}" "${token}") || rc=$?
  if (( rc == 2 )); then
    return 1
  elif (( rc != 0 )); then
    # The mint already happened server-side: the ticket is live. The first
    # line is the cause of the failed write (empty when the writer printed
    # a message itself). With rc 3 the cleanup failed too, and the second
    # line is the directory that may still hold a part of it.
    cause="${path%%$'\n'*}"
    if [[ "${path}" == *$'\n'* ]]; then path="${path#*$'\n'}"; else path=""; fi
    if [[ "${cause}" == "the write was interrupted" ]]; then
      # A signal stopped the write (the trap of the writer removed what it
      # made): the note form of the node join. The temp dir is fine.
      echo "" >&2
      warn "kubehz: interrupted after the ticket was minted. It stays valid until ${expires:-<unknown>}, single use, and no copy was saved."
      (( rc != 3 )) || warn "The cleanup failed too: ${path} may still hold a part of it. Delete that directory."
      warn "Mint a fresh one if you are not retrying:  lo kubehz join ${node_name}"
      return 1
    fi
    error "could not write the join ticket for '${node_name}'${cause:+: ${cause}}"
    echo "" >&2
    echo "  The ticket was minted before the write failed. It stays valid until ${expires:-<unknown>}," >&2
    if (( rc == 3 )); then
      echo "  single use. The cleanup failed too: ${path} may still hold a part of it;" >&2
      echo "  delete that directory. Mint a fresh one once the temp dir (TMPDIR) is writable:" >&2
    else
      echo "  single use, and no copy was saved. Mint a fresh one once the temp dir" >&2
      echo "  (TMPDIR) is writable:" >&2
    fi
    echo "    lo kubehz join ${node_name}" >&2
    return 1
  fi
  echo "    (written to ${path}, mode 0600)"
  echo "  On the machine, follow the node-join guide for your platform"
  echo "  (kubehz docs: Spaces → Joining nodes)."
  echo "  Delete the ticket file (and its directory) once the node has joined."
  echo "  The ticket is bound to this node name and expires quickly — mint a"
  echo "  fresh one with:"
  echo "    lo kubehz join ${node_name}"
}

# Full provision arc for hosting: shared.
# Usage: kubehz::provision_shared <domain> <cluster_yaml>
kubehz::provision_shared() {
  local domain="${1}" cluster_yaml="${2}"

  [[ -n "${KUBEHZ_TOKEN:-}" ]] || {
    error "KUBEHZ_TOKEN is required to provision a space (get one from your kubehz account)"
    return 1
  }

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_ensure "${domain}" "${cluster_yaml}" || return 1
  local space_id="${KUBEHZ_SPACE_ID}"
  [[ -n "${space_id}" && "${space_id}" != "null" ]] || {
    error "kubehz API did not return a space ID"
    return 1
  }

  kubehz::space_wait_active "${space_id}" || return 1

  echo "Space '${LOK8S_SPACE_SLUG}' is Active (id: ${space_id})"
  echo "  Namespace: ${LOK8S_SPACE_SLUG}"
  # The space's kubectl kubeconfig (D30): the api serves a kubelogin file for
  # a shared space (the public endpoint, the shard's sign-in client, the
  # context kubehz-<slug>; no credential inside). An api without the route, a
  # space still wiring up or one with a dedicated plane keep the older two
  # lines, and nothing fails: the space is Active either way.
  local kubeconfig_path
  if kubeconfig_path="$(kubehz::space_kubeconfig "${space_id}" "${domain}")"; then
    echo "  Access: kubectl --context kubehz-${LOK8S_SPACE_SLUG} -n ${LOK8S_SPACE_SLUG} get pods"
    echo "  Kubeconfig: ${kubeconfig_path} (kubectl signs you in with your kubehz account)"
  else
    echo "  Access: sign in with your kubehz account (OIDC) — the control plane"
    echo "  itself is operated by the platform and is not directly accessible."
  fi

  local node
  for node in "${LOK8S_SPACE_NODES[@]}"; do
    kubehz::space_mint_join "${space_id}" "${node}" || return 1
  done
  if (( ${#LOK8S_SPACE_NODES[@]} == 0 )); then
    echo ""
    echo "  No nodes declared under spec.kubehz.space.nodes — mint a join"
    echo "  ticket any time with: lo kubehz join <node-name>"
  fi
}

# Fetch the shared space's kubectl kubeconfig and write it to
# .kubeconfig/<domain>.yaml (0600, the hosted path's location). Prints the
# path; returns 1 when the api has no file for this space (see the caller).
# Usage: kubehz::space_kubeconfig <space_id> <domain>
kubehz::space_kubeconfig() {
  local space_id="${1}" domain="${2}"
  kubehz::space_api GET "/api/spaces/${space_id}/kubeconfig" >/dev/null 2>&1 || return 1
  [[ -n "${KUBEHZ_SPACE_API_BODY}" ]] || return 1
  local path="${PATH_BASE}/.kubeconfig/${domain}.yaml" tmp
  mkdir -p "$(dirname "${path}")" || return 1
  # Whole file or nothing: a temp file beside it, the mode set, one rename.
  tmp="$(mktemp "$(dirname "${path}")/.kubeconfig-XXXXXX")" || return 1
  if ! printf '%s\n' "${KUBEHZ_SPACE_API_BODY}" > "${tmp}" || ! chmod 600 "${tmp}" || ! mv -f "${tmp}" "${path}"; then
    rm -f "${tmp}"
    return 1
  fi
  echo "${path}"
}

# ── Destroy ──────────────────────────────────────────────

# Deregister the Space. Removing a space withdraws access and removes its
# namespaces — workloads on your machines stop being scheduled.
# Usage: kubehz::destroy_shared <domain> <cluster_yaml>
kubehz::destroy_shared() {
  local domain="${1}" cluster_yaml="${2}"

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -z "${KUBEHZ_SPACE_ROW}" ]]; then
    echo "No space '${LOK8S_SPACE_SLUG}' found — nothing to destroy"
    return 0
  fi

  local space_id
  space_id=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
  [[ -n "${space_id}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
  local rc=0
  kubehz::space_api DELETE "/api/spaces/${space_id}" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && kubehz::space_api_error "Failed to remove space '${LOK8S_SPACE_SLUG}'"
    return 1
  fi
  echo "Space '${LOK8S_SPACE_SLUG}' removed (id: ${space_id})"
  # The kubeconfig provision wrote (D30) names a space that is gone.
  rm -f "${PATH_BASE}/.kubeconfig/${domain}.yaml"
}

# ── Status ───────────────────────────────────────────────

# Render the Space + its registered nodes.
# Usage: kubehz::space_status <domain> <cluster_yaml>
kubehz::space_status() {
  local domain="${1}" cluster_yaml="${2}"

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -z "${KUBEHZ_SPACE_ROW}" ]]; then
    echo "Space:   '${LOK8S_SPACE_SLUG}' not found (not provisioned yet?)"
    return 0
  fi

  local space_id phase max_nodes max_namespaces max_object
  space_id=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
  [[ -n "${space_id}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
  phase=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.status // "Unknown"')
  max_nodes=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNodes // "-"')
  max_namespaces=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNamespaces // "-"')
  max_object=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxObjectKiB // "-"')
  echo "Space:   ${LOK8S_SPACE_SLUG} (id: ${space_id})"
  echo "Phase:   ${phase}"
  echo "Limits:  nodes ${max_nodes}, namespaces ${max_namespaces}, object cap ${max_object} KiB"

  kubehz::space_api GET "/api/spaces/${space_id}/nodes" 2>/dev/null || {
    echo "Nodes:   unknown (API unreachable)"
    return 0
  }
  local count
  # The route answers {nodes:[{name,lane,status,…}], usage:{nodes,maxNodes}} —
  # treating it as an array printed the OBJECT's key count.
  count=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '(.data? // .) | .usage.nodes // 0' 2>/dev/null) || count=0
  local max; max=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '(.data? // .) | .usage.maxNodes // "-"' 2>/dev/null) || max='-'
  echo "Nodes:   ${count}/${max}"
  # After the lane: `cordoned` while the node is unschedulable (any cordon:
  # yours, a platform migration, a node retirement), then the last cordon,
  # uncordon or drain request with its phase, and the reason when the
  # platform gives one (`drain Blocked: <reason>`). The reason is the
  # platform's own text: clipped to 256 characters here (jq counts code
  # points, as the Go twin counts runes). One node is one line: a newline or
  # a tab in a server string becomes a space, so a reason cannot print a
  # second node line. Then the def scrub drops the other unshown characters.
  echo "${KUBEHZ_SPACE_API_BODY}" \
    | jq -r "${KUBEHZ_SCRUB_JQ}"'(.data? // .) | .nodes[]? | ("  " + .name + "  " + (.status // "-") + "  " + (.lane // "-")
        + (if .unschedulable == true then "  cordoned" else "" end)
        + (if (.maintenance | type) == "object" then
             "  " + (.maintenance.action | if type == "string" then . else "-" end)
             + " " + (.maintenance.phase | if type == "string" then . else "-" end)
             + (.maintenance.reason | if type == "string" and . != ""
                 then ": " + (if length > 256 then .[0:256] + "…" else . end) else "" end)
           else "" end))
        | split("\n") | join(" ") | split("\t") | join(" ") | scrub' 2>/dev/null || true
}
