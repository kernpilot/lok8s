#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-node — machines you bring, joined to a kubehz-HOSTED control plane
#
# A static pool is a worker pool whose machines you own: bare metal, a second
# cloud, a virtual machine that already runs. kubehz operates the control
# plane; nothing provisions or rotates these machines. You install a kubelet,
# run one join command, and the node appears in your own cluster.
#
# Three subcommands, all against `hosting: hosted`:
#   join    mint a ticket and run the kubeadm join flow on THIS machine
#   remove  take one node out of the cluster and free its slot
#   status  list the nodes you brought, with the slot count
#
# Three more act on one node of a Space (`hosting: shared`). A Space gives you
# no rights on the nodes of the shared control plane, so the platform makes
# the change for you (see "Maintenance" below):
#   cordon    mark the node unschedulable; its pods keep running
#   uncordon  make the node schedulable again
#   drain     cordon the node and evict its pods
#
# The CLUSTER-level `lo kubehz join` and `lo kubehz deregister` keep their own
# meaning: they are about a cluster, not a node.
#
# The platform composes the whole `kubeadm join` line — the join address and
# the CA fingerprints are properties of a control plane you do not run, so you
# cannot compute them. This file mints the ticket, checks the line, and runs
# it. It never builds a join command of its own.
#
# The ticket is bound to ONE node name and to ten minutes. Its plaintext
# arrives once and is stored nowhere: a lost ticket is minted again, never
# recovered.
#
# LIBRARY-ONLY: loaded through libs/kubehz/main; not directly executable.

import ^utils/verbose
import ^utils/http
import ^libs/kubehz/shared

kubehz::node() {
  local -a usage=(
    'join|j@destructive'    'Join THIS machine to a hosted cluster (runs kubeadm join)'
    'remove|r@destructive'  'Remove one node from a hosted cluster and free its slot'
    'status|s@readonly'     'List the nodes you brought to a hosted cluster'
    'cordon@idempotent'     'Mark one node of a Space unschedulable (its pods keep running)'
    'uncordon@idempotent'   'Make one node of a Space schedulable again'
    'drain@destructive'     'Cordon one node of a Space and evict its pods'
  )
  :usage "Nodes you bring to a kubehz control plane" "${@}"
  "${usage[@]}"
}

# ── Preflight ────────────────────────────────────────────

# The first half of the two preflights (node::preflight for the hosted verbs,
# node::space_preflight for the Space verbs): the active domain, its spec
# file and its kubehz block. The Go twin is nodeDomainConfig.
# Usage: node::domain_config <domain>
# Sets: NODE_CLUSTER_YAML (and the LOK8S_KUBEHZ_* block through read_config)
node::domain_config() {
  local domain="${1}"
  NODE_CLUSTER_YAML=""

  [[ -n "${domain}" ]] || { error "No active domain. Use: lo use <domain>"; return 1; }

  NODE_CLUSTER_YAML="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  [[ -f "${NODE_CLUSTER_YAML}" ]] || { error "No cluster.lok8s.yaml for domain: ${domain}"; return 1; }

  # || return: an unread config must not flow into the hosting check as an
  # empty string — the same guard the cluster-level subcommands carry.
  kubehz::read_config "${NODE_CLUSTER_YAML}" || return 1
}

# The part of the two preflights after the hosting check: the api URL and
# the tenant token, with no control character in it. The Go twin is
# nodeAPIAccess.
# Usage: node::api_access <domain> <action>
node::api_access() {
  local domain="${1}" action="${2}"
  local api_url="${LOK8S_KUBEHZ_API_URL}"
  [[ -n "${api_url}" ]] || { error "spec.kubehz.apiUrl is not set for ${domain}"; return 1; }
  # The tenant bearer and a bootstrap token travel on this URL — never over
  # plain HTTP.
  http::require_https "${api_url}" "spec.kubehz.apiUrl" || return 1

  [[ -n "${KUBEHZ_TOKEN:-}" ]] || {
    error "KUBEHZ_TOKEN is required to ${action}."
    echo "  Mint a clusters:write API token in the dashboard (Access -> API Tokens)." >&2
    return 1
  }
  # The request helpers check the token again, but only after other steps
  # (the space list, the cluster registry) that can print lines of their
  # own. Here both twins refuse it at the same point, before any request.
  http::credential_ok KUBEHZ_TOKEN || return 1
}

# Whether a value has the shape of an id that is pasted into a URL PATH (a
# cluster id, a space id): a `../` in it would address a different route.
# The Go twin is urlIDRe.
# Usage: node::url_id <value>
node::url_id() {
  [[ "${1}" =~ ^[A-Za-z0-9-]+$ ]]
}

# Everything the three subcommands need before they touch the api: the active
# domain's kubehz block, the api URL, the tenant token, and the platform
# cluster id.
#
# `cluster_id` is the caller's own local, read here through dynamic scope the
# way `domain` is: an explicit --cluster-id wins, and without it the id comes
# from the tenant registry for the active domain. The flag is NOT called
# --cluster: `lo` already owns that name globally for the kind cluster to
# manage, and two flags with one name is a trap, not a shorthand.
# Usage: node::preflight <domain> <action>
# Sets: NODE_CLUSTER_ID (and the LOK8S_KUBEHZ_* block through read_config)
node::preflight() {
  local domain="${1}" action="${2}"
  NODE_CLUSTER_ID=""

  node::domain_config "${domain}" || return 1

  # Static pools sit on a control plane the platform runs. A self-hosted
  # cluster owns its own apiserver, and a Space is a slice of a SHARED plane
  # whose nodes carry their own verb (`lo kubehz join`).
  case "${LOK8S_KUBEHZ_HOSTING}" in
    hosted) ;;
    shared)
      error "kubehz: '${domain}' is hosting: shared — its nodes join a Space."
      echo "  Mint a Space join ticket with:  lo kubehz join <node-name>" >&2
      echo "  Read the nodes of the Space and their maintenance phase with:  lo kubehz status" >&2
      return 1 ;;
    *)
      error "kubehz: '${domain}' is hosting: ${LOK8S_KUBEHZ_HOSTING} — it runs its own control plane."
      echo "  Join nodes with kubeadm against your own API server." >&2
      return 1 ;;
  esac

  node::api_access "${domain}" "${action}" || return 1
  local api_url="${LOK8S_KUBEHZ_API_URL}"

  # An explicit --cluster-id wins; it is also the only way to reach a cluster
  # the local specs do not describe. The value is pasted into a URL PATH, so
  # its shape is checked here — a `../` in it would address a different route.
  if [[ -n "${cluster_id:-}" ]]; then
    if ! node::url_id "${cluster_id}"; then
      error "kubehz: '${cluster_id}' is not a cluster id."
      echo "  A cluster id looks like cl-xxxxxxxx. Read yours in the dashboard." >&2
      return 1
    fi
    NODE_CLUSTER_ID="${cluster_id}"
    return 0
  fi

  local resolve_rc=0
  NODE_CLUSTER_ID=$(kubehz::resolve_cluster_id "${domain}" "${api_url}") || resolve_rc=$?
  case "${resolve_rc}" in
    0) ;;
    2)
      error "kubehz: the registry holds no cluster for ${domain}."
      echo "  Name the cluster directly with:  --cluster-id cl-xxxxxxxx" >&2
      return 1 ;;
    *)
      error "kubehz: the cluster registry did not answer (${api_url})."
      echo "  Check KUBEHZ_TOKEN and the network, then try again." >&2
      return 1 ;;
  esac
}

# ── Error vocabulary ─────────────────────────────────────

# Strip terminal control characters from a server string before it is shown.
# A compromised api could hide ANSI escapes in a message, a timestamp or a
# node row and redraw the caller's terminal — worst under --print-only, where
# the printed output is read as truth. Tab and newline survive (the status
# rows travel as TSV); every other character below 0x20, and DEL, is dropped.
# Values that become argv are NOT routed through here: the join-line alphabet
# gate guards that side, and display is the only concern of this one.
# Usage: node::scrub <string>
node::scrub() {
  tr -d '\000-\010\013-\037\177' <<<"${1}"
}

# Turn the api's refusal codes into an instruction. Every branch says what to
# do next; the fall-through prints the api's own words, which are almost
# always the actionable ones.
# Usage: node::api_error <context>
node::api_error() {
  local context="${1}" code msg
  code=$(jq -r '.data.code // .code // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || code=""
  msg=$(jq -r '.data.message // .message // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || msg=""
  msg=$(node::scrub "${msg}")

  case "${code}" in
    STATIC_POOLS_NOT_ENABLED)
      error "kubehz: your account may not use static pools yet."
      echo "  Static pools roll out account by account. Ask kubehz support to set" >&2
      echo "  the staticPoolsEnabled flag, then run this command again." >&2 ;;
    KUBELET_BELOW_FLOOR)
      error "kubehz: the kubelet on this machine is too old${msg:+ — ${msg}}"
      echo "  A node must run a kubelet no more than two minor versions below the" >&2
      echo "  control plane. Upgrade the kubelet, then run this command again." >&2 ;;
    QUOTA_EXCEEDED)
      error "kubehz: this cluster has no free slot for another node${msg:+ — ${msg}}"
      echo "  Free a slot:  lo kubehz node remove --name <node-name>" >&2
      echo "  Or ask kubehz support to raise the limit." >&2 ;;
    CONTROL_PLANE_NOT_READY)
      error "kubehz: the control plane has not published its join address yet."
      echo "  The platform publishes the address and the CA fingerprints after the" >&2
      echo "  cluster declares its first pool with kind: static." >&2
      echo "  Check with:  lo kubehz node status" >&2 ;;
    NODE_EXISTS)
      error "kubehz: this cluster already holds a node with that name${msg:+ — ${msg}}"
      echo "  Choose another name with --name, or remove the old node first:" >&2
      echo "    lo kubehz node remove --name <node-name>" >&2 ;;
    POOL_NOT_STATIC)
      error "kubehz: kubehz provisions the machines in that pool${msg:+ — ${msg}}"
      echo "  A machine you bring joins a pool with kind: static. Declare one in the" >&2
      echo "  dashboard, then join." >&2 ;;
    WORKER_POOL_NOT_FOUND)
      error "kubehz: this cluster has no such pool${msg:+ — ${msg}}"
      echo "  Declare a pool with kind: static in the dashboard, then join." >&2 ;;
    NOT_HOSTED)
      error "kubehz: this cluster runs its own control plane${msg:+ — ${msg}}"
      echo "  Join nodes with kubeadm against your own API server." >&2 ;;
    TENANT_SUSPENDED)
      error "kubehz: your account is suspended, so it may not add nodes."
      echo "  Contact kubehz support." >&2 ;;
    TOKEN_SCOPE_MISSING)
      error "kubehz: KUBEHZ_TOKEN does not carry the clusters:write scope."
      echo "  Mint a token with clusters:write in the dashboard (Access -> API Tokens)." >&2 ;;
    STEP_UP_REQUIRED|STEP_UP_MFA_REQUIRED)
      error "kubehz: the platform asks for a fresh, two-factor sign-in."
      echo "  A browser sign-in cannot happen here. Put a clusters:write API token in" >&2
      echo "  KUBEHZ_TOKEN instead — minting that token IS the approval." >&2 ;;
    HOSTED_BACKEND_ERROR)
      error "kubehz: the hosted control-plane backend did not answer${msg:+ — ${msg}}"
      echo "  Nothing changed. Try again shortly, or contact kubehz support." >&2 ;;
    *)
      kubehz::space_api_error "${context}" ;;
  esac
  return 0
}

# ── Local facts + shape checks ───────────────────────────

# Refuse a node name the platform would refuse anyway, and — for `remove` —
# a name that is not a name at all: the value is pasted into a URL PATH, so a
# `../` in it would address a different route. The refusal repeats the value
# with each backslash doubled: error() prints through `echo -e`, and a typed
# \e[2J must print as typed (as the Go twin prints it), not as an escape.
# Usage: node::assert_node_name <name>
node::assert_node_name() {
  local name="${1}"
  if [[ ! "${name}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ || "${#name}" -gt 63 ]]; then
    error "kubehz: '${name//\\/\\\\}' is not a node name the platform accepts."
    echo "  A node name is a DNS label: lowercase letters, digits and dashes, 63 at most." >&2
    echo "  Give one with:  --name <node-name>" >&2
    return 1
  fi
}

# `lo` owns --cluster/-s globally (the kind cluster to manage), and argsh
# inherits it into every subcommand — so on a `node` verb it parses silently
# and is then ignored, because the target here is --cluster-id. That is exactly
# the two-names-one-meaning trap this file's header refuses. Catch it by name
# from the raw argv, the same precedent .lok8s/lo uses to spot an explicit
# --domain. --cluster-id and --space-id are untouched: they match neither arm.
# Usage: node::reject_global_cluster_flag "$@"
node::reject_global_cluster_flag() {
  node::global_cluster_flag_given "$@" || return 0
  error "kubehz: --cluster/-s names the kind cluster lo manages, not the target here."
  echo "  Name the platform cluster with:  --cluster-id cl-xxxxxxxx" >&2
  return 1
}

# The same trap on the verbs that act on a Space: the hint names --space-id.
# Usage: node::reject_space_cluster_flag "$@"
node::reject_space_cluster_flag() {
  node::global_cluster_flag_given "$@" || return 0
  error "kubehz: --cluster/-s names the kind cluster lo manages, not the target here."
  echo "  Name the space with:  --space-id sp-xxxxxxxx" >&2
  return 1
}

# Whether argv carries the global --cluster/-s in any form.
# Usage: node::global_cluster_flag_given "$@"
node::global_cluster_flag_given() {
  local arg
  for arg in "$@"; do
    case "${arg}" in
      # -s?* catches argsh's ATTACHED short-flag form: argsh parses `-scl-x`
      # as `--cluster=cl-x`, so without it a value bound to the global
      # kind-cluster flag is silently dropped (review round 2, L1). No node
      # short flag starts with `s`, so this cannot swallow a real one.
      --cluster|--cluster=*|-s|-s?*) return 0 ;;
    esac
  done
  return 1
}

# The node name kubeadm would choose: the short hostname, lowercased.
node::default_name() {
  local name
  name=$(hostname -s 2>/dev/null) || true
  [[ -n "${name}" ]] || name="${HOSTNAME:-}"
  echo "${name%%.*}" | tr '[:upper:]' '[:lower:]'
}

# The kubelet version on THIS machine, empty when there is no kubelet to ask.
# Sent with the mint so the platform refuses a machine that is too far behind
# BEFORE the join touches it. `kubelet --version` prints "Kubernetes v1.33.4".
node::kubelet_version() {
  command -v kubelet >/dev/null 2>&1 || return 0
  local out
  out=$(kubelet --version 2>/dev/null) || return 0
  [[ "${out}" =~ (v[0-9]+\.[0-9]+\.[0-9]+[^[:space:]]*) ]] || return 0
  echo "${BASH_REMATCH[1]}"
}

# The pool to join when --pool is absent: the one pool every node on this
# cluster already sits in. A first node cannot be inferred — the tenant names
# its pool. Prints the pool name, or nothing.
# Usage: node::infer_pool <cluster_id>
node::infer_pool() {
  local cluster_id="${1}" pools
  kubehz::space_api GET "/api/clusters/${cluster_id}/nodes" >/dev/null 2>&1 || return 0
  pools=$(jq -r '(.data? // .) | [.nodes[]?.pool] | unique | .[]' \
    <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || return 0
  (( $(grep -c . <<<"${pools}") == 1 )) || return 0
  echo "${pools}"
}

# ── Join ─────────────────────────────────────────────────

# The join flags this CLI will run, and no others. The api composes EXACTLY
#   kubeadm join <endpoint> --token <t> [--discovery-token-ca-cert-hash <h>]... --node-name <n>
# (kubehz-api server/utils/static-pools.ts::composeJoinCommand). A flag outside
# this set — --discovery-file, --config, --control-plane, --certificate-key,
# --ignore-preflight-errors, --discovery-token-unsafe-skip-ca-verification — is
# built from the SAME innocent characters yet hands the machine to whoever
# composed the line. So the gate is the grammar, not the alphabet.
readonly -a NODE_JOIN_ALLOWED_FLAGS=(
  --token
  --discovery-token-ca-cert-hash
  --node-name
)

# Refuse a join line whose SEMANTICS this CLI does not recognise. The alphabet
# check keeps a shell metacharacter out (nothing can escape into a shell); the
# structural check keeps a dangerous kubeadm FLAG out (nothing can escape into
# root on this machine). A command we cannot read is a command we must not run.
# Usage: node::assert_join_command <line>
node::assert_join_command() {
  local line="${1}"
  if [[ "${line}" != "kubeadm join "* ]]; then
    error "kubehz: the platform returned a command this CLI does not run."
    echo "  Expected a 'kubeadm join' line. Nothing ran on this machine." >&2
    echo "  Print the command instead and read it:  --print-only" >&2
    return 1
  fi
  # Word characters, dots, colons, slashes, equals, plus and dash — the whole
  # alphabet of an address, a bootstrap token, a sha256 pin and a DNS label.
  # This is the shell-injection guard, and it MUST stand before `read -ra`
  # splits the line: a token this alphabet rejects never reaches the argv.
  if [[ ! "${line}" =~ ^[A-Za-z0-9._:/=+-]+([[:blank:]][A-Za-z0-9._:/=+-]+)*$ ]]; then
    error "kubehz: the join command carries characters this CLI does not run."
    echo "  Nothing ran on this machine. Print the command and read it:  --print-only" >&2
    return 1
  fi

  # Structural allowlist. Split the line and walk it: `kubeadm` `join`, then the
  # endpoint (host:port), then a run of flags. EVERY token that begins with `--`
  # must be one of NODE_JOIN_ALLOWED_FLAGS — a dangerous flag can never hide as
  # a flag's value, because a value the api emits (an endpoint, a token, a
  # sha256 pin, a DNS label) never begins with `--`. At least one CA fingerprint
  # is REQUIRED: without it a node would trust whatever apiserver answers.
  local -a tok
  read -ra tok <<<"${line}"

  local endpoint_re='^[A-Za-z0-9.-]+:[0-9]{1,5}$'
  if [[ ! "${tok[2]:-}" =~ ${endpoint_re} ]]; then
    error "kubehz: the join command's server address is not a host:port."
    echo "  Nothing ran on this machine. Print the command and read it:  --print-only" >&2
    return 1
  fi

  local i flag seen_ca=0 allowed
  for (( i = 3; i < ${#tok[@]}; i++ )); do
    [[ "${tok[i]}" == --* ]] || continue   # a value following an allowed flag
    flag="${tok[i]%%=*}"                    # tolerate --flag=value as well as --flag value
    allowed=0
    local candidate
    for candidate in "${NODE_JOIN_ALLOWED_FLAGS[@]}"; do
      [[ "${flag}" == "${candidate}" ]] && { allowed=1; break; }
    done
    if (( ! allowed )); then
      error "kubehz: the platform sent a join flag this CLI will not run: ${flag}"
      echo "  Nothing ran on this machine. This CLI runs only the join, token, CA-pin" >&2
      echo "  and node-name flags. Print the command and read it:  --print-only" >&2
      return 1
    fi
    [[ "${flag}" == "--discovery-token-ca-cert-hash" ]] && seen_ca=1
  done

  if (( ! seen_ca )); then
    error "kubehz: the join command pins no CA fingerprint, so a node could not verify the control plane."
    echo "  Nothing ran on this machine. A safe join carries at least one" >&2
    echo "  --discovery-token-ca-cert-hash. Print the command and read it:  --print-only" >&2
    return 1
  fi
}

# Whether this process may write /etc/kubernetes. Its own function so the unit
# suite can walk the join path without running as root.
node::is_root() {
  [[ "${EUID}" -eq 0 ]]
}

# Printed when a join is interrupted (Ctrl-C) after the ticket is minted but
# before kubeadm finishes: the ticket already holds a node slot for about ten
# minutes, so name the way to free it — the same note the kubeadm-failed branch
# carries. `node_name` is read from the interrupted node::join through dynamic
# scope (the trap handler runs while node::join is still on the stack).
node::interrupted_slot_note() {
  echo "" >&2
  warn "kubehz: interrupted after the ticket was minted — it holds a node slot for about ten minutes."
  warn "Free the slot if you are not retrying:  lo kubehz node remove --name ${node_name}"
}

# Printed when a post-mint gate refuses the returned join line: nothing ran on
# this machine, but the mint itself succeeded — the ticket holds a node slot
# server-side until it expires. One message, one place: every refusal between
# the mint and the join carries it. `node_name` is read from node::join
# through dynamic scope, the same way the interrupt note above reads it.
node::minted_slot_note() {
  echo "" >&2
  echo "  The mint succeeded, so this attempt holds a node slot until the ticket" >&2
  echo "  expires (about ten minutes). Free the slot now with:" >&2
  echo "    lo kubehz node remove --name ${node_name}" >&2
}

# Join THIS machine to a hosted cluster.
node::join() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local cluster_id="" pool="" name="" node_ip="" kubelet_version="" print_only=0
  local -a args=(
    'cluster-id|c'      'Cluster id (cl-xxxxxxxx); default: the cluster of the active domain'
    'pool|p'            'Static pool to join; default: the one pool every node of the cluster is in'
    'name|n'            'Node name; default: the short hostname of this machine'
    'node-ip|'          'Address other nodes reach this machine on (needed behind NAT)'
    'kubelet-version|'  'Kubelet version to declare; default: read from this machine'
    'print-only|:+'     'Print the join command and run nothing'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  node::reject_global_cluster_flag "${@}" || return 1
  :args "Join this machine to a kubehz-hosted cluster" "${@}"

  node::preflight "${domain}" "join a node" || return 1

  local node_name="${name}"
  [[ -n "${node_name}" ]] || node_name=$(node::default_name)
  node::assert_node_name "${node_name}" || return 1

  local node_pool="${pool}"
  [[ -n "${node_pool}" ]] || node_pool=$(node::infer_pool "${NODE_CLUSTER_ID}")
  if [[ -z "${node_pool}" ]]; then
    error "kubehz: name the static pool this machine joins."
    echo "  Add:  --pool <pool-name>" >&2
    echo "  The CLI infers the pool only when every node of the cluster shares one." >&2
    return 1
  fi

  # A machine with no kubeadm cannot complete a join. Say so BEFORE minting a
  # ticket that would hold a slot for ten minutes for nothing. --print-only is
  # exempt: printing a command to run elsewhere is the point of that flag.
  if (( ! print_only )) && ! command -v kubeadm >/dev/null 2>&1; then
    error "kubehz: kubeadm is not on this machine, so the join cannot run."
    echo "  Install kubeadm, kubelet and a container runtime first — see the" >&2
    echo "  Kubernetes install guide for your distribution." >&2
    echo "  To mint the ticket here and join elsewhere, add:  --print-only" >&2
    return 1
  fi
  if (( ! print_only )) && ! node::is_root; then
    error "kubehz: kubeadm join writes to /etc/kubernetes, so it must run as root."
    echo "  Run it again with 'sudo -E' — the -E keeps KUBEHZ_TOKEN and the PATH_*" >&2
    echo "  lo environment, which plain sudo would strip." >&2
    echo "  Or add --print-only and run the printed command as root yourself." >&2
    return 1
  fi

  local declared="${kubelet_version}"
  [[ -n "${declared}" ]] || declared=$(node::kubelet_version)

  local payload
  payload=$(jq -n \
    --arg nodeName "${node_name}" \
    --arg pool "${node_pool}" \
    --arg kubeletVersion "${declared}" \
    '{nodeName: $nodeName, pool: $pool}
      + (if $kubeletVersion != "" then {kubeletVersion: $kubeletVersion} else {} end)')

  local rc=0
  kubehz::space_api POST "/api/clusters/${NODE_CLUSTER_ID}/nodes/join-token" "${payload}" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && node::api_error "Failed to mint a join ticket for '${node_name}'"
    return 1
  fi

  # Guard every read: the mint returned 2xx, but a 2xx body is not a promise of
  # JSON. Under errexit a bare `$(jq …)` on a non-JSON body would kill `lo` with
  # a raw parse error AFTER the ticket was minted — and that ticket holds a
  # slot. Fall back to empty and let the empty-join_command branch below say so.
  local join_command expires ready
  join_command=$(jq -r '(.data? // .) | .joinCommand // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || join_command=""
  expires=$(jq -r '(.data? // .) | .expiresAt // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || expires=""
  expires=$(node::scrub "${expires}")
  # `.ready` WITHOUT a `//` alternative: jq's `//` takes the right side when
  # the left is null OR FALSE, so `.ready // empty` erases the one value this
  # warning exists to catch. An absent key reads "null" here and warns about
  # nothing, which is the honest answer for an api that did not say.
  ready=$(jq -r '(.data? // .) | .ready' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || ready=""
  if [[ -z "${join_command}" ]]; then
    error "kubehz: the platform accepted the mint but returned no join command this CLI could read."
    echo "  A ticket may have been minted — if so it holds a node slot for about ten" >&2
    echo "  minutes. Check for it and free the slot if it is there:" >&2
    echo "    lo kubehz node status" >&2
    echo "    lo kubehz node remove --name ${node_name}" >&2
    return 1
  fi
  node::assert_join_command "${join_command}" || { node::minted_slot_note; return 1; }

  # `ready: false` means the ticket exists and holds a slot, but the platform
  # has not handed the cluster the matching request yet — the kubelet would
  # wait for a credential that is not installed.
  if [[ "${ready}" == "false" ]]; then
    warn "kubehz: the platform has not armed this ticket yet — the join may time out."
    warn "Mint again in a minute if it does."
  fi

  local -a join_argv
  read -ra join_argv <<<"${join_command}"
  [[ -n "${node_ip}" ]] && join_argv+=(--node-ip "${node_ip}")

  if (( print_only )); then
    echo ""
    echo "  Node '${node_name}' joins pool '${node_pool}' of cluster ${NODE_CLUSTER_ID}."
    echo "  Run this as root on that machine before ${expires:-the ticket expires}:"
    echo ""
    echo "    ${join_argv[*]}"
    echo ""
    echo "  The ticket is single use and lasts ten minutes. It already holds a node"
    echo "  slot. Mint a fresh one with the same command when it expires."
    return 0
  fi

  echo "kubehz: joining '${node_name}' to pool '${node_pool}' of cluster ${NODE_CLUSTER_ID}"
  # The ticket is live and holds a slot from here until the join lands. A
  # Ctrl-C mid-join would otherwise leave the caller unaware the slot is held.
  trap 'node::interrupted_slot_note' INT TERM
  # argv, never a shell: the line was checked above and is passed word by word.
  if ! "${join_argv[@]}"; then
    trap - INT TERM
    error "kubehz: kubeadm join failed — read its output above."
    echo "  The node keeps its slot until you remove it:" >&2
    echo "    lo kubehz node remove --name ${node_name}" >&2
    echo "  Run 'kubeadm reset' on this machine before you join it again." >&2
    return 1
  fi
  trap - INT TERM
  echo ""
  echo "kubehz: node '${node_name}' joined cluster ${NODE_CLUSTER_ID}."
  echo "  It reports Ready within a few minutes. Watch it with:"
  echo "    lo kubehz node status"
}

# ── Remove ───────────────────────────────────────────────

# Take one node out of a hosted cluster.
node::remove() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local cluster_id="" name=""
  local -a args=(
    'name|n:!'          'Node name to remove'
    'cluster-id|c'      'Cluster id (cl-xxxxxxxx); default: the cluster of the active domain'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  node::reject_global_cluster_flag "${@}" || return 1
  :args "Remove a node from a kubehz-hosted cluster" "${@}"

  node::assert_node_name "${name}" || return 1
  node::preflight "${domain}" "remove a node" || return 1

  local rc=0
  kubehz::space_api DELETE "/api/clusters/${NODE_CLUSTER_ID}/nodes/${name}" || rc=$?
  if (( rc != 0 )); then
    if (( rc == 2 )) && [[ "${KUBEHZ_SPACE_API_STATUS}" == "404" ]]; then
      error "kubehz: cluster ${NODE_CLUSTER_ID} holds no node named '${name}'."
      echo "  List the nodes with:  lo kubehz node status" >&2
      return 1
    fi
    (( rc == 2 )) && node::api_error "Failed to remove node '${name}'"
    return 1
  fi

  # Guard the read: a 2xx body is not a promise of JSON, and under errexit a
  # bare `$(jq …)` on a non-JSON body would kill `lo` after the delete landed.
  # The pool name is cosmetic; its absence just drops the parenthetical.
  local removed_pool
  removed_pool=$(jq -r '(.data? // .) | .pool // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || removed_pool=""
  removed_pool=$(node::scrub "${removed_pool}")
  echo "kubehz: node '${name}' is draining${removed_pool:+ (pool ${removed_pool})}."
  echo "  The platform cordons the node, then deletes it from the cluster."
  echo "  Its slot is free now, so another machine can take it."
  echo "  Pods on the machine are NOT evicted first — the machine is yours, and"
  echo "  kubehz takes the membership, never the hardware."
  echo "  Run 'kubeadm reset' on the machine before you join it anywhere again."
}

# ── Status ───────────────────────────────────────────────

# List the nodes brought to a hosted cluster.
node::status() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local cluster_id=""
  local -a args=(
    'cluster-id|c'      'Cluster id (cl-xxxxxxxx); default: the cluster of the active domain'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  node::reject_global_cluster_flag "${@}" || return 1
  :args "List the nodes you brought to a kubehz-hosted cluster" "${@}"

  node::preflight "${domain}" "list nodes" || return 1

  local rc=0
  kubehz::space_api GET "/api/clusters/${NODE_CLUSTER_ID}/nodes" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && node::api_error "Failed to list the nodes of ${NODE_CLUSTER_ID}"
    return 1
  fi

  local used max discovery_ready
  used=$(jq -r '(.data? // .) | .usage.nodes // 0' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || used=0
  max=$(jq -r '(.data? // .) | .usage.maxStaticNodes // "-"' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || max='-'
  discovery_ready=$(jq -r '(.data? // .) | .discoveryReady // false' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || discovery_ready="false"
  used=$(node::scrub "${used}")
  max=$(node::scrub "${max}")

  echo "Cluster: ${NODE_CLUSTER_ID} (${domain})"
  echo "Nodes:   ${used}/${max}"

  local rows
  rows=$(jq -r '(.data? // .) | .nodes[]? | [.name, (.pool // "-"), (.status // "-"), (.joinedAt // "-")] | @tsv' \
    <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || rows=""
  # Scrubbed as one block: tab and newline survive the scrub, so the TSV
  # structure the read loop below walks is intact.
  rows=$(node::scrub "${rows}")
  if [[ -n "${rows}" ]]; then
    echo ""
    printf '  %-24s %-16s %-10s %s\n' "NAME" "POOL" "STATUS" "JOINED"
    local row_name row_pool row_status row_joined
    while IFS=$'\t' read -r row_name row_pool row_status row_joined; do
      [[ -n "${row_name}" ]] || continue
      printf '  %-24s %-16s %-10s %s\n' "${row_name}" "${row_pool}" "${row_status}" "${row_joined}"
    done <<<"${rows}"
  else
    echo ""
    echo "  No nodes yet. Join this machine with:  lo kubehz node join --pool <pool-name>"
  fi

  # The one warning this endpoint can carry: without a published join address
  # and CA fingerprints, every mint is refused.
  if [[ "${discovery_ready}" != "true" ]]; then
    echo ""
    warn "The control plane has not published its join address yet — a join is refused until it does."
    warn "The platform publishes it after the cluster declares its first pool with kind: static."
  fi
}

# ── Maintenance (one node of a Space) ────────────────────

# Cordon, uncordon and drain act on one node of a Space (`hosting: shared`).
# The api publishes a request, and the platform's operator acts on it
# shortly after: the change is asynchronous, and `lo kubehz status` shows the
# last request of each node with its phase. There is one request per node,
# and the latest action wins: a cordon, uncordon or drain replaces the
# pending request of that node, and the answer names the action it replaced.
#
# The auth is the one the hosted verbs above use: a KUBEHZ_TOKEN bearer with
# the clusters:write scope. A drain stops pods, so the platform asks a
# browser session for a fresh two-factor sign-in; an API token is exempt.

# Everything the three maintenance verbs need before they touch the api: the
# active domain's kubehz block (hosting: shared), the api URL, the tenant
# token, and the space id.
#
# `space_id` is the caller's own local, read through dynamic scope the way
# node::preflight reads `cluster_id`: an explicit --space-id wins, and without
# it the id comes from the space list, by the slug of the domain's spec. The
# list needs the read scope, so --space-id is also the way for a token that
# carries clusters:write only.
# Usage: node::space_preflight <domain> <action>
# Sets: NODE_SPACE_ID NODE_SPACE_LABEL (and the LOK8S_KUBEHZ_* block)
node::space_preflight() {
  local domain="${1}" action="${2}"
  NODE_SPACE_ID=""
  NODE_SPACE_LABEL=""

  node::domain_config "${domain}" || return 1
  local cluster_yaml="${NODE_CLUSTER_YAML}"

  # Only a Space needs the platform for this. A hosted or a self-hosted
  # cluster has an API server of its own, and kubectl does it there.
  case "${LOK8S_KUBEHZ_HOSTING}" in
    shared) ;;
    hosted)
      error "kubehz: '${domain}' is hosting: hosted. This command is for the nodes of a Space."
      echo "  A hosted cluster has its own API server. Use kubectl cordon, uncordon or drain there." >&2
      return 1 ;;
    *)
      error "kubehz: '${domain}' is hosting: ${LOK8S_KUBEHZ_HOSTING}. This command is for the nodes of a Space."
      echo "  Use kubectl cordon, uncordon or drain against your own API server." >&2
      return 1 ;;
  esac

  node::api_access "${domain}" "${action}" || return 1

  # The id is pasted into a URL PATH, so its shape is checked here: a `../`
  # in it would address a different route. The refusal doubles each
  # backslash for the `echo -e` of error() (see node::assert_node_name).
  if [[ -n "${space_id:-}" ]]; then
    if ! node::url_id "${space_id}"; then
      error "kubehz: '${space_id//\\/\\\\}' is not a space id."
      echo "  A space id looks like sp-xxxxxxxx. Read yours in the dashboard." >&2
      return 1
    fi
    NODE_SPACE_ID="${space_id}"
    NODE_SPACE_LABEL="${space_id}"
    return 0
  fi

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1
  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  # The slug is the spec's value as typed, and no check limits its shape:
  # its backslashes are doubled for the `echo -e` of error().
  if [[ -z "${KUBEHZ_SPACE_ROW}" ]]; then
    error "kubehz: no space '${LOK8S_SPACE_SLUG//\\/\\\\}' found for ${domain}."
    echo "  Create it with 'lo provision', or name the space with:  --space-id sp-xxxxxxxx" >&2
    return 1
  fi
  # The id of the row goes into the URL too, so it gets the same check.
  local id
  id=$(jq -r '.id // empty' <<<"${KUBEHZ_SPACE_ROW}" 2>/dev/null) || id=""
  if ! node::url_id "${id}"; then
    error "kubehz: the space row carries no id this CLI can use."
    return 1
  fi
  NODE_SPACE_ID="${id}"
  NODE_SPACE_LABEL="${LOK8S_SPACE_SLUG}"
}

# The drain deadline as the api takes it: a whole number of seconds from 60
# to 3600. Leading zeros are dropped, so 0600 is 600 (never octal), the same
# number the Go twin sends. The refusal does not repeat the value: error()
# prints through `echo -e`, and the Go twin would print a backslash as typed.
# Usage: node::drain_timeout <value>
# Outputs: the number of seconds to stdout
node::drain_timeout() {
  local value="${1}" n
  if [[ "${value}" =~ ^0*([0-9]{1,4})$ ]]; then
    n=$(( 10#${BASH_REMATCH[1]} ))
    if (( n >= 60 && n <= 3600 )); then
      echo "${n}"
      return 0
    fi
  fi
  error "kubehz: --timeout takes a whole number of seconds from 60 to 3600."
  return 1
}

# The refusal of a request whose result is open. The api says so itself
# (NODE_MAINTENANCE_OUTCOME_UNKNOWN), or the answer did not arrive: a gateway
# answered for the api, the connection ended after the send, or a 2xx is not
# the answer of the route. <cause> says which (empty for the api). The Go
# twin is maintenanceUnknown.
# Usage: node::maintenance_unknown <action> <name> [cause]
node::maintenance_unknown() {
  local action="${1}" name="${2}" cause="${3:-}"
  error "kubehz: the result of the ${action} request is unknown${cause:+ (${cause})}. Possibly, the request got to the control plane."
  echo "  Read the phase of node '${name}' with 'lo kubehz status' before you try again." >&2
  echo "  A drain that you send again can start a new deadline." >&2
}

# Whether a curl exit code says that curl sent no request: it failed before
# a connection carried one (the URL, the proxy and host names, the connect,
# the TLS handshake and the certificate checks). Any other failure (no
# reply, a reset, a timeout) can come after the send. The Go twin reads the
# same from httptrace (requestSent). One known limit: curl's 28 is a timeout
# in any phase, so a connect timeout reads as "after the send" here.
# Usage: node::curl_sent_nothing <curl_exit_code>
node::curl_sent_nothing() {
  case "${1}" in
    1|2|3|4|5|6|7|35|45|53|54|58|59|60|66|77|83|90|91|97|98) return 0 ;;
    *) return 1 ;;
  esac
}

# Turn a refusal of the maintenance routes into an instruction. Each refusal
# says whether something changed; the ones that cannot know say how to find
# out. The rest prints the api's own words, which are almost always the
# actionable ones.
# Usage: node::maintenance_error <action> <name>
node::maintenance_error() {
  local action="${1}" name="${2}" code
  code=$(jq -r '.data.code // .code // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || code=""

  # A gateway in front of the api answers 502 or 504 when the api does not
  # answer in time, and 503 with no code when the connection to the api
  # fails. The api can still act on the request (its publish runs on after
  # the gateway timeout), so the result is open.
  case "${KUBEHZ_SPACE_API_STATUS}" in
    502|504)
      node::maintenance_unknown "${action}" "${name}" "HTTP ${KUBEHZ_SPACE_API_STATUS}"
      return 0 ;;
    503)
      if [[ -z "${code}" ]]; then
        node::maintenance_unknown "${action}" "${name}" "HTTP 503"
        return 0
      fi ;;
  esac

  case "${code}" in
    NODE_NOT_JOINED)
      error "kubehz: node '${name}' has not joined the space yet."
      echo "  Nothing changed. Wait until 'lo kubehz status' shows the node Ready, then try again." >&2 ;;
    NODE_MAINTENANCE_CONFLICT)
      error "kubehz: a maintenance request of another space holds the request name of node '${name}'."
      echo "  Nothing changed. Contact kubehz support." >&2 ;;
    NODE_MAINTENANCE_UNAVAILABLE)
      error "kubehz: the ${action} request did not reach the control plane."
      echo "  Nothing changed. Try again shortly." >&2 ;;
    NODE_MAINTENANCE_AUDIT_UNAVAILABLE)
      error "kubehz: the platform cannot record the ${action} request, so it did not send it."
      echo "  Nothing changed. Try again shortly." >&2 ;;
    NODE_MAINTENANCE_OUTCOME_UNKNOWN)
      node::maintenance_unknown "${action}" "${name}" ;;
    TOKEN_SCOPE_MISSING|STEP_UP_REQUIRED|STEP_UP_MFA_REQUIRED)
      node::api_error "Failed to ${action} node '${name}'" ;;
    *)
      kubehz::space_api_error "Failed to ${action} node '${name}'" ;;
  esac
  return 0
}

# Send one maintenance request and render the answer. A 202 says that the
# platform took the request, not that the node changed: the output says so,
# and names where to read the phase. <timeout> is the drain --timeout in
# seconds (empty: not given, or not a drain). Each <note> is one line that
# the caller adds after the first line.
# Usage: node::maintain <action> <name> <json_body|""> <timeout|""> [note...]
node::maintain() {
  local action="${1}" name="${2}" payload="${3}" timeout="${4}"
  shift 4
  local path="/api/spaces/${NODE_SPACE_ID}/nodes/${name}/${action}"

  local rc=0
  kubehz::space_api_call POST "${path}" "${payload}" || rc=$?
  if (( rc == 1 )); then
    # A transport failure. Before the send (DNS, connect, TLS), nothing
    # reached the api. After it, possibly the api took the request: no
    # answer is not a refusal. No curl exit code: the token check refused
    # the token before curl ran, and said so.
    [[ -n "${KUBEHZ_SPACE_API_CURL_RC}" ]] || return 1
    if node::curl_sent_nothing "${KUBEHZ_SPACE_API_CURL_RC}"; then
      error "kubehz API unreachable (POST ${path})"
    else
      node::maintenance_unknown "${action}" "${name}" "no answer"
    fi
    return 1
  fi
  if (( rc != 0 )); then
    # The api answers 404 for a space it does not know and for a node the
    # space does not hold; an api older than these routes answers 404 too.
    # The label can be the slug as typed: its backslashes are doubled for
    # the `echo -e` of error().
    if [[ "${KUBEHZ_SPACE_API_STATUS}" == "404" ]]; then
      error "kubehz: the platform knows no node '${name}' in space ${NODE_SPACE_LABEL//\\/\\\\}."
      echo "  Check the node name and the space with:  lo kubehz status" >&2
      return 1
    fi
    node::maintenance_error "${action}" "${name}"
    return 1
  fi

  # The answer of the route carries status "requested". Any other 2xx (a
  # proxy page, an apiUrl that names another server) says nothing about the
  # request, so these verbs do not report a success. Guard the reads: a 2xx
  # body is not a promise of JSON. Only the three actions the api knows are
  # named; anything else reads as no replacement.
  local replaced status
  replaced=$(jq -r '(.data? // .) | .replaced // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || replaced=""
  status=$(jq -r '(.data? // .) | .status // empty' <<<"${KUBEHZ_SPACE_API_BODY}" 2>/dev/null) || status=""
  if [[ "${status}" != "requested" ]]; then
    node::maintenance_unknown "${action}" "${name}" "HTTP ${KUBEHZ_SPACE_API_STATUS} with an answer this CLI cannot read"
    return 1
  fi

  echo "kubehz: ${action} of node '${name}' in space ${NODE_SPACE_LABEL} requested."
  local note
  for note in "$@"; do
    echo "${note}"
  done
  # The answer names the replaced action only. A drain over a drain of the
  # same machine keeps the first deadline and the first timeout. A new
  # machine under the same node name starts a new one. So the lines say
  # both, and that a new --timeout has no effect then.
  case "${replaced}" in
    drain)
      if [[ "${action}" == "drain" ]]; then
        echo "  It replaces a pending drain of this node. The first deadline stays if the machine is the same."
        [[ -z "${timeout}" ]] ||
          echo "  For the same machine, the first timeout stays too, so --timeout ${timeout} has no effect."
      else
        echo "  It cancels a pending drain. Pods that the drain did not evict stay on the node."
      fi ;;
    cordon|uncordon)
      echo "  It replaces a pending ${replaced} of this node." ;;
  esac
  echo "  The change is asynchronous. Read its phase with:  lo kubehz status"
}

# Mark one node of a Space unschedulable.
node::cordon() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local space_id="" name=""
  local -a args=(
    'name|n:!'          'Node name to cordon'
    'space-id|'         'Space id (sp-xxxxxxxx); default: the space of the active domain'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  node::reject_space_cluster_flag "${@}" || return 1
  :args "Mark one node of a Space unschedulable (its pods keep running)" "${@}"

  node::assert_node_name "${name}" || return 1
  node::space_preflight "${domain}" "cordon a node" || return 1
  node::maintain cordon "${name}" "" "" \
    "  The scheduler puts no new pods on the node. The pods on it keep running."
}

# Make one node of a Space schedulable again.
node::uncordon() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local space_id="" name=""
  local -a args=(
    'name|n:!'          'Node name to uncordon'
    'space-id|'         'Space id (sp-xxxxxxxx); default: the space of the active domain'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  node::reject_space_cluster_flag "${@}" || return 1
  :args "Make one node of a Space schedulable again" "${@}"

  node::assert_node_name "${name}" || return 1
  node::space_preflight "${domain}" "uncordon a node" || return 1
  node::maintain uncordon "${name}" "" "" \
    "  The scheduler can put new pods on the node again. Evicted pods do not move back." \
    "  A cordon that the platform holds (a migration, a node retirement) stays."
}

# Cordon one node of a Space and evict its pods. The node stays in the
# space: an uncordon puts it back into service.
node::drain() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local space_id="" name="" timeout="" evict_unmanaged=0
  local -a args=(
    'name|n:!'            'Node name to drain'
    'timeout|'            'Seconds the platform tries, from 60 to 3600; default: the platform default'
    'evict-unmanaged|:+'  'Also evict the pods that no controller recreates'
    'space-id|'           'Space id (sp-xxxxxxxx); default: the space of the active domain'
    'domain|:^~domain'    'Domain to use'
    "${args[@]:-}"
  )
  node::reject_space_cluster_flag "${@}" || return 1
  :args "Cordon one node of a Space and evict its pods" "${@}"

  # `force` is the api's name (kubectl drain --force). The flag has its own
  # name here because `lo` owns --force/-f globally. argsh parses the global
  # flag at any place in argv into the `force` of main, so a --force that
  # means `kubectl drain --force` is refused here, not ignored.
  if (( ${force:-0} )); then
    error "kubehz: drain does not use the global --force/-f. To also evict the pods that no controller recreates, use --evict-unmanaged."
    return 1
  fi
  node::assert_node_name "${name}" || return 1
  local seconds=""
  if [[ -n "${timeout}" ]]; then
    seconds=$(node::drain_timeout "${timeout}") || return 1
  fi
  node::space_preflight "${domain}" "drain a node" || return 1

  local evict=false
  (( evict_unmanaged )) && evict=true
  local payload
  payload=$(jq -nc --arg t "${seconds}" --argjson f "${evict}" \
    '(if $t != "" then {timeoutSeconds: ($t | tonumber)} else {} end)
      + (if $f then {force: true} else {} end)')

  local -a notes=("  The platform cordons the node and evicts its pods.")
  if [[ -n "${seconds}" ]]; then
    notes+=("  It tries for at most ${seconds} seconds.")
  else
    notes+=("  It tries until the deadline the platform sets by default.")
  fi
  if [[ "${evict}" == "true" ]]; then
    notes+=("  It also evicts the pods that no controller recreates. Nothing recreates them.")
  else
    notes+=("  A pod that no controller recreates stays, and the drain waits as Blocked."
      "  To evict such pods too, add:  --evict-unmanaged")
  fi
  node::maintain drain "${name}" "${payload}" "${seconds}" "${notes[@]}"
}
