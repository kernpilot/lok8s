#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2016,SC2034
# SC2016: single-quoted $ here is jq program text
# vim: set syntax=bash:
# kubehz-agent — `lo kubehz space …` and `lo kubehz cluster …`. An AI agent or
# a pipeline makes these kubehz api calls with an agent key. `lo mcp` turns
# the commands into tools, like every other leaf. The Go twin is
# internal/kubehz/agent.go, with the same messages and the same bytes on
# stdout. hack/parity-kubehz.sh diffs both against an https stub of the api.
#
# THE CREDENTIAL: the agent key is four variables (KUBEHZ_AGENT_CLIENT_ID,
# KUBEHZ_AGENT_CLIENT_SECRET, KUBEHZ_AGENT_TOKEN_URL, KUBEHZ_AGENT_SCOPE).
# The grant of `lo kubehz token` (kubehz::token_access) turns it into an
# access token, with the same cache file. Without a key, KUBEHZ_TOKEN is the
# bearer. KUBEHZ_API_URL names the api. No flag names the URL or holds a
# credential: a model that could set the URL could send the bearer to any
# host. The bearer reaches curl in a config on stdin, never on argv.
#
# lo adds no authority. The api enforces the role of the key, its scope, its
# monthly spend cap and the lease. What a key creates ends after two hours
# unless the key extends the lease. lo checks only the shape of what it
# sends: an id that goes into a URL path, and whole numbers.
#
# OUTPUT: -o text prints a table for a list and label lines for one record.
# json and yaml print fixed lowerCamel fields. The records are projections, so
# a new api field changes no output. Every string from the api loses its
# control characters (the jq `clean`) in every format.
#
# The two `kubeconfig` leaves count as credential output. The Go `lo mcp`
# never offers them. The `lo chat` defaults deny them under the names that
# the argsh `lo mcp` gives (lo_space_kubeconfig, lo_cluster_kubeconfig).
#
# LIBRARY-ONLY: loaded through libs/kubehz/main; not directly executable.

import ^utils/verbose
import ^utils/http
import ^libs/kubehz/shared

kubehz::space() {
  local -a usage=(
    'list@readonly'       'List the spaces the credential reaches'
    'get@readonly'        'Show one space'
    'create'              'Create a space (an agent key sets a lease)'
    'delete@destructive'  'Delete a space'
    'lease@destructive'   'Set the hours until the platform deletes a space'
    'kubeconfig'          'Write the agent kubeconfig of a space to a file'
  )
  :usage "Spaces through the kubehz api (agent tools)" "${@}"
  "${usage[@]}"
}

kubehz::cluster() {
  local -a usage=(
    'list@readonly'       'List the clusters the credential reaches'
    'get@readonly'        'Show one cluster'
    'lease@destructive'   'Set the hours until the platform deletes a hosted cluster'
    'kubeconfig'          'Write the agent kubeconfig of a hosted cluster to a file'
  )
  :usage "Clusters through the kubehz api (agent tools)" "${@}"
  "${usage[@]}"
}

# ── the leaves ───────────────────────────────────────────

kubehz::space::list() {
  local output="text"
  local -a args=(
    'output|o'  'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "List the spaces the credential reaches" "${@}"
  kubehz::agent_list space "${output}"
}

kubehz::space::get() {
  local id output="text"
  local -a args=(
    'id'        'Space id (sp-…)'
    'output|o'  'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "Show one space" "${@}"
  kubehz::agent_output "${output}" || return 1
  kubehz::agent_check_id space get "${id}" || return 1
  kubehz::agent_one space "space get ${id}" "${id}" GET "/api/spaces/${id}" || return 1
  kubehz::agent_print "${output}" space_detail space_detail_text
}

kubehz::space::create() {
  local name="" slug="" nodes="" namespaces="" object_cap_kib="" region="" lease_hours="" output="text"
  local -a args=(
    'name|:!'            'Display name of the space'
    'slug|:!'            'DNS label of the space, unique on the platform (the namespace name)'
    'nodes|'             "Node limit; default: the platform's"
    'namespaces|'        "Namespace limit; default: the platform's"
    'object-cap-kib|'    "Size cap of one Secret or ConfigMap in KiB; default: the platform's"
    'region|'            "Region to place the space in; default: the platform's choice"
    'lease-hours|'       'Hours until the platform deletes the space (1 to 720); an agent key gets 2 without it'
    'output|o'           'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "Create a space (an agent key sets a lease)" "${@}"
  kubehz::agent_output "${output}" || return 1

  local action body i flag field value number
  # flag, request field, value: in the order the Go twin checks them.
  local -a numbers=(
    nodes           maxNodes       "${nodes}"
    namespaces      maxNamespaces  "${namespaces}"
    object-cap-kib  maxObjectKiB   "${object_cap_kib}"
  )
  action="space create $(kubehz::agent_clean_e "${slug}")"
  body=$(jq -cn --arg name "${name}" --arg slug "${slug}" '{name: $name, slug: $slug}') || return 1
  # A number the flags leave out is not sent: the api applies its default.
  for (( i = 0; i < ${#numbers[@]}; i += 3 )); do
    flag="${numbers[i]}"
    field="${numbers[i + 1]}"
    value="${numbers[i + 2]}"
    [[ -n "${value}" ]] || continue
    if ! kubehz::agent_match "${value}" '^[0-9]+$' || ! number=$(kubehz::space_number_value "${value}"); then
      error "kubehz ${action}: --${flag} $(kubehz::agent_clean_e "${value}") is not valid"
      echo "  Use a whole number of 1 or more, or leave the flag out for the platform default." >&2
      return 1
    fi
    body=$(jq -c --arg f "${field}" --argjson n "${number}" '. + {($f): $n}' <<<"${body}") || return 1
  done
  if [[ -n "${region}" ]]; then
    body=$(jq -c --arg r "${region}" '. + {region: $r}' <<<"${body}") || return 1
  fi
  if [[ -n "${lease_hours}" ]]; then
    kubehz::agent_hours "${action}" lease-hours "${lease_hours}" || return 1
    body=$(jq -c --argjson n "${KUBEHZ_AGENT_HOURS}" '. + {leaseHours: $n}' <<<"${body}") || return 1
  fi
  kubehz::agent_one space "${action}" "" POST "/api/spaces" "${body}" || return 1
  kubehz::agent_print "${output}" space space_text
}

kubehz::space::delete() {
  local id output="text"
  local -a args=(
    'id'        'Space id (sp-…)'
    'output|o'  'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "Delete a space" "${@}"
  kubehz::agent_output "${output}" || return 1
  kubehz::agent_check_id space delete "${id}" || return 1
  kubehz::agent_one space "space delete ${id}" "${id}" DELETE "/api/spaces/${id}" || return 1
  kubehz::agent_print "${output}" '{id: (.id | str), status: (.status | str)}' \
    '"space \(.id | cell): \(.status | cell)"'
}

kubehz::space::lease() {
  local id hours="" output="text"
  local -a args=(
    'id'        'Space id (sp-…)'
    'hours|:!'  'Hours from now until the platform deletes it (1 to 720)'
    'output|o'  'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "Set the hours until the platform deletes a space" "${@}"
  kubehz::agent_lease space "${id}" "${hours}" "${output}"
}

kubehz::space::kubeconfig() {
  # force: the inherited global --force (the handover::receive idiom).
  local id file="" output="text" force="${force:-0}"
  local -a args=(
    'id'           'Space id (sp-…)'
    'file|:!'      'Write the kubeconfig to this file (mode 0600) and print the path; a file that exists needs --force'
    'force|f:^:+'  'Replace a file that exists (a link is written through)'
    'output|o'     'Output format: text, json or yaml'
    "${args[@]:-}"
  )
  :args "Write the agent kubeconfig of a space to a file" "${@}"
  kubehz::agent_kubeconfig space "${id}" "${file}" "${force}" "${output}"
}

kubehz::cluster::list() {
  local output="text"
  local -a args=(
    'output|o'  'Output format: text, json or yaml'
