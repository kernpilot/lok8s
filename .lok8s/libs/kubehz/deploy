#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-deploy — render and apply the in-cluster kubehz agent.
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.
#
# TWO AGENTS, ONE HEARTBEAT
# =========================
# lok8s ships two in-cluster agents that speak the same platform contract:
#
#   cronjob   CronJob kubehz-heartbeat, manifests/agent/. A POSIX-sh script in
#             a stock alpine/k8s image. It owns the cluster IDENTITY: it mints
#             the agent-token A and the claim-code C into Secret kubehz-agent
#             (create-if-absent, never rotated) and enrolls their SHA-256
#             hashes with the platform. It beats every five minutes with a
#             schema-1 snapshot: nodes, control-plane component health,
#             certificate expiry, and the 24 h handover assessment.
#
#   operator  Deployment kubehz-live-agent, manifests/live-agent/. The Go
#             agent from the public kubehz-agent repo. Typed client-go
#             informers push a debounced schema-2 snapshot within seconds of a
#             change — nodes with capacity and instance type, pod phase
#             counts, warning events, machine-controller failures, and the
#             lok8s addon inventory. It also runs the desired-state pull loop,
#             which is what makes worker scaling, self-healing and worker
#             upgrades possible when the platform authorizes them.
#
# EXACTLY ONE of them may beat. The platform stores lastHeartbeatSnapshot
# latest-wins, so a schema-1 beat lands on top of a schema-2 one and blanks
# every field the CronJob does not send — workloads, events, actions,
# machineIssues, inventory, the agent identity. It also flips the cluster's
# expectedIntervalSeconds between 60 s and 300 s, which makes `connected` flap.
# Two producers do not merge; they erase each other, and the dashboard shows a
# live view that empties itself every five minutes.
#
# The lever is a single in-cluster value: KUBEHZ_HEARTBEAT_OWNER in the
# ConfigMap kubehz-agent-config, written here from spec.kubehz.agent.
#
#   - "cronjob"  — the CronJob beats. The live agent is not deployed, and this
#                  command REMOVES it if a previous run installed it.
#   - "operator" — the live agent beats. The CronJob still runs: it keeps the
#                  identity Secret bootstrapped and enrolled (the Go agent
#                  reads that Secret and mints nothing), then exits before the
#                  snapshot, the heartbeat POST and the desired-state poll.
#
# An unset key reads as "cronjob", so a cluster installed before this key
# existed keeps beating exactly as it did.
#
# The APPLY ORDER is load-bearing, and it differs per direction so that no
# instant has two live producers:
#
#   to operator: write the marker first (the CronJob stops beating), wait for
#                any in-flight heartbeat pod to finish, then start the live
#                agent.
#   to cronjob:  delete the live agent first (its beat stops with the pod),
#                then write the marker that lets the CronJob beat again.

import ^utils/verbose
import ^utils/http

# Where the vendored manifests live.
KUBEHZ_AGENT_MANIFESTS="${PATH_LOK8S}/libs/kubehz/manifests/agent"
KUBEHZ_LIVE_AGENT_MANIFESTS="${PATH_LOK8S}/libs/kubehz/manifests/live-agent"

# How long to wait for an in-flight heartbeat pod before starting the live
# agent. The CronJob's own activeDeadlineSeconds is 120, so a pod that is
# still running past this is stuck, not busy — we warn and continue rather
# than block a deploy forever.
KUBEHZ_HEARTBEAT_DRAIN_SECONDS=130

# ── Subcommand ───────────────────────────────────────────

# Deploy the in-cluster agent for the active domain via `lo kubehz deploy`.
# Applies against the AMBIENT kubeconfig (exported by main from the active
# domain before dispatch) — switch clusters with `lo use <domain>` first, the
# same rule `lo kubehz claim-code` and `lo kubehz re-enroll` follow.
kubehz::deploy() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local dry_run=0
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    'dry-run|:+'        'Print the rendered manifests and apply nothing'
    "${args[@]:-}"
  )
  :args "Deploy the in-cluster kubehz agent" "${@}"
  [[ -n "${domain}" ]] || { error "No active domain. Use: lo use <domain>"; return 1; }

  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  [[ -f "${cluster_yaml}" ]] || { error "No cluster.lok8s.yaml for domain: ${domain}"; return 1; }

  kubehz::read_config "${cluster_yaml}" || return 1
  # validate_config reads `.kind` off LOK8S_SPEC_FILE for its per-kind hosting
  # rules. `lo kubehz register` gets that from provision::resolve_spec; deploy
  # already HOLDS the spec path, so set it directly — otherwise the per-kind
  # check reads an unbound variable and prints a bash error over our output.
  export LOK8S_SPEC_FILE="${cluster_yaml}"
  kubehz::validate_config || return 1

  # The orchestration lives in kubehz::deploy_agent (no :args) so it is
  # unit-testable without argsh's flag parser — the codebase convention.
  kubehz::deploy_agent "${domain}" "${dry_run}"
}

# ── Orchestration ────────────────────────────────────────

# kubehz::deploy_agent <domain> [dry_run]
# Requires kubehz::read_config to have run (LOK8S_KUBEHZ_* are set).
kubehz::deploy_agent() {
  local domain="${1}" dry_run="${2:-0}"
  local api_url="${LOK8S_KUBEHZ_API_URL}"
  local owner="${LOK8S_KUBEHZ_AGENT:-cronjob}"
  local access="${LOK8S_KUBEHZ_ACCESS:-none}"

  # A Space has no cluster of its own to run an agent in — its nodes enroll
  # with join tickets and the platform operates the control plane.
  if [[ "${LOK8S_KUBEHZ_HOSTING}" == "shared" ]]; then
    error "hosting: shared has no in-cluster agent to deploy (a Space's nodes enroll with 'lo kubehz join')"
    return 1
  fi
  if [[ "${access}" == "none" ]]; then
    error "spec.kubehz.access is 'none' — there is no agent to deploy. Set access: registered (or managed) first."
    return 1
  fi

  # The agent's bearer token travels on this URL, so re-assert HTTPS here:
  # validate_config already checked it, but this value is about to be baked
  # into a ConfigMap that outlives the command.
  http::require_https "${api_url}" "spec.kubehz.apiUrl" || return 1

  # Both values are substituted into YAML with sed. They come from the spec,
  # not from a network response, but a spec is still input — pin their shape
  # before they can carry a delimiter or a newline into a manifest.
  if [[ ! "${domain}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]]; then
    error "refusing to template an implausible cluster domain: ${domain}"
    return 1
  fi
  if [[ ! "${api_url}" =~ ^https://[A-Za-z0-9._~:/?#@!$\&\'\(\)*+,\;=%-]+$ ]]; then
    error "refusing to template an implausible spec.kubehz.apiUrl: ${api_url}"
    return 1
  fi

  local workdir
  workdir=$(mktemp -d) || { error "could not create a render directory"; return 1; }
  # shellcheck disable=SC2064
  trap "rm -rf '${workdir}'" RETURN

  kubehz::render_agent "${workdir}" "${domain}" "${api_url}" "${owner}" "${access}" || return 1

  if (( dry_run )); then
    kubehz::deploy_print "${workdir}" "${owner}" "${access}"
    return $?
  fi

  kubehz::deploy_apply "${workdir}" "${owner}" "${access}" || return 1
  kubehz::deploy_summary "${domain}" "${owner}" "${access}"
}

# ── Render ───────────────────────────────────────────────

# Copy the shipped manifests into <workdir> and substitute the placeholder
# tokens. BOTH trees are always rendered, in either mode: cronjob mode still
# needs the live-agent tree so `kubectl delete -k` has the full object set to
# remove a previous operator install. What `access` decides is only WHICH
# overlay the caller then applies or deletes (base, or managed — a superset).
# Sets KUBEHZ_LIVE_AGENT_OVERLAY to that path.
# Usage: kubehz::render_agent <workdir> <domain> <api_url> <owner> <access>
kubehz::render_agent() {
  local workdir="${1}" domain="${2}" api_url="${3}" owner="${4}" access="${5}"

  [[ -d "${KUBEHZ_AGENT_MANIFESTS}" ]] || {
    error "kubehz agent manifests not found at ${KUBEHZ_AGENT_MANIFESTS}"
    return 1
  }
  mkdir -p "${workdir}/agent" || return 1
  cp -r "${KUBEHZ_AGENT_MANIFESTS}/." "${workdir}/agent/" || return 1

  [[ -d "${KUBEHZ_LIVE_AGENT_MANIFESTS}" ]] || {
    error "kubehz live-agent manifests not found at ${KUBEHZ_LIVE_AGENT_MANIFESTS}"
    return 1
  }
  mkdir -p "${workdir}/live-agent" || return 1
  cp -r "${KUBEHZ_LIVE_AGENT_MANIFESTS}/." "${workdir}/live-agent/" || return 1

  # One substitution pass over every rendered file: the two agents deliberately
  # share the placeholder vocabulary so one pass feeds both.
  local file
  while IFS= read -r -d '' file; do
    sed -i \
      -e "s|KUBEHZ_API_URL_PLACEHOLDER|${api_url}|g" \
      -e "s|CLUSTER_ID_PLACEHOLDER|${domain}|g" \
      -e "s|HEARTBEAT_OWNER_PLACEHOLDER|${owner}|g" \
      "${file}" || return 1
  done < <(find "${workdir}" -type f -name '*.yaml' -print0)

  # Nothing may reach a cluster with a placeholder still in it: an unsubstituted
  # CLUSTER_ID would beat under a nonexistent cluster id, and an unsubstituted
  # owner would read as neither "cronjob" nor "operator" — which the CronJob's
  # guard treats as cronjob, silently arming a second producer.
  local leftovers
  leftovers=$(grep -rl 'PLACEHOLDER' "${workdir}" 2>/dev/null) || leftovers=""
  if [[ -n "${leftovers}" ]]; then
    error "kubehz: rendered manifests still carry a placeholder — refusing to apply:"
    while IFS= read -r file; do
      [[ -z "${file}" ]] || printf '  %s\n' "${file#"${workdir}/"}" >&2
    done <<< "${leftovers}"
    return 1
  fi

  # The overlay the caller will apply/delete, resolved once.
  KUBEHZ_LIVE_AGENT_OVERLAY="${workdir}/live-agent/base"
  [[ "${access}" != "managed" ]] || KUBEHZ_LIVE_AGENT_OVERLAY="${workdir}/live-agent/managed"
}

# ── Dry run ──────────────────────────────────────────────

# Print what would be applied, in apply order, and nothing else.
# Usage: kubehz::deploy_print <workdir> <owner> <access>
kubehz::deploy_print() {
  local workdir="${1}" owner="${2}" access="${3}"

  echo "# --- CronJob agent (kubehz-heartbeat) — identity + enrollment; heartbeat owner: ${owner} ---"
  kustomize build "${workdir}/agent" || return 1
  if [[ "${owner}" == "operator" ]]; then
    echo "---"
    echo "# --- Live agent (kubehz-live-agent) — ${access} tier RBAC ---"
    kustomize build "${KUBEHZ_LIVE_AGENT_OVERLAY}" || return 1
  else
    echo "---"
    echo "# The live agent is NOT deployed in cronjob mode; a previous install would be removed."
  fi
}

# ── Apply ────────────────────────────────────────────────

# Usage: kubehz::deploy_apply <workdir> <owner> <access>
kubehz::deploy_apply() {
  local workdir="${1}" owner="${2}" access="${3}"

  if [[ "${owner}" == "operator" ]]; then
    # 1. The marker first. From the CronJob's next tick on it bootstraps and
    #    enrolls but does not beat, so the beat is unowned rather than
    #    contested while we start the live agent.
    kubectl apply -k "${workdir}/agent" || {
      error "kubehz: could not apply the CronJob agent (identity bootstrap) — nothing else was changed"
      return 1
    }
    # 2. A pod that started BEFORE the marker landed is already past the guard
    #    and will still POST once. Wait it out, so the live agent's first beat
    #    cannot overlap it.
    kubehz::wait_heartbeat_idle
    # 3. Now the live agent, which becomes the only producer.
    kubectl apply -k "${KUBEHZ_LIVE_AGENT_OVERLAY}" || {
      error "kubehz: could not apply the live agent. The CronJob is no longer beating (KUBEHZ_HEARTBEAT_OWNER=operator), so this cluster is reporting NOTHING until you retry or set spec.kubehz.agent back to cronjob and re-run."
      return 1
    }
    return 0
  fi

  # cronjob mode. Remove the live agent BEFORE re-arming the CronJob's beat —
  # the Go agent stops the moment its pod goes, and only then may the other
  # producer start. Deleting the MANAGED overlay removes the base with it, so
  # one delete covers an install made at either tier. The rendered live-agent
  # base owns no Namespace and no Secret on purpose, so this can never take the
  # identity Secret with it.
  kubectl delete -k "${workdir}/live-agent/managed" --ignore-not-found=true 2>/dev/null \
    || debug "no live agent to remove"
  kubectl apply -k "${workdir}/agent" || {
    error "kubehz: could not apply the CronJob agent"
    return 1
  }
}

# Wait for any in-flight heartbeat pod to finish. Usually returns at once
# (nothing is running four minutes out of five). Fail-soft: a probe that
# cannot read pods, or a pod that outlives the CronJob's own 120 s deadline,
# warns and lets the deploy continue.
kubehz::wait_heartbeat_idle() {
  local waited=0 running
  while (( waited < KUBEHZ_HEARTBEAT_DRAIN_SECONDS )); do
    running=$(kubectl -n kubehz-system get pods -l app=kubehz-heartbeat \
      --field-selector=status.phase=Running -o name 2>/dev/null | grep -c .) || running=0
    (( running > 0 )) || return 0
    if (( waited == 0 )); then
      echo "kubehz: waiting for the in-flight heartbeat pod to finish before starting the live agent…"
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
  warn "kubehz: a heartbeat pod is still running after ${KUBEHZ_HEARTBEAT_DRAIN_SECONDS}s — continuing; it may deliver one last schema-1 beat, which the live agent overwrites within a minute"
}

# ── Summary ──────────────────────────────────────────────

# Say what is now running and what the customer actually gets. Honest about
# both directions: what the live agent adds, and what only the CronJob reports.
# Usage: kubehz::deploy_summary <domain> <owner> <access>
kubehz::deploy_summary() {
  local domain="${1}" owner="${2}" access="${3}"

  echo
  if [[ "${owner}" == "operator" ]]; then
    echo "kubehz: live agent deployed for ${domain} (deployment/kubehz-live-agent, ${access} tier)."
    echo "  It owns the heartbeat. The CronJob keeps the identity Secret bootstrapped"
    echo "  and enrolled, and no longer beats — one producer, always."
    echo
    echo "  You get: live view (nodes with capacity and instance type, pod phase counts,"
    echo "  warning events, machine-controller failures, addon inventory), pushed within"
    echo "  seconds of a change instead of every five minutes."
    if [[ "${access}" == "managed" ]]; then
      echo
      echo "  Acting RBAC is applied (worker scaling, self-healing, worker upgrades)."
      echo "  Nothing acts until the platform authorizes it: the agent polls the desired"
      echo "  state and obeys the server's execution flags, which the platform computes"
      echo "  from your tier, this cluster's access, and its own kill switches. Your tier"
      echo "  must allow it (Supporter+) and the platform must have it switched on."
      echo "  Every write runs with your cluster's own credentials — kubehz holds none."
    else
      echo
      echo "  Acting is NOT enabled: access is '${access}', so no acting RBAC was granted"
      echo "  and the desired-state loop stays report-only. Set access: managed to opt in."
    fi
    echo
    echo "  Not reported while the live agent owns the beat: control-plane component"
    echo "  health, certificate expiry, and the 24 h handover assessment ('lo kubehz"
    echo "  assess' will go stale). The live agent does not collect them yet. Set"
    echo "  spec.kubehz.agent: cronjob and re-run to get them back."
  else
    echo "kubehz: heartbeat CronJob deployed for ${domain} (cronjob/kubehz-heartbeat)."
    echo "  It owns the heartbeat and beats every five minutes. Any live agent from a"
    echo "  previous run was removed, so there is one producer."
    echo
    echo "  You get: node status, control-plane component health, certificate expiry,"
    echo "  and the 24 h handover assessment. For the live view and for worker scaling,"
    echo "  self-healing or worker upgrades, set spec.kubehz.agent: operator and re-run."
  fi
  echo
  echo "  Claim this cluster (once): lo kubehz claim-code"
  echo "  Check it beat:             lo kubehz status"
}
