#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# drivers — direct access to a driver's own CLI (`lo drivers <name> <cmd>`)
#
# Sources .lok8s/drivers/<name>/main and dispatches to its main::driver usage
# table (provision/destroy/status/kubeconfig). Mostly a debugging/ops door —
# the normal path is `lo provision`, which routes through provision::dispatch.

main::drivers() {
  local name="" list=0 help=0
  local -a rest args=(
    "list|l:+" "List available drivers"
    "help|h:+" "Show help for driver"
    "name"     "Driver name"
    "rest"     "Driver-specific arguments"
    "${args[@]:-}"
  )
  :args "Driver-specific commands" "${@}"

  if (( list )); then
    echo -e "Available drivers:\n"
    # List available drivers
    for dir in "${PATH_LOK8S}/drivers"/*/; do
      [[ -d "${dir}" ]] || continue
      local d="${dir%/}"
      d="${d##*/}"
      [[ -n "${d}" ]] || continue
      [[ "${d}" == .* ]] && continue
      printf -- "- %s\n" "${d}"
    done
    return 0
  fi

  # No driver named: --help gets usage guidance instead of the misleading
  # "Driver '' not found"; a bare call gets a pointer to --list.
  if [[ -z "${name}" ]]; then
    if (( help )); then
      echo "Usage: lo drivers [--list] <name> [driver args...]"
      echo "Run 'lo drivers --list' to see available drivers."
      return 0
    fi
    error "Driver name required — try: lo drivers --list"
    return 1
  fi

  # The name lands in a path we source — allowlist it (same guard class as
  # bootstrap::dispatch's domain/kind validation).
  if [[ ! "${name}" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    error "Invalid driver name: ${name}"
    return 1
  fi
  if [[ -f "${PATH_LOK8S}/drivers/${name}/main" ]]; then
    # shellcheck disable=SC1090
    source "${PATH_LOK8S}/drivers/${name}/main"
    declare -F main::driver >/dev/null || { error "driver '${name}' has no main::driver entry"; return 1; }
    ! (( help )) || rest+=("--help")
    main::driver "${rest[@]}"
    return $?
  fi

  error "Driver '${name}' not found"
  return 1
}
[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::drivers "${@}"
