#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# deploy — domain artifact deployment
# Applies the single clusters/<domain>/artifacts.yaml produced by `lo build`:
# CRDs first (server-side apply + wait Established), then the rest (server-side
# apply + scoped wait-ready). `-l/--label <key=value>` deploys only the matching
# subset. Workload-plane ordering is intentionally not a framework primitive:
# kubectl handles in-manifest order, Tilt handles runtime deps at the resource
# level, cluster-infra ordering lives in cluster.spec.bootstrap.

import ^utils/types
import ^utils/verbose
import ^utils/kapply

main::deploy() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local label cluster_override
  local -a args=(
    'domain|:^~domain'   'Domain to use'
    'label|l'            'Only deploy resources with this label (key=value; key may be lok8s.dev/<x> or any label key)'
    'cluster-override|'  'Override cluster domain for kubeconfig resolution'
    "${args[@]:-}"
  )
  :args "Deploy the domain artifact" "${@}"
  _resolve_kubeconfig_for_domain

  if [[ -n "${label:-}" ]]; then
    local lkey="${label%%=*}"
    local lval="${label#*=}"
    if [[ "${lkey}" == "${label}" || -z "${lval}" ]]; then
      error "invalid --label '${label}' — expected key=value (e.g. lok8s.dev/name=zitadel)"
      return 1
    fi
    deploy::apply_filtered "${domain}" "${lkey}" "${lval}"
  else
    deploy::apply "${domain}"
  fi
}

main::destroy() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  :args "Destroy a cluster" "${@}"
  provision::dispatch_destroy "${domain}"
}

# deploy::_has_objects — return 0 if a YAML stream contains at least one
# kubernetes object, 1 otherwise. Empty streams (zero docs, comments only,
# whitespace, or only `---` separators) return 1.
#
# Used by apply paths to skip `kubectl apply` gracefully — kubectl apply
# fails with "error: no objects passed to apply" on empty streams, which
# is technically correct but breaks legitimate workflows like a
# label-filtered subset that excludes everything.
#
# Implementation: any line that has a `kind:` declaration is taken as
# evidence of an object. Robust enough for kustomize output (which
# always emits a `kind:` field at the top of each doc).
#
# Usage:
#   if deploy::_has_objects <<< "${stream}"; then ...
#   if deploy::_has_objects < some_file.yaml; then ...
deploy::_has_objects() {
  grep -qE '^kind:[[:space:]]+[A-Za-z]'
}

# deploy::_apply <label> <manifest-stream>
#   Apply a manifest stream in two phases: CRDs first, then everything.
#   Empty streams are a graceful no-op.
#
#   Phase 1: extract + apply CustomResourceDefinitions, then wait for them to
#            become Established. Server-side apply — large CRDs (CNPG, CAPI)
#            exceed the client-side last-applied annotation limit (262144 bytes).
#   Phase 2: apply the whole stream (re-applying the CRDs server-side is a
#            no-op), then wait for the stream's own Deployments/DaemonSets/
#            StatefulSets to become ready (scoped to the manifest, not the whole
#            cluster). Best-effort — a readiness timeout is a ⚠, never fatal.
deploy::_apply() {
  local label="$1" manifest="$2"

  if ! deploy::_has_objects <<< "${manifest}"; then
    debug "No objects for ${label}, skipping apply"
    return 0
  fi

  # Phase 1: CRDs first.
  local crds
  crds=$(yq 'select(.kind == "CustomResourceDefinition")' <<< "${manifest}" 2>/dev/null || true)
  if deploy::_has_objects <<< "${crds}"; then
    debug "Applying CRDs for ${label}"
    echo "${crds}" | kapply::apply --label "${label} crds"
    deploy::wait_crds "${crds}"
  fi

  # Phase 2: apply the rest + scoped wait-ready.
  debug "Applying resources for ${label}"
  echo "${manifest}" | kapply::apply --label "${label}"
  kapply::wait_ready "${label}" 120 <<< "${manifest}"
}

# Apply the domain's single artifact (clusters/<domain>/artifacts.yaml).
# Usage: deploy::apply <domain>
deploy::apply() {
  local domain="${1:-"${DOMAIN_NAME:-lok8s.dev}"}"
  local artifact="${PATH_CLUSTERS}/${domain}/artifacts.yaml"

  if [[ ! -f "${artifact}" ]]; then
    error "no artifact for ${domain}: ${artifact} — run 'lo build' first"
    return 1
  fi

  debug "Deploying ${domain} from ${artifact}"
  deploy::_apply "${domain}" "$(cat "${artifact}")"
}

# Apply only the resources in the domain artifact carrying <label_key>=<label_value>.
# The key is used verbatim: it may be a bare key (app) or a namespaced one
# (lok8s.dev/name). Selective deploy is user opt-in — it requires the user to
# have set kustomize `labels:` (or metadata.labels) on the targets they want to
# address.
# Usage: deploy::apply_filtered <domain> <label_key> <label_value>
deploy::apply_filtered() {
  local domain="$1" label_key="$2" label_value="$3"
  local artifact="${PATH_CLUSTERS}/${domain}/artifacts.yaml"

  # Validate label key/value to prevent yq injection (the value is interpolated
  # into a yq expression below).
  if [[ ! "${label_key}" =~ ^[a-zA-Z0-9._/-]+$ ]] || [[ ! "${label_value}" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    error "Invalid filter: key and value must be alphanumeric with . _ - /"
    return 1
  fi

  if [[ ! -f "${artifact}" ]]; then
    error "no artifact for ${domain}: ${artifact} — run 'lo build' first"
    return 1
  fi

  # Filter the single domain artifact by the (full) label key = value.
  local filtered
  filtered=$(yq "select(.metadata.labels.\"${label_key}\" == \"${label_value}\")" "${artifact}" 2>/dev/null || true)
  if ! deploy::_has_objects <<< "${filtered}"; then
    warn "no objects match ${label_key}=${label_value} in ${artifact}"
    return 0
  fi

  debug "Deploying ${domain} subset (${label_key}=${label_value})"
  deploy::_apply "${domain} (${label_key}=${label_value})" "${filtered}"
}

# Wait for CRDs to become established.
deploy::wait_crds() {
  local crds="$1"
  local crd_name
  while IFS= read -r crd_name; do
    [[ -n "${crd_name}" ]] || continue
    debug "Waiting for CRD: ${crd_name}"
    kubectl wait --for=condition=Established crd/"${crd_name}" --timeout=60s 2>/dev/null || {
      warn "CRD ${crd_name} not established within timeout"
    }
  done < <(echo "${crds}" | yq -r '.metadata.name // ""')
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::deploy "${@}"
