#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# hetzner — Hetzner Cloud provider
# Declarative resource provisioning from JSON/YAML descriptors via hcloud CLI.
# Supports cloud VMs + bare metal (Robot) + per-server cloud-init.
# Adapted from github.com/lanisce/cloud-init/provider/hetzner

PATH_SCRIPTS="${PATH_LOK8S}"
import ^utils/verbose
import ^utils/types

: "${CLOUD_HETZNER_JSON:=""}"
: "${CLOUD_DRY_RUN:=""}"
: "${CLOUD_DRY_RUN_PATH:=""}"
# Hetzner Robot (dedicated servers) REST API base. Overridable for tests.
: "${HROBOT_API:=https://robot-ws.your-server.de}"
# Robot REST API timeouts (seconds). Every Robot curl is `--fail` + timed out so
# an HTTP 4xx/5xx or a hang can never read as success. The rescue/reset/lookup
# path uses the longer pair; doctor uses the shorter *_DOCTOR_* pair to stay fast.
: "${HROBOT_CONNECT_TIMEOUT:=10}"
: "${HROBOT_MAX_TIME:=30}"
: "${HROBOT_DOCTOR_CONNECT_TIMEOUT:=5}"
: "${HROBOT_DOCTOR_MAX_TIME:=8}"
# Marker that exists ONLY inside Hetzner's rescue system — the single source of
# truth for the read-only rescue-vs-installed SSH probe (rebuild barrier + doctor).
_HETZNER_RESCUE_MARKER="/root/.oldroot/nfs/install/installimage"

_HETZNER_DIR="${BASH_SOURCE[0]%/*}"
# shellcheck source=utils/json.sh
source "${_HETZNER_DIR}/utils/json.sh"
# shellcheck source=utils/resources.sh
source "${_HETZNER_DIR}/utils/resources.sh"

# ── Provider contract ────────────────────────────────────
#
# Implements provider::* from .lok8s/utils/provider.
# PROVIDER_CONFIG_FILE is a YAML or JSON descriptor file.
# When it's a JSON descriptor (hetzner.json format), the full
# hetzner::create loop handles all resource types with per-server
# cloud-init hooks. When it's simple YAML config fields, the
# provider reads the config and dispatches to the create loop.

_cfg() { yq -r "${1}" "${PROVIDER_CONFIG_FILE}"; }

# _validate_node_labels <labels-json> [<node-name>]
# Light k8s-label validity guard: drop any key/value that violates the
# Kubernetes label constraints and warn, so a bad label fails EARLY here
# (clear message, keeps provisioning) instead of late inside `kubeone apply`
# (opaque kubeadm/labelNodes error). Rules enforced (k8s syntax):
#   value: <=63 chars, empty OR [alnum]([alnum._-]*[alnum])?
#   key:   optional "<dns-subdomain>/" prefix (<=253) + name segment
#          <=63 chars matching [alnum]([alnum._-]*[alnum])?
# A single trailing "-" on a key is KubeOne's addRemoveKeyValues REMOVAL
# marker ("key-": "" deletes the Node label on the next apply) — the key is
# validated as if the marker were absent, so a removal entry passes through.
# Echoes the filtered labels JSON map. Proportionate: skip+warn, not fatal.
_validate_node_labels() {
  local labels_json="${1:-"{}"}" node="${2:-node}"
  local dropped
  dropped=$(echo "${labels_json}" | jq -r '
    def valid_seg: test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_value: . == "" or test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_key:
      (sub("-$"; "") | split("/")) as $p
      | (if ($p | length) == 1 then ($p[0] | valid_seg)
         elif ($p | length) == 2 then (($p[0] | length) <= 253 and ($p[0] | test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")) and ($p[1] | valid_seg))
         else false end);
    to_entries[] | select((.key | valid_key | not) or (.value | valid_value | not)) | .key' 2>/dev/null)
  if [[ -n "${dropped}" ]]; then
    local k
    while IFS= read -r k; do
      [[ -n "${k}" ]] || continue
      warn "node ${node}: dropping invalid k8s label '${k}' (violates key/value syntax or 63-char limit)"
    done <<< "${dropped}"
  fi
  echo "${labels_json}" | jq -c '
    def valid_seg: test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_value: . == "" or test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_key:
      (sub("-$"; "") | split("/")) as $p
      | (if ($p | length) == 1 then ($p[0] | valid_seg)
         elif ($p | length) == 2 then (($p[0] | length) <= 253 and ($p[0] | test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")) and ($p[1] | valid_seg))
         else false end);
    with_entries(select((.key | valid_key) and (.value | valid_value)))'
}

# shellcheck disable=SC2120 # optional config arg; the sole caller invokes it arg-less
provider::validate() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"

  command -v hcloud &>/dev/null || {
    error "hcloud CLI not found. Install: https://github.com/hetznercloud/cli"
    return 1
  }
  credentials::require hetzner || return 1
  # hcloud auth: HCLOUD_TOKEN env is sufficient (CI/automation); a CLI
  # context is the interactive alternative — require either, then prove
  # the credentials actually work with a cheap read call.
  local context
  context="$(hcloud context active 2>/dev/null || echo "")"
  if [[ -z "${HCLOUD_TOKEN:-}" && -z "${context}" ]]; then
    error "No hcloud credentials: set HCLOUD_TOKEN or run: hcloud context create <name>"
    return 1
  fi
  hcloud server-type list -o noheader &>/dev/null || {
    error "hcloud API not reachable with the provided credentials"
    return 1
  }
  debug "hetzner provider validated (${context:+context: ${context}}${context:-HCLOUD_TOKEN env})"
}

provider::credential_data() {
  [[ -n "${HCLOUD_TOKEN:-}" ]] || { error "HCLOUD_TOKEN not set"; return 1; }
  echo "hcloud-token=${HCLOUD_TOKEN}"
  [[ -z "${HROBOT_USER:-}" ]]     || echo "robot-user=${HROBOT_USER}"
  [[ -z "${HROBOT_PASSWORD:-}" ]] || echo "robot-password=${HROBOT_PASSWORD}"
}

provider::provision() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # Log all operations to a file (always, regardless of quiet mode)
  export CLOUD_LOG_FILE="${work_dir}/hetzner-provision.log"
  mkdir -p "${work_dir}"
  : > "${CLOUD_LOG_FILE}"
  _hetzner_log "provision started: config=${config_file} work_dir=${work_dir}"

  [[ -f "${config_file}" ]] || { error "config not found: ${config_file}"; return 1; }

  # Source the cloud-config generator (for per-server cloud-init)
  local cc_script="${PATH_LOK8S}/providers/hetzner/cloud-config"
  if [[ -f "${cc_script}" ]]; then
    # shellcheck source=/dev/null
    source "${cc_script}"
  fi

  # Set up cloud-init environment from config. The CLOUD_PATH / CLOUD_PATH_LIB /
  # CLOUD_USER / CLOUD_GROUP / CLOUD_PATH_PUB resolution is shared with
  # provider::rebuild (one helper, so the two can't drift). CLOUD_PATHD is
  # provision-specific: the whole-cluster module set from .cloudInit.modules
  # (rebuild overrides CLOUD_PATHD per server from each server's #cloud.d).
  hetzner::_export_cloudinit_env "${config_file}"
  local ci_modules
  ci_modules=$(_cfg '.cloudInit.modules // ""' 2>/dev/null || echo "")
  export CLOUD_PATHD="${ci_modules}"

  # Load the descriptor (JSON or YAML → JSON)
  CLOUD_HETZNER_JSON="$(envsubst < "${config_file}")"
  # If the config is YAML (not JSON), convert via yq
  if ! echo "${CLOUD_HETZNER_JSON}" | jq empty 2>/dev/null; then
    CLOUD_HETZNER_JSON="$(yq -o json '.' "${config_file}")"
  fi

  # Run the full provisioning sequence (JSON descriptor loop)
  hetzner::lookup
  hetzner::ssh-key
  hetzner::floating-ip
  hetzner::network
  hetzner::load-balancer
  hetzner::server
  hetzner::volume

  # Dump result state
  hetzner::json '.' > "${work_dir}/hetzner.dump.json"
  debug "hetzner provision complete"
}

provider::destroy() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # Try to read cluster_name from config, fall back to dump state
  local cluster_name=""
  cluster_name=$(_cfg '.cluster_name // ""' 2>/dev/null || echo "")
  if [[ -z "${cluster_name}" ]] && [[ -f "${work_dir}/hetzner.dump.json" ]]; then
    cluster_name=$(jq -r '.name // .cluster_name // empty' "${work_dir}/hetzner.dump.json" 2>/dev/null || echo "")
  fi

  # Fall back to reading the name field from the JSON descriptor
  if [[ -z "${cluster_name}" ]] && [[ -f "${config_file}" ]]; then
    cluster_name=$(jq -r 'if .server then .server[0].name | split("-") | .[:-2] | join("-") else .cluster_name // empty end' "${config_file}" 2>/dev/null || echo "")
  fi

  [[ -n "${cluster_name}" ]] || { error "cannot determine cluster name for destroy"; return 1; }

  local selector="lok8s.dev/cluster=${cluster_name}"
  debug "destroying hetzner resources for ${cluster_name}"

  local ids
  for resource in load-balancer server placement-group firewall volume floating-ip ssh-key network; do
    ids=$(hcloud "${resource}" list -o json -l "${selector}" | jq -r '.[].id' 2>/dev/null || echo "")
    for id in ${ids}; do
      debug "deleting ${resource} ${id}"
      hcloud "${resource}" delete "${id}" 2>/dev/null || true
    done
  done

  debug "hetzner destroy complete for ${cluster_name}"
}

# ── Standard output ──────────────────────────────────────

provider::output() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  local cluster_name ssh_user
  cluster_name=$(_cfg '.cluster_name // ""')
  ssh_user=$(_cfg '.sshUser // .cloudInit.user // "root"')

  local selector="lok8s.dev/cluster=${cluster_name}"

  local servers_json lb_json net_json
  servers_json=$(hcloud server list -o json -l "${selector}")
  lb_json=$(hcloud load-balancer list -o json -l "${selector}")
  # Networks aren't created with the cluster label, so the label lookup
  # returns nothing → the CCM never gets the network ID → node init hangs.
  # Look the network up by its descriptor NAME instead (unique per project).
  local net_name_desc
  net_name_desc=$(_cfg '.network[0].name // ""' 2>/dev/null || echo "")
  net_json=$(hcloud network list -o json -l "${selector}")
  if [[ "$(echo "${net_json}" | jq 'length' 2>/dev/null || echo 0)" == "0" && -n "${net_name_desc}" ]]; then
    net_json=$(hcloud network list -o json | jq --arg n "${net_name_desc}" '[.[] | select(.name == $n)]')
  fi

  local lb_address lb_private
  lb_address=$(echo "${lb_json}" | jq -r '.[0].public_net.ipv4.ip // empty' 2>/dev/null || echo "")
  # The LB's PRIVATE IP (on the attached network, = k8sServiceHost). The apiserver
  # serving cert must cover it as a SAN or CP (re)joins fail "apiserver cert not
  # valid for <ip>". Surfaced so _append_inventory adds it to alternativeNames
  # automatically (no manual KUBEONE_EXTRA_SANS).
  lb_private=$(echo "${lb_json}" | jq -r '.[0].private_net[0].ip // empty' 2>/dev/null || echo "")

  # Build access array from SSH key entries in the descriptor
  local access="[]"
  local ssh_private_key ssh_public_key
  ssh_private_key=$(_cfg '.sshPrivateKey // ""' 2>/dev/null || echo "")
  ssh_public_key=$(_cfg '.sshPublicKey // ""' 2>/dev/null || echo "")

  # Default access entry for cloud VMs
  access=$(jq -n \
    --arg user "${ssh_user}" \
    --arg privkey "${ssh_private_key}" \
    --arg pubkey "${ssh_public_key}" \
    '[{"id": "default", "type": "ssh", "user": $user, "port": 22, "privateKey": $privkey, "publicKey": $pubkey}]')

  # Check for bare metal servers with different access
  if [[ -f "${config_file}" ]]; then
    local desc
    # Normalize to JSON (yq reads JSON too) so bare-metal extraction works for a
    # YAML descriptor, matching how _cfg/desc are resolved elsewhere.
    desc=$(yq -o json '.' "${config_file}")
    local has_root
    has_root=$(echo "${desc}" | jq '[.server[]? | select(.["#cloud.root"] == "true")] | length')
    if (( has_root > 0 )); then
      local robot_key
      robot_key=$(echo "${desc}" | jq -r '.server[]? | select(.["#cloud.root"] == "true") | .["#ssh-private-key"] // "" | select(. != "")' | head -1)
      access=$(echo "${access}" | jq \
        --arg user "${ssh_user}" \
        --arg privkey "${robot_key:-${ssh_private_key}}" \
        '. + [{"id": "dedicated", "type": "ssh", "user": $user, "port": 22, "privateKey": $privkey}]')
    fi
  fi

  local nodes="[]"

  # Cloud VMs from hcloud
  local server
  while IFS= read -r server; do
    [[ -n "${server}" ]] || continue
    local name pub_ip priv_ip role group
    name=$(echo "${server}" | jq -r '.name')
    pub_ip=$(echo "${server}" | jq -r '.public_net.ipv4.ip')
    priv_ip=$(echo "${server}" | jq -r '.private_net[0].ip // .public_net.ipv4.ip')
    role=$(echo "${server}" | jq -r '.labels["lok8s.dev/role"] // "worker"')
    group=$(echo "${server}" | jq -r '.labels["lok8s.dev/group"] // "default"')
    # Node labels to stamp on the k8s Node (via kubeone labelNodes). Carry every
    # hcloud server label EXCEPT the lok8s.dev/{cluster,role,group} orchestration
    # keys (those select infra, they are not node taxonomy). This is how the
    # tier.kubehz.cloud/* + capability.* + role.kubehz.cloud/platform taxonomy
    # reaches the Node.
    local node_labels
    node_labels=$(echo "${server}" | jq -c '(.labels // {}) | del(.["lok8s.dev/cluster"], .["lok8s.dev/role"], .["lok8s.dev/group"])')
    node_labels=$(_validate_node_labels "${node_labels}" "${name}")

    nodes=$(echo "${nodes}" | jq \
      --arg name "${name}" --arg role "${role}" --arg group "${group}" \
      --arg pub "${pub_ip}" --arg priv "${priv_ip}" \
      --arg user "${ssh_user}" --argjson labels "${node_labels}" \
      '. + [{"name": $name, "role": $role, "group": $group, "public_ip": $pub, "private_ip": $priv, "access": "default", "ssh_user": $user, "ssh_port": 22, "labels": $labels}]')
  done < <(echo "${servers_json}" | jq -c '.[]')

  # Bare metal servers from JSON descriptor (#cloud.root with #external-ip)
  if [[ -f "${config_file}" ]]; then
    local desc
    desc="${desc:-$(yq -o json '.' "${config_file}")}"
    while IFS= read -r server; do
      [[ -n "${server}" ]] || continue
      local name pub_ip priv_ip labels role group
      name=$(echo "${server}" | jq -r '.name')
      pub_ip=$(echo "${server}" | jq -r '.["#external-ip"] // empty')
      [[ -n "${pub_ip}" ]] || continue
      priv_ip=$(echo "${server}" | jq -r '.["#internal-ip"] // .["#external-ip"]')
      labels=$(echo "${server}" | jq -r '.["#labels"] // ""')
      role="worker"
      group="dedicated"
      [[ "${labels}" != *"role=control-plane"* ]] || role="control-plane"
      # Parse the comma-separated "k=v,k=v" #labels string into a node-label map,
      # dropping the lok8s.dev/{cluster,role,group} orchestration keys (same rule
      # as the cloud-VM path). Also drop the bare `role` key: `role=control-plane`
      # is an orchestration SELECTOR consumed above to set the node role — it is
      # not node taxonomy and must not survive as a Node label. Everything else —
      # the tier.kubehz.cloud/*, capability.*, role.kubehz.cloud/platform taxonomy
      # — becomes a Node label kubeone stamps on provision AND recover.
      # split("=") then rejoin .[1:] so a value that itself contains "=" (e.g.
      # base64 padding, k=a=b) is preserved intact instead of truncated at the
      # first "=". select((.[0]|length) > 0) drops a leading "=" / empty key
      # ("=orphan") which would otherwise emit a "" label key.
      local node_labels
      node_labels=$(echo "${labels}" | jq -R -c 'split(",") | map(select(length>0) | split("=") | select((.[0]|length) > 0) | {(.[0]): (.[1:]|join("="))}) | add // {}
        | del(.["lok8s.dev/cluster"], .["lok8s.dev/role"], .["lok8s.dev/group"], .["role"])')
      node_labels=$(_validate_node_labels "${node_labels}" "${name}")

      nodes=$(echo "${nodes}" | jq \
        --arg name "${name}" --arg role "${role}" --arg group "${group}" \
        --arg pub "${pub_ip}" --arg priv "${priv_ip}" \
        --arg user "${ssh_user}" --argjson labels "${node_labels}" \
        '. + [{"name": $name, "role": $role, "group": $group, "public_ip": $pub, "private_ip": $priv, "access": "dedicated", "ssh_user": $user, "ssh_port": 22, "labels": $labels}]')
    done < <(echo "${desc}" | jq -c '.server[]? | select(.["#cloud.root"] == "true")')
  fi

  local net_id net_name net_cidr
  net_id=$(echo "${net_json}" | jq -r '.[0].id // empty' 2>/dev/null || echo "")
  net_name=$(echo "${net_json}" | jq -r '.[0].name // empty' 2>/dev/null || echo "")
  net_cidr=$(echo "${net_json}" | jq -r '.[0].ip_range // empty' 2>/dev/null || echo "")

  jq -n \
    --arg ep "${lb_address}" \
    --arg eppriv "${lb_private}" \
    --argjson access "${access}" \
    --argjson nodes "${nodes}" \
    --arg net_id "${net_id}" --arg net_name "${net_name}" --arg net_cidr "${net_cidr}" \
    '{
      "api": {"endpoint": $ep, "privateEndpoint": $eppriv, "port": 6443},
      "access": $access,
      "nodes": $nodes,
      "network": {"id": $net_id, "name": $net_name, "cidr": $net_cidr}
    }'
}

provider::status() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  local cluster_name
  cluster_name=$(_cfg '.cluster_name // ""')

  local servers_json running total
  servers_json=$(hcloud server list -o json -l "lok8s.dev/cluster=${cluster_name}")
  total=$(echo "${servers_json}" | jq 'length')
  running=$(echo "${servers_json}" | jq '[.[] | select(.status == "running")] | length')

  if (( total == 0 )); then echo "NotFound"
  elif (( running == total )); then echo "Running"
  else echo "Partial (${running}/${total} running)"; fi
}

# ── Optional hook: rebuild ───────────────────────────────
#
# provider::rebuild <config_file> <work_dir>
#   Reset the descriptor's EXISTING nodes to the state provider::provision
#   expects for a fresh install — WITHOUT recreating the cloud resources
#   (IPs, network, load-balancer are preserved). Descriptor-driven: it acts
#   ONLY on the servers declared in the descriptor.
#     • Cloud VMs (no #cloud.root)  → reimaged in place via `hcloud server
#       rebuild --image <descriptor image> --user-data-from-file <fresh
#       cloud-init>` (same generator provision's create hook uses).
#     • Bare-metal (#cloud.root)    → booted into the Robot rescue system
#       (activate rescue with the descriptor key's fingerprint + hardware
#       reset), ready for installimage.
#   Barrier: waits until every cloud VM reports cloud-init done AND every
#   bare-metal node is in rescue. Returns non-zero if any node fails.
#
#   It does NOT wipe data disks: that is the descriptor's #wipe-devices
#   feature, honored by provision's installimage hook — re-adding an inline
#   wipe here would double-wipe. This hook is DESTRUCTIVE (it reimages nodes)
#   but does not prompt: the caller (a future `lo recover`) owns consent.
provider::rebuild() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  [[ -f "${config_file}" ]] || { error "config not found: ${config_file}"; return 1; }
  mkdir -p "${work_dir}"
  export CLOUD_LOG_FILE="${work_dir}/hetzner-rebuild.log"
  : > "${CLOUD_LOG_FILE}"
  _hetzner_log "rebuild started: config=${config_file} work_dir=${work_dir}"

  # Dry-run plumbing (shared with provision's dry-run::cmd): with CLOUD_DRY_RUN
  # every destructive action is PRINTED instead of executed, so a future
  # `lo recover --dry-run` prints the full plan and reimages NOTHING. dry-run::cmd
  # needs a writable CLOUD_DRY_RUN_PATH — default it under work_dir if the caller
  # left it unset.
  [[ -z "${CLOUD_DRY_RUN:-}" || -n "${CLOUD_DRY_RUN_PATH:-}" ]] || \
    CLOUD_DRY_RUN_PATH="${work_dir}/dry-run"

  # Load the descriptor (JSON, or YAML → JSON) exactly like provision.
  local desc
  desc="$(envsubst < "${config_file}")"
  if ! echo "${desc}" | jq empty 2>/dev/null; then
    desc="$(yq -o json '.' "${config_file}")"
  fi

  # Cluster label — the scope EVERY destructive call is confined to, exactly as
  # provider::destroy / provider::output do. No cluster_name → refuse to act.
  local cluster_name selector
  cluster_name="$(echo "${desc}" | jq -r '.cluster_name // ""')"
  [[ -n "${cluster_name}" ]] || {
    error "rebuild: descriptor has no cluster_name — refusing to act"; return 1; }
  selector="lok8s.dev/cluster=${cluster_name}"

  # Resolved inventory (descriptor + live cloud state) → per-node public IPs.
  local inv
  inv="$(provider::output "${config_file}")" || {
    error "rebuild: could not resolve inventory (provider::output failed)"; return 1; }

  # Cloud-init generation environment (shared with provider::provision).
  local cc_script="${PATH_LOK8S}/providers/hetzner/cloud-config"
  [[ ! -f "${cc_script}" ]] || {
    # shellcheck source=/dev/null
    source "${cc_script}"
  }
  hetzner::_export_cloudinit_env "${config_file}"

  # Readiness-barrier SSH command (identity from the descriptor).
  local ssh_key
  ssh_key="$(echo "${desc}" | jq -r '.sshPrivateKey // ""')"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${ssh_key}" != "~/"* ]] || ssh_key="${HOME}/${ssh_key:2}"
  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=12
                 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
                 -o LogLevel=ERROR)
  [[ -z "${ssh_key}" ]] || ssh_cmd+=(-i "${ssh_key}")

  # Rescue-key fingerprint (bare-metal only) — from the descriptor public key
  # unless explicitly overridden. Derived once, reused for every worker.
  local fingerprint="${PROVIDER_ROBOT_RESCUE_FP:-}"

  local count
  count="$(echo "${desc}" | jq '(.server // []) | length')"

  # ── Phase 1 — ATOMIC PREFLIGHT (read-only) ──────────────────────────────
  # Resolve and validate EVERY node before touching anything: name sanity, a
  # resolvable public IP, and the destructive target itself — cloud VMs must
  # resolve to exactly one server carrying the cluster label; bare-metal nodes
  # to exactly one Robot server whose IP equals the descriptor #external-ip
  # (NOT its non-unique free-text server_name). Any failure aborts here with
  # NOTHING reimaged/reset — no partial recovery, no acting on a foreign box.
  local -a plan=() cloud_ips=() metal_ips=()
  local idx server name is_root pub image cloud_d ci num ext_ip
  for (( idx=0; idx<count; idx++ )); do
    server="$(echo "${desc}" | jq -c ".server[${idx}]")"
    name="$(echo "${server}" | jq -r '.name // ""')"
    [[ -n "${name}" ]] || { error "rebuild: server[${idx}] has no name — aborting"; return 1; }
    # Defense in depth: only ever act on plausible resource names.
    [[ "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || {
      error "rebuild: refusing suspicious server name '${name}'"; return 1; }
    is_root="$(echo "${server}" | jq -r '.["#cloud.root"] // ""')"
    pub="$(echo "${inv}" | jq -r --arg n "${name}" '.nodes[] | select(.name==$n) | .public_ip // empty')"
    # A node scheduled for rebuild MUST have a resolvable IP — else the barrier
    # can't confirm it reached its target state (it would be silently skipped
    # from the wait set), so we refuse rather than under-verify.
    [[ -n "${pub}" ]] || {
      error "rebuild: node '${name}' has no resolvable public IP in the inventory — aborting (touch nothing)"; return 1; }

    if [[ "${is_root}" == "true" ]]; then
      # ── Bare-metal: resolve to exactly ONE Robot server BY IP ──
      if [[ -z "${HROBOT_USER:-}" || -z "${HROBOT_PASSWORD:-}" ]]; then
        error "rebuild: bare-metal node '${name}' needs Robot creds (HROBOT_USER/HROBOT_PASSWORD)"; return 1
      fi
      if [[ -z "${fingerprint}" ]]; then
        fingerprint="$(hetzner::_rescue_fingerprint "$(echo "${desc}" | jq -r '.sshPublicKey // ""')")" || fingerprint=""
      fi
      [[ -n "${fingerprint}" ]] || {
        error "rebuild: cannot determine rescue key fingerprint for '${name}' (descriptor .sshPublicKey unreadable; set PROVIDER_ROBOT_RESCUE_FP)"; return 1; }
      ext_ip="$(echo "${server}" | jq -r '.["#external-ip"] // ""')"
      [[ -n "${ext_ip}" ]] || {
        error "rebuild: bare-metal node '${name}' has no #external-ip — cannot resolve it in Robot by IP"; return 1; }
      num="$(hetzner::_robot_server_number_by_ip "${ext_ip}")" || num=""
      [[ -n "${num}" ]] || {
        error "rebuild: bare-metal node '${name}' (${ext_ip}) did not resolve to exactly one Robot server by IP — refusing to rescue/reset (name/IP collision, no match, or Robot API error)"; return 1; }
      plan+=("metal"$'\t'"${name}"$'\t'"${num}"$'\t'"${fingerprint}")
      metal_ips+=("${pub}")
    else
      # ── Cloud VM: name must uniquely carry the cluster label ──
      hetzner::_cloud_server_unique_labeled "${name}" "${selector}" || {
        error "rebuild: cloud node '${name}' does not resolve to exactly one server carrying ${selector} — refusing to reimage"; return 1; }
      image="$(echo "${server}" | jq -r '.image // "ubuntu-24.04"')"
      cloud_d="$(echo "${server}" | jq -r '.["#cloud.d"] // ""')"
      declare -F cloud-config::generate &>/dev/null || {
        error "rebuild: cloud-config generator unavailable"; return 1; }
      ci="${work_dir}/rebuild-${name}.cloud-init.yaml"
      export CLOUD_PATHD="${cloud_d}"
      cloud-config::generate > "${ci}" 2>>"${CLOUD_LOG_FILE}" || {
        error "rebuild: cloud-init generation failed for '${name}'"; return 1; }
      plan+=("cloud"$'\t'"${name}"$'\t'"${image}"$'\t'"${ci}")
      cloud_ips+=("${pub}")
    fi
  done

  if (( ${#plan[@]} == 0 )); then
    warn "rebuild: descriptor declares no servers — nothing to do"
    return 0
  fi

  # ── Phase 2 — EXECUTE (destructive). Preflight validated ALL nodes. ─────
  # Under CLOUD_DRY_RUN every destructive action is PRINTED, not run: the cloud
  # reimage via dry-run::cmd (exactly as provision routes its hcloud writes), the
  # Robot rescue+reset via the dry-run branch inside each helper. A failure names
  # the offending node so the operator knows WHICH one failed (and that the
  # cluster may be left partially reimaged).
  local rc=0 entry kind pname pa pb
  for entry in "${plan[@]}"; do
    IFS=$'\t' read -r kind pname pa pb <<<"${entry}"
    if [[ "${kind}" == "metal" ]]; then
      _hetzner_print "🔧 rescue+reset \033[1m${pname}\033[0m (robot#${pa})"
      hetzner::_robot_rescue "${pa}" "${pb}" || {
        error "rebuild: node '${pname}' (robot#${pa}) rescue activation failed — cluster may be partially reimaged"; rc=1; continue; }
      hetzner::_robot_reset  "${pa}" || {
        error "rebuild: node '${pname}' (robot#${pa}) hardware reset failed — cluster may be partially reimaged"; rc=1; continue; }
    else
      _hetzner_print "📦 rebuild \033[1m${pname}\033[0m (image ${pa})"
      dry-run::cmd hcloud server rebuild "${pname}" --image "${pa}" --user-data-from-file "${pb}" || {
        error "rebuild: node '${pname}' reimage failed ('hcloud server rebuild ${pname}') — cluster may be partially reimaged"; rc=1; continue; }
    fi
  done

  # ── Phase 3 — Barrier: all cloud VMs cloud-init-done AND all workers in rescue.
  # Under dry-run nothing was reimaged, so there is no state transition to wait
  # for — short-circuit cleanly. (A real cluster would still be "installed" /
  # never in rescue, so running the barrier here would falsely time out.)
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 dry-run: no node was reimaged — skipping readiness barrier"
    (( rc != 0 )) || _hetzner_print \
      "🧪 dry-run complete — the plan above WOULD reset the nodes; nothing was changed"
    return "${rc}"
  fi

  hetzner::_rebuild_barrier ssh_cmd cloud_ips metal_ips || rc=1

  (( rc != 0 )) || _hetzner_print \
    "✅ rebuild complete — nodes reset (data disks untouched; wipe is #wipe-devices during provision)"
  return "${rc}"
}

# hetzner::_export_cloudinit_env <config_file>
# Export the shared CLOUD_* generation environment (CLOUD_PATH / CLOUD_PATH_LIB /
# CLOUD_USER / CLOUD_GROUP / CLOUD_PATH_PUB) so cloud-config::generate produces
# the same user-data a fresh provision would. The single source of truth for
# both provider::provision and provider::rebuild (they can't drift). CLOUD_PATHD
# is intentionally NOT set here — each caller owns it (provision: whole-cluster
# .cloudInit.modules; rebuild: per-server #cloud.d).
hetzner::_export_cloudinit_env() {
  local config_file="${1}"
  local ci_path ci_user ci_group ci_pub
  ci_path="$(_cfg '.cloudInit.path // ""' 2>/dev/null || echo "")"
  if [[ -n "${ci_path}" && "${ci_path}" != /* ]]; then
    ci_path="$(dirname "${config_file}")/${ci_path}"
  fi
  if [[ -z "${ci_path}" || ! -d "${ci_path}" ]]; then
    ci_path="${PATH_LOK8S}/providers/hetzner/cloud-init"
  fi
  export CLOUD_PATH="${ci_path}"
  export CLOUD_PATH_LIB="${PATH_LOK8S}/providers/hetzner/cloud-init"
  ci_user="$(_cfg '.cloudInit.user // "root"' 2>/dev/null || echo "root")"
  ci_group="$(_cfg '.cloudInit.group // "root"' 2>/dev/null || echo "root")"
  ci_pub="$(_cfg '.cloudInit.sshPubPath // ""' 2>/dev/null || echo "")"
  export CLOUD_USER="${ci_user}" CLOUD_GROUP="${ci_group}"
  export CLOUD_PATH_PUB="${ci_pub:-${HOME}/.ssh}"
  CLOUD_PATH_PUB="${CLOUD_PATH_PUB/#\~/${HOME}}"
}

# hetzner::_rebuild_barrier <ssh_arr> <cloud_ip_arr> <metal_ip_arr>
# Wait (namerefs) until every cloud VM reports `cloud-init status ... done`
# and every bare-metal node is back in the Robot rescue system. Read-only
# probes. Tunables: PROVIDER_REBUILD_WAIT_TRIES / _WAIT_INTERVAL.
#
# LIMITATION: this verifies the target STATE (cloud-init done / booted into
# rescue), NOT that a reimage actually occurred. A stale OS that never got
# reimaged could still report `cloud-init status done` from a prior boot and
# pass the cloud check; a box already sitting in rescue likewise passes the
# metal check. A robust proof would thread a per-run nonce through the reimage
# and read it back — deliberately NOT done here (over-engineering for a recovery
# flow whose caller drives the reset with explicit intent).
hetzner::_rebuild_barrier() {
  local -n _sshref="${1}" _cloudref="${2}" _metalref="${3}"
  local tries="${PROVIDER_REBUILD_WAIT_TRIES:-48}"
  local interval="${PROVIDER_REBUILD_WAIT_INTERVAL:-15}"
  local ssh_user="${CLOUD_USER:-root}"
  local nc="${#_cloudref[@]}" nm="${#_metalref[@]}"
  local i j cloud_ready metal_ready
  for (( i=0; i<tries; i++ )); do
    cloud_ready=0
    for (( j=0; j<nc; j++ )); do
      "${_sshref[@]}" "${ssh_user}@${_cloudref[j]}" \
        'cloud-init status 2>/dev/null | grep -q done' && cloud_ready=$((cloud_ready+1))
    done
    metal_ready=0
    for (( j=0; j<nm; j++ )); do
      "${_sshref[@]}" "root@${_metalref[j]}" \
        "test -x ${_HETZNER_RESCUE_MARKER}" 2>/dev/null && metal_ready=$((metal_ready+1))
    done
    _hetzner_log "barrier: cloud_ready=${cloud_ready}/${nc} metal_ready=${metal_ready}/${nm}"
    [[ "${cloud_ready}" -eq "${nc}" && "${metal_ready}" -eq "${nm}" ]] && return 0
    sleep "${interval}"
  done
  error "rebuild: nodes did not reach target state within $(( tries * interval ))s"
  return 1
}

# hetzner::_rescue_fingerprint <pubkey_path>
# MD5 fingerprint (colon-hex, the form Hetzner Robot registers) of a public key.
hetzner::_rescue_fingerprint() {
  local pub="${1:-}"
  [[ -n "${pub}" ]] || return 1
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${pub}" != "~/"* ]] || pub="${HOME}/${pub:2}"
  [[ -f "${pub}" ]] || return 1
  ssh-keygen -l -E md5 -f "${pub}" 2>/dev/null \
    | grep -oE 'MD5:[0-9a-f:]+' | sed 's/^MD5://' | head -1
}

# hetzner::_robot_server_number_by_ip <ip> [connect_timeout] [max_time]
#   → Robot server_number for the UNIQUE server whose main IP == <ip>.
# Robot's server_name is free-text and NOT unique, so we never match on it for a
# destructive action (a name collision would rescue+reset the wrong bare-metal
# box). Match on server_ip instead and print a number ONLY when EXACTLY ONE
# server matches; empty + non-zero on zero/multiple matches or any API error
# (`--fail` + timeouts so an HTTP 4xx/5xx / hang can't read as a hit).
hetzner::_robot_server_number_by_ip() {
  local ip="${1:-}"
  local connect_timeout="${2:-${HROBOT_CONNECT_TIMEOUT}}" max_time="${3:-${HROBOT_MAX_TIME}}"
  [[ -n "${ip}" ]] || return 1
  local json matches count
  json="$(curl -f -sS --connect-timeout "${connect_timeout}" --max-time "${max_time}" \
            -u "${HROBOT_USER}:${HROBOT_PASSWORD}" "${HROBOT_API}/server" 2>/dev/null)" || return 1
  matches="$(echo "${json}" | jq -c --arg ip "${ip}" \
              '[.[].server | select(.server_ip==$ip)]' 2>/dev/null)" || return 1
  count="$(echo "${matches}" | jq 'length' 2>/dev/null || echo 0)"
  [[ "${count}" == "1" ]] || return 1
  echo "${matches}" | jq -r '.[0].server_number'
}

# hetzner::_cloud_server_unique_labeled <name> <selector>
# Succeed only if EXACTLY ONE hcloud server named <name> carries the cluster
# label — the same scoping destroy/output use — so a rebuild can never reimage a
# name collision, a stale, or a foreign (unlabeled) server.
hetzner::_cloud_server_unique_labeled() {
  local name="${1:-}" selector="${2:-}" n
  [[ -n "${name}" && -n "${selector}" ]] || return 1
  n="$(hcloud server list -o json -l "${selector}" 2>/dev/null \
        | jq --arg n "${name}" '[.[] | select(.name==$n)] | length' 2>/dev/null || echo 0)"
  [[ "${n}" == "1" ]]
}

# hetzner::_robot_rescue <number> <key_fingerprint>
hetzner::_robot_rescue() {
  local num="${1}" fingerprint="${2}"
  # Honor dry-run: PRINT the intended activation and issue no POST. Kept as an
  # explicit branch (not dry-run::cmd) so the Robot user:password on the curl
  # command line is never teed into the plan log.
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 [dry-run] would activate Robot rescue on robot#${num} (POST ${HROBOT_API}/boot/${num}/rescue os=linux authorized_key=${fingerprint})"
    return 0
  fi
  curl -f -sS --connect-timeout "${HROBOT_CONNECT_TIMEOUT}" --max-time "${HROBOT_MAX_TIME}" \
    -u "${HROBOT_USER}:${HROBOT_PASSWORD}" "${HROBOT_API}/boot/${num}/rescue" \
    -d os=linux --data-urlencode "authorized_key=${fingerprint}" >/dev/null 2>&1 \
    || { error "rebuild: rescue activation failed for robot#${num}"; return 1; }
}

# hetzner::_robot_reset <number>  — hardware reset
hetzner::_robot_reset() {
  local num="${1}"
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 [dry-run] would hardware-reset robot#${num} (POST ${HROBOT_API}/reset/${num} type=hw)"
    return 0
  fi
  curl -f -sS --connect-timeout "${HROBOT_CONNECT_TIMEOUT}" --max-time "${HROBOT_MAX_TIME}" \
    -u "${HROBOT_USER}:${HROBOT_PASSWORD}" "${HROBOT_API}/reset/${num}" \
    -d type=hw >/dev/null 2>&1 \
    || { error "rebuild: hardware reset failed for robot#${num}"; return 1; }
}

# ── Optional hook: doctor ────────────────────────────────
#
# provider::doctor <config_file>
#   Transparent, READ-ONLY infrastructure diagnosis. Prints one TAB-separated
#   line per check to stdout — `<status>\t<message>` where status ∈ {ok, warn}
#   — plus a final `summary\t<n> ok, <m> warn` line (the machine-usable
#   summary). Every not-ready item carries actionable advice. This hook NEVER
#   exits non-zero (always returns 0) and NEVER mutates anything. `lo doctor`
#   renders these lines as its "provider / infrastructure" section.
provider::doctor() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # Run the checks in a subshell so nothing they do can flip our exit status.
  local report ok warn
  report="$(hetzner::_doctor_checks "${config_file}" 2>/dev/null)"
  [[ -z "${report}" ]] || printf '%s\n' "${report}"
  ok="$(printf '%s\n' "${report}" | grep -c $'^ok\t' || true)"
  warn="$(printf '%s\n' "${report}" | grep -c $'^warn\t' || true)"
  printf 'summary\t%s ok, %s warn\n' "${ok:-0}" "${warn:-0}"
  return 0
}

# hetzner::_doctor_checks <config_file>
# Emit the per-check `<status>\t<message>` lines. READ-ONLY: only hcloud/Robot
# GETs and non-mutating SSH probes (test -x, cloud-init status). No rebuild,
# reset, rescue, delete, or any write.
hetzner::_doctor_checks() {
  local config_file="${1}"

  # 1) hcloud credentials + API reachability.
  local ctx=""
  ctx="$(hcloud context active 2>/dev/null || echo "")"
  if [[ -n "${HCLOUD_TOKEN:-}" || -n "${ctx}" ]]; then
    if hcloud server-type list -o noheader >/dev/null 2>&1; then
      printf 'ok\thcloud API reachable\n'
    else
      printf 'warn\thcloud credentials set but API not reachable — check HCLOUD_TOKEN / network\n'
    fi
  else
    printf 'warn\tno hcloud credentials — export HCLOUD_TOKEN or run: hcloud context create <name>\n'
  fi

  # 2) Robot credentials + API reachability. robot_api_ok lets later checks
  #    distinguish "API unreachable/errored" from a genuine negative result
  #    (e.g. key not registered) instead of conflating the two.
  local have_robot=0 robot_api_ok=0
  if [[ -n "${HROBOT_USER:-}" && -n "${HROBOT_PASSWORD:-}" ]]; then
    have_robot=1
    if curl -f -sS --connect-timeout "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" --max-time "${HROBOT_DOCTOR_MAX_TIME}" \
         -u "${HROBOT_USER}:${HROBOT_PASSWORD}" "${HROBOT_API}/server" >/dev/null 2>&1; then
      robot_api_ok=1
      printf 'ok\tRobot API reachable\n'
    else
      printf 'warn\tRobot creds set but API not reachable — verify HROBOT_USER/HROBOT_PASSWORD\n'
    fi
  else
    printf 'warn\tRobot creds unset (HROBOT_USER/HROBOT_PASSWORD) — bare-metal rescue/reset unavailable; set them to enable automatic worker reset\n'
  fi

  # Descriptor → JSON.
  [[ -f "${config_file}" ]] || { printf 'warn\tdescriptor not found: %s\n' "${config_file}"; return 0; }
  local desc
  desc="$(envsubst < "${config_file}" 2>/dev/null)"
  echo "${desc}" | jq empty 2>/dev/null || desc="$(yq -o json '.' "${config_file}" 2>/dev/null)"

  local metal_count
  metal_count="$(echo "${desc}" | jq '[(.server // [])[] | select(.["#cloud.root"]=="true")] | length' 2>/dev/null || echo 0)"

  # 3) Rescue SSH key registered in Robot (only with bare-metal + Robot creds).
  #    Distinguish "API errored" from "key not registered" — never report the
  #    key missing when the /key call itself failed.
  if [[ "${metal_count}" =~ ^[0-9]+$ ]] && (( metal_count > 0 )) && (( have_robot )); then
    if (( ! robot_api_ok )); then
      printf 'warn\tcannot verify rescue key — Robot API unreachable (see above); a missing rescue key would lock out a worker reinstall\n'
    else
      local fingerprint
      fingerprint="${PROVIDER_ROBOT_RESCUE_FP:-$(hetzner::_rescue_fingerprint "$(echo "${desc}" | jq -r '.sshPublicKey // ""')" 2>/dev/null)}"
      if [[ -z "${fingerprint}" ]]; then
        printf 'warn\tcannot determine rescue key fingerprint (descriptor .sshPublicKey missing/unreadable) — set PROVIDER_ROBOT_RESCUE_FP\n'
      else
        local keys
        if keys="$(curl -f -sS --connect-timeout "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" --max-time "${HROBOT_DOCTOR_MAX_TIME}" \
                      -u "${HROBOT_USER}:${HROBOT_PASSWORD}" "${HROBOT_API}/key" 2>/dev/null)"; then
          # Exact, whole-value fingerprint match (case-insensitive). A loose
          # substring grep would let a short/truncated fingerprint false-match a
          # longer registered key — compare the /key fingerprint field as a whole.
          if printf '%s' "${keys}" | jq -e --arg fingerprint "${fingerprint}" \
               'any(.[]?; ((.key.fingerprint // "") | ascii_downcase) == ($fingerprint | ascii_downcase))' \
               >/dev/null 2>&1; then
            printf 'ok\trescue SSH key registered in Robot (%s)\n' "${fingerprint}"
          else
            printf 'warn\trescue key %s NOT registered in Robot — a worker reinstall would lock out; add the key in the Robot console (Key management) or via the Robot API before recovering\n' "${fingerprint}"
          fi
        else
          printf 'warn\tcannot verify rescue key — Robot /key API errored (%s NOT confirmed registered); retry or check Robot creds/network\n' "${fingerprint}"
        fi
      fi
    fi
  fi

  # 4) Inventory sanity (control-plane count).
  local inv
  inv="$(provider::output "${config_file}" 2>/dev/null || echo '{}')"
  local cp_count
  cp_count="$(echo "${inv}" | jq '[(.nodes // [])[] | select(.role=="control-plane")] | length' 2>/dev/null || echo 0)"
  if [[ "${cp_count}" =~ ^[0-9]+$ ]] && (( cp_count > 0 )); then
    printf 'ok\tinventory: %s control-plane node(s) resolved\n' "${cp_count}"
  else
    printf 'warn\tinventory: no control-plane nodes resolved — check descriptor labels / hcloud state\n'
  fi

  # SSH identity for read-only node probes.
  local key
  key="$(echo "${desc}" | jq -r '.sshPrivateKey // ""')"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${key}" != "~/"* ]] || key="${HOME}/${key:2}"
  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=6
                 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
  [[ -z "${key}" ]] || ssh_cmd+=(-i "${key}")

  # 5) Per-node: existence/reachability + bare-metal installed-vs-rescue.
  local scount idx server name is_root pub num ext_ip
  scount="$(echo "${desc}" | jq '(.server // []) | length' 2>/dev/null || echo 0)"
  for (( idx=0; idx<scount; idx++ )); do
    server="$(echo "${desc}" | jq -c ".server[${idx}]")"
    name="$(echo "${server}" | jq -r '.name // ""')"
    [[ -n "${name}" ]] || continue
    is_root="$(echo "${server}" | jq -r '.["#cloud.root"] // ""')"
    pub="$(echo "${inv}" | jq -r --arg n "${name}" '.nodes[] | select(.name==$n) | .public_ip // empty')"
    if [[ "${is_root}" == "true" ]]; then
      if (( ! have_robot )); then
        printf 'warn\tworker %s: cannot check Robot state (no Robot creds)\n' "${name}"
      elif (( ! robot_api_ok )); then
        printf 'warn\tworker %s: cannot check Robot state (Robot API unreachable)\n' "${name}"
      else
        # Resolve BY IP (like the destructive path), never by non-unique name.
        ext_ip="$(echo "${server}" | jq -r '.["#external-ip"] // ""')"
        num="$(hetzner::_robot_server_number_by_ip "${ext_ip}" "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" "${HROBOT_DOCTOR_MAX_TIME}" 2>/dev/null || echo "")"
        if [[ -n "${num}" ]]; then
          printf 'ok\tworker %s resolvable in Robot (robot#%s, by IP %s)\n' "${name}" "${num}" "${ext_ip}"
        else
          printf 'warn\tworker %s did NOT uniquely resolve in Robot by IP (%s) — check the Robot server IP matches the descriptor #external-ip\n' "${name}" "${ext_ip:-unset}"
        fi
      fi
      if [[ -n "${pub}" ]]; then
        if "${ssh_cmd[@]}" "root@${pub}" "test -x ${_HETZNER_RESCUE_MARKER}" 2>/dev/null; then
          printf 'ok\tworker %s is in rescue (ready for reinstall)\n' "${name}"
        elif "${ssh_cmd[@]}" "root@${pub}" 'true' 2>/dev/null; then
          printf 'warn\tworker %s is installed, not in rescue — set HROBOT_USER/HROBOT_PASSWORD to reset it automatically (provider::rebuild), or activate rescue via the Robot console\n' "${name}"
        else
          printf 'warn\tworker %s (%s) unreachable over SSH — cannot determine rescue/installed state\n' "${name}" "${pub}"
        fi
      fi
    else
      if [[ -n "${pub}" ]]; then
        printf 'ok\tcloud node %s present (%s)\n' "${name}" "${pub}"
      else
        printf 'warn\tcloud node %s not found in live inventory — it may be missing or unlabeled\n' "${name}"
      fi
    fi
  done
}

# ── CLI entry point ──────────────────────────────────────

main::hetzner() {
  local dry_run hetzner_json
  local domain="${domain:-}"
  # One unconditional array, both ways of running. The old conditional build
  # was broken in both directions: standalone declared `domain` but no flag
  # entry (the advertised --domain was unparseable), and under `lo` it
  # REPLACED the array — silently dropping --hetzner-json. The `:^` domain
  # entry yields to lo's own non-inheritable `domain|` duplicate in the tail.
  local -a args=(
    'dry-run|:+'        'Enable dry-run mode (log commands without executing)'
    'hetzner-json|'     'Path to hetzner.json'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  :args "Hetzner Cloud provisioning" "${@}"

  if [[ -n "${hetzner_json:-}" ]]; then
    CLOUD_HETZNER_JSON_PATH="${hetzner_json}"
  elif [[ -n "${domain:-}" ]]; then
    CLOUD_HETZNER_JSON_PATH="${PATH_CLUSTERS}/${domain}/hetzner.json"
  else
    error "Either --hetzner-json or --domain required"
    return 1
  fi

  [[ -f "${CLOUD_HETZNER_JSON_PATH}" ]] || {
    error "No such file: ${CLOUD_HETZNER_JSON_PATH}"
    return 1
  }

  if (( dry_run )); then
    CLOUD_DRY_RUN=1
    CLOUD_DRY_RUN_PATH="${PATH_LOK8S}/.state/dry-run"
  fi

  # Use the provider contract
  export PROVIDER_CONFIG_FILE="${CLOUD_HETZNER_JSON_PATH}"
  provider::validate || return $?
  provider::provision "${CLOUD_HETZNER_JSON_PATH}" "$(dirname "${CLOUD_HETZNER_JSON_PATH}")"
}
