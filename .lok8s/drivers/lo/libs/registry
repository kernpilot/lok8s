#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# registry — container registry management (CLI wrapper)
# Reads from .registries.json (generated by config-registry.sh)

import ^utils/verbose
import ^utils/domain

# Source Lo driver utils at file scope for config + registry helpers
_LO_UTILS="${PATH_LOK8S}/drivers/lo/utils"
source "${PATH_LOK8S}/utils/ip.sh"
# kapply::run — the collapsing progress block around registry reconciliation.
source "${PATH_LOK8S}/utils/kapply.sh"
source "${_LO_UTILS}/defaults.sh"
source "${_LO_UTILS}/config-registry.sh"
source "${_LO_UTILS}/config.sh"
source "${_LO_UTILS}/network.sh"
source "${_LO_UTILS}/registries.sh"

# The domain a registry command operates on: the INHERITED `domain` (lo
# main's resolved local / main::registry's --domain, via argsh dynamic
# scoping) with a DOMAIN_NAME fallback for standalone sourcing (Tilt
# subshells). NEVER re-read clusters/.active here — main already did, with
# the full flag > env > .active precedence (utils/domain.sh).
#
# NOTE: inside registry::each callbacks `domain` is SHADOWED by the
# per-entry mirror-domain field — resolve before iterating (every command
# entry point below does).
_registry_domain() {
  echo "${domain:-${DOMAIN_NAME:-lok8s.dev}}"
}

# Ensure config is loaded for the active domain. Idempotent. FATAL when the
# domain has no Lo cluster spec or the network config cannot be resolved —
# every caller feeds docker/network commands that would otherwise run against
# unset variables (a half-run once looked like success while erroring rc=0).
_registry_init() {
  [[ -n "${LOK8S_REGISTRY_JSON:-}" ]] && [[ -f "${LOK8S_REGISTRY_JSON}" ]] && return 0
  local _domain
  _domain="$(_registry_domain)"
  domain::require_driver lo "${_domain}" "registry management" || return 1
  lo::read_network_config "${PATH_CLUSTERS}/${_domain}/cluster.lok8s.yaml"
}

main::registry() {
  local -a usage=(
    'up|u'     'Spin up registries'
    'down|d'   'Spin down registries'
    'status|s' 'Check registry status'
    'clean|c'  'Clean up registries'
    'tls|t'    "The registry set's TLS certificate (docker volume)"
  )
  local shared
  # Default from the INHERITED `domain` (lo main's resolved local, via bash
  # dynamic scoping) — same idiom as main::image.
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local -a args=(
    'shared|S:+'        'Include shared mirrors (for clean/status)'
    'domain|:^~domain'  'Domain to use (default: DOMAIN_NAME env, then the active domain)'
    "${args[@]:-}"
  )
  :usage "Manage registry" "${@}"
  "${usage[@]}"
}

registry::up() {
  _registry_init || return 1
  local _domain
  _domain="$(_registry_domain)"
  local cluster_yaml="${PATH_CLUSTERS}/${_domain}/cluster.lok8s.yaml"

  lo::network || return 1
  if registry::is_shared; then
    lo::registry_network || return 1
  fi

  kapply::run registries lo::registries "${_domain}" "${cluster_yaml}"
}

registry::down() {
  _registry_init || return 1
  _down_entry() {
    # `reg_domain`, not `domain`: the entry field must not shadow the
    # inherited main::registry domain arg (AG012).
    local name="${1}" ip="${2}" url="${3}" reg_domain="${4}" host="${5}" type="${6}"
    local container_info
    container_info=$(registry::container "${name}")
    local reg_name="${container_info%%	*}"
    docker rm -f "${reg_name}" 2>/dev/null || true
  }
  registry::each _down_entry
}

registry::clean() {
  _registry_init || return 1

  lo::cleanup_registries "${LOK8S_SPEC_CLUSTER_NAME:-local}"

  if (( ${shared:-0} )); then
    _clean_shared() {
      # `reg_domain`, not `domain`: the entry field must not shadow the
      # inherited main::registry domain arg (AG012).
      local name="${1}" ip="${2}" url="${3}" reg_domain="${4}" host="${5}" type="${6}"
      [[ "${type}" == "mirror" ]] || return 0
      local reg_name="${LO_SHARED_REGISTRY_PREFIX}${name}"
      docker rm -f "${reg_name}" 2>/dev/null || true
      docker volume rm -f "${reg_name}" 2>/dev/null || true
      rm -f "${LO_REGISTRY_STATE_DIR}/${reg_name}.yaml" "${LO_REGISTRY_STATE_DIR}/${reg_name}.yaml.lock"
    }
    registry::each _clean_shared

    # An explicitly-invoked clean must actually clear the network — it is the
    # remediation the squatted-registry error recommends, which fires exactly
    # when a holder is attached. Detach whatever remains (named, so the
    # operator sees whose containers were cut) before removing; a detached
    # kind node re-attaches on its cluster's next `lo up`.
    local net
    net=$(registry::network_name)
    local member
    for member in $(docker network inspect "${net}" \
      -f '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' 2>/dev/null); do
      warn "registry clean: detaching '${member}' from ${net} (re-attaches on its cluster's next 'lo up')"
      docker network disconnect -f "${net}" "${member}" >/dev/null 2>&1 || true
    done
    if docker network inspect "${net}" &>/dev/null; then
      if ! docker network rm "${net}" 2>/dev/null; then
        warn "registry clean: could not remove ${net} — it still has attached containers (docker network inspect ${net})"
        return 1
      fi
      debug "Removed registry network ${net}"
    fi
  fi
}

registry::tls() {
  local -a usage=(
    'status|s' 'Show the certificate and what each registry mounts'
    'renew|r'  'Mint a new certificate into the volume and restart the registries'
  )
  :usage "The registry set's TLS certificate (docker volume)" "${@}"
  "${usage[@]}"
}

# _tls_cert_mounts — one "container<TAB>mount" line per registry of the set,
# in registry order (every container inspected before anything acts on it,
# like the Go driver's registryCertMounts).
_tls_cert_mounts() {
  _tls_mount_entry() {
    # `reg_domain`, not `domain`: the entry field must not shadow the
    # inherited main::registry domain arg (AG012).
    local name="${1}" ip="${2}" url="${3}" reg_domain="${4}" host="${5}" type="${6}"
    local container_info
    container_info=$(registry::container "${name}")
    local reg_name="${container_info%%	*}"
    printf '%s\t%s\n' "${reg_name}" "$(lo::registry_cert_mount "${reg_name}")"
  }
  registry::each _tls_mount_entry
}

# tls::status — the set's certificate and what each container mounts. The
# output is byte-identical to the Go driver's RegistryTLSStatus.
tls::status() {
  _registry_init || return 1
  local _domain
  _domain="$(_registry_domain)"
  if ! registry::is_tls; then
    echo "registry TLS  off (spec.registries.tls: false in ${_domain})"
    return 0
  fi
  local vol
  vol=$(lo::registry_tls_volume)
  echo "registry TLS  on"
  echo "volume        ${vol}"
  local read_rc=0
  if ! lo::registry_tls_volume_exists "${vol}"; then
    echo "certificate   none. The volume does not exist. Next: lo up"
  elif lo::registry_tls_read "${vol}" || { read_rc=$?; false; }; then
    _tls_print_leaf "${LO_REGISTRY_TLS_READ_CRT}"
    local prev="${LO_REGISTRY_TLS_READ_SANS}"
    while [[ "${prev}" == *$'\n' ]]; do prev="${prev%$'\n'}"; done
    if [[ "${prev}" != "$(lo::registry_tls_sans)" ]]; then
      echo "san set       stale. The registries changed since the mint. Next: lo registry tls renew"
    fi
  elif (( read_rc == 2 )); then
    return 1
  else
    echo "certificate   none. The volume holds no complete tls.crt + tls.key pair. Next: lo registry tls renew"
  fi
  echo "containers"
  local reg_name mount kind src
  while IFS=$'\t' read -r reg_name mount; do
    kind="${mount%%|*}"
    src="${mount#*|}"
    case "${kind}" in
      volume) printf '  %-28s volume %s\n' "${reg_name}" "${src}" ;;
      bind)   printf '  %-28s bind %s (legacy). Next: lo registry down && lo registry up\n' "${reg_name}" "${src}" ;;
      none)   printf '  %-28s no certificate mount\n' "${reg_name}" ;;
      *)      printf '  %-28s absent\n' "${reg_name}" ;;
    esac
  done < <(_tls_cert_mounts)
}

# _tls_rfc3339 <openssl date> — "Sep 14 15:00:00 2026 GMT" as
# 2026-09-14T15:00:00Z. GNU date first, BSD/macOS `-j -f` fallback (the
# kapply.sh pattern), so darwin prints the same dates as the binary.
_tls_rfc3339() {
  date -ud "${1}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || TZ=UTC date -j -f '%b %e %H:%M:%S %Y %Z' "${1}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
    || echo "${1}"
}

# _tls_print_leaf <pem> — `not before`, `not after` (RFC 3339, UTC) and the
# `sans` line (DNS names, then IP addresses), through openssl.
_tls_print_leaf() {
  local pem="${1}" dates
  if ! command -v openssl >/dev/null 2>&1; then
    echo "certificate   unreadable: openssl not found. Next: lo registry tls renew"
    return 0
  fi
  if ! dates=$(printf '%s' "${pem}" | openssl x509 -noout -startdate -enddate 2>/dev/null); then
    echo "certificate   unreadable: no PEM block. Next: lo registry tls renew"
    return 0
  fi
  local before after
  before=$(sed -n 's/^notBefore=//p' <<<"${dates}")
  after=$(sed -n 's/^notAfter=//p' <<<"${dates}")
  echo "not before    $(_tls_rfc3339 "${before}")"
  echo "not after     $(_tls_rfc3339 "${after}")"
  local san dns=() ips=() entry
  san=$(printf '%s' "${pem}" | openssl x509 -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr ',' '\n')
  while IFS= read -r entry; do
    entry="${entry#"${entry%%[! ]*}"}"
    case "${entry}" in
      DNS:*)        dns+=("${entry#DNS:}") ;;
      "IP Address:"*) ips+=("${entry#IP Address:}") ;;
    esac
  done <<<"${san}"
  echo "sans          ${dns[*]}${dns[*]:+ }${ips[*]}"
}

# tls::renew — mint a fresh certificate into the volume and restart the
# set's containers. They keep their config-hash label, which carries the old
# cert signature, so the next `lo up` recreates them with the new one; the
# cluster nodes need nothing, they trust the dev CA.
tls::renew() {
  _registry_init || return 1
  local _domain
  _domain="$(_registry_domain)"
  if ! registry::is_tls; then
    echo "error: spec.registries.tls is false in ${_domain}. There is no certificate to renew." >&2
    return 1
  fi
  local -a sans=()
  mapfile -t sans < <(lo::registry_tls_sans)
  if (( ${#sans[@]} == 0 )); then
    echo "error: no registry SANs resolved — cannot mint registry TLS cert" >&2
    return 1
  fi
  local vol exists=0
  vol=$(lo::registry_tls_volume)
  lo::registry_tls_volume_exists "${vol}" && exists=1
  lo::registry_tls_mint "${_domain}" "${vol}" "${exists}" "${sans[@]}" || return 1
  echo "registry TLS renewed: volume ${vol}, ${#sans[@]} SANs"
  local mounts reg_name mount
  mounts=$(_tls_cert_mounts)
  while IFS=$'\t' read -r reg_name mount; do
    [[ "${mount}" != "absent" ]] || continue
    if ! docker restart "${reg_name}" >/dev/null 2>&1; then
      echo "error: docker restart ${reg_name} failed. Next: lo registry down && lo registry up" >&2
      return 1
    fi
    echo "restarted ${reg_name}"
  done <<<"${mounts}"
  echo "Next: run 'lo up' in each cluster that uses the set. It picks the certificate up there."
}

registry::status() {
  _registry_init || return 1

  # One aligned line per registry, kapply-style markers:
  #   ✓ build      [project] kubehz-registry-build → https://10.125.125.101 · 3 repos
  #   ⚠ cache      [project] kubehz-registry-cache → … · running, unreachable
  #   ✗ io-docker  [shared]  lok8s-registry-io-docker → … · not running
  # Repo names print dimmed under the line in verbose mode (lo -v).
  local _c_ok='' _c_warn='' _c_err='' _c_dim='' _c_off=''
  if [[ -t 1 ]]; then
    _c_ok=$'\033[32m' _c_warn=$'\033[33m' _c_err=$'\033[31m' _c_dim=$'\033[2m' _c_off=$'\033[0m'
  fi

  _status_entry() {
    # `reg_domain`, not `domain`: the entry field must not shadow the
    # inherited main::registry domain arg (AG012).
    local name="${1}" ip="${2}" url="${3}" reg_domain="${4}" host="${5}" type="${6}"
    local container_info label
    container_info=$(registry::container "${name}")
    local reg_name="${container_info%%	*}"
    local reg_network="${container_info##*	}"

    if [[ "${type}" == "mirror" ]] && registry::is_shared; then
      label="[shared]"
      (( ${shared:-0} )) || return 0
    else
      label="[project]"
    fi

    # Look up container by network — avoids name collisions across clusters
    local container_on_network
    container_on_network=$(docker ps --filter "network=${reg_network}" --format '{{.Names}}' 2>/dev/null \
      | grep -x "${reg_name}" || true)

    # TLS mode serves HTTPS (mkcert cert trusted via the host CA store).
    local endpoint
    endpoint="$(registry::url "${ip}")"

    local marker="${_c_err}✗${_c_off}" state="not running" repos=""
    if [[ -n "${container_on_network}" ]]; then
      local catalog
      if catalog=$(curl -sf --connect-timeout 1 --max-time 2 "${endpoint}/v2/_catalog" 2>/dev/null); then
        marker="${_c_ok}✓${_c_off}"
        local n
        n=$(jq -r '.repositories | length' <<<"${catalog}" 2>/dev/null || echo "")
        if [[ -n "${n}" ]]; then
          local noun=repos; [[ "${n}" == "1" ]] && noun=repo
          state="${n} ${noun}"
          repos=$(jq -r '.repositories[]' <<<"${catalog}" 2>/dev/null || true)
        else
          state="up"
        fi
      else
        marker="${_c_warn}⚠${_c_off}"
        state="running, unreachable"
      fi
    fi

    printf '%b %-10s %-9s %s → %s · %s\n' \
      "${marker}" "${name}" "${label}" "${reg_name}" "${endpoint}" "${state}"
    if [[ -n "${DEBUG:-}" && -n "${repos}" ]]; then
      local repo
      while IFS= read -r repo; do
        printf '      %s%s%s\n' "${_c_dim}" "${repo}" "${_c_off}"
      done <<<"${repos}"
    fi
  }
  registry::each _status_entry
}
