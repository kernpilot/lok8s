#!/usr/bin/env bash
# shellcheck shell=bash disable=SC2016,SC2034,SC1091
# SC2016: single-quoted $ here is jq/yq/awk program text or a remote-script literal
# vim: set syntax=bash:
set -euo pipefail

: "${PATH_BASE:="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"}"
: "${PATH_BIN:="${PATH_BASE}/.bin"}"
: "${PATH_SECRETS:="${PATH_BASE}/.secrets"}"
: "${PATH_LOK8S:="${PATH_BASE}/.lok8s"}"
: "${PATH_CLUSTERS:="${PATH_BASE}/clusters"}"
: "${LOK8S_CLUSTER_NAME:=local}"

: "${KIND_CONFIG:="${PATH_LOK8S}/drivers/lo/cluster/config.yaml"}"
: "${KIND_EXPERIMENTAL_DOCKER_NETWORK:=lok8s}"
: "${KIND_NODE_VERSION:=v1.31.12@sha256:0f5cc49c5e73c0c2bb6e2df56e7df189240d83cf94edfa30946482eb08ec57d2}"

# NO DOMAIN_NAME default here: a baked-in value would masquerade as
# user-set env and outrank clusters/.active in domain::resolve's
# flag > env > .active > lok8s.dev chain (the terminal default lives in
# utils/domain.sh, at the END of the chain where it belongs).
: "${DOMAIN_SANS:="*"}"

ARGSH_SOURCE="${BASH_SOURCE[0]}"
# argsh's ^-prefix imports resolve relative to PATH_SCRIPTS. We keep the
# variable as a synonym for PATH_LOK8S so libs that use ^utils/verbose
# (and similar) keep working without per-file edits.
PATH_SCRIPTS="${PATH_LOK8S}"
export PATH_SCRIPTS

source "${PATH_BIN}/argsh"
import ^libs/deploy
import ^libs/tilt
import ^libs/hooks
import ^libs/env
import ^libs/secrets
import ^libs/k8s
import ^libs/provision
import ^libs/recover
import ^libs/bootstrap
import ^libs/kubeconfig
import ^libs/use
import ^libs/init
import ^libs/build
import ^libs/lint
import ^libs/audit
import ^libs/status
import ^libs/doctor
import ^libs/trust
import ^libs/chat
import ^libs/ai
import ^libs/version
import ^libs/crds
import ^libs/gitops
import ^libs/kubehz/main
import ^libs/inventory/main
import ^libs/kustomize
import ^libs/image
import ^libs/addons
import ^libs/drivers
import ^utils/types
import ^utils/domain
import ^utils/template
import ^utils/verbose
import ^utils/targets
import ^utils/http
import ^utils/credentials
import ^drivers/lo/libs/registry

main() {
  local verbose=0 force=0 force_recreate=0 remote=0 kubernetes cluster config domain domain_sans
  cluster="${LOK8S_CLUSTER_NAME}"
  kubernetes="${KIND_NODE_VERSION}"
  config="${KIND_CONFIG}"
  # THE single domain-resolution point. Precedence (domain::resolve):
  # --domain flag (parsed below, overrides this default) > DOMAIN_NAME env >
  # clusters/.active > lok8s.dev. Every subcommand/lib inherits the result —
  # via the argsh `'domain|:^~domain'` arg (this local is their default
  # through dynamic scoping) or the re-exported DOMAIN_NAME after parsing.
  # Do NOT re-derive the domain from `.active` anywhere below main.
  domain="$(domain::resolve)"
  domain_sans="${DOMAIN_SANS}"

  local -a usage=(
    'up|u@destructive'                 'Start cluster'
    'down@destructive'                 'Stop cluster'
    'clean@destructive'                'Clean up local volumes'

    'provision|p@destructive'          'Provision a cluster (full lifecycle)'
    'bootstrap@destructive@idempotent' 'Apply/reapply bootstrap addons'
    'build|b@idempotent'               'Build kustomize targets'
    'deploy|d@destructive@idempotent'  'Deploy platform'
    'destroy@destructive'              'Destroy a cluster'
    'recover@destructive'              'Rebuild a cluster from bare metal (disaster recovery)'

    'use@idempotent'                   'Set/show active domain'
    'kubeconfig|kc@readonly'           'Print a domain kubeconfig (--oidc for kubelogin exec-plugin)'
    'init@idempotent'                  'Scaffold service config (lok8s.yaml/services.yaml/Tiltfile)'
    'lint|l@readonly'                  'Validate structure and specs'
    'audit|au@readonly'                'Static security-posture audit (read-only, cluster-free; --json)'
    'status@readonly'                  'Cluster health and status'
    'doctor@readonly'                  'Diagnose the environment + toolchain'
    'trust@idempotent'                 'Trust the local dev CA (mkcert -install)'
    'chat'                             'Chat with a local AI (transparent, streaming)'
    'ai'                               'Manage the AI integration (lo chat + agent skills)'
    'version@readonly'                 'Print lok8s + toolchain versions'
    'gitops|g'                         'GitOps integration'
    'kubehz|kh'                        'kubehz platform integration'

    'tilt|t'                           'Manage tilt cluster'
    '#hooks'                           'Dev hook actions (internal; driven by the Tilt hooks: wrapper)'
    'env|e'                            'Manage environment'
    'k8s'                              'Generate/render K8s artifacts'
    'crds'                             'Generate operator CRDs from schema source'
    'kustomize|ku'                     'Manage kustomize plugins (Go)'
    'registry|r'                       'Manage Docker registries'
    'image|i'                          'Manage the local cache registry'
    'addons|a@readonly'                'List driver addons for the active cluster'
    'secrets|s'                        'Manage secrets (encrypt/decrypt/set)'

    'drivers'                          'Driver-specific commands'
  )

  local -a args=(
    '-'             'Global flags:'
    'verbose|v:+'        'Enable verbose logging'
    'force|f:+'          'Force operation without prompts (also recreates immutable/terminating conflicts)'
    'force-recreate|:+'  'On apply, recreate objects blocked by an immutable field or a stuck Terminating finalizer'
    'remote|r:+'         'Provision on remote VM (uses spec.provider + spec.remote)'
    'kubernetes|'   'Kubernetes version to use'
    'cluster|s'     'Cluster name to manage'
    'config|'       'Kind config to use'
    'domain|'       'Domain to use'
    'domain-sans|'  'Domain sans to use'
  )

  # Detect an EXPLICIT `--domain` flag so consumers can tell it apart from
  # the ambient resolution (env/.active). `lo use` needs this: with env now
  # outranking .active, "DOMAIN_NAME != .active" no longer implies a flag —
  # acting on it would let a bare `lo use` silently rewrite .active from the
  # environment. Scanned from the raw argv (not a value comparison — that
  # misclassified `--domain X` as implicit whenever X equaled the default).
  local _domain_flag=0 _arg
  for _arg in "${@}"; do
    [[ "${_arg}" == "--domain" || "${_arg}" == --domain=* ]] || continue
    _domain_flag=1
    break
  done

  :usage "lok8s - local dev orchestration" "${@}"
  if (( verbose )); then export DEBUG=1; fi
  if (( remote )); then export LOK8S_REMOTE=1; fi
  # --force|-f subsumes --force-recreate: "force without prompts" includes
  # auto-recreating immutable/terminating conflicts — the non-interactive / DR
  # "just do it" escape for the batched heal (e.g. lo recover, a known-messy
  # re-apply). --force-recreate stays as the explicit spelling.
  if (( force || force_recreate )); then export LOK8S_FORCE_RECREATE=1; fi
  DOMAIN_NAME="${domain}"
  export DOMAIN_NAME
  LOK8S_DOMAIN_EXPLICIT="${_domain_flag}"
  export LOK8S_DOMAIN_EXPLICIT

  # Read spec from active cluster spec (if available)
  local cluster_spec="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  if [[ -f "${cluster_spec}" ]] && command -v yq &>/dev/null; then
    local spec_net_name spec_cluster_name
    spec_net_name=$(yq -r '.spec.network.name // ""' "${cluster_spec}" 2>/dev/null || true)
    if [[ -n "${spec_net_name}" ]]; then
      KIND_EXPERIMENTAL_DOCKER_NETWORK="${spec_net_name}"
    fi
    spec_cluster_name=$(yq -r '.metadata.name // ""' "${cluster_spec}" 2>/dev/null || true)
    if [[ -n "${spec_cluster_name}" ]]; then
      cluster="${spec_cluster_name}"
    fi
  fi

  export KUBECONFIG="${PATH_BASE}/.kubeconfig/${cluster}.yaml"
  "${usage[@]}"
}

_list_domains() {
  # List all domain names from clusters/, one per line (excludes hidden dirs)
  for dir in "${PATH_CLUSTERS}"/*/; do
    [[ -d "${dir}" ]] || continue
    local d
    d=$(basename "${dir}")
    [[ "${d}" == .* ]] && continue
    echo "${d}"
  done
}

# -- Convenience orchestrators --

# Compact run header — the noteworthy facts for the run, replacing the bare
# kubeconfig path that used to leak from the driver. e.g.
#
#   kubehz-dev  lo · kind · v1.31.12
#   kubeconfig  .kubeconfig/kubehz-dev.yaml
#
_lo_header() {
  local domain="${1}"
  local spec="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local deploy_spec="${PATH_CLUSTERS}/${domain}/deploy.lok8s.yaml"
  local meta="" kind=""
  if command -v yq &>/dev/null && [[ -f "${spec}" ]]; then
    local ver
    kind=$(yq -r '.kind // ""' "${spec}" 2>/dev/null | tr '[:upper:]' '[:lower:]')
    ver=$(yq -r '.spec.kubernetes.version // ""' "${spec}" 2>/dev/null)
    meta="${kind}"
    [[ "${kind}" == "lo" ]] && meta="${meta} · kind"
    [[ -n "${ver}" && "${ver}" != "null" ]] && meta="${meta} · ${ver%%@*}"
  elif command -v yq &>/dev/null && [[ -f "${deploy_spec}" ]]; then
    meta="deploy → $(yq -r '.spec.clusterRef.domain // "?"' "${deploy_spec}" 2>/dev/null)"
  fi
  printf '\n  \033[1;36m%s\033[0m  \033[2m%s\033[0m\n' "${domain}" "${meta}"
  printf '  \033[2mkubeconfig  %s\033[0m\n' "${KUBECONFIG#"${PATH_BASE}/"}"

  # Registry summary (kind clusters only): mode · scheme · count. The flags come
  # from the SPEC so they reflect THIS run (the default is tls:true); the count
  # comes from the last-generated .registries.json (stable, refreshed each up).
  if [[ "${kind}" == "lo" ]] && command -v yq &>/dev/null; then
    local r_shared r_tls r_mode="local" r_sec="plain" r_count="—"
    local registries_json="${PATH_CLUSTERS}/${domain}/.registries.json"
    r_shared=$(yq -r '.spec.registries.shared.enabled // true' "${spec}" 2>/dev/null)
    r_tls=$(yq -r '.spec.registries.tls // true' "${spec}" 2>/dev/null)
    [[ "${r_shared}" == "true" ]] && r_mode="shared"
    [[ "${r_tls}" == "true" ]] && r_sec="tls"
    if command -v jq &>/dev/null && [[ -f "${registries_json}" ]]; then
      r_count=$(jq -r '.registries | length' "${registries_json}" 2>/dev/null || echo "—")
    fi
    printf '  \033[2mregistries  %s · %s · %s\033[0m\n' "${r_mode}" "${r_sec}" "${r_count}"
  fi
  printf '\n'
}

main::up() {
  local force="${force:-0}"
  local open_tilt ci timeout
  local -a args=(
    'open-tilt|o:+'  'Open Tilt in a browser (interactive mode only)'
    'ci|:+'          'Headless: build+deploy+wait-ready via `tilt ci`, exit with real status (no TTY/browser)'
    'timeout|t'      'Readiness timeout for --ci (e.g. 300s, 10m); passed to `tilt ci`'
    'force|f:^:+'    'Skip the real-infrastructure confirmation (cloud drivers)'
    "${args[@]}"
  )
  :args "Starting cluster" "${@}"

  _lo_header "${domain}"

  # Reconcile infra first regardless of mode (kind cluster, registries,
  # bootstrap addons) — only the post-reconcile Tilt step differs.
  provision::dispatch "${domain}"

  # Headless mode: foreground `tilt ci` (build + deploy + wait + exit status).
  # No backgrounded `tilt up`, no browser. Its exit code is main::up's.
  if (( ci )); then
    if [[ -n "${timeout:-}" ]]; then
      tilt::ci --timeout "${timeout}"
    else
      tilt::ci
    fi
    return
  fi

  tilt::up
  # NOTE: not `tilt::up && (( open_tilt )) && {…}` — with --open unset the
  # arithmetic evaluates 0 as the function's LAST command, so a successful
  # interactive `lo up` exited 1 (review find, 2026-07-09).
  if (( open_tilt )); then
    local port
    port=$(tilt::port)
    if command -v xdg-open &>/dev/null; then
      xdg-open "http://localhost:${port}"
    elif command -v open &>/dev/null; then
      open "http://localhost:${port}"
    else
      echo "Tilt UI: http://localhost:${port}"
    fi
  fi
}

main::down() {
  printf '\n  \033[1;36m%s\033[0m  \033[2mtearing down\033[0m\n' "${cluster}"

  # Driver-aware teardown. Cloud drivers (capi/kkp/kubeone) provision real
  # infrastructure and must be deprovisioned via the driver's destroy contract;
  # only the local kind driver (lo) is torn down by deleting the kind cluster +
  # Tilt + registries below.
  local spec="${PATH_CLUSTERS}/${DOMAIN_NAME:-}/cluster.lok8s.yaml" kind=""
  [[ -f "${spec}" ]] && kind=$(yq -r '.kind' "${spec}" 2>/dev/null | tr '[:upper:]' '[:lower:]')
  if [[ -n "${kind}" && "${kind}" != "lo" ]]; then
    printf '  \033[2m• destroying %s cluster via its driver (deprovisions infrastructure)\033[0m\n' "${kind}"
    # A failed driver destroy means infrastructure may be ORPHANED (and billed)
    # — that must be a visible non-zero exit, never a silent success. A gate
    # DECLINE (sentinel rc 3) is different: nothing ran, nothing is orphaned —
    # exit non-zero without the scary orphan warning.
    local destroy_rc=0
    provision::dispatch_destroy "${DOMAIN_NAME}" || destroy_rc=$?
    if (( destroy_rc == 3 )); then
      return 1
    elif (( destroy_rc != 0 )); then
      printf '  \033[31m✗ driver destroy failed — infrastructure may still exist; inspect and re-run\033[0m\n'
      return 1
    fi
    printf '\n'
    return
  fi

  printf '  \033[2m• stopping Tilt\033[0m\n'
  tilt::down

  if kind get clusters 2>/dev/null | grep -qx "${cluster}"; then
    printf '  \033[2m• deleting kind cluster (node teardown can take ~10–30s)\033[0m\n'
    kind delete cluster --name "${cluster}" || true
  else
    printf '  \033[2m• kind cluster not running\033[0m\n'
  fi

  # Registries: a SHARED setup is left up — the mirrors are reused across clusters
  # and build/cache stay warm for a fast next `lo up`. A non-shared setup is
  # project-local with nothing to reuse, so tear its containers down (the named
  # volumes stay, so build cache survives a later recreate).
  local registries_json="${PATH_CLUSTERS}/${DOMAIN_NAME:-}/.registries.json"
  if command -v jq &>/dev/null && [[ -f "${registries_json}" ]]; then
    local r_shared r_count r_pnet
    r_shared=$(jq -r '.shared // false' "${registries_json}" 2>/dev/null)
    r_count=$(jq -r '.registries | length' "${registries_json}" 2>/dev/null || echo "?")
    if [[ "${r_shared}" == "true" ]]; then
      printf '  \033[2mℹ registries left up: %s containers (shared mirrors reused; build/cache kept warm)\033[0m\n' "${r_count}"
      printf '  \033[2m  remove:     lo registry down\033[0m\n'
      printf '  \033[2m  + volumes:  lo registry clean --shared\033[0m\n'
    else
      r_pnet=$(jq -r '.project_network // ""' "${registries_json}" 2>/dev/null)
      local n removed=0
      if [[ -n "${r_pnet}" ]]; then
        while IFS= read -r n; do
          [[ -n "${n}" ]] || continue
          docker rm -f "${r_pnet}-registry-${n}" &>/dev/null && removed=$((removed + 1)) || true
        done < <(jq -r '.registries[].name' "${registries_json}" 2>/dev/null)
      fi
      printf '  \033[2m• shut down %s registry containers (not shared — nothing to reuse; volumes kept)\033[0m\n' "${removed}"
    fi
  fi
  printf '\n'
}

main::clean() {
  local all
  local -a args=(
    'all|a:+'  'Clean up all volumes'
    "${args[@]}"
  )
  :args "Cleaning up local volumes" "${@}"
  main::down
  if (( all )); then
    docker system prune -f
    return
  fi
  for volume in $(docker volume ls --filter "name=^${cluster}-" -q); do
    docker volume rm -f "${volume}"
  done
  # Registries are a Lo-driver artifact — nothing to clean for cloud/deploy
  # domains, and the driver gate in _registry_init would (rightly) refuse.
  if [[ "$(domain::driver "${domain}" 2>/dev/null || true)" == "lo" ]]; then
    registry::clean
  else
    # Visible, not debug: on a migrated/deleted domain this leaves any
    # lok8s-registry-* containers behind — say so instead of hiding it.
    warn "skipping registry cleanup — domain '${domain}' is not a Lo cluster (leftover registries: docker rm -f \$(docker ps -aq --filter name=-registry-))"
  fi
}

# Entrypoint guard: run main only when executed directly. The libs' guard
# variant can't work here — lo self-sets ARGSH_SOURCE (line 20), so any
# ARGSH_SOURCE test is a tautology (the old `-z` form made this line always
# dispatch, executing the CLI even when sourced).
[[ "${0}" != "${BASH_SOURCE[0]}" ]] || main "${@}"
