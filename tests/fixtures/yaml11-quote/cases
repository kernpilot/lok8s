# The table of the -o yaml quoting, for both twins: internal/cli/output_yaml11_test.go
# and tests/unit/kubehz_agent_yaml11_test.bats. Each line is a JSON value, the yaml
# scalar that the value prints as (in `v: <scalar>`; a string value prints the same
# as a key, `<scalar>: 1`), and why, separated by tabs:
#   set      a string of the YAML 1.1 set: the pattern of each twin matches it
#   encoder  a string that the encoders quote themselves (the pattern does not match)
#   plain    a string that stays plain (the pattern does not match)
#   value    a real bool, null or number, which stays plain
#
# The strings that a YAML 1.1 reader reads as a bool, a null or a number print
# in double quotes.
# the bool words in any case
"y"	"y"	set
"Y"	"Y"	set
"n"	"n"	set
"N"	"N"	set
"yes"	"yes"	set
"Yes"	"Yes"	set
"YES"	"YES"	set
"yEs"	"yEs"	set
"no"	"no"	set
"No"	"No"	set
"NO"	"NO"	set
"nO"	"nO"	set
"on"	"on"	set
"On"	"On"	set
"ON"	"ON"	set
"oN"	"oN"	set
"off"	"off"	set
