# The table of the -o yaml quoting, for both twins: internal/cli/output_yaml11_test.go
# and tests/unit/kubehz_agent_yaml11_test.bats. Each line is a JSON value, a tab,
# and the yaml scalar that the value prints as (in `v: <scalar>`; a string value
# prints the same as a key, `<scalar>: 1`).
#
# The strings that a YAML 1.1 reader reads as a bool, a null or a number print
# in double quotes.
# the bool words in any case
"y"	"y"
"Y"	"Y"
"n"	"n"
"N"	"N"
"yes"	"yes"
"Yes"	"Yes"
"YES"	"YES"
"yEs"	"yEs"
"no"	"no"
"No"	"No"
"NO"	"NO"
"nO"	"nO"
"on"	"on"
"On"	"On"
"ON"	"ON"
"oN"	"oN"
"off"	"off"
"Off"	"Off"
"OFF"	"OFF"
"oFf"	"oFf"
"true"	"true"
"True"	"True"
"TRUE"	"TRUE"
"tRUE"	"tRUE"
"false"	"false"
"False"	"False"
"FALSE"	"FALSE"
"fAlSe"	"fAlSe"
# the null words in any case, and ~
"null"	"null"
"Null"	"Null"
"NULL"	"NULL"
"nUll"	"nUll"
"~"	"~"
# binary
"0b1"	"0b1"
"0B1"	"0B1"
"-0b1_0"	"-0b1_0"
"+0b11"	"+0b11"
# octal 0o
"0o17"	"0o17"
"0O17"	"0O17"
"-0o7"	"-0o7"
"+0o1_7"	"+0o1_7"
# decimal, also with a leading 0 (the YAML 1.1 octal 0777, and 08)
"0"	"0"
"7"	"7"
"-7"	"-7"
"+7"	"+7"
"1_000"	"1_000"
"1_"	"1_"
"0777"	"0777"
"0_7"	"0_7"
"-017"	"-017"
"08"	"08"
"019"	"019"
"00"	"00"
# hex
"0x1F"	"0x1F"
"0X1f"	"0X1f"
"-0x1_f"	"-0x1_f"
"0xdead_beef"	"0xdead_beef"
# sexagesimal
"1:20"	"1:20"
"-1:20"	"-1:20"
"+1:20"	"+1:20"
"190:20:30.15"	"190:20:30.15"
"12:30:45"	"12:30:45"
"0:30"	"0:30"
"1:2:3"	"1:2:3"
# floats with a fraction or an exponent
"1.5"	"1.5"
"-1.5"	"-1.5"
"+1."	"+1."
"1."	"1."
".5"	".5"
"-.5"	"-.5"
"1.5e3"	"1.5e3"
"1.5E-3"	"1.5E-3"
"1e3"	"1e3"
"1E+3"	"1E+3"
"-2e-2"	"-2e-2"
"6.8523015e+5"	"6.8523015e+5"
"685.230_15e+03"	"685.230_15e+03"
"1_0.5"	"1_0.5"
".5e3"	".5e3"
"1e1_0"	"1e1_0"
# .inf and .nan in any case
".inf"	".inf"
".Inf"	".Inf"
".INF"	".INF"
".iNf"	".iNf"
"+.inf"	"+.inf"
"-.inf"	"-.inf"
"-.InF"	"-.InF"
".nan"	".nan"
".NaN"	".NaN"
".NAN"	".NAN"
".nAn"	".nAn"
# the empty string
""	""
