#!/usr/bin/env bats
# secrets_test.bats — SOPS/age round-trip for .lok8s/libs/secrets.
# Skips when the crypto tools aren't on PATH (e.g. minimal CI containers);
# runs the full encrypt→decrypt round-trip wherever sops + ssh-to-age +
# ssh-keygen are available.

setup() {
  load "../test_helper"
  # `run --separate-stderr` (the decrypt compare test) needs bats >= 1.5.
  bats_require_minimum_version 1.5.0
  setup_tmpdir

  export PATH="${_PROJECT_ROOT}/.bin:${PATH}"
  export PATH_BASE="${BATS_TEST_TMPDIR}"
  export PATH_SECRETS="${BATS_TEST_TMPDIR}/.secrets"
  mkdir -p "${PATH_SECRETS}"

  import() { :; };  export -f import
  :usage() { :; };  export -f :usage
  :args()  { shift; }; export -f :args

  source "${_PROJECT_ROOT}/.lok8s/utils/verbose.sh"
  source "${_PROJECT_ROOT}/.lok8s/libs/secrets"
}

teardown() { teardown_tmpdir; }

require_tools() {
  for t in sops ssh-to-age ssh-keygen; do
    command -v "$t" >/dev/null || skip "$t not installed"
  done
}

# _block prints the block that lo writes into the .gitignore of a store (Go
# twin: gitignoreContent).
_block() {
  builtin printf '%s\n' \
    '# BEGIN lok8s secrets. lo rewrites the lines up to the END line: add your own rules below it.' \
    '# Ignore everything except this file and the SOPS-encrypted secret files.' \
    '# A plaintext secret file must never be committed.' \
    '*' '!.gitignore' '!Secret.*.enc' '*/' '# END lok8s secrets'
}

# _legacy prints the lines that lo wrote before the block.
_legacy() {
  builtin printf '%s\n' \
    '# Auto-generated by lok8s — ignore everything except SOPS-encrypted' \
    '# secret cache files. Plaintext cache entries must never be committed.' \
    '*' '!.gitignore' '!Secret.*.enc'
}

# bats test_tags=real-sops
@test "secrets: SOPS/age encrypt → decrypt round-trips a value" {
  require_tools
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"

  printf 'super-secret-value' > "${PATH_SECRETS}/Secret.app.default.TOKEN"

  run secrets::init --ssh-key "${BATS_TEST_TMPDIR}/id.pub"
  assert_success
  [ -f "${PATH_BASE}/.sops.yaml" ]

  run secrets::encrypt
  assert_success
  [ -f "${PATH_SECRETS}/Secret.app.default.TOKEN.enc" ]

  # Drop the plaintext, then restore it from the .enc with the test identity.
  rm "${PATH_SECRETS}/Secret.app.default.TOKEN"
  SOPS_AGE_KEY="$(ssh-to-age -private-key < "${BATS_TEST_TMPDIR}/id")"
  export SOPS_AGE_KEY
  run secrets::decrypt
  assert_success
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.TOKEN")" = 'super-secret-value' ]
}

# decrypt keeps a plaintext that is newer than its .enc. It was silent about
# it (the recreate: "Decrypted 71" of 103, 32 skipped without a word). Now it
# compares the kept plaintext with the decrypted .enc, names each one that
# differs (never its value), counts both kinds in the summary and exits 0.
# bats test_tags=real-sops
@test "secrets decrypt: a kept newer plaintext is compared with its .enc" {
  require_tools
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  printf 'same-value' > "${PATH_SECRETS}/Secret.app.default.SAME"
  printf 'committed-value' > "${PATH_SECRETS}/Secret.app.default.EDITED"
  printf 'restored-value' > "${PATH_SECRETS}/Secret.app.default.GONE"
  secrets::init --ssh-key "${BATS_TEST_TMPDIR}/id.pub" >/dev/null
  secrets::encrypt >/dev/null

  # SAME: newer, equal. EDITED: newer, a value the .enc does not hold.
  # GONE: no plaintext, so decrypt writes it.
  printf 'local-edit-value' > "${PATH_SECRETS}/Secret.app.default.EDITED"
  touch -t 202001010000 "${PATH_SECRETS}"/Secret.*.enc
  rm "${PATH_SECRETS}/Secret.app.default.GONE"

  SOPS_AGE_KEY="$(ssh-to-age -private-key < "${BATS_TEST_TMPDIR}/id")"
  export SOPS_AGE_KEY
  # stdout keeps its old contract (piped stdout); the warnings and the skip
  # count go to stderr.
  domain=alpha.dev run --separate-stderr secrets::decrypt < /dev/null
  assert_success
  assert_output 'Decrypted 1 secret(s)'
  output="${stderr}" lines=("${stderr_lines[@]}")
  assert_line '[warn] Secret.app.default.EDITED: the plaintext is newer than Secret.app.default.EDITED.enc and differs from it. Decrypt kept the plaintext.'
  assert_line '[warn] 1 plaintext(s) differ from the .enc. To store them, run "lo secrets encrypt --domain alpha.dev". To use the .enc values, delete these plaintexts, then run "lo secrets decrypt --domain alpha.dev".'
  assert_line 'Skipped 2 secret(s) with a newer plaintext: 1 equal, 1 differ'
  refute_output --partial 'SAME:'
  local v
  for v in same-value committed-value local-edit-value restored-value; do
    refute_output --partial "${v}"
  done
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.EDITED")" = 'local-edit-value' ]
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.GONE")" = 'restored-value' ]
}

# The compare path discards the sops stderr: on a MAC mismatch the CLI prints
# two unkeyed SHA-512 digests of the plaintext. A stub sops prints that shape;
# only the fixed line with the file name may reach the output. No crypto tools
# needed.
@test "secrets decrypt: a failed compare prints no sops digest" {
  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  printf '{"data":"ENC[fake]","sops":{}}' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  touch -t 202001010000 "${PATH_SECRETS}/Secret.app.default.K.enc"
  sops() {
    echo "MAC mismatch. File has 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08, computed 60303ae22b998861bce3b28f33eec1be758a213c86c93c076dbe9f558c11c752" >&2
    return 1
  }
  export -f sops
  export SOPS_AGE_KEY="stub-identity"
  run secrets::decrypt < /dev/null
  assert_failure
  assert_output '[error] Failed to decrypt Secret.app.default.K.enc'
}

# The same on the main decrypt path (no plaintext): the sops stderr is
# discarded there too, and the line names the file only (as Go).
@test "secrets decrypt: a failed decrypt prints no sops digest" {
  printf '{"data":"ENC[fake]","sops":{}}' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  sops() {
    echo "MAC mismatch. File has 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08, computed 60303ae22b998861bce3b28f33eec1be758a213c86c93c076dbe9f558c11c752" >&2
    return 1
  }
  export -f sops
  export SOPS_AGE_KEY="stub-identity"
  run secrets::decrypt < /dev/null
  assert_failure
  assert_output '[error] Failed to decrypt Secret.app.default.K.enc'
}

# A kept plaintext that cannot be read is named as such, not as a decrypt
# failure (and the run does not die on a bare redirection error).
@test "secrets decrypt: an unreadable kept plaintext is named" {
  [[ "${EUID}" -ne 0 ]] || skip "root reads a 0000 file"
  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  printf '{"data":"ENC[fake]","sops":{}}' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  touch -t 202001010000 "${PATH_SECRETS}/Secret.app.default.K.enc"
  chmod 000 "${PATH_SECRETS}/Secret.app.default.K"
  export SOPS_AGE_KEY="stub-identity"
  run secrets::decrypt < /dev/null
  chmod 600 "${PATH_SECRETS}/Secret.app.default.K"
  assert_failure
  assert_output '[error] Failed to read Secret.app.default.K'
}

# A kept plaintext whose .enc this key cannot decrypt fails the run, the same
# way a decrypt of a missing plaintext does.
# bats test_tags=real-sops
@test "secrets decrypt: the compare fails on an .enc the key cannot decrypt" {
  require_tools
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  ssh-keygen -t ed25519 -N '' -C other -f "${BATS_TEST_TMPDIR}/other" -q
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  secrets::init --ssh-key "${BATS_TEST_TMPDIR}/id.pub" >/dev/null
  secrets::encrypt >/dev/null
  touch -t 202001010000 "${PATH_SECRETS}/Secret.app.default.K.enc"

  SOPS_AGE_KEY="$(ssh-to-age -private-key < "${BATS_TEST_TMPDIR}/other")"
  export SOPS_AGE_KEY
  run secrets::decrypt < /dev/null
  assert_failure
  assert_line '[error] Failed to decrypt Secret.app.default.K.enc'
}

# bats test_tags=real-sops
@test "secrets: encrypt writes a .secrets/.gitignore that commits only .enc" {
  require_tools
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  # setup() stubs `:args`, so --ssh-key is never parsed and secrets::init falls
  # back to LOK8S_SSH_KEY, which defaults to ${HOME}/.ssh/id_ed25519 — the
  # developer's PRIVATE key. ssh-to-age then fails to parse it and the test dies
  # for a reason that has nothing to do with .gitignore. The round-trip test
  # above already exports this for the same reason; this one did not.
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  secrets::init --ssh-key "${BATS_TEST_TMPDIR}/id.pub"
  run secrets::encrypt
  assert_success
  run cat "${PATH_SECRETS}/.gitignore"
  assert_output --partial '!Secret.*.enc'
}

# A .gitignore of the store that is a symlink or a directory: encrypt refuses
# it before it reads or writes it, and stops. The file that the link names
# and the store stay as they were: type, link, time and bytes of each entry
# (Go twin: TestEncryptRefusesAGitignoreThatIsALinkOrNotARegularFile). No
# crypto tools: the encrypt of a file is a stub that logs it.
_gitignore_refused() { # <link|dir>
  local outside="${BATS_TEST_TMPDIR}/elsewhere" log="${BATS_TEST_TMPDIR}/encrypt.log" before
  mkdir -p "${outside}"
  : > "${log}"
  secrets::_encrypt_file() { echo "${1}" >> "${log}"; }
  printf 'creation_rules: []\n' > "${PATH_BASE}/.sops.yaml"
  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  case "${1}" in
    link) printf '# not the rules of lok8s\n' > "${outside}/gitignore"
          ln -s "${outside}/gitignore" "${PATH_SECRETS}/.gitignore" ;;
    dir) mkdir "${PATH_SECRETS}/.gitignore" ;;
  esac
  _states() {
    find "${PATH_SECRETS}" "${outside}" -printf '%y %p %l %T@\n' | LC_ALL=C sort
    find "${PATH_SECRETS}" "${outside}" -type f -exec cksum {} + | LC_ALL=C sort
  }
  before="$(_states)"
  run secrets::encrypt
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/.gitignore is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: lo stopped before the .enc writes. Remove it, then run this command again" ] || {
    echo "$output" >&2; return 1; }
  [ ! -s "${log}" ] || { echo "encrypted: $(cat "${log}")" >&2; return 1; }
  [ "$(_states)" = "${before}" ] || { diff <(echo "${before}") <(_states) >&2; return 1; }
}

# The .gitignore write goes to a temp file in the store and a rename: a hard
# link to the old file keeps its bytes, the new file has mode 0644, and no
# temp file stays (Go twin: TestEnsureGitignoreReplacesAHardLink).
@test "secrets: the .gitignore write replaces a hard link instead of writing through it" {
  local outside="${BATS_TEST_TMPDIR}/elsewhere"
  printf '# old\n' > "${outside}"
  ln "${outside}" "${PATH_SECRETS}/.gitignore"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$(cat "${outside}")" = '# old' ] || { echo "the write went through the hard link" >&2; return 1; }
  cmp -s "${PATH_SECRETS}/.gitignore" <(_block; printf '# old\n') || { cat "${PATH_SECRETS}/.gitignore" >&2; return 1; }
  [ ! "${outside}" -ef "${PATH_SECRETS}/.gitignore" ]
  [ "$(stat -c %a "${PATH_SECRETS}/.gitignore")" = 644 ]
  [ -z "$(find "${PATH_SECRETS}" -name '..gitignore.tmp-*')" ]
}

# A .gitignore that it cannot write (the store is read-only): status 1, one
# line names the file (no message of mktemp, chmod or mv: it has the raw
# path), and the old file stays (Go twin:
# TestEnsureGitignoreReportsAWriteThatFails).
@test "secrets: a .gitignore write that fails gives status 1 and keeps the old file" {
  [ "$(id -u)" -ne 0 ] || skip "root writes every directory"
  printf '# old\n' > "${PATH_SECRETS}/.gitignore"
  chmod 555 "${PATH_SECRETS}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  chmod 755 "${PATH_SECRETS}"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output}" = "[error] cannot write .secrets/.gitignore: it was not changed" ] || { echo "$output" >&2; return 1; }
  [ "$(cat "${PATH_SECRETS}/.gitignore")" = '# old' ]
}

# init returns the status of its .gitignore write, and writes no .sops.yaml:
# the .gitignore comes first (Go twin: TestInitReturnsAGitignoreWriteThatFails).
# ssh-to-age and sops are functions: no crypto tools.
@test "secrets init: a .gitignore write that fails gives status 1" {
  [ "$(id -u)" -ne 0 ] || skip "root writes every directory"
  ssh-to-age() { echo 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7'; }
  sops() { :; }
  printf 'ssh-ed25519 AAAA test\n' > "${BATS_TEST_TMPDIR}/id.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  printf '# old\n' > "${PATH_SECRETS}/.gitignore"
  chmod 555 "${PATH_SECRETS}"
  run secrets::init
  chmod 755 "${PATH_SECRETS}"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "[error] cannot write .secrets/.gitignore: it was not changed" ] || { echo "$output" >&2; return 1; }
  [ "$(cat "${PATH_SECRETS}/.gitignore")" = '# old' ]
  [ ! -e "${PATH_BASE}/.sops.yaml" ] || { echo "init wrote .sops.yaml before its .gitignore" >&2; return 1; }
}

# A .gitignore write that stops part way (the payload write ends after half
# of the payload, as on a full disk): status 1, the last line names the file,
# the old file stays, and no temp file is left (Go twin:
# TestAddKeyKeepsTheGitignoreOnAPartialWrite). printf is a function here: for
# the block it writes the first half of its first line and a call marker,
# then fails. The lines of the library use builtin printf. The control: with
# the real printf the write passes.
@test "secrets: a .gitignore write that stops part way keeps the old file and leaves no temp file" {
  local marker="${BATS_TEST_TMPDIR}/printf.ran"
  printf '# old\n' > "${PATH_SECRETS}/.gitignore"
  printf() {
    [[ "${*}" == *'!Secret.*.enc'* ]] || { builtin printf "${@}"; return; }
    builtin printf '%s' "${2:0:${#2}/2}"
    : >> "${marker}"
    return 1
  }
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  unset -f printf
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ -e "${marker}" ] || { echo "fixture: the payload write did not run" >&2; return 1; }
  [ "${output}" = "[error] cannot write .secrets/.gitignore: it was not changed" ] || { echo "$output" >&2; return 1; }
  [ "$(cat "${PATH_SECRETS}/.gitignore")" = '# old' ] || { echo "the .gitignore changed: $(cat "${PATH_SECRETS}/.gitignore")" >&2; return 1; }
  [ -z "$(find "${PATH_SECRETS}" -name '..gitignore.tmp-*')" ] || { echo "a temp file was left" >&2; return 1; }

  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "the control: status $status: $output" >&2; return 1; }
  grep -qxF '!Secret.*.enc' "${PATH_SECRETS}/.gitignore" || { echo "the control: $(cat "${PATH_SECRETS}/.gitignore")" >&2; return 1; }
  [ -z "$(find "${PATH_SECRETS}" -name '..gitignore.tmp-*')" ] || { echo "the control left a temp file" >&2; return 1; }
}

# The .gitignore plan reads the whole file as git does (Go twin:
# TestPlanGitignore). A file with comments only is not current (the old
# check found the allow line in a comment): it gets the block on top, and
# its bytes follow the block.
@test "secrets: a .gitignore with comments only gets the block on top" {
  local ignore="${PATH_SECRETS}/.gitignore"
  printf '# *\n# !Secret.*.enc\n' > "${ignore}"
  run secrets::_gitignore_current "${PATH_SECRETS}"
  [ "$status" -eq 1 ] || { echo "a file with comments only is current" >&2; return 1; }
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; printf '# *\n# !Secret.*.enc\n') || { cat "${ignore}" >&2; return 1; }
}

# A file with no block gets it on top, and a file that starts with the lines
# that lo wrote before the block gets the block in their place. The other
# bytes follow it, a last line with no newline too (Go twin:
# TestPlanGitignore).
@test "secrets: a .gitignore with no block gets it, and the legacy lines get it in their place" {
  local ignore="${PATH_SECRETS}/.gitignore"
  printf 'mine\n/tmp/\nlast' > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "no block: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; printf 'mine\n/tmp/\nlast') || { cat "${ignore}" >&2; return 1; }

  { _legacy; printf 'extra\n'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "legacy: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; printf 'extra\n') || { cat "${ignore}" >&2; return 1; }

  _legacy | sed 's/$/\r/' > "${ignore}"
  printf 'extra\r\n' >> "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "legacy with CRLF: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; printf 'extra\r\n') || { cat -A "${ignore}" >&2; return 1; }
}

# The lines above and below the block stay byte for byte (a CR, an empty
# line, a last line with no newline), and a changed block becomes the block.
# A second run writes nothing: the file keeps its inode (Go twin:
# TestEnsureGitignoreKeepsTheLinesOfTheUser).
@test "secrets: the rules of the user above and below the block stay byte for byte" {
  local ignore="${PATH_SECRETS}/.gitignore" inode
  { printf 'above\r\n'
    _block | head -n 1 | sed 's/$/\r/'
    printf '# an old comment\n*\n!.gitignore\n!Secret.*.enc\n# END lok8s secrets\n'
    printf 'below\n\n# note\nlast'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(printf 'above\r\n'; _block; printf 'below\n\n# note\nlast') || { cat -A "${ignore}" >&2; return 1; }
  inode="$(stat -c %i "${ignore}")"
  run secrets::_gitignore_current "${PATH_SECRETS}"
  [ "$status" -eq 0 ] || { echo "the plan is not current" >&2; return 1; }
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "the second run: status $status: $output" >&2; return 1; }
  [ "$(stat -c %i "${ignore}")" = "${inode}" ] || { echo "the second run wrote the file" >&2; return 1; }
}

# Each negation inside and below the block is refused, with the file, the
# line number and the reason, then a final line with the step that the
# check stops before. Another rule in the block is refused too. The file
# keeps its bytes (Go twin: TestPlanGitignore).
@test "secrets: a later negation inside and below the block is refused, with its line" {
  local ignore="${PATH_SECRETS}/.gitignore" negation inside
  negation='this negation can re-include a plaintext secret file (the last matching rule wins): remove the line, or keep the file outside the store'
  inside='this rule is in the lok8s block, which lo rewrites: move it below the END line'
  { printf 'above\n'; _block | head -n 7; printf '!Secret.app.default.K\n*.log\n# END lok8s secrets\nkeep\n!*.yaml\n'; } > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/.gitignore:9: ${negation}
[error] .secrets/.gitignore:10: ${inside}
[error] .secrets/.gitignore:13: ${negation}
[error] .secrets/.gitignore was not changed, and lo stopped before the plaintext write: fix each cause above, then run this command again" ] || {
    echo "$output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "the file changed" >&2; return 1; }

  printf 'x\n!Secret.app.default.K\n' > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "no block: status $status: $output" >&2; return 1; }
  [ "${lines[0]}" = "[error] .secrets/.gitignore:2: ${negation}" ] || { echo "$output" >&2; return 1; }

  { _legacy; printf '!*\n'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "legacy: status $status: $output" >&2; return 1; }
  [ "${lines[0]}" = "[error] .secrets/.gitignore:6: ${negation}" ] || { echo "$output" >&2; return 1; }
}

# Below the block, each line whose first byte is ! is refused, whatever it
# matches: with the */ line of the block, nothing else below the block can
# re-include a path. An escaped !, a leading space and positive rules pass.
# A rule above the block has no effect, a negation too: the block comes
# after it. A comment and an empty line count in the line number (Go twin:
# TestPlanGitignore).
@test "secrets: each negation below the block is refused, and the rules above it have no effect" {
  local ignore="${PATH_SECRETS}/.gitignore" negation n=9 l
  negation='this negation can re-include a plaintext secret file (the last matching rule wins): remove the line, or keep the file outside the store'
  { printf '!plain\n!*\n'; _block; printf '%s\n' '\!x' ' !x' '*.log' 'Secret.*.enc' '.gitignore'; } > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "the accepted rules: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "a current file was written" >&2; return 1; }

  local -a bad=('![x/Secret.].enc' '!Secret.*.ENC' '!?' '!README.md' '!Secret.x.enc' '!.gitignore' '!')
  { _block; printf '%s\n' "${bad[@]}"; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${#lines[@]}" -eq 8 ] || { echo "$output" >&2; return 1; }
  for l in "${bad[@]}"; do
    [ "${lines[n - 9]}" = "[error] .secrets/.gitignore:${n}: ${negation}" ] || { echo "line ${n} (${l}): ${lines[n - 9]}" >&2; return 1; }
    n=$(( n + 1 ))
  done

  { _block; printf '# note\n\n!plain\n'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "after a comment: status $status: $output" >&2; return 1; }
  [ "${lines[0]}" = "[error] .secrets/.gitignore:11: ${negation}" ] || { echo "$output" >&2; return 1; }
}

# Any marker shape other than one BEGIN line, then one END line, is refused
# with each marker line. A NUL byte is refused with one line (git ends a
# rule at that byte), and so is a file of more than 1048576 bytes. A
# refused file keeps its bytes, and a file at the limit passes (Go twin:
# TestPlanGitignore).
@test "secrets: a bad marker shape, a NUL byte and a large file are refused" {
  local ignore="${PATH_SECRETS}/.gitignore" marker begin end final
  marker='the BEGIN and END lines of the lok8s block must occur once each, with BEGIN first'
  final='[error] .secrets/.gitignore was not changed, and lo stopped before the plaintext write: fix each cause above, then run this command again'
  begin="$(_block | head -n 1)" end='# END lok8s secrets'
  printf '%s\n' "${begin}" "${begin}" "${end}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "two BEGIN lines: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/.gitignore:1: ${marker}
[error] .secrets/.gitignore:2: ${marker}
[error] .secrets/.gitignore:3: ${marker}
${final}" ] || { echo "$output" >&2; return 1; }

  printf '%s\n' "${end}" "${begin}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "END first: status $status: $output" >&2; return 1; }
  [ "${lines[0]}" = "[error] .secrets/.gitignore:1: ${marker}" ] && [ "${lines[1]}" = "[error] .secrets/.gitignore:2: ${marker}" ] || {
    echo "$output" >&2; return 1; }

  printf 'a\0b\n' > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "NUL: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/.gitignore: the file has a NUL byte, and git ends a rule at that byte: remove it
${final}" ] || { echo "$output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "the file changed" >&2; return 1; }

  head -c 1048577 /dev/zero | tr '\0' '#' > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "a large file: status $status" >&2; return 1; }
  [ "$output" = "[error] .secrets/.gitignore: the file has more than 1048576 bytes, and lo does not read a larger .gitignore: make it smaller
${final}" ] || { echo "$output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "the large file changed" >&2; return 1; }

  # The plan must fit the limit too: the next run would refuse a larger
  # file. A file at the limit is read, and its plan with the block is
  # refused, and so is a short block that grows past the limit. A plan at
  # the limit is written (the test of set below runs it twice).
  local grow blen
  grow='[error] .secrets/.gitignore: with the lok8s block the file would have more than 1048576 bytes, and lo does not read a larger .gitignore: make it smaller'
  blen="$(_block | wc -c)"
  head -c 1048576 /dev/zero | tr '\0' '#' > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "a file at the limit: status $status: $output" >&2; return 1; }
  [ "$output" = "${grow}
${final}" ] || { echo "$output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "the file at the limit changed" >&2; return 1; }

  { printf '%s\n' "${begin}" "${end}"; head -c $(( 1048576 - blen + 1 )) /dev/zero | tr '\0' '#'; } > "${ignore}"
  cp -p -- "${ignore}" "${BATS_TEST_TMPDIR}/before"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "a short block that grows: status $status: $output" >&2; return 1; }
  [ "$output" = "${grow}
${final}" ] || { echo "$output" >&2; return 1; }
  cmp -s "${ignore}" "${BATS_TEST_TMPDIR}/before" || { echo "the short block changed" >&2; return 1; }

  head -c $(( 1048576 - blen + 1 )) /dev/zero | tr '\0' '#' > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "a plan one byte over the limit: status $status: $output" >&2; return 1; }

  head -c $(( 1048576 - blen )) /dev/zero | tr '\0' '#' > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "a plan at the limit: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; head -c $(( 1048576 - blen )) /dev/zero | tr '\0' '#') || { echo "a plan at the limit: wrong bytes" >&2; return 1; }
  [ "$(wc -c < "${ignore}")" -eq 1048576 ]
}

# A refusal prints the file, the line number and the reason. It never
# prints the rule, which can hold a pasted secret, and a byte of the path
# outside the printable ASCII range shows as ? (Go twin:
# TestGitignoreRefusalNeverPrintsTheRule).
@test "secrets: a refusal names the file, the line and the reason, never the rule" {
  local negation inside dir store
  negation='this negation can re-include a plaintext secret file (the last matching rule wins): remove the line, or keep the file outside the store'
  inside='this rule is in the lok8s block, which lo rewrites: move it below the END line'
  for store in .secrets "st"$'\033'"[2Jore"; do
    dir="${PATH_BASE}/${store}"
    mkdir -p "${dir}"
    { printf 'above\n'; _block | head -n 1; printf 'PASSWORD=hunter2\n'; _block | sed -n '4,8p'; printf '!API_TOKEN=s3cr3t-value\n'; } > "${dir}/.gitignore"
    cp -p -- "${dir}/.gitignore" "${BATS_TEST_TMPDIR}/before"
    run secrets::_ensure_gitignore "${dir}" "the plaintext write"
    [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
    local rel="${store//$'\033'/?}/.gitignore"
    [ "$output" = "[error] ${rel}:3: ${inside}
[error] ${rel}:9: ${negation}
[error] ${rel} was not changed, and lo stopped before the plaintext write: fix each cause above, then run this command again" ] || {
      echo "$output" >&2; return 1; }
    [[ "${output}" != *hunter2* && "${output}" != *s3cr3t* && "${output}" != *PASSWORD* && "${output}" != *API_TOKEN* && "${output}" != *$'\033'* ]] || {
      echo "the refusal prints the rule" >&2; return 1; }
    cmp -s "${dir}/.gitignore" "${BATS_TEST_TMPDIR}/before" || { echo "the file changed" >&2; return 1; }
  done
}

# Git skips a UTF-8 BOM only at the start of a .gitignore. The plan reads
# the first line without it and keeps it at the start: a BOM before BEGIN
# still finds the block, and a file with no block gets the block after the
# BOM (Go twin: TestPlanGitignoreKeepsTheBOMAtTheStart).
@test "secrets: a BOM stays at the start of the .gitignore" {
  local ignore="${PATH_SECRETS}/.gitignore" bom=$'\xef\xbb\xbf' negation
  negation='this negation can re-include a plaintext secret file (the last matching rule wins): remove the line, or keep the file outside the store'
  printf '%smine\n' "${bom}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "no block: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(printf '%s' "${bom}"; _block; printf 'mine\n') || { od -c "${ignore}" | head -3 >&2; return 1; }
  run secrets::_gitignore_current "${PATH_SECRETS}"
  [ "$status" -eq 0 ] || { echo "a BOM before BEGIN: the block is not current" >&2; return 1; }

  { printf '%s' "${bom}"; _block | head -n 1; printf '*\n# END lok8s secrets\n'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "a changed block: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(printf '%s' "${bom}"; _block) || { od -c "${ignore}" | head -3 >&2; return 1; }

  { printf '%s' "${bom}"; _legacy; printf 'x\n'; } > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "legacy: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(printf '%s' "${bom}"; _block; printf 'x\n') || { od -c "${ignore}" | head -3 >&2; return 1; }

  printf '%s' "${bom}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "a BOM only: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(printf '%s' "${bom}"; _block) || { od -c "${ignore}" | head -3 >&2; return 1; }

  printf '%s!plain\n' "${bom}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "a negation on the first line: status $status: $output" >&2; return 1; }
  [ "${lines[0]}" = "[error] .secrets/.gitignore:1: ${negation}" ] || { echo "$output" >&2; return 1; }

  # A BOM on line 3 is bytes of that line, not a second start: the line
  # starts with the BOM, not with !, so it is no negation.
  printf 'a\nb\n%s!plain\n' "${bom}" > "${ignore}"
  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 0 ] || { echo "a BOM on line 3: status $status: $output" >&2; return 1; }
  cmp -s "${ignore}" <(_block; printf 'a\nb\n%s!plain\n' "${bom}") || { od -c "${ignore}" | head -3 >&2; return 1; }
}

# _git_would_add <ignorecase> — copies the .gitignore of PATH_SECRETS into
# the store .secrets/ of a new git repository, with the files of a store:
# a plaintext and its ciphertext, a directory Secret.x.enc/ whose
# .gitignore re-includes its plaintext child, the restore.d/ and tls/
# directories, and a file of the user. It prints what `git add --dry-run
# -A` would add, sorted. The git config of the host is not read
# (GIT_CONFIG_NOSYSTEM, an empty global config, HOME in a temp dir). A
# missing git fails the test.
_git_would_add() {
  local repo home s
  command -v git > /dev/null || { echo "this test needs git" >&2; return 1; }
  repo="$(mktemp -d "${BATS_TEST_TMPDIR}/repo.XXXXXX")" home="$(mktemp -d "${BATS_TEST_TMPDIR}/home.XXXXXX")"
  s="${repo}/.secrets"
  mkdir -p "${s}/Secret.x.enc" "${s}/Secret.y.enc" "${s}/restore.d" "${s}/tls"
  cp -- "${PATH_SECRETS}/.gitignore" "${s}/.gitignore"
  printf 'plain' > "${s}/Secret.app.default.K"
  printf 'cipher' > "${s}/Secret.app.default.K.enc"
  printf '!*\n' > "${s}/Secret.x.enc/.gitignore"
  printf 'plain' > "${s}/Secret.x.enc/Secret.app.default.P"
  printf 'cipher' > "${s}/Secret.y.enc/Secret.a.b.c.enc"
  printf '!*\n' > "${s}/restore.d/.gitignore"
  printf 'plain' > "${s}/restore.d/app.yaml"
  printf 'plain' > "${s}/tls/tls.key"
  printf 'notes' > "${s}/README.md"
  (
    cd "${repo}" || exit 1
    _git() { env -i PATH="${PATH}" HOME="${home}" LC_ALL=C GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null git "$@"; }
    _git init -q || exit 1
    _git -c "core.ignorecase=${1}" -c core.quotepath=off add --dry-run -A > "${repo}.added" || exit 1
    sed -e "s/^add '//" -e "s/'\$//" "${repo}.added" | LC_ALL=C sort
  )
}

# Git is the oracle: with each .gitignore that lo writes, git would commit
# only the .gitignore and the ciphertext of the top of the store, with
# core.ignorecase off and on. The rules above the block (also the negations
# there) and the accepted rules below it change nothing (Go twin:
# TestGitignoreKeepsPlaintextOutOfGit). The argsh container of CI has no
# git, so the test skips there; CI runs the real-git tag again on the
# runner, where a skip fails the step.
# bats test_tags=real-git
@test "secrets: with the .gitignore of lo, git commits only the .gitignore and the ciphertext" {
  command -v git >/dev/null 2>&1 || skip "git not installed"
  local want=$'.secrets/.gitignore\n.secrets/Secret.app.default.K.enc' input ic got
  local -a inputs=(
    ''
    $'!*\n!Secret.app.default.K\n!restore.d/\n!Secret.x.enc/\n'"$(_block)"$'\n\\!x\n*.log\n# note\n\n'
    $'\xef\xbb\xbfmine\n'
    "$(_legacy)"$'\nextra\n'
    "$(_block)"$'\na\nb\n\xef\xbb\xbf!Secret.app.default.K\n'
  )
  for input in "${inputs[@]}"; do
    rm -f -- "${PATH_SECRETS}/.gitignore"
    [[ -z "${input}" ]] || printf '%s' "${input}" > "${PATH_SECRETS}/.gitignore"
    run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
    [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
    for ic in false true; do
      got="$(_git_would_add "${ic}")" || { echo "git failed" >&2; return 1; }
      [ "${got}" = "${want}" ] || { printf 'core.ignorecase=%s, input %q: git would add\n%s\n' "${ic}" "${input}" "${got}" >&2; return 1; }
    done
  done
}

# _refused_ignore <step> writes a .gitignore that re-includes the plaintext
# of app (line 9), and sets the caller's refusal to the two lines of its
# refusal, with the step that the check stops before.
_refused_ignore() {
  { _block; printf '!Secret.app.default.K\n'; } > "${PATH_SECRETS}/.gitignore"
  refusal="[error] .secrets/.gitignore:9: this negation can re-include a plaintext secret file (the last matching rule wins): remove the line, or keep the file outside the store
[error] .secrets/.gitignore was not changed, and lo stopped before ${1}: fix each cause above, then run this command again"
}

# set checks the .gitignore before it writes the plaintext: a store with no
# .gitignore gets it, and a refused one stops the run with no plaintext
# (Go twin: TestSetChecksTheGitignoreBeforeThePlaintext). :args sets the
# arguments of set, and the live drift check is a function that does
# nothing: no kubectl.
@test "secrets set: the .gitignore is checked before the plaintext" {
  local refusal
  :args() { name=app key=K value=v; }
  secrets::_live_drift() { :; }
  run secrets::set
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  cmp -s "${PATH_SECRETS}/.gitignore" <(_block) || { cat "${PATH_SECRETS}/.gitignore" >&2; return 1; }
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.K")" = v ]
  rm -f -- "${PATH_SECRETS}/Secret.app.default.K"

  _refused_ignore "the plaintext write"
  run secrets::set
  [ "$status" -eq 1 ] || { echo "a refused .gitignore: status $status: $output" >&2; return 1; }
  [ "$output" = "${refusal}" ] || { echo "$output" >&2; return 1; }
  [ ! -e "${PATH_SECRETS}/Secret.app.default.K" ] || { echo "set wrote the plaintext" >&2; return 1; }
}

# set refuses a key that makes the plaintext name end in .enc, in any
# letter case, before any write and before it reads the value: the rule
# !Secret.*.enc of the .gitignore re-includes that name. The refusal names
# the key and the file, never the value. A key that ends in ENC without the
# dot is written (Go twin: TestSetRefusesAKeyThatEndsInEnc).
@test "secrets set: a key that ends in .enc is refused before any write" {
  local _k
  :args() { name=app key="${_k}" value=the-value; }
  secrets::_live_drift() { :; }
  for _k in enc ENC password.enc Password.Enc; do
    run secrets::set
    [ "$status" -eq 1 ] || { echo "${_k}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] the key '${_k}' is refused: the plaintext file Secret.app.default.${_k} would end in .enc (in any letter case), and the .gitignore rule !Secret.*.enc lets git commit it. Nothing was written: use a key name that does not end in .enc" ] || {
      echo "${_k}: $output" >&2; return 1; }
    [ -z "$(ls -A "${PATH_SECRETS}")" ] || { echo "${_k}: set wrote $(ls -A "${PATH_SECRETS}")" >&2; return 1; }
  done
  _k=NOT_ENC
  run secrets::set
  [ "$status" -eq 0 ] || { echo "the control: status $status: $output" >&2; return 1; }
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.NOT_ENC")" = the-value ]
}

# decrypt checks the .gitignore before the first plaintext, also before it
# looks for the age key (Go twin: TestDecryptChecksTheGitignoreBeforeThePlaintext).
# ssh-to-age and sops are functions that log a call: no crypto tools.
@test "secrets decrypt: the .gitignore is checked before the key lookup" {
  local refusal log="${BATS_TEST_TMPDIR}/tools.log"
  ssh-to-age() { echo ssh-to-age >> "${log}"; return 1; }
  sops() { echo sops >> "${log}"; return 1; }
  export SOPS_AGE_KEY_FILE="${BATS_TEST_TMPDIR}/no-keys.txt"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/no-key"
  unset SOPS_AGE_KEY
  printf 'x' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  _refused_ignore "the first plaintext write"
  run secrets::decrypt
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "${refusal}" ] || { echo "$output" >&2; return 1; }
  [ ! -e "${log}" ] || { echo "a tool ran: $(cat "${log}")" >&2; return 1; }
  [ ! -e "${PATH_SECRETS}/Secret.app.default.K" ]

  printf 'mine\n' > "${PATH_SECRETS}/.gitignore"
  run secrets::decrypt
  cmp -s "${PATH_SECRETS}/.gitignore" <(_block; printf 'mine\n') || { cat "${PATH_SECRETS}/.gitignore" >&2; return 1; }
}

# decrypt refuses, before any write and before it looks for the age key, a
# ciphertext whose plaintext name ends in .enc in any letter case: the rule
# !Secret.*.enc of the .gitignore re-includes that name. Each such file has
# a line, in the order of the store (Go twin:
# TestDecryptRefusesAPlaintextNameThatEndsInEnc). ssh-to-age and sops are
# functions that log a call: no crypto tools.
@test "secrets decrypt: a ciphertext whose plaintext name ends in .enc is refused before any write" {
  local log="${BATS_TEST_TMPDIR}/tools.log" base rule before
  ssh-to-age() { echo ssh-to-age >> "${log}"; return 1; }
  sops() { echo sops >> "${log}"; return 1; }
  export SOPS_AGE_KEY_FILE="${BATS_TEST_TMPDIR}/no-keys.txt"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/no-key"
  unset SOPS_AGE_KEY
  for base in Secret.app.default.K.enc Secret.app.default.enc.enc Secret.app.default.PW.ENC.enc; do
    printf 'x' > "${PATH_SECRETS}/${base}"
  done
  before="$(ls -A "${PATH_SECRETS}")"
  rule=', which ends in .enc (in any letter case), and the .gitignore rule !Secret.*.enc lets git commit it'
  run secrets::decrypt
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/Secret.app.default.PW.ENC.enc: decrypt would write the plaintext file Secret.app.default.PW.ENC${rule}
[error] .secrets/Secret.app.default.enc.enc: decrypt would write the plaintext file Secret.app.default.enc${rule}
[error] decrypt wrote no plaintext file: move these .enc files out of the store, then run this command again" ] || {
    echo "$output" >&2; return 1; }
  [ ! -e "${log}" ] || { echo "a tool ran: $(cat "${log}")" >&2; return 1; }
  [ "$(ls -A "${PATH_SECRETS}")" = "${before}" ] || { echo "decrypt wrote $(ls -A "${PATH_SECRETS}")" >&2; return 1; }
}

# _store_state <dir> — prints each entry under <dir>: its type, its name,
# its link target and, for a regular file, its sha256. Any write shows in
# it.
_store_state() {
  local f
  while IFS= read -r -d '' f; do
    builtin printf '%s %s %s' "$(stat -c %F -- "${f}")" "${f}" "$(readlink -- "${f}" || true)"
    [[ -L "${f}" || ! -f "${f}" ]] || builtin printf ' %s' "$(sha256sum < "${f}")"
    builtin printf '\n'
  done < <(find "${1}" -print0 | LC_ALL=C sort -z)
}

# _not_regular is the middle of each refusal of a destination that is not a
# regular file.
_not_regular=' is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: '

# set refuses a name, a namespace or a key that is not one part of a path,
# before it reads the value (cat is a function that logs a call) and before
# any write. The refusal names the field and its text with printable bytes
# only. With the directory Secret.app.default.anchor/ in the store, the key
# anchor/../.gitignore would write the value into the .gitignore (Go twin:
# TestSetRefusesAPathPartBeforeItReadsTheValue). A shell argument cannot
# hold a NUL, so the Go test has that case only.
@test "secrets set: a name, a namespace or a key with a path part is refused before it reads the value" {
  local log="${BATS_TEST_TMPDIR}/read.log" before row _n _s _k field shown why
  local sep='it has a / or a \, which makes the file name a path' dots='it is . or .., a part of a path'
  cat() { echo cat >> "${log}"; }
  secrets::_live_drift() { :; }
  :args() { name="${_n}" namespace="${_s}" key="${_k}" value=""; }
  _block > "${PATH_SECRETS}/.gitignore"
  mkdir "${PATH_SECRETS}/Secret.app.default.anchor"
  before="$(_store_state "${PATH_SECRETS}")"
  local -a rows=(
    "app|default|anchor/../.gitignore|key|anchor/../.gitignore|${sep}"
    "app|default|../x|key|../x|${sep}"
    "app|default|a/b|key|a/b|${sep}"
    "app|default|a\\b|key|a\\b|${sep}"
    "app|default|.|key|.|${dots}"
    "app|default|..|key|..|${dots}"
    "app|default|a"$'\e'"[2Jb|key|a?[2Jb|it has a control byte"
    "a/b|default|K|name|a/b|${sep}"
    "app|..|K|namespace|..|${dots}"
  )
  for row in "${rows[@]}"; do
    IFS='|' read -r _n _s _k field shown why <<< "${row}"
    run secrets::set < /dev/null
    [ "$status" -eq 1 ] || { echo "${row}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] the ${field} '${shown}' is refused: ${why}. Nothing was written: use a ${field} without it" ] || {
      echo "${row}: $output" >&2; return 1; }
    [ "$(_store_state "${PATH_SECRETS}")" = "${before}" ] || { echo "${row}: a store entry changed" >&2; return 1; }
    [ ! -e "${log}" ] || { echo "${row}: set read the value" >&2; return 1; }
  done
}

# The plaintext file of set is one entry of the store itself
# (secrets::_set_destination): a base with a / in it is refused, also when
# a .. in it leads back to the store (Go twin: TestSetDestination).
@test "secrets set: the plaintext file is an entry of the store itself" {
  local dest="" base
  secrets::_set_destination /p/.secrets Secret.app.default.K
  [ "${dest}" = /p/.secrets/Secret.app.default.K ]
  for base in Secret.app.default.anchor/../.gitignore Secret.app.default.a/b Secret.app.default.K/; do
    run secrets::_set_destination /p/.secrets "${base}"
    [ "$status" -eq 1 ] || { echo "${base}: status $status" >&2; return 1; }
    [ "$output" = "[error] the plaintext file ${base} is refused: it is not a file of the store directory itself. Nothing was written: use a name, a namespace and a key without a path part" ] || {
      echo "${base}: $output" >&2; return 1; }
  done
}

# set refuses a plaintext file that is a symlink (to a file that git
# commits) or a directory: nothing is written, and the file that the link
# names keeps its bytes (Go twin: TestSetRefusesALinkedPlaintextFile).
@test "secrets set: a plaintext file that is a symlink or a directory is refused" {
  local target before
  :args() { name=app key=K value=the-value; }
  secrets::_live_drift() { :; }
  _block > "${PATH_SECRETS}/.gitignore"
  printf 'ciphertext-bytes' > "${PATH_SECRETS}/Secret.leak.enc"
  for target in Secret.leak.enc .gitignore ''; do
    rm -rf -- "${PATH_SECRETS}/Secret.app.default.K"
    if [[ -z "${target}" ]]; then
      mkdir "${PATH_SECRETS}/Secret.app.default.K"
    else
      ln -s "${target}" "${PATH_SECRETS}/Secret.app.default.K"
    fi
    before="$(_store_state "${PATH_SECRETS}")"
    run secrets::set
    [ "$status" -eq 1 ] || { echo "${target:-a directory}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] .secrets/Secret.app.default.K${_not_regular}lo stopped before the plaintext write. Remove it, then run this command again" ] || {
      echo "${target:-a directory}: $output" >&2; return 1; }
    [ "$(_store_state "${PATH_SECRETS}")" = "${before}" ] || { echo "${target:-a directory}: a store entry changed" >&2; return 1; }
  done
}

# _hard_link_replaced <want> — the plaintext file Secret.app.default.K was a
# hard link of elsewhere: it holds <want> with mode 600, elsewhere holds
# old, the two are different files, and no temp file is left (Go twin:
# hardLinkReplaced).
_hard_link_replaced() {
  local dest="${PATH_SECRETS}/Secret.app.default.K" other="${BATS_TEST_TMPDIR}/elsewhere"
  [ "$(< "${dest}")" = "${1}" ] || { echo "the plaintext file: $(< "${dest}")" >&2; return 1; }
  [ "$(< "${other}")" = old ] || { echo "the other name of the hard link: $(< "${other}")" >&2; return 1; }
  [ ! "${dest}" -ef "${other}" ] || { echo "the plaintext file is still a hard link" >&2; return 1; }
  [ "$(stat -c %a -- "${dest}")" = 600 ] || { echo "mode $(stat -c %a -- "${dest}")" >&2; return 1; }
  [ -z "$(find "${PATH_SECRETS}" -name '.Secret.app.default.K.tmp-*')" ] || { echo "a temp file was left" >&2; return 1; }
}

# set replaces a hard link at the plaintext file as a name: the other name
# keeps its old content (Go twin: TestSetReplacesAHardLinkedPlaintextFile).
@test "secrets set: a hard link at the plaintext file is replaced as a name" {
  :args() { name=app key=K value=new; }
  secrets::_live_drift() { :; }
  _block > "${PATH_SECRETS}/.gitignore"
  printf 'old' > "${BATS_TEST_TMPDIR}/elsewhere"
  ln "${BATS_TEST_TMPDIR}/elsewhere" "${PATH_SECRETS}/Secret.app.default.K"
  run secrets::set
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  _hard_link_replaced new
}

# decrypt refuses a plaintext file that is a symlink (to a file that git
# commits) before its first write and before the key lookup: nothing is
# written, and the file that the link names keeps its bytes. ssh-to-age and
# sops are functions that log a call (Go twin:
# TestDecryptRefusesALinkedPlaintextFile).
@test "secrets decrypt: a plaintext file that is a symlink is refused before any write" {
  local log="${BATS_TEST_TMPDIR}/tools.log" target before
  ssh-to-age() { echo ssh-to-age >> "${log}"; return 1; }
  sops() { echo sops >> "${log}"; return 1; }
  export SOPS_AGE_KEY=stub-identity
  _block > "${PATH_SECRETS}/.gitignore"
  printf 'x' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  printf 'ciphertext-bytes' > "${PATH_SECRETS}/Secret.leak.enc"
  for target in Secret.leak.enc .gitignore; do
    rm -f -- "${PATH_SECRETS}/Secret.app.default.K"
    ln -s "${target}" "${PATH_SECRETS}/Secret.app.default.K"
    before="$(_store_state "${PATH_SECRETS}")"
    run secrets::decrypt < /dev/null
    [ "$status" -eq 1 ] || { echo "${target}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] .secrets/Secret.app.default.K${_not_regular}decrypt would write the plaintext of Secret.app.default.K.enc there
[error] decrypt wrote no plaintext file: remove these entries, then run this command again" ] || {
      echo "${target}: $output" >&2; return 1; }
    [ "$(_store_state "${PATH_SECRETS}")" = "${before}" ] || { echo "${target}: a store entry changed" >&2; return 1; }
    [ ! -e "${log}" ] || { echo "${target}: a tool ran: $(< "${log}")" >&2; return 1; }
  done
}

# decrypt replaces a hard link at the plaintext file as a name: the other
# name keeps its old content, and the plaintext file holds the decrypted
# value. The plaintext is older than its .enc, so decrypt writes it. sops
# is a function that prints the value (Go twin:
# TestDecryptReplacesAHardLinkedPlaintextFile).
@test "secrets decrypt: a hard link at the plaintext file is replaced as a name" {
  sops() { [ "${1}" = decrypt ] || return 1; builtin printf 'decrypted-value'; }
  export SOPS_AGE_KEY=stub-identity
  _block > "${PATH_SECRETS}/.gitignore"
  printf 'x' > "${PATH_SECRETS}/Secret.app.default.K.enc"
  printf 'old' > "${BATS_TEST_TMPDIR}/elsewhere"
  touch -t 202001010000 "${BATS_TEST_TMPDIR}/elsewhere"
  ln "${BATS_TEST_TMPDIR}/elsewhere" "${PATH_SECRETS}/Secret.app.default.K"
  run secrets::decrypt < /dev/null
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = 'Decrypted 1 secret(s)' ] || { echo "$output" >&2; return 1; }
  _hard_link_replaced decrypted-value
}

# A path of a refusal prints with printable bytes only: a file name and a
# store name with a control byte show it as ? (Go twin:
# TestPlaintextRefusalsPrintAPathAsPrintable).
@test "secrets: a refused plaintext file prints its path with printable bytes only" {
  local name=$'Secret.app.default.K\e[2J'
  export SOPS_AGE_KEY=stub-identity
  _block > "${PATH_SECRETS}/.gitignore"
  printf 'x' > "${PATH_SECRETS}/${name}.enc"
  ln -s Secret.leak.enc "${PATH_SECRETS}/${name}"
  run secrets::decrypt < /dev/null
  [ "$status" -eq 1 ] || { echo "decrypt: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] .secrets/Secret.app.default.K?[2J${_not_regular}decrypt would write the plaintext of Secret.app.default.K?[2J.enc there
[error] decrypt wrote no plaintext file: remove these entries, then run this command again" ] || {
    echo "decrypt: $output" >&2; return 1; }

  :args() { name=app key=K value=the-value; }
  secrets::_live_drift() { :; }
  PATH_SECRETS="${PATH_BASE}/st"$'\e'"[2Jore"
  mkdir -p "${PATH_SECRETS}/Secret.app.default.K"
  _block > "${PATH_SECRETS}/.gitignore"
  run secrets::set
  [ "$status" -eq 1 ] || { echo "set: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] st?[2Jore/Secret.app.default.K${_not_regular}lo stopped before the plaintext write. Remove it, then run this command again" ] || {
    echo "set: $output" >&2; return 1; }
}

# At the size limit, a run writes a .gitignore that the next run reads: the
# plan of a file with no block is exactly 1048576 bytes, set writes it, and
# a second set passes and does not write it again. One byte more is refused
# before any write, also by the second run (Go twin:
# TestGitignoreAtTheSizeLimitPassesTwice).
@test "secrets set: a .gitignore plan at the size limit passes twice, and one byte more is refused twice" {
  local blen run before
  :args() { name=app key=K value=v; }
  secrets::_live_drift() { :; }
  blen="$(_block | wc -c)"
  head -c $(( 1048576 - blen )) /dev/zero | tr '\0' '#' > "${PATH_SECRETS}/.gitignore"
  for run in 1 2; do
    run secrets::set
    [ "$status" -eq 0 ] || { echo "run ${run}: status $status: $output" >&2; return 1; }
    cmp -s "${PATH_SECRETS}/.gitignore" <(_block; head -c $(( 1048576 - blen )) /dev/zero | tr '\0' '#') || {
      echo "run ${run}: the .gitignore has $(wc -c < "${PATH_SECRETS}/.gitignore") bytes" >&2; return 1; }
  done

  rm -f -- "${PATH_SECRETS}/Secret.app.default.K"
  head -c $(( 1048576 - blen + 1 )) /dev/zero | tr '\0' '#' > "${PATH_SECRETS}/.gitignore"
  for run in 1 2; do
    before="$(_store_state "${PATH_SECRETS}")"
    run secrets::set
    [ "$status" -eq 1 ] || { echo "one byte more, run ${run}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] .secrets/.gitignore: with the lok8s block the file would have more than 1048576 bytes, and lo does not read a larger .gitignore: make it smaller
[error] .secrets/.gitignore was not changed, and lo stopped before the plaintext write: fix each cause above, then run this command again" ] || {
      echo "one byte more, run ${run}: $output" >&2; return 1; }
    [ "$(_store_state "${PATH_SECRETS}")" = "${before}" ] || { echo "one byte more, run ${run}: a store entry changed" >&2; return 1; }
  done
}

# A rerun of init with a config writes no config, but it checks the
# .gitignore of the store and writes it when it needs a change, with the key
# in the config and with another key; a refused .gitignore stops it (Go
# twin: TestInitRerunChecksTheGitignore). ssh-to-age and sops are
# functions: no crypto tools.
@test "secrets init: a rerun checks the .gitignore and writes it when it needs a change" {
  local refusal cfg="${PATH_BASE}/.sops.yaml" key
  ssh-to-age() { echo 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7'; }
  sops() { :; }
  printf 'ssh-ed25519 AAAA test\n' > "${BATS_TEST_TMPDIR}/id.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  for key in age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7 age1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqz; do
    printf "creation_rules:\n  - path_regex: 'Secret\\\\..*'\n    age: '%s'\n" "${key}" > "${cfg}"
    cp -p -- "${cfg}" "${BATS_TEST_TMPDIR}/cfg"
    { _legacy; printf 'mine\n'; } > "${PATH_SECRETS}/.gitignore"
    run secrets::init
    [ "$status" -eq 0 ] || { echo "${key}: status $status: $output" >&2; return 1; }
    cmp -s "${PATH_SECRETS}/.gitignore" <(_block; printf 'mine\n') || { cat "${PATH_SECRETS}/.gitignore" >&2; return 1; }
    cmp -s "${cfg}" "${BATS_TEST_TMPDIR}/cfg" || { echo "${key}: init wrote the config" >&2; return 1; }

    _refused_ignore "its first write"
    cp -p -- "${PATH_SECRETS}/.gitignore" "${BATS_TEST_TMPDIR}/before"
    run secrets::init
    [ "$status" -eq 1 ] || { echo "${key}: a refused .gitignore: status $status: $output" >&2; return 1; }
    [ "$output" = "${refusal}" ] || { echo "${key}: $output" >&2; return 1; }
    cmp -s "${PATH_SECRETS}/.gitignore" "${BATS_TEST_TMPDIR}/before" || { echo "${key}: the .gitignore changed" >&2; return 1; }
  done
}

# init needs a mv that takes -T: a first run renames its temp file onto
# .sops.yaml, so it refuses before its first write (the lock file), with a
# line that names that write, also with a .gitignore that has the bytes of
# the plan. A rerun writes no config: with the key in the config it writes
# the .gitignore when the store has none, so it asks for the mv too, and
# with a current .gitignore it needs none. Here the mv has no -T
# (secrets::_mv_has_t is a function), and ssh-to-age and sops are
# functions: no crypto tools. The Go binary needs no mv.
@test "secrets init: a mv without -T is refused before the first write, and on a rerun only when it writes the .gitignore" {
  ! command -v gmv >/dev/null 2>&1 || skip "gmv is installed: init renames with it"
  ssh-to-age() { echo 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7'; }
  sops() { :; }
  secrets::_mv_has_t() { return 1; }
  printf 'ssh-ed25519 AAAA test\n' > "${BATS_TEST_TMPDIR}/id.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  local cfg="${PATH_BASE}/.sops.yaml" ignore="${PATH_SECRETS}/.gitignore"
  local refusal="[error] this mv has no -T, so the .sops.yaml write cannot rename onto .sops.yaml safely: install GNU coreutils (gmv) or use the lo binary"

  run secrets::init
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "${refusal}" ] || { echo "$output" >&2; return 1; }
  [ ! -e "${cfg}" ] || { echo "init wrote the config" >&2; return 1; }
  [ ! -e "${cfg}.lock" ] || { echo "init made the lock file" >&2; return 1; }
  [ ! -e "${ignore}" ]

  _block > "${ignore}"
  run secrets::init
  [ "$status" -eq 1 ] || { echo "a current .gitignore: status $status: $output" >&2; return 1; }
  [ "$output" = "${refusal}" ] || { echo "a current .gitignore: $output" >&2; return 1; }
  [ ! -e "${cfg}" ] || { echo "a current .gitignore: init wrote the config" >&2; return 1; }
  [ ! -e "${cfg}.lock" ] || { echo "a current .gitignore: init made the lock file" >&2; return 1; }

  # A rerun: the config lists the key.
  printf "creation_rules:\n  - path_regex: 'Secret\\\\..*'\n    age: '%s'\n" "$(ssh-to-age)" > "${cfg}"
  rm -f -- "${ignore}"
  run secrets::init
  [ "$status" -eq 1 ] || { echo "the rerun with no .gitignore: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] this mv has no -T, so the .gitignore write cannot rename onto the .gitignore safely: install GNU coreutils (gmv) or use the lo binary" ] || {
    echo "$output" >&2; return 1; }
  [ ! -e "${ignore}" ] || { echo "the rerun wrote the .gitignore" >&2; return 1; }

  _block > "${ignore}"
  run secrets::init
  [ "$status" -eq 0 ] || { echo "the rerun: status $status: $output" >&2; return 1; }
  [ "$output" = "age key already configured in .sops.yaml" ] || { echo "$output" >&2; return 1; }
  cmp -s "${ignore}" <(_block) || { cat "${ignore}" >&2; return 1; }
}

# _init_config <recipient> prints the .sops.yaml that init writes (Go twin:
# wantInitConfig).
_init_config() {
  builtin printf '%s\n' \
    '# SOPS encryption config for lok8s secret cache files.' \
    '# Recipients are age public keys derived from SSH keys via ssh-to-age.' \
    '# Add team members with: lo secrets add-key <ssh-pubkey-path|age1…>' \
    'creation_rules:' \
    "  - path_regex: 'Secret\\..*'" \
    "    age: '${1}'"
}

# _init_fakes makes ssh-to-age print the age key of the tests and sops do
# nothing (no crypto tools), and points LOK8S_SSH_KEY at a public key file.
_init_fakes() {
  ssh-to-age() { echo 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7'; }
  sops() { :; }
  printf 'ssh-ed25519 AAAA test\n' > "${BATS_TEST_TMPDIR}/id.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
}

# A key that derives no age recipient (ssh-to-age skips a key that is not
# ed25519: it prints a note and exits 0) is refused with the line of the Go
# twin and status 1, and nothing is written: no .sops.yaml and no lock file.
# A rerun (a .sops.yaml is there) refuses the key the same way: grep -qF with
# an empty pattern matches every config, so a rerun took it for a key that
# is configured (Go twin: TestInitRefusesAKeyThatDerivesNoRecipient).
# ssh-to-age and sops are functions: no crypto tools.
@test "secrets init: a key that derives no age recipient is refused, and nothing is written" {
  ssh-to-age() { echo 'skipped key: got ssh-rsa key type, but only ed25519 keys are supported' >&2; }
  sops() { :; }
  printf 'ssh-rsa AAAA test\n' > "${BATS_TEST_TMPDIR}/id_rsa.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id_rsa.pub"
  local before run_kind
  for run_kind in first rerun; do
    if [[ "${run_kind}" == rerun ]]; then
      _init_config 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7' > "${PATH_BASE}/.sops.yaml"
    fi
    before="$(_store_state "${PATH_BASE}")"
    run secrets::init
    [ "$status" -eq 1 ] || { echo "${run_kind}: status $status: $output" >&2; return 1; }
    [ "$output" = "skipped key: got ssh-rsa key type, but only ed25519 keys are supported
[error] no age recipient derived from ${LOK8S_SSH_KEY} (ed25519 SSH keys only) — nothing written to ${PATH_BASE}/.sops.yaml" ] || {
      echo "${run_kind}: $output" >&2; return 1; }
    [ "$(_store_state "${PATH_BASE}")" = "${before}" ] || { echo "${run_kind}: init wrote a file" >&2; return 1; }
  done
}

# The same with the real ssh-to-age and an RSA key of the test. :args is a
# stub here, so the key goes in LOK8S_SSH_KEY (its default names the
# developer's private key).
# bats test_tags=real-sops
@test "secrets init: a real RSA key derives no age recipient, and nothing is written" {
  require_tools
  ssh-keygen -t rsa -b 2048 -N '' -C test -f "${BATS_TEST_TMPDIR}/id_rsa" -q
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id_rsa.pub"
  local before
  before="$(_store_state "${PATH_BASE}")"
  run secrets::init
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output##*$'\n'}" = "[error] no age recipient derived from ${BATS_TEST_TMPDIR}/id_rsa.pub (ed25519 SSH keys only) — nothing written to ${PATH_BASE}/.sops.yaml" ] || {
    echo "$output" >&2; return 1; }
  [ "$(_store_state "${PATH_BASE}")" = "${before}" ] || { echo "init wrote a file" >&2; return 1; }
}

# While another run holds the lock of .sops.yaml, init refuses with the line
# of add-key and remove-key and writes nothing. After the release, init
# writes the config (Go twin: TestInitRefusesWhileTheLockIsHeld).
@test "secrets init: while another run holds the lock, init refuses and writes nothing" {
  command -v flock >/dev/null 2>&1 || skip "flock not installed"
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" fd before
  exec {fd}>"${cfg}.lock"
  flock -n "${fd}"
  before="$(_store_state "${PATH_BASE}")"
  LO_SECRETS_LOCK_WAIT=0 run secrets::init
  exec {fd}>&-
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "[error] ${cfg}.lock is held by another lo secrets init, add-key or remove-key: nothing was changed. When that run ends, run this command again" ] || {
    echo "$output" >&2; return 1; }
  [ "$(_store_state "${PATH_BASE}")" = "${before}" ] || { echo "init wrote a file" >&2; return 1; }

  run secrets::init
  [ "$status" -eq 0 ] || { echo "after the release: status $status: $output" >&2; return 1; }
  cmp -s "${cfg}" <(_init_config 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7') || { cat "${cfg}" >&2; return 1; }
}

# init checks the path without following a link, before the lock and again
# under it (Go twin: TestInitChecksThePathBeforeAndUnderTheLock). A file that
# another run wrote while this run waited keeps its bytes: flock is a
# function here that writes the file, then takes the lock. A link that names
# no file and a directory are refused before the lock: they are not
# replaced, the file that the link names is not made, and no lock file is
# made. Each case prints its refusal with status 1, and no temp file stays.
@test "secrets init: the path is checked before the lock and again under it" {
  command -v flock >/dev/null 2>&1 || skip "flock not installed"
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" other='# written by another run' kind before
  flock() { builtin printf '%s\n' "${other}" > "${cfg}"; command flock "$@"; }
  run secrets::init
  unset -f flock
  [ "$status" -eq 1 ] || { echo "another run: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] another run wrote ${cfg} after this run checked it: this run wrote nothing. Run lo secrets init again" ] || {
    echo "another run: $output" >&2; return 1; }
  [ "$(cat "${cfg}")" = "${other}" ] || { echo "the file of the other run changed: $(cat "${cfg}")" >&2; return 1; }
  [ -z "$(find "${PATH_BASE}" -maxdepth 1 -name '..sops.yaml.tmp-*')" ] || { echo "a temp file stays" >&2; return 1; }

  # The first case took the lock and made the lock file.
  rm -f -- "${cfg}.lock"
  for kind in link directory; do
    rm -f -- "${cfg}"
    if [[ "${kind}" == link ]]; then
      # The directory of the target exists: a write through the link would
      # make the file.
      mkdir -p -- "${PATH_BASE}/elsewhere"
      ln -s -- "${PATH_BASE}/elsewhere/sops.yaml" "${cfg}"
    else
      mkdir -- "${cfg}"
    fi
    before="$(_store_state "${PATH_BASE}")"
    run secrets::init
    [ "$status" -eq 1 ] || { echo "${kind}: status $status: $output" >&2; return 1; }
    [ "$output" = "[error] ${cfg}${_not_regular}nothing was written. Remove it, then run lo secrets init again" ] || {
      echo "${kind}: $output" >&2; return 1; }
    [ ! -e "${cfg}.lock" ] || { echo "${kind}: the refusal made the lock file" >&2; return 1; }
    [ "$(_store_state "${PATH_BASE}")" = "${before}" ] || { echo "${kind}: init changed a file" >&2; return 1; }
    rm -rf -- "${cfg}"
  done
}

# A .sops.yaml write that stops part way leaves no part of a config and no
# temp file, and prints one line that names the file, with status 1.
# printf is a function here: for the config it writes the first half and a
# call marker, then fails, as on a full disk. The next init then runs as a
# first run, not as a rerun: it writes the whole config, mode 0644 (Go twin:
# TestInitLeavesNoPartOfAConfigOnAPartialWrite).
@test "secrets init: a config write that stops part way leaves no config and no temp file" {
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" marker="${BATS_TEST_TMPDIR}/printf.ran"
  printf() {
    [[ "${*}" == *'creation_rules:'* ]] || { builtin printf "${@}"; return; }
    builtin printf '%s' "${2:0:${#2}/2}"
    : >> "${marker}"
    return 1
  }
  run secrets::init
  unset -f printf
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ -e "${marker}" ] || { echo "fixture: the config write did not run" >&2; return 1; }
  [ "$output" = "[error] cannot write ${cfg}: no config was written" ] || { echo "$output" >&2; return 1; }
  [[ ! -e "${cfg}" && ! -L "${cfg}" ]] || { echo "an entry is at the path: $(cat "${cfg}")" >&2; return 1; }
  [ -z "$(find "${PATH_BASE}" -maxdepth 1 -name '..sops.yaml.tmp-*')" ] || { echo "a temp file stays" >&2; return 1; }

  run secrets::init
  [ "$status" -eq 0 ] || { echo "the next init: status $status: $output" >&2; return 1; }
  [ "${output%%$'\n'*}" = "Created ${cfg}" ] || { echo "the next init: $output" >&2; return 1; }
  cmp -s "${cfg}" <(_init_config 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7') || { cat "${cfg}" >&2; return 1; }
  [ "$(stat -c %a -- "${cfg}")" = 644 ] || { echo "mode $(stat -c %a -- "${cfg}")" >&2; return 1; }
  [ -z "$(find "${PATH_BASE}" -maxdepth 1 -name '..sops.yaml.tmp-*')" ] || { echo "the next init left a temp file" >&2; return 1; }
}

# A temp file that a stopped run left (..sops.yaml.tmp-*) is not the config:
# init writes .sops.yaml as a first run does, and the temp file keeps its
# bytes (Go twin: TestInitDoesNotTakeALeftTempFileForTheConfig).
@test "secrets init: a temp file that a stopped run left is not the config" {
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" left="${PATH_BASE}/..sops.yaml.tmp-AbC123"
  local part="# SOPS encryption config for lok8s secret cache files.
creation_rules:
  - path_regex: 'Sec"
  builtin printf '%s' "${part}" > "${left}"
  run secrets::init
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output%%$'\n'*}" = "Created ${cfg}" ] || { echo "$output" >&2; return 1; }
  cmp -s "${cfg}" <(_init_config 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7') || { cat "${cfg}" >&2; return 1; }
  [ "$(cat "${left}")" = "${part}" ] || { echo "the left temp file changed" >&2; return 1; }
}

# A config write that fails and whose temp file cannot be removed names the
# temp file, then the file that it did not write (Go twin:
# TestInitNamesATempFileThatItCannotRemove). chmod and rm fail for a temp
# file only, so the teardown removes the rest.
@test "secrets init: a temp file that a failed config write cannot remove is named" {
  _init_fakes
  # A current .gitignore: init does not write it, so the functions below
  # touch the temp file of the config only.
  _block > "${PATH_SECRETS}/.gitignore"
  rm() { case "${*: -1}" in *.tmp-*) echo "rm: cannot remove '${*: -1}'" >&2; return 1 ;; esac; command rm "$@"; }
  chmod() { case "${*: -1}" in *.tmp-*) return 1 ;; esac; command chmod "$@"; }
  run secrets::init
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  grep -qxE '\[error\] cannot remove the temp file \.\.sops\.yaml\.tmp-[[:alnum:]]{6}: remove it by hand' <<< "${output}" || { echo "$output" >&2; return 1; }
  [ "${output##*$'\n'}" = "[error] cannot write ${PATH_BASE}/.sops.yaml: no config was written" ] || { echo "$output" >&2; return 1; }
  [[ "${output}" != *'rm: '* ]] || { echo "the message of rm is printed: $output" >&2; return 1; }
  [ ! -e "${PATH_BASE}/.sops.yaml" ] || { echo "init wrote the config" >&2; return 1; }
}

# init makes the store and its .gitignore before .sops.yaml (Go twin:
# TestInitLeavesNoConfigWhenAStoreStepFails). A store step that fails leaves
# no .sops.yaml and no temp file, so the next init runs as a first run and
# writes the config. printf is a function here that fails for the block of
# the .gitignore; mkdir is one that fails for the store of the domain.
@test "secrets init: a store step that fails leaves no config" {
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" want_cfg
  want_cfg="$(_init_config 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7')"
  printf() { [[ "${*}" != *'!Secret.*.enc'* ]] || return 1; builtin printf "${@}"; }
  run secrets::init
  unset -f printf
  [ "$status" -eq 1 ] || { echo "the .gitignore: status $status: $output" >&2; return 1; }
  [ "$output" = "[error] cannot write .secrets/.gitignore: it was not changed" ] || { echo "the .gitignore: $output" >&2; return 1; }
  [[ ! -e "${cfg}" && ! -L "${cfg}" ]] || { echo "the .gitignore: init wrote .sops.yaml" >&2; return 1; }
  [ -z "$(find "${PATH_BASE}" -maxdepth 1 -name '..sops.yaml.tmp-*')" ] || { echo "a temp file stays" >&2; return 1; }
  run secrets::init
  [ "$status" -eq 0 ] || { echo "the next init: status $status: $output" >&2; return 1; }
  [ "$(cat "${cfg}")" = "${want_cfg}" ] || { cat "${cfg}" >&2; return 1; }

  rm -f -- "${cfg}"
  export PATH_CLUSTERS="${BATS_TEST_TMPDIR}/clusters"
  command mkdir -p -- "${PATH_CLUSTERS}/alpha.dev"
  domain=alpha.dev
  mkdir() {
    [[ "${*: -1}" != */alpha.dev/secrets ]] || { echo "mkdir: cannot create directory '${*: -1}': Permission denied" >&2; return 1; }
    command mkdir "$@"
  }
  run secrets::init
  unset -f mkdir
  [ "$status" -eq 1 ] || { echo "the store: status $status: $output" >&2; return 1; }
  [[ "$output" != *Created* ]] || { echo "the store: $output" >&2; return 1; }
  [[ ! -e "${cfg}" && ! -L "${cfg}" ]] || { echo "the store: init wrote .sops.yaml" >&2; return 1; }
  run secrets::init
  [ "$status" -eq 0 ] || { echo "the next init with the store: status $status: $output" >&2; return 1; }
  [ "$(cat "${cfg}")" = "${want_cfg}" ] || { cat "${cfg}" >&2; return 1; }
  cmp -s "${PATH_CLUSTERS}/alpha.dev/secrets/.gitignore" <(_block) || { echo "the store has no .gitignore" >&2; return 1; }
}

# init holds the lock of .sops.yaml during the write of the temp file and
# after the rename (Go twin: TestInitHoldsTheLockAcrossTheRename). printf is
# a function here that tests the lock before it writes the config, and the
# rename is wrapped: after each rename (the .gitignore, then the config), a
# flock -n on the lock file must fail. After the run, the lock is free.
@test "secrets init: holds the lock across the rename" {
  command -v flock >/dev/null 2>&1 || skip "flock not installed"
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" marker="${BATS_TEST_TMPDIR}/lock.probe"
  _probe() {
    if command flock -n "${cfg}.lock" true; then echo "${1}: free"; else echo "${1}: held"; fi >> "${marker}"
  }
  printf() {
    [[ "${*}" != *'creation_rules:'* ]] || _probe write
    builtin printf "${@}"
  }
  eval "_real_rename_onto() $(declare -f secrets::_rename_onto | tail -n +2)"
  secrets::_rename_onto() { _real_rename_onto "$@" || return; _probe "rename ${3##*/}"; }
  run secrets::init
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$(cat "${marker}")" = "rename .gitignore: held
write: held
rename .sops.yaml: held" ] || { cat "${marker}" >&2; return 1; }
  command flock -n "${cfg}.lock" true || { echo "the lock is held after the run" >&2; return 1; }
}

# The mode of .sops.yaml is 644 under each umask: the temp file gets the mode
# with a chmod, which the umask does not change (Go twin:
# TestInitConfigModeIsTheSameUnderEachUmask).
@test "secrets init: the config mode is 644 under each umask" {
  _init_fakes
  local cfg="${PATH_BASE}/.sops.yaml" mask
  for mask in 077 000; do
    rm -f -- "${cfg}"
    umask "${mask}"
    run secrets::init
    umask 022
    [ "$status" -eq 0 ] || { echo "umask ${mask}: status $status: $output" >&2; return 1; }
    [ "$(stat -c %a -- "${cfg}")" = 644 ] || { echo "umask ${mask}: mode $(stat -c %a -- "${cfg}")" >&2; return 1; }
  done
}

# A write that fails and whose temp file cannot be removed names the temp
# file with the same line in the three writes through a temp file: the
# .gitignore, the .sops.yaml and an .enc (Go twin:
# TestWriteReplacingReportsATempFileItCannotRemove). The functions below
# fail for a temp file only, so the teardown removes the rest.
@test "secrets: a temp file that a failed write cannot remove is named, with the same line in each write" {
  rm() { case "${*: -1}" in *.tmp-*) echo "rm: cannot remove '${*: -1}'" >&2; return 1 ;; esac; command rm "$@"; }
  chmod() { case "${*: -1}" in *.tmp-*) return 1 ;; esac; command chmod "$@"; }
  cp() { case "${*: -1}" in *.tmp-*) return 1 ;; esac; command cp "$@"; }
  sops() { return 1; }
  local re='\[error\] cannot remove the temp file '

  run secrets::_ensure_gitignore "${PATH_SECRETS}" "the plaintext write"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  grep -qxE "${re}\.secrets/\.\.gitignore\.tmp-[[:alnum:]]{6}: remove it by hand" <<< "${output}" || { echo "$output" >&2; return 1; }
  [ "${output##*$'\n'}" = "[error] cannot write .secrets/.gitignore: it was not changed" ] || { echo "$output" >&2; return 1; }
  [[ "${output}" != *'rm: '* ]] || { echo "the message of rm is printed: $output" >&2; return 1; }

  # The plaintext writes of set and decrypt print the same line. mv fails
  # for a temp file, so the rename of set fails.
  _block > "${PATH_SECRETS}/.gitignore"
  mv() { [[ "${*}" != *.tmp-* ]] || return 1; command mv "$@"; }
  :args() { name=app key=P value=the-value; }
  secrets::_live_drift() { :; }
  run secrets::set
  unset -f mv
  [ "$status" -eq 1 ] || { echo "set: status $status: $output" >&2; return 1; }
  local want="^${re}\.secrets/\.Secret\.app\.default\.P\.tmp-[[:alnum:]]{6}: remove it by hand"$'\n'"\[error\] set cannot write \.secrets/Secret\.app\.default\.P: it was not changed$"
  [[ "${output}" =~ ${want} ]] || { echo "set: $output" >&2; return 1; }
  [ ! -e "${PATH_SECRETS}/Secret.app.default.P" ] || { echo "set wrote the plaintext" >&2; return 1; }
  printf 'x' > "${PATH_SECRETS}/Secret.app.default.D.enc"
  SOPS_AGE_KEY=stub-identity run secrets::decrypt < /dev/null
  [ "$status" -eq 1 ] || { echo "decrypt: status $status: $output" >&2; return 1; }
  want="^${re}\.secrets/\.Secret\.app\.default\.D\.tmp-[[:alnum:]]{6}: remove it by hand"$'\n'"\[error\] Failed to decrypt Secret\.app\.default\.D\.enc$"
  [[ "${output}" =~ ${want} ]] || { echo "decrypt: $output" >&2; return 1; }

  printf 'creation_rules: []\n' > "${PATH_BASE}/.sops.yaml"
  run secrets::_replace "${PATH_BASE}/.sops.yaml" 'new'
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  grep -qxE "${re}\.sops\.yaml\.tmp-[[:alnum:]]{6}: remove it by hand" <<< "${output}" || { echo "$output" >&2; return 1; }
  [ "$(cat "${PATH_BASE}/.sops.yaml")" = 'creation_rules: []' ]

  printf 'v' > "${PATH_SECRETS}/Secret.app.default.K"
  run secrets::_encrypt_file "${PATH_SECRETS}/Secret.app.default.K"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  grep -qxE "${re}\.secrets/\.Secret\.app\.default\.K\.enc\.tmp-[[:alnum:]]{6}: remove it by hand" <<< "${output}" || { echo "$output" >&2; return 1; }
  [ "${output##*$'\n'}" = "[error] Failed to encrypt Secret.app.default.K" ] || { echo "$output" >&2; return 1; }
}

# An .enc that is older than its plaintext, with a plaintext that is not
# after now, is no time in the future: the clock that stamps a write can be
# behind the time of the system, so an .enc written after its plaintext can
# get the older time. The encrypt prints no warning (Go twin:
# TestNudgeNewerWarnsOnlyForATimeAfterNow). The sops function dates the .enc
# one second before the plaintext, and the plaintext is one minute old: the
# test sets each time, so the result does not depend on the clock.
@test "secrets encrypt: an .enc older than a plaintext that is not after now gets no warning" {
  sops() {
    [ "${8}" = --output ] || return 1
    printf 'enc' > "${9}" && touch -r "${10}" -d '-1 second' -- "${9}"
  }
  printf 'creation_rules: []\n' > "${PATH_BASE}/.sops.yaml"
  local plain="${PATH_SECRETS}/Secret.app.default.K"
  printf 'v' > "${plain}"
  touch -d '-1 minute' -- "${plain}"
  run secrets::_encrypt_file "${plain}"
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [[ "${output}" != *'[warn]'* ]] || { echo "$output" >&2; return 1; }
  [ "$(cat "${plain}.enc")" = enc ]
  [[ "${plain}" -nt "${plain}.enc" ]] || { echo "fixture: the .enc is not the older file" >&2; return 1; }
  [ -z "$(find "${PATH_SECRETS}" -name '.*.now-*')" ] || { echo "a temp file of the time check stayed" >&2; return 1; }
}

# A plaintext dated after now gets the warning, and the encrypt ends with
# status 0 (Go twin: TestNudgeNewerWarnsOnlyForATimeAfterNow).
@test "secrets encrypt: a plaintext dated after now gets the future-time warning" {
  sops() {
    [ "${8}" = --output ] || return 1
    printf 'enc' > "${9}"
  }
  printf 'creation_rules: []\n' > "${PATH_BASE}/.sops.yaml"
  local plain="${PATH_SECRETS}/Secret.app.default.K" line
  line="[warn] .secrets/Secret.app.default.K has a time in the future: its .enc keeps the time of the encrypt, and each encrypt writes it again. Set the time of the plaintext to now (touch it)"
  printf 'v' > "${plain}"
  touch -d '+1 hour' -- "${plain}"
  run secrets::_encrypt_file "${plain}"
  [ "$status" -eq 0 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output}" = "${line}" ] || { echo "$output" >&2; return 1; }
  [ -z "$(find "${PATH_SECRETS}" -name '.*.now-*')" ] || { echo "a temp file of the time check stayed" >&2; return 1; }
}

# Without a .sops.yaml the encrypt of one file and the sweep of a store
# refuse with one line, before sops runs, and write no .enc (Go twins:
# TestSetEncryptWithoutSopsYAMLFails, TestEncryptSweepWithoutSopsYAMLFails).
@test "secrets encrypt: without a .sops.yaml the encrypt of a file and the sweep refuse with one line" {
  sops() { echo "sops ran" >&2; return 1; }
  local plain="${PATH_SECRETS}/Secret.app.default.K" line='[error] No .sops.yaml found. Run: lo secrets init'
  printf 'v' > "${plain}"
  run secrets::_encrypt_file "${plain}"
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output}" = "${line}" ] || { echo "$output" >&2; return 1; }
  run secrets::_encrypt_store "${PATH_SECRETS}" "" find
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "${output}" = "${line}" ] || { echo "$output" >&2; return 1; }
  [ ! -e "${plain}.enc" ] || { echo "an .enc was written" >&2; return 1; }
}

# The sweep prints its summary to stdout only and an error to stderr only.
# The Go twin TestEncryptSweepWithoutSopsYAMLFails checks the error half: the
# error line on stderr and nothing on stdout.
@test "secrets encrypt: the summary goes to stdout and the error goes to stderr" {
  sops() {
    [ "${8}" = --output ] || return 1
    printf 'enc' > "${9}"
  }
  local plain="${PATH_SECRETS}/Secret.app.default.K"
  printf 'v' > "${plain}"
  run --separate-stderr secrets::_encrypt_store "${PATH_SECRETS}" "" find
  [ "$status" -eq 1 ] || { echo "status $status: $output / $stderr" >&2; return 1; }
  [ -z "${output}" ] || { echo "stdout: $output" >&2; return 1; }
  [ "${stderr}" = '[error] No .sops.yaml found. Run: lo secrets init' ] || { echo "stderr: $stderr" >&2; return 1; }
  printf 'creation_rules: []\n' > "${PATH_BASE}/.sops.yaml"
  run --separate-stderr secrets::_encrypt_store "${PATH_SECRETS}" "" find
  [ "$status" -eq 0 ] || { echo "status $status: $output / $stderr" >&2; return 1; }
  [ "${output}" = 'Encrypted 1 secret(s)' ] || { echo "stdout: $output" >&2; return 1; }
  [ -z "${stderr}" ] || { echo "stderr: $stderr" >&2; return 1; }
  [ "$(cat "${plain}.enc")" = enc ]
}

# init checks the .gitignore of the store before its first write, and a
# rerun with a config checks it too. Its status is the refusal's: 1, no
# .sops.yaml, and the file that the link names keeps its bytes (Go twin:
# TestInitRefusesABadGitignoreBeforeAnyWrite). ssh-to-age and sops are
# functions: no crypto tools.
@test "secrets init: a .gitignore that is a symlink is refused before the config is written, also on a rerun" {
  ssh-to-age() { echo 'age1zvkyg2lc7kjhpnjwqpjkwzr9qkxnwqp5xzdmqvxqjhqx0nqwqjqs3xqzq7'; }
  sops() { :; }
  printf 'ssh-ed25519 AAAA test\n' > "${BATS_TEST_TMPDIR}/id.pub"
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  local outside="${BATS_TEST_TMPDIR}/elsewhere/gitignore" line
  mkdir -p "${outside%/*}"
  printf '# not the rules of lok8s\n' > "${outside}"
  ln -s "${outside}" "${PATH_SECRETS}/.gitignore"
  line="[error] .secrets/.gitignore is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: lo stopped before its first write. Remove it, then run this command again"
  run secrets::init
  [ "$status" -eq 1 ] || { echo "status $status: $output" >&2; return 1; }
  [ "$output" = "${line}" ] || { echo "$output" >&2; return 1; }
  [ ! -e "${PATH_BASE}/.sops.yaml" ] || { echo "init wrote the config" >&2; return 1; }
  [ "$(cat "${outside}")" = '# not the rules of lok8s' ]

  printf "creation_rules:\n  - path_regex: 'Secret\\\\..*'\n    age: '%s'\n" "$(ssh-to-age)" > "${PATH_BASE}/.sops.yaml"
  run secrets::init
  [ "$status" -eq 1 ] || { echo "the rerun: status $status: $output" >&2; return 1; }
  [ "$output" = "${line}" ] || { echo "$output" >&2; return 1; }
  [ "$(cat "${outside}")" = '# not the rules of lok8s' ]
}

@test "secrets encrypt: a .gitignore that is a symlink is refused, and the file it names is not written" {
  _gitignore_refused link
}

@test "secrets encrypt: a .gitignore that is a directory is refused" {
  _gitignore_refused dir
}

# --- flat-store shadow / drift detection (no crypto tools needed) -------------
# secrets::check_flat_shadows compares a domain's per-domain store against the
# flat store, resolved as ${PATH_SECRETS:-${PATH_BASE}/.secrets} (PATH_SECRETS
# overrides the default ${PATH_BASE}/.secrets); these tests set PATH_SECRETS to it.

_shadow_setup() {
  DOM_DIR="${BATS_TEST_TMPDIR}/clusters/app.example.com"
  mkdir -p "${DOM_DIR}/secrets" "${PATH_SECRETS}"
}

@test "check_flat_shadows: clean when no flat duplicate exists" {
  _shadow_setup
  printf 'v' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  # A global-only flat secret (no per-domain counterpart) must NOT be flagged.
  printf 'global' > "${PATH_SECRETS}/Secret.registries-tls.lok8s-system.tls.crt"
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_success
  assert_output ''
}

@test "check_flat_shadows: flags an identical flat duplicate as a deprecated shadow" {
  _shadow_setup
  printf 'same' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  printf 'same' > "${PATH_SECRETS}/Secret.app.default.TOKEN"
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_failure
  assert_output --partial 'Flat-store shadow'
  assert_output --partial 'Secret.app.default.TOKEN'
}

@test "check_flat_shadows: flags a divergent flat duplicate as DRIFT" {
  _shadow_setup
  printf 'per-domain-value' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  printf 'STALE-flat-value' > "${PATH_SECRETS}/Secret.app.default.TOKEN"
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_failure
  assert_output --partial 'Flat-store DRIFT'
  assert_output --partial 'Secret.app.default.TOKEN'
}

@test "check_flat_shadows: ignores .enc/.sha siblings in the per-domain store" {
  _shadow_setup
  printf 'v'   > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  printf 'enc' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN.enc"
  printf 'sha' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN.sha"
  # Flat duplicates of ONLY the .enc/.sha (not the plaintext) are not shadows.
  printf 'enc' > "${PATH_SECRETS}/Secret.app.default.TOKEN.enc"
  printf 'sha' > "${PATH_SECRETS}/Secret.app.default.TOKEN.sha"
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_success
  assert_output ''
}

@test "check_flat_shadows: emits exactly one line per shadow" {
  _shadow_setup
  printf 'a' > "${DOM_DIR}/secrets/Secret.app.default.ONE"
  printf 'a' > "${PATH_SECRETS}/Secret.app.default.ONE"   # identical -> shadow
  printf 'b' > "${DOM_DIR}/secrets/Secret.app.default.TWO"
  printf 'X' > "${PATH_SECRETS}/Secret.app.default.TWO"   # differing -> DRIFT
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_failure
  [ "${#lines[@]}" -eq 2 ]                                # one line per shadow, no dupes/drops
  assert_output --partial 'Flat-store shadow: Secret.app.default.ONE'
  assert_output --partial 'Flat-store DRIFT: Secret.app.default.TWO'
}

@test "check_flat_shadows: honors a custom PATH_SECRETS flat-store location" {
  # Regression for the PR's own case: a manual PATH_SECRETS pointing at a
  # NON-default flat store must still be the store this check compares against.
  # (It previously hard-coded ${PATH_BASE}/.secrets and would have missed this.)
  DOM_DIR="${BATS_TEST_TMPDIR}/clusters/app.example.com"
  mkdir -p "${DOM_DIR}/secrets"
  export PATH_SECRETS="${BATS_TEST_TMPDIR}/custom-flat"
  mkdir -p "${PATH_SECRETS}"
  printf 'same' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  printf 'same' > "${PATH_SECRETS}/Secret.app.default.TOKEN"
  run secrets::check_flat_shadows "${DOM_DIR}"
  assert_failure
  assert_output --partial 'Flat-store shadow: Secret.app.default.TOKEN'
}

@test "check_flat_shadows: under set -u, bails when neither PATH_SECRETS nor PATH_BASE is set" {
  # Both unset must short-circuit BEFORE flat resolves to a bogus "/.secrets".
  # Run under `set -u` (as lo does) so this PROVES the guard: without it the bare
  # ${PATH_BASE} in the flat default would be an unbound-variable abort (non-zero).
  DOM_DIR="${BATS_TEST_TMPDIR}/clusters/app.example.com"
  mkdir -p "${DOM_DIR}/secrets"
  printf 'v' > "${DOM_DIR}/secrets/Secret.app.default.TOKEN"
  unset PATH_SECRETS PATH_BASE
  _under_u() ( set -u; secrets::check_flat_shadows "$@" )
  run _under_u "${DOM_DIR}"
  assert_success
  assert_output ''
}

# ── secrets set — value from stdin ───────────────────────────────────────
# These run the lib STANDALONE through the real argsh runtime (the stubbed
# :args in setup() can't parse positionals), so the value positional's
# :~stdin type is actually exercised. ARGSH_BUILTIN_PATH pins the repo's
# argsh.so so the runtime doesn't try to download one into the tmpdir.
# The inner bash unsets the exported :usage/:args/import STUBS from setup()
# (export -f) — the standalone run must use the real argsh implementations.

secrets_cli() {
  ARGSH_BUILTIN_PATH="${ARGSH_BUILTIN_PATH:-${_PROJECT_ROOT}/.bin/argsh.so}" \
  PATH_SCRIPTS="${_PROJECT_ROOT}/.lok8s" \
    bash -c 'unset -f :usage :args import 2>/dev/null; exec "${@}"' -- \
    "${_PROJECT_ROOT}/.bin/argsh" "${_PROJECT_ROOT}/.lok8s/libs/secrets" "${@}"
}
secrets_cli_piped() { printf %s "${1}" | secrets_cli "${@:2}"; }

# Skip when the b-managed argsh toolchain isn't installed (fresh clone before
# `b install`) — without the pinned .so argsh would try to DOWNLOAD one into
# the cwd, passing online and failing obscurely offline.
require_argsh_cli() {
  [ -x "${_PROJECT_ROOT}/.bin/argsh" ] || skip "argsh not installed (b install)"
  [ -f "${_PROJECT_ROOT}/.bin/argsh.so" ] || skip "argsh.so not installed (b install)"
}

@test "secrets set: literal value lands in the cache" {
  require_argsh_cli
  run secrets_cli set -n app KEY literal-v
  assert_success
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "literal-v" ]
}

@test "secrets set: omitted value reads piped stdin" {
  require_argsh_cli
  run secrets_cli_piped piped-v set -n app KEY
  assert_success
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "piped-v" ]
}

@test "secrets set: explicit - reads piped stdin (argsh with arg-sh/argsh#176)" {
  require_argsh_cli
  # Older argsh parsers reject a bare `-` before the :~stdin type can consume
  # it (the exact error wording varies by version) — probe by OUTCOME: only
  # run when the parser demonstrably stored the piped value via `-`.
  secrets_cli_piped probe set -n probe P - >/dev/null 2>&1 || true
  if [ "$(cat "${PATH_SECRETS}/Secret.probe.default.P" 2>/dev/null)" != "probe" ]; then
    skip "argsh parser predates bare-dash positional support (arg-sh/argsh#176)"
  fi
  run secrets_cli_piped dash-v set -n app KEY -
  assert_success
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "dash-v" ]
}

# ── secrets set --encrypt ────────────────────────────────────────────────
# `--encrypt` (short -e; alias --enc) encrypts ONLY the just-written file via
# secrets::_encrypt_file (never a whole-store sweep). Gate: ${PATH_BASE}/.sops.yaml
# must exist — its presence == "encryption is configured". These run through the
# real argsh runtime (secrets_cli) so the flag spec is actually parsed.
#
# secrets::_encrypt_file pins `sops --config ${PATH_BASE}/.sops.yaml`, so the
# config it uses is exactly the one the gate checked — it does NOT walk up and
# pick a different .sops.yaml (e.g. the repo's own /workspace/.sops.yaml under
# Docker). That is what lets the round-trip test below decrypt with the tmpdir
# key: the .enc really is encrypted to the recipient we configured.

# The alias/parse tests need NO crypto tools: with .sops.yaml absent the gate
# fails fast, so all three spellings must produce the SAME "No .sops.yaml" error
# AND still have written the plaintext cache (proving the KEY/value positionals
# parsed with the flag consumed — an unknown flag would instead shift them).
@test "secrets set --encrypt: without .sops.yaml → error, non-zero (no .enc)" {
  require_argsh_cli
  run secrets_cli set -n app --encrypt KEY val
  assert_failure
  assert_output --partial 'No .sops.yaml'
  # cache still written (plaintext), but no .enc produced
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "val" ]
  [ ! -f "${PATH_SECRETS}/Secret.app.default.KEY.enc" ]
}

@test "secrets set --enc/-e: parse the same as --encrypt" {
  require_argsh_cli
  # No .sops.yaml → each spelling fails identically at the encrypt gate; the
  # plaintext cache lands under the right (name,ns,key), proving the token was
  # recognized as the boolean flag (not swallowed as a positional).
  for flag in --encrypt --enc -e; do
    rm -f "${PATH_SECRETS}"/Secret.app.default.*
    run secrets_cli set -n app "${flag}" KEY val
    assert_failure
    assert_output --partial 'No .sops.yaml'
    [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "val" ]
  done
}

# bats test_tags=real-sops
@test "secrets set --encrypt: encrypts exactly that file, others untouched" {
  require_argsh_cli
  require_tools
  # Configure encryption (gate = ${PATH_BASE}/.sops.yaml present) with a tmpdir key.
  # Use the real-world rule shape (Secret\..* — same as `secrets::init` writes),
  # not a catch-all .*, so the test exercises the recipient scoping sops actually
  # applies (path_regex is matched against the cache filename argument).
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  printf 'creation_rules:\n  - path_regex: Secret\\..*\n    age: %s\n' \
    "$(ssh-to-age < "${BATS_TEST_TMPDIR}/id.pub")" > "${PATH_BASE}/.sops.yaml"

  # A pre-existing sibling plaintext with NO .enc — must stay plaintext-only.
  printf 'sib' > "${PATH_SECRETS}/Secret.other.default.SIB"

  run secrets_cli set -n app --encrypt KEY 'round-trip-me'
  assert_success
  assert_output --partial 'Set + encrypted app/default/KEY'
  # exactly this file encrypted …
  [ -f "${PATH_SECRETS}/Secret.app.default.KEY.enc" ]
  # … and the sibling was NOT swept up
  [ ! -f "${PATH_SECRETS}/Secret.other.default.SIB.enc" ]
  # … and it decrypts with OUR tmpdir key — proving --config pinned the config
  # we set (not a shadowing .sops.yaml higher up, e.g. the repo's own one).
  local got
  got="$(SOPS_AGE_KEY="$(ssh-to-age -private-key < "${BATS_TEST_TMPDIR}/id")" \
    sops --config "${PATH_BASE}/.sops.yaml" decrypt \
      --input-type binary --output-type binary \
      "${PATH_SECRETS}/Secret.app.default.KEY.enc")"
  [ "${got}" = 'round-trip-me' ]
}

# ── secrets set — missing/stale-.enc warning (plaintext write, encryption on) ──
# When .sops.yaml exists but --encrypt is NOT passed, the plaintext write has no
# matching .enc (either none yet, or the committed one is now stale) — warn
# (always-on; no quiet level to gate on). Silent when .sops.yaml is absent. This
# path is crypto-free (never invokes sops), so it runs without require_tools.
@test "secrets set: warns about a missing/stale .enc when .sops.yaml exists but --encrypt omitted" {
  require_argsh_cli
  : > "${PATH_BASE}/.sops.yaml"   # presence is all the gate checks
  run secrets_cli set -n app KEY val
  assert_success
  assert_output --partial 'wrote plaintext cache only'
  assert_output --partial "run 'lo secrets encrypt' or re-run with --encrypt/-e"
  [ "$(cat "${PATH_SECRETS}/Secret.app.default.KEY")" = "val" ]
  [ ! -f "${PATH_SECRETS}/Secret.app.default.KEY.enc" ]   # plaintext only
}

@test "secrets set: NO stale-.enc warning when .sops.yaml is absent" {
  require_argsh_cli
  # No .sops.yaml under PATH_BASE → encryption not configured → stay quiet.
  run secrets_cli set -n app KEY val
  assert_success
  refute_output --partial 'wrote plaintext cache only'
  assert_output --partial 'Set app/default/KEY'
}

# ── secrets set — live-cluster drift warning ─────────────────────────────
# `set` writes the STORE; the running workload keeps its old value until
# `lo build` + apply. The gap is by design, the silence was the bug (the
# 2026-06-15 drift trap). These pin the warning AND its silences — an
# advisory that fires when it should not is as bad as one that never fires.
#
# kubectl is a PATH shim so no cluster is needed. It is exported onto PATH
# ahead of any real kubectl, and the standalone `secrets_cli` run inherits it.

# stub_kubectl <live-base64-or-empty> [current-context]
# Records its argv to ${STUB_LOG} so the jsonpath can be asserted.
stub_kubectl() {
  local live="${1}" ctx="${2:-kind-test}"
  export STUB_BIN="${BATS_TEST_TMPDIR}/stubbin"
  export STUB_LOG="${BATS_TEST_TMPDIR}/kubectl.log"
  mkdir -p "${STUB_BIN}"
  cat > "${STUB_BIN}/kubectl" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\${*}" >> "${STUB_LOG}"
if [[ "\${1}" == "config" ]]; then printf '%s' '${ctx}'; exit 0; fi
printf '%s' '${live}'
EOF
  chmod +x "${STUB_BIN}/kubectl"
  export PATH="${STUB_BIN}:${PATH}"
}

@test "live drift: warns when the live Secret holds a different value" {
  stub_kubectl "$(printf 'old-v' | base64 | tr -d '\n')"
  run secrets::_live_drift app default KEY new-v
  assert_success
  assert_output --partial 'still holds the PREVIOUS value'
  assert_output --partial "kind-test"
}

@test "live drift: SILENT when the live Secret already matches" {
  stub_kubectl "$(printf 'same-v' | base64 | tr -d '\n')"
  run secrets::_live_drift app default KEY same-v
  assert_success
  refute_output --partial 'PREVIOUS value'
}

@test "live drift: silent when the Secret/key is absent live (not yet deployed)" {
  stub_kubectl ""
  run secrets::_live_drift app default KEY any-v
  assert_success
  refute_output --partial 'PREVIOUS value'
}

@test "live drift: silent when kubectl is not installed" {
  # Empty PATH inside a SUBSHELL (the _under_u idiom above): exporting it in
  # the test body strands teardown without `rm`, failing a test whose own
  # assertions passed.
  mkdir -p "${BATS_TEST_TMPDIR}/emptybin"
  _no_kubectl() ( export PATH="${BATS_TEST_TMPDIR}/emptybin"; secrets::_live_drift "${@}" )
  run _no_kubectl app default KEY any-v
  assert_success
  assert_output ''
}

@test "live drift: a dotted key uses the bracket jsonpath, not a nested path" {
  # `{.data.tls.crt}` resolves to nothing, which would read as "no drift" and
  # silently disarm the check for every dotted key (tls.crt, ca.crt, .dockercfg).
  stub_kubectl "$(printf 'old' | base64 | tr -d '\n')"
  run secrets::_live_drift app default tls.crt new
  assert_success
  assert_output --partial 'still holds the PREVIOUS value'
  grep -qF "jsonpath={.data['tls\\.crt']}" "${STUB_LOG}"
}

@test "live drift: a live value differing ONLY by a trailing newline is caught" {
  # The store side can never carry a trailing newline (both the `$(cat)` stdin
  # path and argsh positionals strip it), so a live `v\n` against a stored `v`
  # is a real difference: rendering the store and applying it WOULD rewrite the
  # Secret. Decoding the live side through a command substitution would strip
  # that newline, compare v==v and report "no drift" — a false negative, which
  # is the original silent trap with a green tick on it. base64-to-base64 sees
  # it. This test fails if anyone "simplifies" the comparison to a decode.
  stub_kubectl "$(printf 'v\n' | base64 | tr -d '\n')"
  run secrets::_live_drift app default KEY v
  assert_success
  assert_output --partial 'still holds the PREVIOUS value'
}

@test "secrets set: is WIRED to the drift check (warns through the real CLI)" {
  require_argsh_cli
  stub_kubectl "$(printf 'old-v' | base64 | tr -d '\n')"
  run secrets_cli set -n app KEY new-v
  assert_success
  assert_output --partial 'still holds the PREVIOUS value'
  assert_output --partial 'Set app/default/KEY'
}

# ── secrets encrypt --name ────────────────────────────────────────────────
# Without a filter this walks the WHOLE store and encrypts every plaintext
# whose .enc is older — including entries the operator was mid-edit on. That is
# the deliberate "stage everything" move, and the wrong default for "I changed
# one secret". Committing an .enc for a value nobody meant to publish is not
# something the store can walk back.
#
# Driven through secrets_cli (the REAL argsh runtime): setup() stubs :args, so a
# flag tested here would never be parsed and the assertions would pass on
# behaviour that does not exist.

_two_secrets() {
  require_tools
  require_argsh_cli
  ssh-keygen -t ed25519 -N '' -C test -f "${BATS_TEST_TMPDIR}/id" -q
  export LOK8S_SSH_KEY="${BATS_TEST_TMPDIR}/id.pub"
  secrets_cli init --ssh-key "${BATS_TEST_TMPDIR}/id.pub" >/dev/null
  printf 'alpha-val' > "${PATH_SECRETS}/Secret.alpha.default.TOKEN"
  printf 'beta-val'  > "${PATH_SECRETS}/Secret.beta.default.TOKEN"
}

# bats test_tags=real-sops
@test "secrets encrypt --name: encrypts ONLY that Secret, leaves the rest alone" {
  _two_secrets
  run secrets_cli encrypt --name alpha
  assert_success
  [ -f "${PATH_SECRETS}/Secret.alpha.default.TOKEN.enc" ]
  # The whole point: beta was not staged.
  [ ! -f "${PATH_SECRETS}/Secret.beta.default.TOKEN.enc" ]
}

# bats test_tags=real-sops
@test "secrets encrypt without --name still sweeps the whole store" {
  _two_secrets
  run secrets_cli encrypt
  assert_success
  [ -f "${PATH_SECRETS}/Secret.alpha.default.TOKEN.enc" ]
  [ -f "${PATH_SECRETS}/Secret.beta.default.TOKEN.enc" ]
}

# bats test_tags=real-sops
@test "secrets encrypt --name: a name that matches NOTHING fails loudly" {
  # A typo must not print a reassuring line and exit 0, leaving the operator to
  # commit whatever stale .enc is already on disk.
  _two_secrets
  run secrets_cli encrypt --name alphaa
  assert_failure
  assert_output --partial "no cache files for Secret 'alphaa'"
  # …and it must not have quietly encrypted something else instead.
  [ ! -f "${PATH_SECRETS}/Secret.alpha.default.TOKEN.enc" ]
}

# bats test_tags=real-sops
@test "secrets encrypt --name: rejects a name that could escape the store" {
  _two_secrets
  run secrets_cli encrypt --name "../../etc"
  assert_failure
  assert_output --partial "invalid --name"
}
