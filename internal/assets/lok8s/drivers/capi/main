#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# Capi driver — production clusters via Cluster API
# Implements: driver::provision, driver::export, driver::destroy, driver::status, driver::kubeconfig
# Capi-specific: capi::bootstrap (management cluster bootstrap)
#
# Full CAPI logic (detect_provider, generate, wait_ready, ensure_credentials)
# lives in the sibling drivers/capi/generate — imported here so the driver is
# self-contained (a driver's main must pull in all of its own siblings; see
# CONTRACT). Do NOT rely on `lo` pre-importing it.

import ^utils/verbose
import ^utils/credentials
import ^drivers/capi/generate

# ── CLI dispatch ──────────────────────────────────────────

main::driver() {
  local -a usage=(
    'provision|p@destructive'  'Provision a CAPI cluster'
    'destroy|d@destructive'    'Destroy a CAPI cluster'
    'status|s@readonly'        'Check cluster status'
    'kubeconfig|k@readonly'    'Extract kubeconfig path'
  )
  :usage "CAPI driver" "${@}"
  "${usage[@]}"
}

# ── Driver contract ───────────────────────────────────────

driver::provision() {
  local domain
  local -a args=(
    'domain'  'Domain to use'
  )
  :args "Provision a CAPI cluster" "${@}"

  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"

  # 1. Determine management cluster
  local mgmt_domain mgmt_local namespace
  mgmt_domain=$(yq -r '.spec.managementCluster.domain // ""' "${cluster_yaml}")
  mgmt_local=$(yq -r '.spec.managementCluster.local // false' "${cluster_yaml}")
  namespace=$(yq -r '.spec.cluster.namespace // "default"' "${cluster_yaml}")

  if [[ -z "${mgmt_domain}" ]]; then
    # || return: errexit is suppressed here (libs/provision:341 runs
    # `driver::provision || provision_rc=$?`). Unguarded, a failed read left
    # LOK8S_KUBEHZ_HOSTING unset, so the != "hosted" branch below told the
    # operator of a HOSTED cluster to set spec.managementCluster.domain — the
    # wrong advice for their configuration, and it hides the real error. The
    # destroy path guards the same call for the same reason.
    kubehz::read_config "${cluster_yaml}" || return 1
    if [[ "${LOK8S_KUBEHZ_HOSTING}" != "hosted" ]]; then
      error "spec.managementCluster.domain is required for self-hosted CAPI"
      error "set spec.kubehz.hosting: hosted to use the kubehz seed cluster"
      return 1
    fi
    kubehz::provision_hosted "${domain}" "${cluster_yaml}"
    return
  fi

  # 2. Detect the infra provider (needed to set up the management cluster).
  # || return: an undetected provider is an EMPTY string that flows into
  # ensure_local_mgmt, ensure_credentials and generate, each of which then builds
  # the wrong thing rather than refusing.
  local provider
  provider=$(capi::detect_provider "${cluster_yaml}") || return 1

  # 3. Ensure a management cluster exists.
  local mgmt_kubeconfig="${PATH_BASE}/.kubeconfig/${mgmt_domain}.yaml"
  if [[ "${domain}" == "${mgmt_domain}" && ! -f "${mgmt_kubeconfig}" ]]; then
    # The domain IS the management cluster — bootstrap it on the provider.
    echo "info: bootstrapping management cluster ${mgmt_domain}" >&2
    capi::bootstrap "${domain}"
    return $?
  fi
  if [[ ! -f "${mgmt_kubeconfig}" ]]; then
    if [[ "${mgmt_local}" == "true" ]]; then
      # Cheap, self-contained model: a local kind cluster as the CAPI
      # management cluster (real workload nodes still on the cloud provider).
      capi::ensure_local_mgmt "${mgmt_domain}" "${provider}" || return 1
    else
      error "management cluster kubeconfig not found: ${mgmt_kubeconfig}"
      error "provision it first ('lo provision ${mgmt_domain}'), or set spec.managementCluster.local: true"
      return 1
    fi
  fi

  # 4. Ensure the cluster namespace + credential Secret exist on the mgmt cluster.
  # || return on BOTH: without the namespace the credential Secret and the CAPI
  # resources land nowhere; without the credentials the apply below still
  # SUCCEEDS — applying CAPI custom resources is only writing CRs — and then CAPH
  # cannot authenticate to the provider, so no Machine is ever created. That
  # failure surfaces, if at all, fifteen minutes later in capi::wait_ready and is
  # attributed to the wrong thing, on a cluster the operator was told was being
  # provisioned. errexit is off here (libs/provision:341), so neither aborts on
  # its own.
  # Rendered into a variable rather than piped, so BOTH halves are checked: a
  # `create … | apply` pipeline reports only the LAST command's status, so a
  # failing `create namespace` is invisible to a trailing `|| return 1` unless
  # pipefail happens to be set — this file cannot assume it is (a piped first
  # version of this guard did nothing). Emptiness is checked HERE, not at
  # detection: this is the first place an empty provider does damage (it is
  # threaded into the credential Secret and into generate), and checking earlier
  # would pre-empt the "management cluster kubeconfig not found" diagnosis
  # kind_contract_test.bats pins as the intended message.
  [[ -n "${provider}" ]] || {
    error "could not detect the infrastructure provider from ${cluster_yaml}"
    return 1
  }

  local ns_manifest
  ns_manifest=$(kubectl --kubeconfig "${mgmt_kubeconfig}" create namespace "${namespace}" \
    --dry-run=client -o yaml) || return 1
  printf '%s\n' "${ns_manifest}" \
    | kubectl --kubeconfig "${mgmt_kubeconfig}" apply -f - >&2 || return 1
  capi::ensure_credentials "${cluster_yaml}" "${provider}" "${mgmt_kubeconfig}" || return 1

  # 5. Generate + apply the CAPI resources. On a freshly-initialized management
  #    cluster the provider (CAPH) admission webhooks may still be wiring up cert
  #    injection when clusterctl init returns, so the first apply can fail with
  #    "connection refused" to the webhook service. Retry with backoff until they
  #    serve (apply is idempotent, so already-created objects are unchanged).
  local resources
  resources=$(capi::generate "${cluster_yaml}" "${provider}") || return 1
  local apply_try
  for apply_try in $(seq 1 10); do
    if kubectl apply --kubeconfig "${mgmt_kubeconfig}" -f <(echo "${resources}") >&2; then
      break
    fi
    if (( apply_try == 10 )); then
      error "failed to apply CAPI resources after ${apply_try} attempts (provider webhooks not ready?)"
      return 1
    fi
    echo "info: apply failed — provider webhooks may still be starting; retry ${apply_try}/10 in 15s" >&2
    sleep 15
  done

  # 6. Wait for the workload cluster to provision. Cloud nodes install the
  #    kubeadm stack via cloud-init, so allow generous time (15m).
  local cluster_name
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  # || return: a cluster that never became ready is the whole reason this step
  # exists. Unguarded it fell through to the kubeconfig extraction, which then
  # failed on its own 5 minutes later with "could not extract workload
  # kubeconfig" — a symptom reported as the cause. The CAPI resources were
  # already applied above, so CAPH may have created real Hetzner resources by
  # now — say so, like the destroy path does, instead of leaving the operator
  # to guess whether anything is billing.
  capi::wait_ready "${mgmt_kubeconfig}" "${cluster_name}" "${namespace}" 900 || {
    error "CAPI resources were applied — Hetzner servers and a load balancer may exist and keep billing"
    error "  run 'lo down' to tear down, or inspect: kubectl --kubeconfig ${mgmt_kubeconfig} get cluster,machine -n ${namespace}"
    return 1
  }

  # 7. Extract the workload kubeconfig under the cluster's metadata.name — the
  #    path the framework's bootstrap step (CNI + CCM) and the harness expect.
  #    The kubeconfig secret appears once the control plane is initialized, so
  #    retry briefly.
  mkdir -p "${PATH_BASE}/.kubeconfig"
  local kc="${PATH_BASE}/.kubeconfig/${cluster_name}.yaml" i
  for i in $(seq 1 30); do
    if clusterctl get kubeconfig "${cluster_name}" \
        --namespace "${namespace}" \
        --kubeconfig "${mgmt_kubeconfig}" > "${kc}" 2>/dev/null && [[ -s "${kc}" ]]; then
      break
    fi
    sleep 10
  done
  [[ -s "${kc}" ]] || { error "could not extract workload kubeconfig for ${cluster_name}"; return 1; }

  # 8. Wait for the workload API server to answer before the framework applies
  #    the CNI + CCM (the control-plane node still has to finish kubeadm init).
  #    Fail (so the harness tears down) if it never comes up — otherwise the
  #    framework would apply bootstrap addons against a dead cluster.
  echo "info: waiting for the workload API server to become reachable" >&2
  local reachable=0
  for i in $(seq 1 60); do
    if kubectl --kubeconfig "${kc}" get --raw='/readyz' &>/dev/null; then reachable=1; break; fi
    sleep 10
  done
  if (( ! reachable )); then
    error "workload API server for ${cluster_name} did not become reachable"
    return 1
  fi
}

# driver::export — spec-derived env consumed by spec.bootstrap addons.
# Idempotent, no side effects. Called by provision::dispatch on BOTH the full
# provision and `--bootstrap` paths, before bootstrap::apply.
# The `hcloud` secret the Hetzner CCM mounts is generated by the `ccm` bootstrap
# addon (Secret.hcloud.kube-system.yaml — the SAME single source every driver
# uses), so we don't mint it here; we only export the one CAPI-specific input the
# generator can't infer — the private-network NAME (CAPH names it after the
# cluster) when networking mode is on. HCLOUD_TOKEN is exported by provision::dispatch.
driver::export() {
  local domain
  local -a args=(
    'domain'  'Domain to use'
  )
  :args "Capi driver export" "${@}"

  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local cluster_name provider net_enabled
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  provider=$(capi::detect_provider "${cluster_yaml}")
  net_enabled=$(yq -r '.spec.provider.config.network.enabled // false' "${cluster_yaml}")

  # The CCM reads the private network from the hcloud secret's `network` key in
  # networking mode; the addon generator picks it up from this env var.
  if [[ "${provider}" == "hetzner" && "${net_enabled}" == "true" ]]; then
    export HCLOUD_CCM_NETWORK="${cluster_name}"
  fi
}

driver::destroy() {
  local domain
  local -a args=(
    'domain'  'Domain to use'
  )
  :args "Destroy a CAPI cluster" "${@}"

  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local mgmt_domain cluster_name namespace mgmt_local
  mgmt_domain=$(yq -r '.spec.managementCluster.domain // ""' "${cluster_yaml}")
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  namespace=$(yq -r '.spec.cluster.namespace // "default"' "${cluster_yaml}")
  mgmt_local=$(yq -r '.spec.managementCluster.local // false' "${cluster_yaml}")

  if [[ -z "${mgmt_domain}" ]]; then
    # || return: errexit is suppressed here (the libs/provision destroy call
    # site, provision::dispatch_destroy, runs `driver::destroy || destroy_rc=$?`).
    # Without it a failed config read leaves
    # LOK8S_KUBEHZ_HOSTING unset, the hosted branch is skipped, and a HOSTED
    # cluster falls through to the "managementCluster.domain is required" error —
    # the wrong diagnosis for the wrong path. The kubeone driver guards the same
    # call for the same reason.
    kubehz::read_config "${cluster_yaml}" || return 1
    if [[ "${LOK8S_KUBEHZ_HOSTING}" == "hosted" ]]; then
      kubehz::destroy_hosted "${domain}" "${cluster_yaml}"
      return
    fi
    error "spec.managementCluster.domain is required for self-hosted CAPI destroy"
    return 1
  fi

  local mgmt_kubeconfig="${PATH_BASE}/.kubeconfig/${mgmt_domain}.yaml"

  # If the mgmt kubeconfig was lost but the local kind cluster is still up,
  # recover it — otherwise we would delete the kind cluster below with a live
  # workload (and its billed servers) still behind it.
  if [[ ! -f "${mgmt_kubeconfig}" && "${mgmt_local}" == "true" ]]; then
    local kind_cluster; kind_cluster=$(capi::mgmt_kind_name "${mgmt_domain}")
    if kind get clusters 2>/dev/null | grep -qx "${kind_cluster}"; then
      mkdir -p "${PATH_BASE}/.kubeconfig"
      kind get kubeconfig --name "${kind_cluster}" > "${mgmt_kubeconfig}" 2>/dev/null || true
    fi
  fi

  # A management kubeconfig we cannot find is a destroy we cannot perform.
  # Without this guard the delete below is silently SKIPPED (del_rc stays 0),
  # the workload kubeconfig is removed anyway, and the function returns
  # success — the same silent-success class as the del_rc guard at the bottom,
  # just entered one step earlier. The remote case always hard-fails. The
  # local case is exempt ONLY when the workload kubeconfig is gone too: a
  # missing mgmt kubeconfig AND a missing workload kubeconfig is what a
  # completed destroy looks like (re-runs of 'lo down' stay idempotent) —
  # but a workload kubeconfig still on disk means the previous destroy never
  # finished, and reporting success here would delete the only handle while
  # Hetzner servers may still be billing.
  if [[ ! -f "${mgmt_kubeconfig}" ]]; then
    if [[ "${mgmt_local}" != "true" ]]; then
      error "management kubeconfig ${mgmt_kubeconfig} not found — cannot reach management cluster ${mgmt_domain} to delete workload cluster ${cluster_name}"
      error "  KEEPING ${PATH_BASE}/.kubeconfig/${cluster_name}.yaml — Hetzner servers and load balancer may still be running and billing"
      error "  restore the management cluster kubeconfig, then re-run 'lo down'"
      return 1
    elif [[ -f "${PATH_BASE}/.kubeconfig/${cluster_name}.yaml" ]]; then
      error "local management kubeconfig is gone but workload cluster ${cluster_name} still has a kubeconfig — the previous destroy never completed"
      error "  KEEPING ${PATH_BASE}/.kubeconfig/${cluster_name}.yaml — Hetzner servers and load balancer may still be running and billing"
      error "  recreate the management cluster ('lo up' on ${mgmt_domain}) and re-run 'lo down', or clean up via 'hcloud server list'"
      return 1
    fi
  fi

  # Delete the workload Cluster and BLOCK until CAPH has deprovisioned the
  # Hetzner servers + load balancer (finalizers complete). Deleting the
  # management cluster before this finishes would orphan billed infrastructure.
  local del_rc=0
  if [[ -f "${mgmt_kubeconfig}" ]]; then
    echo "info: deleting workload cluster ${cluster_name} — waiting for Hetzner teardown (up to 10m)" >&2
    kubectl delete cluster "${cluster_name}" \
      --namespace "${namespace}" \
      --kubeconfig "${mgmt_kubeconfig}" \
      --ignore-not-found=true \
      --wait=true --timeout=600s >&2 || del_rc=$?
  fi

  # Tear down the local kind management cluster we created — but only once the
  # workload teardown actually completed, so CAPH can finish if it is still
  # deleting servers.
  if [[ "${mgmt_local}" == "true" ]] && (( del_rc == 0 )); then
    local kind_name; kind_name=$(capi::mgmt_kind_name "${mgmt_domain}")
    echo "info: deleting local kind management cluster '${kind_name}'" >&2
    export KIND_EXPERIMENTAL_DOCKER_NETWORK="${KIND_EXPERIMENTAL_DOCKER_NETWORK:-lok8s-example}"
    kind delete cluster --name "${kind_name}" 2>/dev/null || true
    rm -f "${mgmt_kubeconfig}"
  fi

  # A failed teardown must not report success, and must not delete any handle:
  # without this block a timed-out delete fell through to the infallible
  # `rm -f`, returned 0, and main::down suppressed its orphaned-infra warning
  # (the case provision::dispatch_destroy's rc=3 remap exists to preserve) —
  # while CAPH may still be deprovisioning, or may have given up with servers
  # and a load balancer still billing, and the kubeconfig that could reach
  # them was gone. This is the ONE place that reports the failure — mgmt-local
  # only adds its extra line here.
  if (( del_rc != 0 )); then
    error "workload cluster delete did not complete (rc=${del_rc}) — Hetzner servers and load balancer may still be running and billing"
    error "  KEEPING ${PATH_BASE}/.kubeconfig/${cluster_name}.yaml so the cluster stays reachable"
    if [[ "${mgmt_local}" == "true" ]]; then
      error "  KEEPING the local kind management cluster so CAPH can finish deprovisioning"
    fi
    error "  check 'hcloud server list' and re-run 'lo down', or inspect: kubectl --kubeconfig ${mgmt_kubeconfig} get cluster,machine -A"
    return 1
  fi

  rm -f "${PATH_BASE}/.kubeconfig/${cluster_name}.yaml"
}

driver::status() {
  local domain
  local -a args=(
    'domain'  'Domain to use'
  )
  :args "Check CAPI cluster status" "${@}"

  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local mgmt_domain cluster_name
  mgmt_domain=$(yq -r '.spec.managementCluster.domain // ""' "${cluster_yaml}")
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")

  if [[ -z "${mgmt_domain}" ]]; then
    echo "Unknown"
    return
  fi

  local mgmt_kubeconfig="${PATH_BASE}/.kubeconfig/${mgmt_domain}.yaml"
  kubectl get cluster "${cluster_name}" --kubeconfig "${mgmt_kubeconfig}" \
    -o jsonpath='{.status.phase}' 2>/dev/null || echo "NotFound"
}

driver::kubeconfig() {
  local domain
  local -a args=(
    'domain'  'Domain to use'
  )
  :args "Extract kubeconfig" "${@}"

  # Written under the workload cluster's metadata.name (see driver::provision).
  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local cluster_name
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  echo "${PATH_BASE}/.kubeconfig/${cluster_name}.yaml"
}

# Optional contract function — Capi needs credential setup
driver::ensure_credentials() {
  local cluster_yaml="${1}" provider="${2}" kubeconfig="${3}"

  credentials::require "${provider}" || return 1

  # Delegate to capi::ensure_credentials from drivers/capi/generate
  capi::ensure_credentials "${cluster_yaml}" "${provider}" "${kubeconfig}"
}

# Deterministic kind cluster name for a management domain (kind forbids dots).
# ensure_local_mgmt (create) and driver::destroy (delete) must agree, so the
# name is derived in one place. e.g. capi-mgmt.lok8s.dev -> capi-mgmt-lok8s-dev
capi::mgmt_kind_name() { echo "${1//[._]/-}"; }

# Create (or reuse) a LOCAL kind cluster as the CAPI management cluster and
# install Cluster API + the infra provider on it. Used when the cluster spec
# sets managementCluster.local: true — the cheap, self-contained dev model
# (kind management locally, real workload nodes on the cloud provider).
# Usage: capi::ensure_local_mgmt <mgmt_domain> <provider>
capi::ensure_local_mgmt() {
  local mgmt_domain="${1}" provider="${2}"
  local mgmt_kubeconfig="${PATH_BASE}/.kubeconfig/${mgmt_domain}.yaml"
  local kind_name; kind_name=$(capi::mgmt_kind_name "${mgmt_domain}")

  # Pin the provider versions so the example is reproducible (and matches what
  # the driver was validated against) rather than tracking clusterctl's latest.
  local capi_version="v1.13.2" infra infra_version
  case "${provider}" in
    hetzner) infra="hetzner"; infra_version="v1.1.7" ;;
    *) error "local management cluster: unsupported provider '${provider}'"; return 1 ;;
  esac

  echo "info: creating local kind management cluster '${kind_name}'" >&2
  export KIND_EXPERIMENTAL_DOCKER_NETWORK="${KIND_EXPERIMENTAL_DOCKER_NETWORK:-lok8s-example}"
  if ! kind get clusters 2>/dev/null | grep -qx "${kind_name}"; then
    kind create cluster --name "${kind_name}" >&2
  fi
  mkdir -p "${PATH_BASE}/.kubeconfig"
  kind get kubeconfig --name "${kind_name}" > "${mgmt_kubeconfig}"

  if kubectl --kubeconfig "${mgmt_kubeconfig}" -n capi-system get deployment capi-controller-manager &>/dev/null; then
    echo "info: Cluster API already installed on '${kind_name}'" >&2
  else
    echo "info: installing Cluster API ${capi_version} + ${infra} ${infra_version} (clusterctl init)" >&2
    clusterctl init \
      --kubeconfig "${mgmt_kubeconfig}" \
      --core "cluster-api:${capi_version}" \
      --bootstrap "kubeadm:${capi_version}" \
      --control-plane "kubeadm:${capi_version}" \
      --infrastructure "${infra}:${infra_version}" \
      --wait-providers >&2
  fi
}

# ── Management cluster bootstrap ─────────────────────────

# Bootstrap a management cluster from scratch.
# Flow: temp kind cluster -> clusterctl init -> apply mgmt CR -> wait ->
#       install operator + CAPI on mgmt -> clusterctl move -> deploy targets -> cleanup
# Usage: capi::bootstrap <domain>   (cluster_yaml is re-derived from the domain)
capi::bootstrap() {
  local domain="${1}"
  local cluster_yaml="${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml"
  local bootstrap_name="lok8s-bootstrap"
  local bootstrap_kubeconfig="${PATH_BASE}/.kubeconfig/${bootstrap_name}.yaml"
  local mgmt_kubeconfig="${PATH_BASE}/.kubeconfig/${domain}.yaml"

  # Detect provider for infrastructure flag
  local provider
  provider=$(capi::detect_provider "${cluster_yaml}")

  local infra_provider
  case "${provider}" in
    hetzner) infra_provider="hetzner" ;;
    aws)     infra_provider="aws" ;;
    *)
      echo "error: unsupported provider for bootstrap: ${provider}" >&2
      return 1
      ;;
  esac

  # NOTE on gating: bootstrap runs under callers' `|| return 1`, so errexit is
  # OFF in this body — every step must carry its own gate or a failure is
  # swallowed and the flow "succeeds" into cleanup. On any failure the
  # bootstrap kind cluster is KEPT: it may hold the only copy of the CAPI
  # resources (before a successful move it always does), and keeping it makes
  # the bootstrap re-entrant (step 1 reuses an existing cluster).

  # 1. Create temporary kind bootstrap cluster
  echo "info: creating bootstrap cluster" >&2
  export KIND_EXPERIMENTAL_DOCKER_NETWORK="${KIND_EXPERIMENTAL_DOCKER_NETWORK:-lok8s}"
  if ! kind get clusters 2>/dev/null | grep -q "^${bootstrap_name}$"; then
    kind create cluster --name "${bootstrap_name}" || {
      echo "error: bootstrap kind cluster create failed" >&2
      return 1
    }
  fi
  mkdir -p "${PATH_BASE}/.kubeconfig"
  kind get kubeconfig --name "${bootstrap_name}" > "${bootstrap_kubeconfig}" || {
    echo "error: cannot read bootstrap kubeconfig" >&2
    return 1
  }

  # 2. Install CAPI core + infrastructure provider on bootstrap
  echo "info: installing CAPI on bootstrap cluster" >&2
  clusterctl init \
    --kubeconfig "${bootstrap_kubeconfig}" \
    --infrastructure "${infra_provider}" \
    --core cluster-api \
    --wait-providers || {
    echo "error: clusterctl init on bootstrap cluster failed" >&2
    return 1
  }

  # 3. Ensure credentials on bootstrap cluster
  capi::ensure_credentials "${cluster_yaml}" "${provider}" "${bootstrap_kubeconfig}" || {
    echo "error: provider credentials setup on bootstrap cluster failed" >&2
    return 1
  }

  # 4. Generate and apply management cluster CAPI resources
  echo "info: applying management cluster resources" >&2
  local resources
  resources=$(capi::generate "${cluster_yaml}" "${provider}") || {
    echo "error: CAPI resource generation failed" >&2
    return 1
  }
  kubectl apply --kubeconfig "${bootstrap_kubeconfig}" -f <(echo "${resources}") || {
    echo "error: applying management cluster resources failed" >&2
    return 1
  }

  # 5. Wait for management cluster to become ready
  local cluster_name
  cluster_name=$(yq -r '.metadata.name' "${cluster_yaml}")
  echo "info: waiting for management cluster to become ready" >&2
  capi::wait_ready "${bootstrap_kubeconfig}" "${cluster_name}" || {
    echo "error: management cluster ${cluster_name} did not become ready" >&2
    return 1
  }

  # 6. Extract management cluster kubeconfig
  clusterctl get kubeconfig "${cluster_name}" \
    --kubeconfig "${bootstrap_kubeconfig}" \
    > "${mgmt_kubeconfig}" || {
    echo "error: cannot extract management cluster kubeconfig" >&2
    return 1
  }

  # 7. Install lok8s operator on management cluster
  echo "info: installing lok8s operator on management cluster" >&2
  if [[ -d "${PATH_BASE}/operator/deploy" ]]; then
    kubectl apply --kubeconfig "${mgmt_kubeconfig}" \
      -f "${PATH_BASE}/operator/deploy/" 2>/dev/null || true
  fi

  # 8. Install CAPI + providers on management cluster
  echo "info: installing CAPI on management cluster" >&2
  clusterctl init \
    --kubeconfig "${mgmt_kubeconfig}" \
    --infrastructure "${infra_provider}" \
    --core cluster-api \
    --wait-providers || {
    echo "error: clusterctl init on management cluster failed" >&2
    return 1
  }

  # 9. Move CAPI resources from bootstrap to management cluster.
  # A failed move MUST keep the bootstrap cluster — at this point it still
  # owns the CAPI resources; deleting it would destroy the only record of
  # the just-provisioned infrastructure.
  echo "info: moving CAPI resources to management cluster" >&2
  clusterctl move \
    --kubeconfig "${bootstrap_kubeconfig}" \
    --to-kubeconfig "${mgmt_kubeconfig}" || {
    echo "error: clusterctl move failed — bootstrap cluster ${bootstrap_name} kept (it still owns the CAPI resources); re-run bootstrap after fixing" >&2
    return 1
  }

  # 10. Delete bootstrap cluster (only after a successful move)
  echo "info: cleaning up bootstrap cluster" >&2
  kind delete cluster --name "${bootstrap_name}" 2>/dev/null || true
  rm -f "${bootstrap_kubeconfig}"

  echo "info: management cluster ${domain} bootstrapped successfully" >&2
}
