#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# kubehz-shared — Spaces on the kubehz shared control plane (hosting: shared)
#
# A Space is one tenant's slice of a platform-operated control plane: the
# platform runs and secures the control plane, you bring the machines that run
# your workloads. `lo provision` creates (or adopts) the Space and mints
# single-node join tickets; `lo destroy` deregisters it. Access to your
# namespaces is through your kubehz login (OIDC) — there is no admin
# kubeconfig to download, by design.
#
# LIBRARY-ONLY: no main::* entry point and no dispatch guard — loaded via
# libs/kubehz/main; not directly executable.

import ^utils/verbose

# ── Config reader ────────────────────────────────────────

# The three numbers a space is made of, with the bounds the platform accepts.
# A space has no plan: the tenant sets the node ceiling, the namespace ceiling
# and the object cap (the size limit for one Secret or ConfigMap in the
# space's namespaces), under spec.kubehz.space.limits.
LOK8S_SPACE_NODES_DEFAULT=2
LOK8S_SPACE_NODES_MIN=1
LOK8S_SPACE_NODES_MAX=5
LOK8S_SPACE_NAMESPACES_DEFAULT=1
LOK8S_SPACE_NAMESPACES_MIN=1
LOK8S_SPACE_NAMESPACES_MAX=3
LOK8S_SPACE_OBJECT_CAP_DEFAULT=256
LOK8S_SPACE_OBJECT_CAP_MIN=64
LOK8S_SPACE_OBJECT_CAP_MAX=512

# Read one of the three numbers. A missing or null value takes the default.
# spec.kubehz.space.nodes is the machine-name list, so a list under
# limits.nodes is the two fields confused: name both.
# Usage: kubehz::space_number <cluster_yaml> <field> <default> <min> <max>
# Outputs: the number to stdout
kubehz::space_number() {
  local cluster_yaml="${1}" field="${2}" def="${3}" min="${4}" max="${5}"
  local type value
  type=$(yq -r ".spec.kubehz.space.limits.${field} | type" "${cluster_yaml}" 2>/dev/null) || type=""
  case "${type}" in
    ''|null|'!!null')
      echo "${def}"
      return 0 ;;
    '!!int'|'!!str') ;;
    '!!seq')
      if [[ "${field}" == "nodes" ]]; then
        error "spec.kubehz.space.limits.nodes is a list: it is the node ceiling"
        echo "  Set spec.kubehz.space.limits.nodes to a whole number from ${LOK8S_SPACE_NODES_MIN} to ${LOK8S_SPACE_NODES_MAX}." >&2
        echo "  The machine names stay under spec.kubehz.space.nodes." >&2
      else
        error "invalid spec.kubehz.space.limits.${field}: expected a whole number from ${min} to ${max}"
      fi
      return 1 ;;
    *)
      error "invalid spec.kubehz.space.limits.${field}: expected a whole number from ${min} to ${max}"
      return 1 ;;
  esac
  value=$(yq -r ".spec.kubehz.space.limits.${field}" "${cluster_yaml}") || return 1
  if ! [[ "${value}" =~ ^-?[0-9]+$ ]] || (( value < min )) || (( value > max )); then
    error "invalid spec.kubehz.space.limits.${field}: ${value} (expected a whole number from ${min} to ${max})"
    return 1
  fi
  echo "${value}"
}

# Read and bound the three numbers of a space. A value outside its range is
# refused here, before the api sees it: the message names the field, the value
# and the range.
# Usage: kubehz::space_limits <cluster_yaml>
# Sets: LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
kubehz::space_limits() {
  local cluster_yaml="${1}"
  local plan
  # Space plans are retired. A spec that still carries one asks for a shape
  # the platform no longer has, so say so instead of ignoring it.
  plan=$(yq -r '.spec.kubehz.space.plan // ""' "${cluster_yaml}") || return 1
  if [[ -n "${plan}" && "${plan}" != "null" ]]; then
    error "spec.kubehz.space.plan is not valid: space plans are retired"
    echo "  Set spec.kubehz.space.limits.nodes, spec.kubehz.space.limits.namespaces" >&2
    echo "  and spec.kubehz.space.limits.objectCapKiB instead." >&2
    return 1
  fi
  LOK8S_SPACE_MAX_NODES=$(kubehz::space_number "${cluster_yaml}" nodes \
    "${LOK8S_SPACE_NODES_DEFAULT}" "${LOK8S_SPACE_NODES_MIN}" "${LOK8S_SPACE_NODES_MAX}") || return 1
  LOK8S_SPACE_MAX_NAMESPACES=$(kubehz::space_number "${cluster_yaml}" namespaces \
    "${LOK8S_SPACE_NAMESPACES_DEFAULT}" "${LOK8S_SPACE_NAMESPACES_MIN}" "${LOK8S_SPACE_NAMESPACES_MAX}") || return 1
  LOK8S_SPACE_MAX_OBJECT_KIB=$(kubehz::space_number "${cluster_yaml}" objectCapKiB \
    "${LOK8S_SPACE_OBJECT_CAP_DEFAULT}" "${LOK8S_SPACE_OBJECT_CAP_MIN}" "${LOK8S_SPACE_OBJECT_CAP_MAX}") || return 1
  export LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
}

# Read spec.kubehz.space from a cluster.lok8s.yaml. Everything is optional:
# the slug defaults to the first DNS label of the domain, the display name to
# the slug, and the three limits to 2 nodes, 1 namespace and a 256 KiB object
# cap. Node names listed under spec.kubehz.space.nodes[] get a join ticket
# minted at provision time.
# Usage: kubehz::space_config <domain> <cluster_yaml>
# Sets: LOK8S_SPACE_SLUG LOK8S_SPACE_NAME LOK8S_SPACE_REGION
#       LOK8S_SPACE_MAX_NODES LOK8S_SPACE_MAX_NAMESPACES LOK8S_SPACE_MAX_OBJECT_KIB
#       LOK8S_SPACE_NODES (array)
kubehz::space_config() {
  local domain="${1}" cluster_yaml="${2}"
  local default_slug="${domain%%.*}"

  # || return on every read: errexit is off on the provision path, and a
  # yq PARSE failure is not "no slug configured" — falling back to the
  # default here would let destroy_shared target the WRONG space.
  LOK8S_SPACE_SLUG=$(yq -r '.spec.kubehz.space.slug // ""' "${cluster_yaml}") || return 1
  [[ -n "${LOK8S_SPACE_SLUG}" ]] || LOK8S_SPACE_SLUG="${default_slug}"
  LOK8S_SPACE_NAME=$(yq -r '.spec.kubehz.space.name // ""' "${cluster_yaml}") || return 1
  [[ -n "${LOK8S_SPACE_NAME}" ]] || LOK8S_SPACE_NAME="${LOK8S_SPACE_SLUG}"
  LOK8S_SPACE_REGION=$(yq -r '.spec.kubehz.space.region // ""' "${cluster_yaml}") || return 1
  kubehz::space_limits "${cluster_yaml}" || return 1

  LOK8S_SPACE_NODES=()
  local node
  while IFS= read -r node; do
    [[ -n "${node}" && "${node}" != "null" ]] && LOK8S_SPACE_NODES+=("${node}")
  done < <(yq -r '.spec.kubehz.space.nodes[]?' "${cluster_yaml}" 2>/dev/null)

  export LOK8S_SPACE_SLUG LOK8S_SPACE_NAME LOK8S_SPACE_REGION
}

# ── API plumbing ─────────────────────────────────────────

# One call against the kubehz API with the envelope contract handled. The
# result travels in GLOBALS, never on stdout: a `$(...)` capture would run
# this in a subshell and the status/body the error paths need would die with
# it (the classic bash scope trap — the first version had exactly that bug
# and the unit suite caught it).
#   rc 0  → 2xx; body in KUBEHZ_SPACE_API_BODY
#   rc 2  → non-2xx; status + body in the globals for caller branching
#   rc 1  → transport failure (already rendered)
# Usage: kubehz::space_api <method> <path> [json_body]
kubehz::space_api() {
  local method="${1}" path="${2}" body="${3:-}"
  KUBEHZ_SPACE_API_STATUS=""
  KUBEHZ_SPACE_API_BODY=""

  local -a extra=()
  [[ -n "${body}" ]] && extra=(-H "Content-Type: application/json" -d "${body}")

  local raw
  raw=$(curl -sSL -w $'\n%{http_code}' -X "${method}" \
    "${LOK8S_KUBEHZ_API_URL}${path}" \
    -H "Authorization: Bearer ${KUBEHZ_TOKEN:-}" \
    "${extra[@]}") || {
    error "kubehz API unreachable (${method} ${path})"
    return 1
  }
  KUBEHZ_SPACE_API_STATUS="${raw##*$'\n'}"
  KUBEHZ_SPACE_API_BODY="${raw%$'\n'*}"

  [[ "${KUBEHZ_SPACE_API_STATUS}" == 2* ]] || return 2
}

# Render the message + help halves of a non-2xx envelope — the api's own words
# are almost always the actionable ones.
# Usage: kubehz::space_api_error <context>
kubehz::space_api_error() {
  local context="${1}"
  local msg help
  msg=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.message // .message // empty' 2>/dev/null) || msg=""
  help=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.help // .help // empty' 2>/dev/null) || help=""
  error "${context} (HTTP ${KUBEHZ_SPACE_API_STATUS})${msg:+: ${msg}}"
  [[ -n "${help}" ]] && echo "  ${help}" >&2
  return 0
}

# Find a Space by slug. Result in KUBEHZ_SPACE_ROW (JSON, empty when absent).
# Usage: kubehz::space_lookup <slug>
kubehz::space_lookup() {
  local slug="${1}"
  KUBEHZ_SPACE_ROW=""
  kubehz::space_api GET "/api/spaces" || {
    (( $? == 2 )) && kubehz::space_api_error "Failed to list spaces"
    return 1
  }
  KUBEHZ_SPACE_ROW=$(echo "${KUBEHZ_SPACE_API_BODY}" \
    | jq -r --arg slug "${slug}" \
        '(.data? // .) | (if type=="array" then . else [.] end) | map(select(.slug == $slug)) | first // empty')
}

# ── Provision (create-or-adopt + join tickets) ───────────

# Render the three numbers for one terminal line.
# Usage: kubehz::space_limits_line
kubehz::space_limits_line() {
  echo "nodes ${LOK8S_SPACE_MAX_NODES}, namespaces ${LOK8S_SPACE_MAX_NAMESPACES}, object cap ${LOK8S_SPACE_MAX_OBJECT_KIB} KiB"
}

# Report a space whose limits differ from the spec. Adoption stays read-only:
# lo creates a space with the three numbers, and never changes the numbers of a
# space that exists. Without this note the edit in the spec would do nothing
# and say nothing.
# Usage: kubehz::space_note_limits_drift
kubehz::space_note_limits_drift() {
  local live_nodes live_namespaces live_object_cap
  live_nodes=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNodes // "" | tostring' 2>/dev/null) || return 0
  live_namespaces=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNamespaces // "" | tostring' 2>/dev/null) || return 0
  live_object_cap=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxObjectKiB // "" | tostring' 2>/dev/null) || return 0
  # An api that does not report the three numbers gives nothing to compare.
  [[ -n "${live_nodes}" && -n "${live_namespaces}" && -n "${live_object_cap}" ]] || return 0
  if [[ "${live_nodes}" == "${LOK8S_SPACE_MAX_NODES}" \
    && "${live_namespaces}" == "${LOK8S_SPACE_MAX_NAMESPACES}" \
    && "${live_object_cap}" == "${LOK8S_SPACE_MAX_OBJECT_KIB}" ]]; then
    return 0
  fi
  echo "  Note: this space keeps the limits it was created with."
  echo "  The spec asks for $(kubehz::space_limits_line)."
  echo "  lo does not change them. Change the limits in the kubehz dashboard."
}

# Create the Space, or adopt it when it already exists (idempotent
# re-provision — the same contract every lo driver honors).
# Result in KUBEHZ_SPACE_ID.
# Usage: kubehz::space_ensure <domain> <cluster_yaml>
kubehz::space_ensure() {
  local domain="${1}" cluster_yaml="${2}"
  KUBEHZ_SPACE_ID=""

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -n "${KUBEHZ_SPACE_ROW}" ]]; then
    debug "Space '${LOK8S_SPACE_SLUG}' already exists — adopting"
    KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
    [[ -n "${KUBEHZ_SPACE_ID}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
    kubehz::space_note_limits_drift
    return 0
  fi

  local payload
  payload=$(jq -n \
    --arg name "${LOK8S_SPACE_NAME}" \
    --arg slug "${LOK8S_SPACE_SLUG}" \
    --argjson maxNodes "${LOK8S_SPACE_MAX_NODES}" \
    --argjson maxNamespaces "${LOK8S_SPACE_MAX_NAMESPACES}" \
    --argjson maxObjectKiB "${LOK8S_SPACE_MAX_OBJECT_KIB}" \
    --arg region "${LOK8S_SPACE_REGION}" \
    '{name: $name, slug: $slug, maxNodes: $maxNodes, maxNamespaces: $maxNamespaces, maxObjectKiB: $maxObjectKiB}
      + (if $region != "" then {region: $region} else {} end)')

  local rc=0
  kubehz::space_api POST "/api/spaces" "${payload}" || rc=$?
  if (( rc == 1 )); then
    return 1
  elif (( rc == 2 )); then
    local code
    code=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.code // .code // empty' 2>/dev/null) || code=""
    case "${code}" in
      NO_SHARD_AVAILABLE)
        error "kubehz: no shared control plane has room for a new space right now."
        echo "  Capacity frees as spaces are removed and as new planes come online. You can:" >&2
        echo "    • retry later" >&2
        echo "    • run your own cluster meanwhile (spec.kubehz.hosting: self)" >&2
        return 1 ;;
      SPACE_LIMITS_ABOVE_FREE)
        error "kubehz refused the space limits ($(kubehz::space_limits_line)): they are above the free allowance"
        echo "  A free account gets 1 space with 2 nodes and 1 namespace." >&2
        echo "  Decrease the values in spec.kubehz.space.limits, or upgrade the account in" >&2
        echo "  the kubehz dashboard." >&2
        return 1 ;;
      SPACE_LIMITS_ABOVE_SHARED)
        error "kubehz refused the space limits ($(kubehz::space_limits_line)): they are above the maximum of a shared control plane"
        echo "  Decrease the values in spec.kubehz.space.limits, or use a hosted control" >&2
        echo "  plane: set spec.kubehz.hosting to hosted." >&2
        return 1 ;;
      SPACE_PLAN_RETIRED)
        error "kubehz refused the request: space plans are retired"
        echo "  A space uses spec.kubehz.space.limits: nodes, namespaces and objectCapKiB." >&2
        echo "  Remove spec.kubehz.space.plan from the cluster spec. Then run" >&2
        echo "  lo provision again." >&2
        return 1 ;;
      *)
        # Lost a create race? The adopt path answers it — retry the lookup once.
        if [[ "${KUBEHZ_SPACE_API_STATUS}" == "409" ]]; then
          kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || true
          if [[ -n "${KUBEHZ_SPACE_ROW}" ]]; then
            debug "Space '${LOK8S_SPACE_SLUG}' appeared concurrently — adopting"
            KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
            [[ -n "${KUBEHZ_SPACE_ID}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
            return 0
          fi
        fi
        kubehz::space_api_error "Failed to create the space"
        return 1 ;;
    esac
  fi

  KUBEHZ_SPACE_ID=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.id // .id')
}

# Wait for a Space to reach the Active phase (the platform materializes the
# namespace, quota, access bindings and network policy server-side).
# Usage: kubehz::space_wait_active <space_id> [timeout_seconds]
kubehz::space_wait_active() {
  local space_id="${1}" timeout="${2:-300}"
  local elapsed=0 phase

  while (( elapsed < timeout )); do
    kubehz::space_api GET "/api/spaces/${space_id}" 2>/dev/null || true
    # Fail FAST on the statuses that never heal within the window: an expired
    # token stays 401/403 for all 300s, and a 404 means the space was deleted
    # out from under us — looping to timeout buries the real cause.
    case "${KUBEHZ_SPACE_API_STATUS}" in
      401|403)
        error "kubehz API refused the token while waiting for space ${space_id} (HTTP ${KUBEHZ_SPACE_API_STATUS})"
        return 1 ;;
      404)
        error "space ${space_id} vanished while waiting for it to become Active"
        return 1 ;;
    esac
    # The api serves the observed `status` overlay, never `phase` — reading
    # phase kept this loop at "Unknown" until timeout.
    phase=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.status // .status // "Unknown"' 2>/dev/null) || phase="Unknown"
    case "${phase}" in
      Active)
        debug "Space ${space_id} is Active"
        return 0 ;;
      Failed|Error)
        error "Space ${space_id} failed: phase=${phase}"
        return 1 ;;
    esac
    debug "Space ${space_id} phase: ${phase} (${elapsed}s / ${timeout}s)"
    sleep 5
    elapsed=$(( elapsed + 5 ))
  done

  error "Timed out waiting for space ${space_id} to become Active after ${timeout}s"
  return 1
}

# Mint a single-node join ticket and print the join block. The plaintext token
# is returned exactly once by the api and never persisted anywhere — a lost
# ticket is re-minted, not recovered.
# Usage: kubehz::space_mint_join <space_id> <node_name>
kubehz::space_mint_join() {
  local space_id="${1}" node_name="${2}"

  local payload rc=0
  payload=$(jq -n --arg nodeName "${node_name}" '{nodeName: $nodeName}')
  kubehz::space_api POST "/api/spaces/${space_id}/join-token" "${payload}" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && kubehz::space_api_error "Failed to mint a join ticket for '${node_name}'"
    return 1
  fi

  local token expires
  token=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.token // .token // empty')
  expires=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '.data.expiresAt // .expiresAt // empty')
  if [[ -z "${token}" ]]; then
    error "kubehz API did not return a join token for '${node_name}'"
    return 1
  fi

  echo ""
  echo "  Node '${node_name}' — join ticket (valid until ${expires:-<unknown>}, single use):"
  echo "    ${token}"
  echo "  On the machine, follow the node-join guide for your platform"
  echo "  (kubehz docs: Spaces → Joining nodes). The ticket is bound to this"
  echo "  node name and expires quickly — mint a fresh one with:"
  echo "    lo kubehz join ${node_name}"
}

# Full provision arc for hosting: shared.
# Usage: kubehz::provision_shared <domain> <cluster_yaml>
kubehz::provision_shared() {
  local domain="${1}" cluster_yaml="${2}"

  [[ -n "${KUBEHZ_TOKEN:-}" ]] || {
    error "KUBEHZ_TOKEN is required to provision a space (get one from your kubehz account)"
    return 1
  }

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_ensure "${domain}" "${cluster_yaml}" || return 1
  local space_id="${KUBEHZ_SPACE_ID}"
  [[ -n "${space_id}" && "${space_id}" != "null" ]] || {
    error "kubehz API did not return a space ID"
    return 1
  }

  kubehz::space_wait_active "${space_id}" || return 1

  echo "Space '${LOK8S_SPACE_SLUG}' is Active (id: ${space_id})"
  echo "  Namespace: ${LOK8S_SPACE_SLUG}"
  echo "  Access: sign in with your kubehz account (OIDC) — the control plane"
  echo "  itself is operated by the platform and is not directly accessible."

  local node
  for node in "${LOK8S_SPACE_NODES[@]}"; do
    kubehz::space_mint_join "${space_id}" "${node}" || return 1
  done
  if (( ${#LOK8S_SPACE_NODES[@]} == 0 )); then
    echo ""
    echo "  No nodes declared under spec.kubehz.space.nodes — mint a join"
    echo "  ticket any time with: lo kubehz join <node-name>"
  fi
}

# ── Destroy ──────────────────────────────────────────────

# Deregister the Space. Removing a space withdraws access and removes its
# namespaces — workloads on your machines stop being scheduled.
# Usage: kubehz::destroy_shared <domain> <cluster_yaml>
kubehz::destroy_shared() {
  local domain="${1}" cluster_yaml="${2}"

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -z "${KUBEHZ_SPACE_ROW}" ]]; then
    echo "No space '${LOK8S_SPACE_SLUG}' found — nothing to destroy"
    return 0
  fi

  local space_id
  space_id=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
  [[ -n "${space_id}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
  local rc=0
  kubehz::space_api DELETE "/api/spaces/${space_id}" || rc=$?
  if (( rc != 0 )); then
    (( rc == 2 )) && kubehz::space_api_error "Failed to remove space '${LOK8S_SPACE_SLUG}'"
    return 1
  fi
  echo "Space '${LOK8S_SPACE_SLUG}' removed (id: ${space_id})"
}

# ── Status ───────────────────────────────────────────────

# Render the Space + its registered nodes.
# Usage: kubehz::space_status <domain> <cluster_yaml>
kubehz::space_status() {
  local domain="${1}" cluster_yaml="${2}"

  kubehz::space_config "${domain}" "${cluster_yaml}" || return 1

  kubehz::space_lookup "${LOK8S_SPACE_SLUG}" || return 1
  if [[ -z "${KUBEHZ_SPACE_ROW}" ]]; then
    echo "Space:   '${LOK8S_SPACE_SLUG}' not found (not provisioned yet?)"
    return 0
  fi

  local space_id phase max_nodes max_namespaces max_object
  space_id=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.id // empty')
  [[ -n "${space_id}" ]] || { error "space row carries no id — refusing to continue"; return 1; }
  phase=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.status // "Unknown"')
  max_nodes=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNodes // "-"')
  max_namespaces=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxNamespaces // "-"')
  max_object=$(echo "${KUBEHZ_SPACE_ROW}" | jq -r '.maxObjectKiB // "-"')
  echo "Space:   ${LOK8S_SPACE_SLUG} (id: ${space_id})"
  echo "Phase:   ${phase}"
  echo "Limits:  nodes ${max_nodes}, namespaces ${max_namespaces}, object cap ${max_object} KiB"

  kubehz::space_api GET "/api/spaces/${space_id}/nodes" 2>/dev/null || {
    echo "Nodes:   unknown (API unreachable)"
    return 0
  }
  local count
  # The route answers {nodes:[{name,lane,status,…}], usage:{nodes,maxNodes}} —
  # treating it as an array printed the OBJECT's key count.
  count=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '(.data? // .) | .usage.nodes // 0' 2>/dev/null) || count=0
  local max; max=$(echo "${KUBEHZ_SPACE_API_BODY}" | jq -r '(.data? // .) | .usage.maxNodes // "-"' 2>/dev/null) || max='-'
  echo "Nodes:   ${count}/${max}"
  echo "${KUBEHZ_SPACE_API_BODY}" \
    | jq -r '(.data? // .) | .nodes[]? | "  " + .name + "  " + (.status // "-") + "  " + (.lane // "-")' 2>/dev/null || true
}
