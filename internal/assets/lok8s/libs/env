#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2016,SC2034
# SC2016: single-quoted $ here is jq/yq/awk program text or a remote-script literal
# vim: set syntax=bash:
# env — environment and service configuration
# Merges services.yaml + services.<config>.yaml, generates root kustomization.yaml.
# All registry references are now configurable from services.yaml registry config.
# TODO: narrow to next-line disables once argsh-lint honors them (>0.1.0).
# AG012 suppressed file-wide (next-line disable not honored in argsh-lint 0.1.0):
# the `local domain="${domain:-...}"` sites are NOT clobbers — the RHS default
# keeps the parent's inherited value (flag > env > default).
# argsh disable-file=AG012

import ^utils/types
import ^utils/verbose

main::env() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  local -a usage=(
    'services|v@readonly'         'Print services'
    'kustomization|k@idempotent'  'Generate kustomization.yaml'
  )
  :usage "Manage environment" "${@}"
  "${usage[@]}"
}

# Print merged service configuration.
# Merges services.yaml (committed) + services.<config>.yaml (override).
# Returns empty YAML ({}) when no services.yaml exists (projects that manage
# k8s manifests directly without the services abstraction).
# shellcheck disable=SC2120
env::services() {
  debug "Print services"

  local only_services only_registry
  local -a args=(
    "only-services|s:+" "Only print services"
    "only-registry|r:+" "Only print registry"
    "${args[@]:-}"
  )
  :args "Print services" "${@}"

  local base_file="${PATH_BASE}/services.yaml"
  if [[ ! -f "${base_file}" ]]; then
    # Fall back to legacy filenames
    base_file="${PATH_BASE}/services.base.yaml"
    if [[ ! -f "${base_file}" ]]; then
      # No services config at all — return empty YAML
      debug "No services.yaml found; returning empty config"
      echo "{}"
      return 0
    fi
  fi

  {
    cat "${base_file}"
    # Merge config-specific override if LOK8S_SERVICE_CONFIG is set
    if [[ -n "${LOK8S_SERVICE_CONFIG:-}" ]]; then
      local override="${PATH_BASE}/services.${LOK8S_SERVICE_CONFIG}.yaml"
      if [[ -f "${override}" ]]; then
        echo -e "\n---\n"
        cat "${override}"
      fi
    fi
    # Legacy: also merge services.default.yaml if it exists
    if [[ -f "${PATH_BASE}/services.default.yaml" ]]; then
      echo -e "\n---\n"
      cat "${PATH_BASE}/services.default.yaml"
    fi
  } | yq eval-all '. as $item ireduce ({}; . * $item )' | {
    if (( only_services )); then
      yq '.services'
    elif (( only_registry )); then
      yq '.registry'
    else
      cat
    fi
  } | envsubst
}

env::kustomization() {
  debug "Generate kustomization.yaml"

  local no_build pull
  local -a args=(
    "no-build|n:+" "Do not build artifacts"
    "pull|p:+"     "After writing the kustomization, drain the cache queue (lo image cache --all)"
    "${args[@]:-}"
  )
  :args "Generate kustomization.yaml" "${@}"

  (( no_build )) || build::artifacts

  # Read merged services env once.
  local merged
  merged=$(env::services 2>/dev/null)

  # Global registry config. Three distinct concepts:
  #   prefix   = canonical local image name (lok8s.local — what manifests
  #              reference, what docker_build produces). Never remote.
  #   cache    = on-cluster cache hostname (lok8s.cache — what build:false
  #              services get swapped to so kind pulls without upstream creds).
  #   endpoint = remote registry target (ghcr.io/org, etc.) — only used
  #              when pre-pulling a non-built service into the cache.
  # branch/tag are the path components of both the remote and the cache ref.
  local g_prefix g_cache g_endpoint g_branch g_tag
  g_prefix=$(echo "${merged}"   | yq -r '.registry.prefix   // "lok8s.local"')
  g_cache="lok8s.cache"
  g_endpoint=$(echo "${merged}" | yq -r '.registry.endpoint // "${DOCKER_REGISTRY}"' | envsubst)
  g_branch=$(echo "${merged}"   | yq -r '.registry.branch   // "${DOCKER_PROJECT}"'  | envsubst)
  g_tag=$(echo "${merged}"      | yq -r '.registry.tag      // "${DOCKER_TAG}"'      | envsubst)

  # Default for the per-service `build:` field. Mirrors Tiltfile resolution:
  # per-service > defaults.build > true.
  # NOTE: yq's `//` operator is "alternative on null OR false" — it
  # swallows legitimate `false` values. The only reliable way to
  # distinguish "missing" from "present and false" is `| tostring`,
  # which emits "null" for missing keys and "false"/"true" for bools.
  local default_build
  default_build=$(echo "${merged}" | yq -r '.defaults.build | tostring')
  [[ "${default_build}" == "null" ]] && default_build="true"

  # Cache pre-pull queue: services that need a remote image fetched and
  # pushed into the cache registry before kind tries to pull them. Written
  # to .lok8s/<domain>/artifacts/.cache-queue (TSV: svc \t remote \t branch \t tag).
  local domain="${domain:-${DOMAIN_NAME:-lok8s.dev}}"
  local artifacts_dir="${PATH_CLUSTERS}/${domain}/artifacts"
  mkdir -p "${artifacts_dir}"
  local domain_artifact="${PATH_CLUSTERS}/${domain}/artifacts.yaml"

  # services.<name>.patches, checked against the domain artifact before the
  # cache queue and the overlay are written: a patch that matches none of its
  # service's objects fails the run and leaves both as they were.
  local patches
  patches=$(env::generate_patches "${merged}" "${domain_artifact}" "${domain}") || return 1

  local cache_queue="${artifacts_dir}/.cache-queue"
  : > "${cache_queue}"

  local images
  images=$(env::generate_images "${merged}" "${default_build}" "${g_prefix}" "${g_cache}" "${g_endpoint}" "${g_branch}" "${g_tag}" "${cache_queue}")

  # Write the Tilt overlay kustomization into the domain's artifacts/ directory.
  # It wraps the SINGLE domain artifact (clusters/<domain>/artifacts.yaml, built
  # by build::artifacts above from the domain kustomization) and layers the
  # services.yaml image swaps and the services.<name>.patches on top. Tilt
  # builds this dir into one pool it partitions via filter_yaml() (see
  # .lok8s/tilt/Tiltfile).
  local out_file="${artifacts_dir}/kustomization.yaml"

  {
    echo "# Auto-generated by lok8s — do not edit. Source: lo env kustomization."
    echo "apiVersion: kustomize.config.k8s.io/v1beta1"
    echo "kind: Kustomization"
    echo ""
    if [[ -f "${domain_artifact}" ]]; then
      # ../artifacts.yaml is a raw file above the overlay root — Tilt builds this
      # dir with --load-restrictor=LoadRestrictionsNone so the reference resolves.
      echo "resources:"
      echo "  - ../artifacts.yaml"
    else
      echo "resources: []"
    fi
    if [[ -n "${images}" ]]; then
      echo ""
      echo "images:"
      echo "${images}"
    fi
    if [[ -n "${patches}" ]]; then
      echo ""
      echo "patches:"
      echo "${patches}"
    fi
  } > "${out_file}"

  # Cache pre-pull is now opt-in via --pull. Tilt and lo build orchestrate
  # the cache step separately so failures surface in the right layer and
  # users can run kustomization generation without forcing a network round
  # trip. The queue file is always written; consumers drain it when ready.
  if (( pull )); then
    if ! declare -F image::cache >/dev/null 2>&1; then
      error "--pull requires the image lib (run via 'lo env kustomization --pull', not by sourcing env standalone)"
      return 1
    fi
    if [[ -s "${cache_queue}" ]]; then
      debug "draining $(wc -l < "${cache_queue}") cache queue entries"
      image::cache --all || {
        error "image::cache --all failed; check upstream credentials and network"
        return 1
      }
    fi
  fi
}

# Generate image override lines for kustomization.yaml from services config.
# Extracted from env::kustomization for testability.
# Usage: env::generate_images <merged> <default_build> <g_prefix> <g_cache> <g_endpoint> <g_branch> <g_tag> <cache_queue>
env::generate_images() {
  local merged="${1}" default_build="${2}" g_prefix="${3}" g_cache="${4}"
  local g_endpoint="${5}" g_branch="${6}" g_tag="${7}" cache_queue="${8}"

  local svc_names svc
  svc_names=$(echo "${merged}" | yq -r '.services // {} | keys | .[]')
  [[ -z "${svc_names}" ]] && return 0

  while IFS= read -r svc; do
    [[ -z "${svc}" ]] && continue

    # Skip disabled services (tostring-sentinel because // swallows false)
    local enabled
    enabled=$(echo "${merged}" | yq -r ".services.\"${svc}\".enabled | tostring")
    [[ "${enabled}" == "null" ]] && enabled="true"
    [[ "${enabled}" == "false" ]] && continue

    # Resolve effective build (per-service > defaults > true).
    local svc_build
    svc_build=$(echo "${merged}" | yq -r ".services.\"${svc}\".build | tostring")
    [[ "${svc_build}" == "null" ]] && svc_build="${default_build}"

    # Pinned image (mutually exclusive with registry per validator).
    local pinned
    pinned=$(echo "${merged}" | yq -r ".services.\"${svc}\".image // \"\"")
    if [[ -n "${pinned}" ]]; then
      if [[ "${pinned}" == *@sha256:* ]]; then
        cat <<EOF
  - name: ${g_prefix}/${svc}
    newName: ${pinned%@*}
    digest: "${pinned##*@}"
EOF
      elif [[ "${pinned}" == *:* ]]; then
        local pin_name="${pinned%:*}"
        local pin_tag="${pinned##*:}"
        cat <<EOF
  - name: ${g_prefix}/${svc}
    newName: ${pin_name}
    newTag: "${pin_tag}"
EOF
      else
        cat <<EOF
  - name: ${g_prefix}/${svc}
    newName: ${pinned}
EOF
      fi
      continue
    fi

    # No pin: only emit a swap if we're NOT building locally.
    [[ "${svc_build}" == "true" ]] && continue

    # build:false branch on registry-presence:
    #   per-service.registry.endpoint > global.registry.endpoint > skip+warn
    local s_endpoint s_branch s_tag
    s_endpoint=$(echo "${merged}" | yq -r ".services.\"${svc}\".registry.endpoint // \"${g_endpoint}\"" | envsubst)
    s_branch=$(echo "${merged}"   | yq -r ".services.\"${svc}\".registry.branch   // \"${g_branch}\""   | envsubst)
    s_tag=$(echo "${merged}"      | yq -r ".services.\"${svc}\".registry.tag      // \"${g_tag}\""      | envsubst)

    if [[ -z "${s_endpoint}" ]]; then
      echo "warn: service '${svc}' has build:false but no registry.endpoint configured — skipping image swap (define registry.endpoint, set image:, or set build:true)" >&2
      continue
    fi

    # Cache mode. Manifest swap rewrites to lok8s.cache, and we queue the
    # remote ref for `lo image cache` to pre-populate.
    local remote_ref="${s_endpoint}/${s_branch}/${svc}:${s_tag}"
    printf '%s\t%s\t%s\t%s\n' "${svc}" "${remote_ref}" "${s_branch}" "${s_tag}" >> "${cache_queue}"

    cat <<EOF
  - name: ${g_prefix}/${svc}
    newName: ${g_cache}/${s_branch}/${svc}
    newTag: "${s_tag}"
EOF
  done <<< "${svc_names}"
}

# Generate the `patches:` list items for kustomization.yaml from the
# services.<name>.patches entries of the merged services config. Each patch is
# validated, matched against the domain artifact, and emitted with a label
# selector that keeps it on that service's objects. A failure prints one
# [error] line and returns 1.
# Usage: env::generate_patches <merged> <domain_artifact> <domain>
env::generate_patches() {
  local merged="${1}" domain_artifact="${2}" domain="${3}"
  # C collation: the character ranges below are ASCII ranges.
  local LC_ALL=C
  local label="lok8s.dev/name"
  local re_label='^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$'
  local re_value='^[A-Za-z0-9.:-]+$'
  # A character the emitted block scalar cannot carry (the Go port's
  # patchControlRE): a C0 or C1 control other than tab and newline, a line or
  # paragraph separator, a byte-order mark, U+FFFE or U+FFFF.
  local re_unsafe='[\x{00}-\x{08}\x{0B}-\x{1F}\x{7F}-\x{9F}\x{2028}\x{2029}\x{FEFF}\x{FFFE}\x{FFFF}]'

  local svc_names svc
  [[ "$(echo "${merged}" | yq -r '.services | type')" == "!!map" ]] || return 0
  svc_names=$(echo "${merged}" | yq -r '.services | keys | .[]')
  [[ -z "${svc_names}" ]] && return 0

  while IFS= read -r svc; do
    [[ -z "${svc}" ]] && continue
    # A service entry that is not a mapping has no patches.
    [[ "$(S="${svc}" yq -r '.services[strenv(S)] | type' <<< "${merged}")" == "!!map" ]] || continue

    # A disabled service gets no patches, as it gets no image swap.
    local enabled
    enabled=$(S="${svc}" yq -r '.services[strenv(S)].enabled | tostring' <<< "${merged}")
    [[ "${enabled}" == "false" ]] && continue

    local list_type count
    list_type=$(S="${svc}" yq -r '.services[strenv(S)].patches | type' <<< "${merged}")
    [[ "${list_type}" == "!!null" ]] && continue
    if [[ "${list_type}" != "!!seq" ]]; then
      error "services.${svc}.patches must be a list"
      return 1
    fi
    count=$(S="${svc}" yq -r '.services[strenv(S)].patches | length' <<< "${merged}")
    (( count == 0 )) && continue
    if [[ ! "${svc}" =~ ${re_label} ]]; then
      error "services.${svc}: a service with patches needs a name that is a valid label value"
      return 1
    fi

    local i
    for (( i = 0; i < count; i++ )); do
      local where="services.${svc}.patches[${i}]"
      local q='.services[strenv(S)].patches[env(I)]'
      local line key value

      if [[ "$(S="${svc}" I="${i}" yq -r "${q} | type" <<< "${merged}")" != "!!map" ]]; then
        error "${where} must be a mapping with 'patch' and 'target'"
        return 1
      fi
      # Each key with a prefix, so an empty key is still a line.
      while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        key="${line#k:}"
        if [[ "${key}" != "patch" && "${key}" != "target" ]]; then
          error "${where}.${key} unknown (allowed: patch, target)"
          return 1
        fi
      done < <(S="${svc}" I="${i}" yq -r "${q}"' | keys | .[] | "k:" + (. | tostring)' <<< "${merged}")

      if [[ "$(S="${svc}" I="${i}" yq -r "${q}.patch | type" <<< "${merged}")" != "!!str" ]]; then
        error "${where}.patch must be a non-empty string"
        return 1
      fi
      # Checked BEFORE the patch is read into a variable (a NUL would not
      # survive the read). The same expression as the Go port, on the same
      # regex engine (yq's).
      if [[ "$(S="${svc}" I="${i}" R="${re_unsafe}" yq -r "${q}"'.patch | test(strenv(R))' <<< "${merged}")" == "true" ]]; then
        error "${where}.patch contains a character the overlay cannot carry (only printable characters, tab and newline are allowed)"
        return 1
      fi
      local patch
      patch=$(S="${svc}" I="${i}" yq -r "${q}.patch" <<< "${merged}")
      if [[ -z "${patch//[$' \t\n']/}" ]]; then
        error "${where}.patch must be a non-empty string"
        return 1
      fi

      if [[ "$(S="${svc}" I="${i}" yq -r "${q}.target | type" <<< "${merged}")" != "!!map" ]]; then
        error "${where}.target must be a mapping"
        return 1
      fi
      while IFS= read -r line; do
        [[ -z "${line}" ]] && continue
        key="${line#k:}"
        case "${key}" in
          group|version|kind|name|namespace) ;;
          *)
            error "${where}.target.${key} unknown (allowed: group, version, kind, name, namespace)"
            return 1
            ;;
        esac
      done < <(S="${svc}" I="${i}" yq -r "${q}"'.target | keys | .[] | "k:" + (. | tostring)' <<< "${merged}")
      if [[ "$(S="${svc}" I="${i}" yq -r "${q}.target.kind | type" <<< "${merged}")" == "!!null" ||
            "$(S="${svc}" I="${i}" yq -r "${q}.target.name | type" <<< "${merged}")" == "!!null" ]]; then
        error "${where}.target.kind and ${where}.target.name are required"
        return 1
      fi
      local -A target=()
      for key in group version kind name namespace; do
        [[ "$(S="${svc}" I="${i}" F="${key}" yq -r "${q}"'.target | has(strenv(F))' <<< "${merged}")" == "true" ]] || continue
        # The match runs in yq, on the whole value: a command substitution
        # would strip a trailing newline that the Go port rejects.
        case "$(S="${svc}" I="${i}" F="${key}" yq -r "${q}"'.target[strenv(F)] | type' <<< "${merged}")" in
          '!!map'|'!!seq'|'!!null') value="" ;;
          *)
            if [[ "$(S="${svc}" I="${i}" F="${key}" R="${re_value}" \
                  yq -r "${q}"'.target[strenv(F)] | tostring | test(strenv(R))' <<< "${merged}")" == "true" ]]; then
              value=$(S="${svc}" I="${i}" F="${key}" yq -r "${q}"'.target[strenv(F)]' <<< "${merged}")
            else
              value=""
            fi
            ;;
        esac
        if [[ -z "${value}" ]]; then
          error "${where}.target.${key} must match [A-Za-z0-9.:-]+"
          return 1
        fi
        target[${key}]="${value}"
      done

      # An unset target field matches any value. The group is the part of
      # apiVersion before the first slash, the version the part after the last.
      # An object without a namespace is in "default", as in kustomize.
      local matches=0
      if [[ -f "${domain_artifact}" ]]; then
        matches=$(K="${target[kind]}" N="${target[name]}" NS="${target[namespace]:-}" \
          G="${target[group]:-}" V="${target[version]:-}" S="${svc}" L="${label}" yq ea -r '
          [select(tag == "!!map") | select(
            .kind == strenv(K) and .metadata.name == strenv(N) and
            .metadata.labels[strenv(L)] == strenv(S) and
            (strenv(NS) == "" or .metadata.namespace == strenv(NS) or
              ((.metadata.namespace // "") == "" and strenv(NS) == "default")) and
            (strenv(G) == "" or ((.apiVersion // "") | (contains("/") and ((split("/") | .[0]) == strenv(G))))) and
            (strenv(V) == "" or ((.apiVersion // "") | split("/") | .[-1]) == strenv(V))
          )] | length' "${domain_artifact}" 2>/dev/null) || {
          error "cannot read the ${domain} artifacts"
          return 1
        }
      fi
      if (( matches == 0 )); then
        error "${where}: target ${target[kind]}/${target[name]} matches no object labelled ${label}=${svc} in the ${domain} artifacts"
        return 1
      fi

      # The target values single-quoted with every dot escaped, so kustomize's
      # anchored regex match is an exact match. The patch as a block scalar
      # with an explicit indentation indicator, so a first line that starts
      # with a space keeps it.
      printf '  - target:\n'
      for key in group version kind name namespace; do
        [[ -n "${target[${key}]:-}" ]] || continue
        printf "      %s: '%s'\n" "${key}" "${target[${key}]//./\\.}"
      done
      printf "      labelSelector: '%s=%s'\n" "${label}" "${svc}"
      printf '    patch: |2-\n'
      while IFS= read -r line; do
        if [[ -z "${line}" ]]; then
          echo # an empty line needs no indentation
        else
          printf '      %s\n' "${line}"
        fi
      done <<< "${patch}"
    done
  done <<< "${svc_names}"
}

[[ "${0}" != "${BASH_SOURCE[0]}" && "${ARGSH_SOURCE:-}" != "${BASH_SOURCE[0]}" ]] || main::env "${@}"
