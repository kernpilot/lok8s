#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# vim: set syntax=bash:
# secrets — secret cache management with SOPS/age encryption
#
# The lok8s secret plugin generates values into $PATH_SECRETS as
# plaintext cache files (Secret.<name>.<ns>.<key>). This module adds
# SOPS/age encryption so those cache files can be committed safely.
#
# Layout (single-instance project — flat store):
#   .secrets/Secret.myapp.default.PASSWORD       ← plaintext (gitignored)
#   .secrets/Secret.myapp.default.PASSWORD.enc   ← SOPS-encrypted (committed)
#   .secrets/tls/                                ← mkcert certs (gitignored)
#
# Per-INSTANCE isolation (multi-domain repos): a domain keeps its OWN secrets
# under clusters/<domain>/secrets/, and the CLI + `lo build` use only that store
# for that domain. This is the secure default for anything serving multiple
# environments — dev/prod never share a generated value, and SOPS creation_rules
# can encrypt each domain's store to DIFFERENT recipients so a dev/CI key cannot
# decrypt prod. There is deliberately NO shared tier: a value needed in two
# instances is a manual copy (the operator consenting to that exposure), never a
# silent fallback. See docs/guide/secrets.md.
#   clusters/kubehz.dev/secrets/Secret.app.default.PASSWORD{,.enc}
#   clusters/kubehz.cloud/secrets/Secret.app.default.PASSWORD{,.enc}
#
# .gitignore (per store):
#   *
#   !.gitignore
#   !Secret.*.enc
#
# Encryption uses age keys derived from SSH keys via ssh-to-age.
# No new key ceremony — your existing ~/.ssh/id_ed25519 is your
# encryption identity.

: "${LOK8S_SSH_KEY:=${HOME}/.ssh/id_ed25519}"

import ^utils/types
import ^utils/domain
import ^utils/verbose

# ── CLI entry ────────────────────────────────────────────

main::secrets() {
  local domain="${domain:-${DOMAIN_NAME:-}}"
  local -a args=(
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  local -a usage=(
    'init|i@idempotent'     'Initialize SOPS/age encryption from SSH key'
    'add-key@destructive'   'Add an age recipient and re-key the store'
    'remove-key@destructive' 'Remove an age recipient and re-key the store'
    'set|s@destructive'     'Write a literal value into the secret cache'
    'encrypt|e@idempotent'  'Encrypt plaintext cache files for commit'
    'decrypt|d@idempotent'  'Decrypt .enc files into plaintext cache'
    'allow|a@destructive'   'Approve bash: generators (re-compute .sha + .bash-allow)'
    'list|l@readonly'       'List secrets'
    'print|p@readonly'      'Print secret(s)'
    'env@readonly'          'Emit export KEY=value lines for a cached secret'
    'path@readonly'         'Resolve the secrets path for the current context'
  )
  :usage "Manage secrets" "${@}"
  "${usage[@]}"
}

# ── Path helpers ─────────────────────────────────────────

# shellcheck disable=SC2120
# Resolve the secrets store for the current context. A domain with its own
# clusters/<domain>/secrets/ uses THAT store exclusively (per-instance isolation,
# no flat fallback for it); otherwise the flat PATH_SECRETS store (single-instance
# projects). `lo build` mirrors this — see build::_export_secrets_path. A domain
# whose directory exists without a store, in a project that keeps a store per
# domain, gets no flat fallback either: domain::check_secrets_store prints the
# refusal and secrets::path returns 1, which stops the calling command.
secrets::path() {
  :args "Resolve the secrets path for the current context" "${@}"
  if [[ -n "${domain}" && -d "${PATH_CLUSTERS}/${domain}/secrets" ]]; then
    echo "${PATH_CLUSTERS}/${domain}/secrets"
  else
    domain::check_secrets_store "${domain}" || return 1
    echo "${PATH_SECRETS:-${PATH_BASE}/.secrets}"
  fi
}

# Scaffold a domain's per-domain store so a WRITE lands there (not the flat
# fallback) even on the very first command — secrets::path only returns the
# per-domain path once the dir exists, so create it first when --domain is given.
# `if` (not `&&`) keeps it a set -e-safe no-op when no domain is in context.
secrets::_ensure_store() {
  if [[ -n "${domain}" && -d "${PATH_CLUSTERS}/${domain}" ]]; then
    mkdir -p "${PATH_CLUSTERS}/${domain}/secrets"
  fi
}

# ── Init ─────────────────────────────────────────────────

secrets::init() {
  local ssh_key="${LOK8S_SSH_KEY}"
  local -a args=(
    'ssh-key|k'  'Path to SSH public key'
    "${args[@]:-}"
  )
  :args "Initialize SOPS/age encryption" "${@}"

  command -v ssh-to-age &>/dev/null || {
    error "ssh-to-age not found — install via: b install"
    return 1
  }
  command -v sops &>/dev/null || {
    error "sops not found — install via: b install"
    return 1
  }

  [[ -f "${ssh_key}" ]] || {
    error "SSH public key not found: ${ssh_key}"
    error "Generate one with: ssh-keygen -t ed25519"
    return 1
  }

  local age_pubkey
  age_pubkey=$(ssh-to-age < "${ssh_key}") || {
    error "Failed to derive age public key from ${ssh_key}"
    error "Only ed25519 SSH keys are supported"
    return 1
  }

  local sops_config="${PATH_BASE}/.sops.yaml"

  if [[ -f "${sops_config}" ]]; then
    # Check if this key is already present
    if grep -qF "${age_pubkey}" "${sops_config}"; then
      echo "age key already configured in .sops.yaml"
      return 0
    fi
    warn ".sops.yaml exists but doesn't contain this key"
    warn "Add it with: lo secrets add-key ${ssh_key}"
    echo "Your age public key: ${age_pubkey}"
    return 0
  fi

  cat > "${sops_config}" <<YAML
# SOPS encryption config for lok8s secret cache files.
# Recipients are age public keys derived from SSH keys via ssh-to-age.
# Add team members with: lo secrets add-key <ssh-pubkey-path|age1…>
creation_rules:
  - path_regex: 'Secret\..*'
    age: '${age_pubkey}'
YAML

  echo "Created ${sops_config}"
  echo "Age public key: ${age_pubkey}"
  echo "Derived from: ${ssh_key}"

  # Ensure secrets directory exists with a .gitignore that blocks
  # everything except SOPS-encrypted .enc files.
  secrets::_ensure_store
  local secrets_dir
  secrets_dir=$(secrets::path)
  mkdir -p "${secrets_dir}"
  secrets::_ensure_gitignore "${secrets_dir}"
}

# ── Add key ──────────────────────────────────────────────

# secrets::add-key <ssh-pubkey-path|age-pubkey>
#
# Add a recipient to .sops.yaml and re-key every cache file so they can actually
# read it. Both halves are required: appending the key alone leaves the new
# recipient unable to decrypt ANYTHING, because sops only rewrites a file's
# recipients when that file is re-encrypted.
#
# Was documented before it was implemented (issue #73). The manual equivalent —
# edit .sops.yaml, `touch` every plaintext twin (secrets::encrypt skips files
# whose .enc is newer, so a recipient change re-encrypts nothing), then encrypt
# per domain — is exactly what this removes.
#
# FAILS CLOSED on an orphan: an `.enc` with no decrypted twin cannot be re-keyed
# here, and silently leaving it behind is the worst outcome — the new recipient
# would appear to be added while some secrets stayed unreadable to them. Decrypt
# first, or pass --skip-orphans to accept the gap knowingly.
#
# The argument check and the re-key steps are the helpers below, which
# secrets::remove-key shares (the Go twin pins this command's output in
# internal/secrets/rekey_test.go).
secrets::add-key() {
  local key="" all=0 skip_orphans=0
  local -a args=(
    'key'              'SSH public key path, or an age public key (age1…)'
    'all|a:+'          'Re-key every domain store, not just the current one'
    'skip-orphans|:+'  'Proceed even if some .enc files have no decrypted twin'
    "${args[@]:-}"
  )
  # Before :args, which prints an argument it rejects.
  secrets::_no_private_key "${@}" || return 1
  :args "Add an age recipient and re-key the secret store" "${@}"

  command -v sops &>/dev/null || { error "sops not found — install via: b install"; return 1; }
  # The re-key encrypts: before the first write (the lock file), a mv that
  # takes -T.
  local mv_t=""
  secrets::_mv_t || return 1

  local age_pubkey=""
  secrets::_recipient "${key}" || return 1

  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "${sops_config} not found — run: lo secrets init"
    return 1
  }
  # The file that the lock, the reads and the write use, resolved once
  # (secrets::_config_dest).
  local dest=""
  secrets::_config_dest "${sops_config}" || return 1
  # One run at a time, from this read to the last encrypt.
  secrets::_lock "${dest}" || return 1

  if grep -qF "${age_pubkey}" "${dest}"; then
    echo "recipient already present in .sops.yaml — nothing to add"
    echo "  ${age_pubkey}"
    return 0
  fi

  # Before the first write: the store of the current domain must resolve,
  # with --all too, because the encrypt below re-keys that store. Found
  # after the write, a store that does not resolve stopped the run with the
  # recipient in .sops.yaml, and a rerun found it present and re-keyed
  # nothing. secrets::path says why (Go twin: encryptTargets).
  #
  # Then each .enc that the encrypt below writes must be a regular file or
  # absent (secrets::_encrypt_file refuses any other entry, and that refusal
  # comes after the write). The list is the one of the sweep
  # (secrets::_sweep_files), and the encrypt below reads this same list: it
  # does not list the store again. So a file that the run itself makes
  # readable (a plaintext link to the .gitignore that the encrypt writes) is
  # not encrypted.
  local store="" plain
  local -a targets=() sweep=()
  store="$(secrets::path)" || {
    error "  add-key did not change .sops.yaml: create that directory, or select a domain that has a store, then run this command again"
    return 1
  }
  secrets::_sweep_files "${store}" 'Secret.*'
  for plain in "${sweep[@]}"; do
    targets+=("${plain}.enc")
  done
  secrets::_enc_paths "${targets[@]}" || return 1

  # Append to every creation rule's age list (comma-separated, sops' own format).
  # sed prints the edit and secrets::_replace writes it to dest: a .sops.yaml
  # that is a symlink stays a link, and the file that it names gets the edit
  # (sed -i puts a regular file in the place of the link). The x keeps the
  # trailing newlines.
  local before after edited
  before=$(grep -c "age:" "${dest}")
  edited="$(sed -E "s|^([[:space:]]*age:[[:space:]]*')([^']*)(')|\1\2,${age_pubkey}\3|" "${dest}" && printf x)" || return 1
  secrets::_replace "${dest}" "${edited%x}" || return 1
  after=$(grep -cF "${age_pubkey}" "${dest}")
  (( after >= 1 )) || {
    error "failed to add the recipient to ${sops_config} — is the age: line quoted with '?"
    return 1
  }
  echo "added recipient to .sops.yaml (${before} creation rule(s))"
  echo "  ${age_pubkey}"

  # Re-key the stores. Without this the recipient is listed but holds nothing.
  local -a stores=() orphan_list=() unreadable=()
  secrets::_rekey_stores "${all}" || return 1
  # Every domain store is a path it cannot read (Go twin: AddKey).
  (( ${#stores[@]} )) || { error "no secret store found to re-key"; return 1; }
  secrets::_orphans "${stores[@]}"
  if (( ${#orphan_list[@]} > 0 )) && ! (( skip_orphans )); then
    error "${#orphan_list[@]} encrypted file(s) have no decrypted twin — they would keep the OLD"
    error "  recipient list while .sops.yaml claims the new key was added."
    error "  Run 'lo secrets decrypt' first, or re-run with --skip-orphans to accept it."
    return 1
  fi

  local rekeyed=0
  secrets::_touch_plaintexts "${stores[@]}" || return 1
  echo "re-keying ${rekeyed} cache file(s) across ${#stores[@]} store(s)…"
  # No --name on purpose: a re-key rewrote every cache file in every store, so
  # the whole store is exactly what must be re-encrypted here. The sweep is
  # the list checked before the write (Go twin: encryptChecked).
  secrets::_encrypt_store "${store}" "" list "${sweep[@]}" || return 1
  echo "done — commit .sops.yaml and the updated .enc files together"
}

# ── Re-key helpers (add-key, remove-key) ─────────────────
#
# Each helper fills a variable of its caller (argsh's dynamic scope) and
# returns 1 after its own error line. They run with errexit off when the caller
# writes `helper || return 1`, so every step that can fail has its own check.

# secrets::_is_private_key <arg> — true when the argument has the shape of a
# private key: an age identity (in either case, because bech32 allows both), a
# PEM or OpenSSH private key block, or the first line of any PEM block (an
# unquoted paste splits the block into words, and the first one is
# "-----BEGIN").
secrets::_is_private_key() {
  case "${1}" in
    *AGE-SECRET-KEY-*|*age-secret-key-*|*"PRIVATE KEY"*|*-----BEGIN*) return 0 ;;
  esac
  return 1
}

# secrets::_no_private_key <arg>... — refuses when an argument has the shape of
# a private key, and never prints it. add-key and remove-key run it on "$@"
# before :args, which prints an argument it rejects.
secrets::_no_private_key() {
  local a
  for a in "${@}"; do
    secrets::_is_private_key "${a}" || continue
    error "the key argument looks like a private key — it is not printed"
    error "pass an age public key (age1…) or the path to an ed25519 SSH public key"
    return 1
  done
  return 0
}

# secrets::_config_dest <sops_config> — sets the caller's dest to the file that
# add-key and remove-key lock, read and write, resolved once for the run (Go
# twin: sopsConfigDest): <sops_config> itself, or, for a symlink, the file at
# the end of all its links (readlink -f). The lock sits beside that file and
# secrets::_replace writes it, so the lock and the write cannot name two
# files, and two links to one file take one lock. A path that does not
# resolve to a regular file is refused: the check before it refuses such a
# path, so only a change during the run gets there. The lock never falls
# back to the side of the link. The x keeps a newline at the end of the
# name, which the command substitution would drop.
secrets::_config_dest() {
  dest="${1}"
  if [[ -L "${1}" ]]; then
    dest="$(readlink -f -- "${1}" && printf x)" || dest=""
    dest="${dest%x}"
    dest="${dest%$'\n'}"
  fi
  if [[ -z "${dest}" || -L "${dest}" || ! -f "${dest}" ]]; then
    error "${1} does not resolve to a regular file — nothing was changed; run this command again"
    return 1
  fi
}

# secrets::_lock <dest> — takes the lock of .sops.yaml for the rest of the
# run: flock(1) on <dest>.lock, the file the Go twin locks with flock(2)
# (internal/secrets/lock.go). <dest> is the file that secrets::_config_dest
# resolved. The descriptor stays open, and so the lock held, until lo exits.
# LO_SECRETS_LOCK_WAIT sets the wait in seconds (60 by default, 0 = do not
# wait). Without flock(1) it refuses before any write and makes no lock
# file: a run without the lock can undo another run's change. The Go binary
# locks with flock(2) on every platform.
#
# The lock can sit in the directory of the file that a .sops.yaml link
# names, and another user can write there. So the open never truncates (>>)
# and the run never uses a lock that a link names. A lock path that is not a
# regular file or absent (secrets::_enc_path_ok) is refused before the open,
# with the line of the Go twin. That check and the open are two steps: a
# link put there between them is followed by the open. The open appends and
# writes nothing, so the file that the link names keeps its bytes, and the
# test after the open refuses the run: the opened file must be a regular
# file, and the path must be no link and name that file (Go twin:
# openedPathOK). What stays is an empty file that the open can make through
# a link to a path that does not exist.
secrets::_lock() {
  local lockfile="${1}.lock" wait="${LO_SECRETS_LOCK_WAIT:-}" lockfd
  [[ "${wait}" =~ ^[0-9]+$ ]] || wait=60
  command -v flock &>/dev/null || {
    error "flock not found — add-key and remove-key do not run without the lock of .sops.yaml; nothing was changed"
    error "  install flock, or use the lo binary: it locks on every platform"
    return 1
  }
  secrets::_enc_path_ok "${lockfile}" || {
    error "${lockfile} is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: nothing was changed — remove it, then run this command again"
    return 1
  }
  { exec {lockfd}>>"${lockfile}"; } 2>/dev/null || {
    error "cannot open the lock file ${lockfile} — the lock goes beside the file that .sops.yaml names, so lo needs write access to ${lockfile%/*}; nothing was changed"
    return 1
  }
  if [[ ! -f "/dev/fd/${lockfd}" || -L "${lockfile}" || ! "/dev/fd/${lockfd}" -ef "${lockfile}" ]]; then
    exec {lockfd}>&-
    error "${lockfile} is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: nothing was changed — remove it, then run this command again"
    return 1
  fi
  flock -w "${wait}" "${lockfd}" || {
    error "${lockfile} is held by another lo secrets add-key or remove-key — nothing was changed; run it again when that one ends"
    return 1
  }
}

# secrets::_replace <file> <content> — writes the content to <file>, the file
# that secrets::_config_dest resolved, through a temp file in the same
# directory and a rename, so no reader sees half a file. The new file keeps
# the mode of the old one. It does not resolve <file> again: the caller took
# the lock beside it and read it (Go twin: replaceFile). The rename takes -T
# (secrets::_rename_onto): it replaces a link at <file> instead of writing
# through it, and never moves the temp file into a directory.
secrets::_replace() {
  local file="${1}" tmp mv_t=""
  secrets::_mv_t || return 1
  tmp="$(mktemp "${file}.tmp-XXXXXX")" || return 1
  if cp -p -- "${file}" "${tmp}" && printf '%s' "${2}" > "${tmp}" && secrets::_rename_onto "${mv_t}" "${tmp}" "${file}"; then
    return 0
  fi
  rm -f -- "${tmp}"
  return 1
}

# secrets::_recipient <key> — sets the caller's age_pubkey: the age public key
# as given, or the one derived from an ed25519 SSH public key file.
secrets::_recipient() {
  local key="${1}"
  # Before any message that prints the argument: the not-a-file error below
  # echoes it, and for a pasted private key that is key material.
  secrets::_no_private_key "${key}" || return 1

  # Accept an age key directly, or derive one from an SSH public key.
  if [[ "${key}" == age1* ]]; then
    age_pubkey="${key}"
  else
    [[ -f "${key}" ]] || {
      error "not an age key and not a readable file: ${key}"
      error "pass an age public key (age1…) or the path to an ed25519 SSH public key"
      return 1
    }
    command -v ssh-to-age &>/dev/null || { error "ssh-to-age not found — install via: b install"; return 1; }
    # 2>/dev/null: ssh-to-age echoes its ENTIRE input on failure, which for a
    # mistakenly-passed PRIVATE key would print the key material (see
    # tests/unit/secret_material_containment_test.bats).
    age_pubkey=$(ssh-to-age < "${key}" 2>/dev/null) || {
      error "could not derive an age key from ${key}"
      error "only ed25519 SSH keys are supported, and it must be the PUBLIC key"
      return 1
    }
  fi

  # bech32 age public key. Validated because a typo here is silent: sops accepts
  # the config and every later encrypt writes a recipient nobody holds.
  [[ "${age_pubkey}" =~ ^age1[023456789acdefghjklmnpqrstuvwxyz]{58}$ ]] || {
    error "not a valid age public key: ${age_pubkey}"
    return 1
  }
}

# secrets::_lstat <path> — returns 0 when lstat finds the path (a dangling
# symlink included), 1 when the path does not exist (ENOENT: the path, or a
# directory on the way, is missing), and 2 when it cannot tell: a directory on
# the way that it cannot search, or that is not a directory (Go twin:
# statPath). A caller that gets 0 still checks for a symlink whose target it
# cannot stat ([[ -L p && ! -e p ]]): that path is not absent.
secrets::_lstat() {
  local p="${1}" dir rc=0
  [[ ! -L "${p}" && ! -e "${p}" ]] || return 0
  dir="$(dirname -- "${p}")"
  [[ "${dir}" != "${p}" ]] || return 2
  if [[ -d "${dir}" && -x "${dir}" ]]; then
    return 1
  fi
  secrets::_lstat "${dir}" || rc=$?
  (( rc != 1 )) || return 1
  return 2
}

# secrets::_domain_stores — fills the caller's domain_paths with every
# clusters/<domain>/secrets directory, in glob order, and the caller's
# domain_unreadable with the paths on the way that it cannot read: the
# clusters directory, a domain entry whose symlink target it cannot stat, a
# store path that it cannot lstat (a domain directory it cannot search) or
# whose symlink target it cannot stat (Go twin: domainStores). Each unreadable
# path is in domain_paths too. A path that does not exist is skipped, as the
# glob skips it.
secrets::_domain_stores() {
  local clusters="${PATH_CLUSTERS}" d s rc=0
  secrets::_lstat "${clusters}" || rc=$?
  (( rc != 1 )) || return 0
  if (( rc == 2 )) || [[ -L "${clusters}" && ! -e "${clusters}" ]] \
    || { [[ -d "${clusters}" ]] && [[ ! -r "${clusters}" || ! -x "${clusters}" ]]; }; then
    domain_paths+=("${clusters}")
    domain_unreadable+=("${clusters}")
    return 0
  fi
  [[ -d "${clusters}" ]] || return 0
  for d in "${clusters}"/*; do
    if [[ -L "${d}" && ! -e "${d}" ]]; then
      domain_paths+=("${d}")
      domain_unreadable+=("${d}")
      continue
    fi
    [[ -d "${d}" ]] || continue
    s="${d}/secrets"
    rc=0
    secrets::_lstat "${s}" || rc=$?
    case "${rc}" in
      1) continue ;;
      0) if [[ -d "${s}" ]]; then
           domain_paths+=("${s}")
           continue
         fi
         [[ -L "${s}" && ! -e "${s}" ]] || continue ;;
    esac
    domain_paths+=("${s}")
    domain_unreadable+=("${s}")
  done
  return 0
}

# secrets::_rekey_stores <all> — fills the caller's stores: with all=1 every
# clusters/<domain>/secrets directory (never the flat store), and the caller's
# unreadable with the domain paths it cannot read (secrets::_domain_stores);
# else the store of the current context. remove-key refuses an unreadable
# path; add-key, which wrote .sops.yaml before this step, does not read them.
# When it can read no store and found paths it cannot read, it keeps those
# paths and returns 0, so that remove-key names them in its refusal; add-key
# then stops with "no secret store found to re-key", as before.
secrets::_rekey_stores() {
  local all="${1}" s
  if (( all )); then
    local -a domain_paths=() domain_unreadable=()
    secrets::_domain_stores
    for s in "${domain_paths[@]}"; do
      if secrets::_selected "${s}" "${domain_unreadable[@]}"; then
        unreadable+=("${s}")
      else
        stores+=("${s}")
      fi
    done
  else
    s="$(secrets::path)" || return 1
    stores+=("${s}")
  fi
  (( ${#stores[@]} + ${#unreadable[@]} )) || { error "no secret store found to re-key"; return 1; }
}

# secrets::_orphans <store>... — warns about each Secret.*.enc without a
# decrypted twin, which a re-key cannot rewrite, and adds it to the caller's
# orphan_list.
secrets::_orphans() {
  local store enc
  for store in "${@}"; do
    for enc in "${store}"/Secret.*.enc; do
      [[ -e "${enc}" ]] || continue
      if [[ ! -f "${enc%.enc}" ]]; then
        warn "orphan (no decrypted twin, cannot re-key): ${enc#"${PATH_BASE}/"}"
        orphan_list+=("${enc}")
      fi
    done
  done
  return 0
}

# secrets::_touch_plaintexts <store>... — touches every plaintext cache file and
# counts it in the caller's rekeyed.
secrets::_touch_plaintexts() {
  local store plain
  for store in "${@}"; do
    for plain in "${store}"/Secret.*; do
      [[ -e "${plain}" && "${plain}" != *.enc ]] || continue
      # The freshness skip in secrets::encrypt is keyed on mtime, and a recipient
      # change does not touch the plaintext — so nudge it, which is exactly the
      # manual step this command exists to remove.
      touch "${plain}" || return 1
      rekeyed=$((rekeyed + 1))
    done
  done
  return 0
}

# secrets::_enc_paths <enc>... — refuses each .enc of the list that the
# encrypt refuses (secrets::_enc_path_ok: a symlink, a directory, a FIFO, a
# socket or a device, or a path whose lookup fails for a reason other than
# "does not exist"), before the first write (Go twin: refuseEncPaths). The
# re-key writes each .enc in place, and secrets::_encrypt_file refuses such
# an entry, so one in the list would stop the run after .sops.yaml was
# written. A rerun of remove-key would then stop at the same file, and a
# rerun of add-key would find the recipient present and re-key nothing. The
# last line names what was refused: links, other entries, or both.
secrets::_enc_paths() {
  local enc links=0 others=0
  for enc in "${@}"; do
    ! secrets::_enc_path_ok "${enc}" || continue
    if [[ -L "${enc}" ]]; then
      error "${enc#"${PATH_BASE}/"} is a symlink: the re-key does not write an .enc through a link"
      links=$((links + 1))
    elif [[ -e "${enc}" ]]; then
      error "${enc#"${PATH_BASE}/"} is not a regular file (a directory, a FIFO, a socket or a device): the re-key does not write an .enc there"
      others=$((others + 1))
    else
      error "${enc#"${PATH_BASE}/"} cannot be looked up (an error other than \"no such file or directory\", for example a name that is too long): the re-key does not write an .enc there"
      others=$((others + 1))
    fi
  done
  if (( links + others == 0 )); then
    return 0
  fi
  if (( others == 0 )); then
    error "  replace each link with the file it names, or remove it from the store, then run this command again; nothing was written"
  elif (( links == 0 )); then
    error "  remove or fix each entry named above, then run this command again; nothing was written"
  else
    error "  replace each link with the file it names, and remove or fix each other entry, then run this command again; nothing was written"
  fi
  return 1
}

# secrets::_encs_with <recipient> <store>... — reads the sops metadata of every
# Secret.*.enc of the stores (Go twin: scanEncs): adds each to the caller's
# all_encs, each whose metadata lists the recipient to listed, each store or
# file it cannot stat or read to unreadable (a dangling symlink included), each
# file whose metadata does not parse or lists no age recipient to malformed,
# and each file whose metadata holds a member twice to duplicate. sops writes
# each age recipient into a file's metadata, so a file that lists it is a file
# its key can open. The recipients are read from the parsed metadata
# (secrets::_enc_lists) and compared exactly, so a JSON escape in the file
# cannot hide one. A store that does not exist is skipped.
secrets::_encs_with() {
  local recipient="${1}" store enc rc verdict
  shift
  for store in "${@}"; do
    rc=0
    secrets::_lstat "${store}" || rc=$?
    (( rc != 1 )) || continue
    if (( rc == 2 )) || [[ ! -d "${store}" || ! -r "${store}" || ! -x "${store}" ]]; then
      unreadable+=("${store}")
      continue
    fi
    for enc in "${store}"/Secret.*.enc; do
      if [[ -L "${enc}" && ! -e "${enc}" ]]; then
        unreadable+=("${enc}")
        continue
      fi
      [[ -f "${enc}" ]] || continue
      all_encs+=("${enc}")
      rc=0
      grep -q '' -- "${enc}" 2>/dev/null || rc=$?
      if (( rc > 1 )); then
        unreadable+=("${enc}")
        continue
      fi
      verdict="$(secrets::_enc_lists "${recipient}" "${enc}")" || verdict=""
      case "${verdict}" in
        listed) listed+=("${enc}") ;;
        clear) ;;
        duplicate) duplicate+=("${enc}") ;;
        *) malformed+=("${enc}") ;;
      esac
    done
  done
  return 0
}

# secrets::_other_encs <store>... — walks each store, at any depth and dot
# names included, for an entry whose name ends in .enc and that is not a
# managed Secret.*.enc at the top of the store (Go twin: otherEncs), and adds
# it to the caller's other_encs. remove-key re-keys only the managed files, so
# such a copy (a backup.enc, a file in a subdirectory) would keep the removed
# recipient. It adds to the caller's unreadable each directory below a store
# that it cannot list or search, and the store when the walk fails and names
# no such directory. Each list is sorted by byte per store. find -H follows a
# store that is a symlink to a directory and no link below it: a link is an
# entry, never a directory to walk into. A directory named *.enc is walked,
# not listed. A store that it cannot search is left to secrets::_encs_with,
# which names it (or skips it when it does not exist). The temp file of an
# encrypt (secrets::_encrypt_file: .<name>.enc.tmp-XXXXXX) does not end in
# .enc.
secrets::_other_encs() {
  local store s p rel listed bad
  for store in "${@}"; do
    [[ -d "${store}" && -r "${store}" && -x "${store}" ]] || continue
    # find prints <start>/<rel> for a start without a trailing slash.
    s="${store}"
    while [[ "${s}" == */ && "${s}" != / ]]; do
      s="${s%/}"
    done
    listed=0 bad=0
    # The listing ends with the record "listed" when find and sort succeeded;
    # each entry starts with "${s}/".
    while IFS= read -r -d '' p; do
      if [[ "${p}" != "${s}/"* ]]; then
        [[ "${p}" != listed ]] || listed=1
        continue
      fi
      rel="${p#"${s}/"}"
      if [[ -d "${p}" && ! -L "${p}" ]]; then
        if [[ ! -r "${p}" || ! -x "${p}" ]]; then
          unreadable+=("${store}/${rel}")
          bad=1
        fi
      elif [[ "${rel}" == */* || "${rel}" != Secret.*.enc ]]; then
        other_encs+=("${store}/${rel}")
      fi
    done < <(find -H "${s}" -mindepth 1 \( -type d -o -name '*.enc' \) -print0 2>/dev/null | LC_ALL=C sort -z; (( PIPESTATUS[0] == 0 && PIPESTATUS[1] == 0 )) && printf 'listed\0')
    (( listed || bad )) || unreadable+=("${store}")
  done
  return 0
}

# secrets::_enc_lists <recipient> <enc> — prints listed when the sops metadata
# of the .enc lists the recipient, else clear (Go twin: encRecipients). The
# metadata is the JSON envelope of the binary store: the recipient of each
# entry of sops.age and of the age list of each sops.key_groups entry, its
# JSON escapes decoded. It prints nothing and returns 1 when the file is not
# one JSON object with a sops object, when it holds no age entry or one with no
# recipient string, and when a key that the sops metadata decoder matches
# regardless of case is spelled another way ("AGE", "Recipient"; fold maps
# the two letters that Unicode folds to ASCII here, U+017F and U+212A). For a
# file that passes those checks, it prints duplicate when the file holds the
# sops member twice, or an object in the sops value holds a member twice
# (secrets::_enc_duplicate): jq keeps the last of two members, so the first
# one, with the recipients it holds, is not read.
secrets::_enc_lists() {
  local verdict dup
  # shellcheck disable=SC2016 # a jq program: $r and $n are jq variables
  verdict="$(jq -r -s --arg r "${1}" '
    def fold: explode | map(if . == 383 then 115 elif . == 8490 then 107 else . end) | implode | ascii_downcase;
    def field($n): if type != "object" then error("shape")
      elif any(keys_unsorted[]; . != $n and fold == $n) then error("shape")
      else .[$n] end;
    def ages: if . == null then empty
      elif type != "array" then error("shape")
      else .[] | field("recipient") | if type == "string" and . != "" then . else error("shape") end end;
    if length != 1 or (.[0] | type) != "object" then error("shape") else .[0].sops end
    | if type != "object" then error("shape") else . end
    | [ (field("age") | ages),
        (field("key_groups") | if . == null then empty elif type != "array" then error("shape") else .[] | field("age") | ages end) ]
    | if length == 0 then error("shape") elif any(.[]; . == $r) then "listed" else "clear" end' "${2}" 2>/dev/null)" || return 1
  case "${verdict}" in
    listed|clear) ;;
    *) return 1 ;;
  esac
  dup="$(secrets::_enc_duplicate "${2}")" || return 1
  case "${dup}" in
    true) echo duplicate ;;
    false) echo "${verdict}" ;;
    *) return 1 ;;
  esac
}

# secrets::_enc_duplicate <enc> — prints true when the .enc, one JSON object,
# holds the sops member twice or an object in the sops value holds a member
# twice (at the top of the sops value, in a key_groups item, in a recipient
# entry, at any depth), else false (Go twin: metadataDuplicate). It reads the
# stream form of jq (--stream), which keeps every member: a member that comes
# twice repeats the path of a leaf, or comes back under a container that was
# closed or under a path that was a leaf. The other top-level members, the
# data payload among them, are not metadata and are skipped. Returns 1 when
# jq cannot read the file.
secrets::_enc_duplicate() {
  # shellcheck disable=SC2016 # a jq program: $e, $p, $n, $s, $i and $k are jq variables
  jq -n --stream '
    reduce (inputs | select((.[0] | length) > 0 and .[0][0] == "sops")) as $e
      ({closed: {}, leaves: {}, dup: false};
       if .dup then .
       else
         ($e[0]) as $p | ($p | length) as $n | . as $s
         | if any(range(1; $n) as $i | $p[:$i] | tojson; $s.leaves[.] or $s.closed[.]) then .dup = true
           elif ($e | length) == 2 then
             ($p | tojson) as $k
             | if $s.leaves[$k] or $s.closed[$k] then .dup = true else .leaves[$k] = true end
           elif $n > 1 then .closed[$p[:-1] | tojson] = true
           else . end
       end)
    | .dup' "${1}" 2>/dev/null
}

# secrets::_listing <recipient> <store> — sets the caller's n: the .enc files of
# the store that list the recipient, that cannot be read, whose metadata does
# not parse, or whose metadata holds a member twice.
secrets::_listing() {
  local -a listed=() all_encs=() unreadable=() malformed=() duplicate=()
  secrets::_encs_with "${1}" "${2}"
  n=$(( ${#listed[@]} + ${#unreadable[@]} + ${#malformed[@]} + ${#duplicate[@]} ))
}

# secrets::_selected <store> <selected>... — true when the store is one of the
# selected ones.
secrets::_selected() {
  local store="${1}" s
  shift
  for s in "${@}"; do
    [[ "${s}" != "${store}" ]] || return 0
  done
  return 1
}

# secrets::_other_stores <error|warn> <recipient> <selected>... — prints, with
# the given level, one line for each store that this run does not re-key and
# that still lists the recipient: the domain stores it did not select, then
# the flat store, which --all does not re-key either. A path or a file it
# cannot read, and a file whose metadata does not parse, count as one that
# lists it.
secrets::_other_stores() {
  local say="${1}" recipient="${2}" d flat n domains=0
  local -a domain_paths=() domain_unreadable=()
  shift 2
  secrets::_domain_stores
  for d in "${domain_paths[@]}"; do
    ! secrets::_selected "${d}" "${@}" || continue
    n=0
    secrets::_listing "${recipient}" "${d}"
    (( n > 0 )) || continue
    "${say}" "still listed in ${n} .enc file(s) of a store this run did not re-key: ${d#"${PATH_BASE}/"}"
    domains=$((domains + 1))
  done
  (( domains == 0 )) || "${say}" "  rerun with --all to re-key every domain store"
  flat="${PATH_SECRETS:-${PATH_BASE}/.secrets}"
  if [[ -d "${flat}" ]] && ! secrets::_selected "${flat}" "${@}"; then
    n=0
    secrets::_listing "${recipient}" "${flat}"
    (( n == 0 )) || "${say}" "still listed in ${n} .enc file(s) of the flat store, which --all does not re-key: ${flat#"${PATH_BASE}/"}"
  fi
  return 0
}

# secrets::_own_identity <recipient> — sets the caller's own to the file of the
# caller's own decrypt identity that the recipient belongs to: the sops age
# keys file (${SOPS_AGE_KEY_FILE:-~/.config/sops/age/keys.txt}) by its
# "# public key: " lines, or the SSH key lo decrypts with (LOK8S_SSH_KEY) by
# the age key of its .pub. Empty when neither matches. No private key is
# printed or derived. It reads these two sources only, and the scope line
# that remove-key prints on every run says so.
secrets::_own_identity() {
  local recipient="${1}" f pub derived
  f="${SOPS_AGE_KEY_FILE:-${HOME}/.config/sops/age/keys.txt}"
  if [[ -f "${f}" ]] && grep -qxF -- "# public key: ${recipient}" "${f}" 2>/dev/null; then
    own="${f}"
    return 0
  fi
  pub="${LOK8S_SSH_KEY}.pub"
  if [[ -f "${pub}" ]] && command -v ssh-to-age &>/dev/null; then
    derived="$(ssh-to-age < "${pub}" 2>/dev/null)" || derived=""
    [[ "${derived}" != "${recipient}" ]] || own="${pub}"
  fi
  return 0
}

# secrets::_rules_hits <encoded|groups|all> <recipient> — reads .sops.yaml as
# YAML from stdin and sets the caller's hits: how often a creation rule holds
# the recipient. encoded reads each rule's own age key as written, a plain or
# double-quoted string (its escapes decoded) or a YAML list: the values the
# line edit does not rewrite. groups reads the age lists of key_groups, and
# all the age of every rule and of its key groups, both with aliases and
# merge keys resolved. Returns 1 when yq cannot read the input.
secrets::_rules_hits() {
  local view="${1}" sel out
  case "${view}" in
    encoded) sel='.creation_rules[]? | select(tag == "!!map") | to_entries[] | select(.key == "age") | .value | select((tag == "!!str" and style != "single") or tag == "!!seq")' ;;
    groups) sel='explode(.) | .creation_rules[]? | select(tag == "!!map") | .key_groups[]? | .. | select(tag == "!!map") | .age' ;;
    *) sel='explode(.) | .creation_rules[]? | select(tag == "!!map") | (.age, (.key_groups[]? | .. | select(tag == "!!map") | .age))' ;;
  esac
  out="$(RCPT="${2}" yq --yaml-fix-merge-anchor-to-spec "[ ${sel} | [.] | flatten | .[] | select(tag == \"!!str\") | split(\",\") | .[] | trim | select(. == strenv(RCPT)) ] | length" - 2>/dev/null)" || return 1
  out="${out:-0}"
  [[ "${out}" =~ ^[0-9]+$ ]] || return 1
  hits="${out}"
}

# secrets::_rules_form — reads .sops.yaml as YAML from stdin and sets the
# caller's form (Go twin: yamlFormCheck): tag when a node under creation_rules
# (aliases and merge keys resolved) carries an explicit tag other than !!str,
# !!seq or !!map, key when a mapping anywhere in the file has a key that is not
# a string (an int, a bool or a null key, implicit or not), else ok. Refuse, do
# not interpret: yq and the Go YAML read such a value or mapping differently.
# yq gives a tagged plain node the style "tagged", and a tagged node that is
# also quoted or in flow style no style it names: a style outside the six
# untagged ones marks an explicit tag. Returns 1 when yq cannot read the
# input.
secrets::_rules_form() {
  local out
  # shellcheck disable=SC2016 # a yq program: $d, $tags and $keys are yq variables
  out="$(yq --yaml-fix-merge-anchor-to-spec '
    explode(.) as $d
    | ([ $d | .creation_rules | .. | select((style | test("^(|double|single|literal|folded|flow)$") | not)
           and tag != "!!str" and tag != "!!seq" and tag != "!!map") ] | length) as $tags
    | ([ $d | .. | select(kind == "map") | keys[] | select(tag != "!!str") ] | length) as $keys
    | if $tags > 0 then "tag" elif $keys > 0 then "key" else "ok" end' - 2>/dev/null)" || return 1
  case "${out}" in
    ok|tag|key) form="${out}" ;;
    *) return 1 ;;
  esac
}

# secrets::_rules_check <enc>... — reads the creation rules from stdin and
# matches the plaintext twin of each .enc file against them, the way sops does
# when it encrypts: the path relative to the directory of .sops.yaml, the first
# rule whose path_regex matches. Adds the files that match no rule to the
# caller's none_list, those whose rule has a recipient that is not age to
# notage_list (this check follows the age-only Go twin), and those whose rule
# has an age recipient that does not parse to badage_list. Returns 1 when yq
# cannot read the rules.
#
# The age recipients are read as sops reads them: with key_groups, each item
# of each group's age list (split on ","); without, the rule's age string
# (split on ",", empty parts dropped) or list (joined with ","). The Go twin
# parses each one; here each must have the shape of its type, in sops' order:
# age1pq1… (post-quantum), age1<plugin>1… (a plugin), age1 + 58 bech32
# characters (X25519), ssh-ed25519 or ssh-rsa. The shape check does not test
# the bech32 checksum.
#
# The paths go to yq as one JSON array (jq builds it), one item per path: a
# file name can hold a newline, and an environment variable cannot hold the
# NUL byte that would separate them.
secrets::_rules_check() {
  local enc out i files
  local -a status=() rels=()
  (( ${#} )) || return 0
  for enc in "${@}"; do
    enc="${enc%.enc}"
    rels+=("${enc#"${PATH_BASE}/"}")
  done
  # shellcheck disable=SC2016 # a jq program: $ARGS is a jq variable
  files="$(jq -cn '$ARGS.positional' --args -- "${rels[@]}")" || return 1
  # shellcheck disable=SC2016 # a yq program: $rules, $f, $r, $groups and the other $ names are yq variables
  out="$(FILES="${files}" yq --yaml-fix-merge-anchor-to-spec '
    explode(.) | (.creation_rules // []) as $rules
    | strenv(FILES) | from_json | .[] | . as $f
    | ([ $rules[] | select(tag == "!!map") | select((.path_regex // "") as $re | $f | test($re)) ] | .[0]) as $r
    | ([ $r | .key_groups[]? ] | length) as $groups
    | ([ $r | (.pgp, .kms, .gcp_kms, .hckms, .azure_keyvault, .hc_vault_transit_uri)
         | select((tag == "!!seq" and length > 0) or (tag == "!!str" and ([split(",") | .[] | trim | select(. != "")] | length) > 0)) ] | length) as $flat
    | ([ $r | .key_groups[]? | .. | select(tag == "!!map") | (.pgp, .kms, .gcp_kms, .hckms, .azure_keyvault, .hc_vault)
         | select(tag == "!!seq" and length > 0) ] | length) as $grouped
    | (if $groups > 0 then
         [ $r | .key_groups[]? | .. | select(tag == "!!map") | .age | select(tag != "!!null")
           | if tag == "!!seq" then (.[] | if tag == "!!str" then (select(. != "") | split(",") | .[] | trim) else "-" end) else "-" end ]
       else
         [ $r | .age | select(tag != "!!null")
           | if tag == "!!str" then (split(",") | .[] | trim | select(. != ""))
             elif tag == "!!seq" then (if ([.[] | select(tag != "!!str")] | length) > 0 then "-" else (join(",") | select(. != "") | split(",") | .[] | trim) end)
             else "-" end ]
       end) as $parts
    | ([ $parts[] | select((
           if test("^age1pq1") then test("^age1pq1[023456789acdefghjklmnpqrstuvwxyz]+$")
           elif test("^age1") and (split("1") | length) > 2 then test("^age1[a-z0-9._+-]+1[023456789acdefghjklmnpqrstuvwxyz]+$")
           elif test("^age1") then test("^age1[023456789acdefghjklmnpqrstuvwxyz]{58}$")
           elif test("^ssh-") then test("^ssh-(ed25519|rsa) [A-Za-z0-9+/]+=*( .*)?$")
           else false end) | not) ] | length) as $badage
    | if ($r | tag) != "!!map" then "none"
      elif $groups > 0 and $grouped > 0 then "nonage"
      elif $badage > 0 then "badage"
      elif $groups == 0 and $flat > 0 then "nonage"
      else "ok" end' - 2>/dev/null)" || return 1
  mapfile -t status <<< "${out}"
  (( ${#status[@]} == ${#} )) || return 1
  local -a encs=("${@}")
  for i in "${!encs[@]}"; do
    case "${status[i]}" in
      ok) ;;
      none) none_list+=("${encs[i]}") ;;
      nonage) notage_list+=("${encs[i]}") ;;
      badage) badage_list+=("${encs[i]}") ;;
      *) return 1 ;;
    esac
  done
  return 0
}

# secrets::_drop_recipient <file> <recipient> — sets the caller's edited (the
# file with the recipient removed from every single-quoted age list), rules
# (the creation rules that listed it) and last (those of them that list no
# other recipient). Only a line that listed it is rewritten: its other
# recipients joined with "," and no blanks, the rest of the line kept. Every
# line of edited ends in a newline.
secrets::_drop_recipient() {
  local file="${1}" recipient="${2}" line r found joined
  local head body close rest
  local re="^([[:space:]]*age:[[:space:]]*')([^']*)(')(.*)\$"
  local -a list kept
  edited="" rules=0 last=0
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${re} ]]; then
      head="${BASH_REMATCH[1]}" body="${BASH_REMATCH[2]}"
      close="${BASH_REMATCH[3]}" rest="${BASH_REMATCH[4]}"
      found=0 kept=()
      IFS=',' read -r -a list <<< "${body}"
      for r in "${list[@]}"; do
        r="${r#"${r%%[![:blank:]]*}"}"
        r="${r%"${r##*[![:blank:]]}"}"
        if [[ "${r}" == "${recipient}" ]]; then
          found=1
        elif [[ -n "${r}" ]]; then
          kept+=("${r}")
        fi
      done
      if (( found )); then
        rules=$((rules + 1))
        (( ${#kept[@]} )) || last=$((last + 1))
        printf -v joined '%s,' "${kept[@]}"
        line="${head}${joined%,}${close}${rest}"
      fi
    fi
    edited+="${line}"$'\n'
  done < "${file}"
  return 0
}

# secrets::_rekey_files <store>... — re-encrypts each .enc file of the caller's
# rekey list from its plaintext twin, whatever the timestamps say, and prints
# a count per store as secrets::encrypt does (Go twin: rekeyFiles). Each new
# .enc is the newer file of its pair, as after secrets::encrypt, so a later
# encrypt sweep skips it and the lint check does not name it.
secrets::_rekey_files() {
  local store enc plain count
  for store in "${@}"; do
    count=0
    for enc in "${rekey[@]}"; do
      [[ "${enc%/*}" == "${store}" ]] || continue
      plain="${enc%.enc}"
      secrets::_encrypt_file "${plain}" || return 1
      # A plaintext dated in the future stays the newer file: date the .enc
      # one second after it (Go twin: nudgeNewer, one microsecond).
      [[ "${enc}" -nt "${plain}" ]] || touch -c -r "${plain}" -d '+1 second' -- "${enc}" 2>/dev/null || true
      count=$((count + 1))
    done
    (( count == 0 )) || echo "Encrypted ${count} secret(s)"
  done
  return 0
}

# secrets::_twin_matches <enc> — returns 0 when the .enc, decrypted in memory
# with the caller's identity (secrets::decrypt_entry), holds the bytes of its
# decrypted twin, 1 when it holds other bytes, 2 when it does not decrypt and
# 3 when the twin cannot be read (Go twin: twinsMatch). The decrypted value
# goes through a pipe into cmp only, never into a variable, an argument or a
# file, and the two tracing lines of utils/keysonly.sh keep the run out of a
# trace. The reader after cmp drains the pipe, so that a cmp that stops at
# the first difference does not end the decrypt with SIGPIPE.
# The reader is a subshell, not a { } group: with lastpipe on (for example
# from BASHOPTS in the environment) a group runs in this shell, and its exit
# would end the whole command with the status of the first compare.
secrets::_twin_matches() {
  [[ $- != *[TE]* || -n ${_ko_at-} ]] || { local - _ko_traps _ko_rc _ko_s _ko_at="${#FUNCNAME[@]}"; _ko_traps="$(trap -p DEBUG RETURN ERR)"; trap - DEBUG RETURN ERR; set +xT -E; trap '_ko_s=$?; [[ $- != *e* ]] || { (( ${#FUNCNAME[@]} > ${_ko_at:-0} )) || { trap - DEBUG RETURN ERR; eval "${_ko_traps-}"; }; return "${_ko_s}"; }' ERR; "${FUNCNAME[0]}" "$@"; _ko_rc=$?; trap - DEBUG RETURN ERR; eval "${_ko_traps}"; return "${_ko_rc}"; }
  [[ $- != *x* ]] || { local -; set +x; }
  local -a rcs=()
  {
    secrets::decrypt_entry "${1}" 2>/dev/null | ( rc=0; cmp -s - "${1%.enc}" 2>/dev/null || rc=$?; cat >/dev/null; exit "${rc}" )
    rcs=("${PIPESTATUS[@]}")
  } || true
  (( ${rcs[0]:-1} == 0 )) || return 2
  case "${rcs[1]:-2}" in
    0) return 0 ;;
    1) return 1 ;;
  esac
  return 3
}

# secrets::_twins_match <enc>... — before the first write, compares each .enc
# with its decrypted twin (secrets::_twin_matches; Go twin: twinsMatch). The
# re-key encrypts the twin, so a twin that holds another value would replace
# the value of the .enc. It names each .enc that differs from its twin and
# each that it cannot decrypt, and each twin that it cannot read, and returns
# 1 when a file does not match.
secrets::_twins_match() {
  local enc plain rc bad=0
  for enc in "${@}"; do
    rc=0 plain="${enc%.enc}"
    secrets::_twin_matches "${enc}" || rc=$?
    case "${rc}" in
      0) continue ;;
      1) error "${enc#"${PATH_BASE}/"} differs from its decrypted twin: run lo secrets decrypt for this store, or encrypt the twin first" ;;
      2) error "cannot decrypt ${enc#"${PATH_BASE}/"} to compare it with its twin" ;;
      *) error "cannot read ${plain#"${PATH_BASE}/"}" ;;
    esac
    bad=$((bad + 1))
  done
  if (( bad > 0 )); then
    error "  the re-key encrypts each twin, so a twin that differs would replace the value of its .enc (lo secrets decrypt keeps a twin that is newer than its .enc: to take the .enc value, remove that twin first). Nothing was written."
    return 1
  fi
  return 0
}

# secrets::_rerun <recipient> — prints the command that resumes a re-key that
# stopped after the .sops.yaml write (the caller's domain, all, skip_orphans).
secrets::_rerun() {
  local cmd="lo secrets remove-key ${1}"
  [[ -z "${domain:-}" ]] || cmd+=" --domain ${domain}"
  ! (( all )) || cmd+=" --all"
  ! (( skip_orphans )) || cmd+=" --skip-orphans"
  error "the re-key did not finish. .sops.yaml no longer lists the recipient, and running the same command again, with an identity that decrypts every file, resumes it:"
  error "  ${cmd}"
}

# secrets::_rm_summary <rules> <listed> <rekeyed> <orphans> — prints the
# summary of a remove-key run that ended (Go twin: removeKeySummary): the
# creation rules that changed, the .enc files whose labels listed the
# recipient, and the .enc files that the run re-keyed, which are every managed
# .enc of the selected stores but the orphans that --skip-orphans accepted.
secrets::_rm_summary() {
  echo "${1} creation rule(s) changed"
  echo "${2} .enc file(s) listed the recipient in their labels"
  echo "${3} .enc file(s) re-keyed with a new data key"
  if (( ${4} > 0 )); then
    echo "done — every managed .enc of the selected stores but ${4} orphan(s) was rewritten: commit them together with .sops.yaml"
    return 0
  fi
  echo "done — every managed .enc of the selected stores was rewritten: commit them together with .sops.yaml"
}

# secrets::_post_check <recipient> <store>... — reads the stores again after
# the re-key, with the reads and the walk of the check before the first write
# (secrets::_encs_with, secrets::_other_encs), and returns 1 when the files do
# not pass (Go twin: postCheck). It fails on a path that it cannot read (a
# store, an .enc, a directory below a store), an .enc whose sops metadata does
# not parse or holds a member twice, a managed .enc with a decrypted twin that
# still lists the recipient, a managed .enc with a decrypted twin that is not
# in the caller's known list (the run did not re-key it), another .enc, and,
# without the caller's skip_orphans, an .enc with no decrypted twin. Each line
# names the path. With skip_orphans an orphan that lists the recipient is a
# warning. A file that another writer replaced in place under the same name is
# not seen: the stores must be quiet while remove-key runs.
secrets::_post_check() {
  local recipient="${1}" u enc left=0 changed=0 orphans_left=0 bad
  shift
  local -a listed=() all_encs=() unreadable=() malformed=() duplicate=() other_encs=()
  secrets::_encs_with "${recipient}" "${@}"
  secrets::_other_encs "${@}"
  for u in "${unreadable[@]}"; do
    error "cannot read ${u#"${PATH_BASE}/"}"
  done
  for u in "${malformed[@]}"; do
    error "the sops metadata of ${u#"${PATH_BASE}/"} does not parse or lists no age recipient"
  done
  for u in "${duplicate[@]}"; do
    error "the sops metadata of ${u#"${PATH_BASE}/"} holds a duplicate member"
  done
  for enc in "${all_encs[@]}"; do
    if secrets::_selected "${enc}" "${malformed[@]}" "${duplicate[@]}"; then
      continue # named above
    elif [[ ! -f "${enc%.enc}" ]] && (( skip_orphans )); then
      ! secrets::_selected "${enc}" "${listed[@]}" || orphans_left=$((orphans_left + 1))
    elif [[ ! -f "${enc%.enc}" ]]; then
      error "an .enc with no decrypted twin after the re-key: ${enc#"${PATH_BASE}/"}"
      changed=$((changed + 1))
    elif ! secrets::_selected "${enc}" "${known[@]}"; then
      error "a managed .enc that this run did not re-key: ${enc#"${PATH_BASE}/"}"
      changed=$((changed + 1))
    elif secrets::_selected "${enc}" "${listed[@]}"; then
      error "still encrypted to the removed recipient: ${enc#"${PATH_BASE}/"}"
      left=$((left + 1))
    fi
  done
  for u in "${other_encs[@]}"; do
    error "remove-key re-keys only the managed Secret.*.enc files; ${u#"${PATH_BASE}/"} is another .enc file: re-key or remove it by hand, then run again"
    changed=$((changed + 1))
  done
  bad=$(( ${#unreadable[@]} + ${#malformed[@]} + ${#duplicate[@]} ))
  if (( left > 0 || bad > 0 )); then
    error "${left} .enc file(s) still list the removed recipient after the re-key, ${bad} cannot be read or do not parse"
  fi
  if (( changed > 0 )); then
    error "${changed} file(s) of the stores changed during the run: the stores must be quiet while remove-key runs"
  fi
  (( left + bad + changed == 0 )) || return 1
  if (( orphans_left > 0 )); then
    warn "${orphans_left} orphan .enc file(s) still list the removed recipient — its key can still decrypt them"
  fi
  return 0
}

# ── Remove key ───────────────────────────────────────────

# secrets::remove-key <ssh-pubkey-path|age-pubkey>
#
# add-key in reverse: drop a recipient from every creation rule in .sops.yaml,
# then re-key the selected stores so that no managed Secret.*.enc of them lists
# it, an orphan that --skip-orphans accepts the one exception. Two
# differences matter for a removal: every refusal runs before the first write,
# and the re-encryption covers every selected store, not only the current
# context's.
#
# It holds the lock of .sops.yaml for the whole run, and refuses without
# flock. It reads .sops.yaml as YAML too (yq) and refuses a YAML tag under
# creation_rules other than !!str, !!seq or !!map and a mapping key that is
# not a string, and refuses when the recipient is in a value the line edit
# cannot rewrite (an escaped string, a YAML list, a key group, an alias or a
# merge key), when the edit would drop the last recipient of a rule, and when
# an .enc file of the stores matches no creation rule, a rule with a recipient
# that is not age, or a rule with an age recipient that does not parse. It
# refuses a store path or an .enc file it cannot stat or read (a dangling
# symlink included), a managed .enc that it re-keys and that is a symlink
# (the re-key does not write through a link: secrets::_enc_paths), a
# directory below a store that it cannot list or search, a file at any depth of a store whose name ends in .enc and that is
# not a managed Secret.*.enc at its top (the re-key would not rewrite it:
# secrets::_other_encs), an .enc whose sops metadata holds a member twice
# (jq keeps the last one, so the first could hide a recipient), an .enc whose
# sops metadata does not parse or lists no age recipient, and, without
# --skip-orphans, an .enc with no decrypted twin: a re-key cannot rewrite that
# file, so it keeps the removed recipient. Last, it decrypts each file that it
# re-keys, in memory, with the identity of the caller, and refuses a file
# whose twin holds other bytes, a file that it cannot decrypt and a twin that
# it cannot read (secrets::_twins_match): the re-key encrypts the twin, so a
# twin that differs would replace the value of the .enc. The times of the
# files do not count. A recipient that is in no rule and on no .enc label is a warning,
# not a refusal: the run then re-keys every managed .enc and changes no rule.
#
# It re-encrypts every managed .enc of the selected stores from its
# plaintext, an orphan that --skip-orphans accepts the one exception: the
# labels are not trusted to choose the files. Then it reads the stores again
# with the same reads and walk (secrets::_post_check) and fails, with the
# command that resumes the run, when a file still lists it, when a path cannot
# be read, and when a file changed during the run: another .enc, a managed
# .enc with a decrypted twin that the run did not re-key, or, without
# --skip-orphans, an orphan. Each read takes the recipients from the parsed
# sops metadata of the file (jq). Other stores that still list the recipient
# are named in a warning; they are not re-keyed. The last lines count the
# rules that changed, the files whose labels listed the recipient, and the
# files that the run re-keyed (secrets::_rm_summary).
#
# A removal does not revoke what the key already read; the last line says so.
secrets::remove-key() {
  local key="" all=0 skip_orphans=0
  local -a args=(
    'key'              'SSH public key path, or an age public key (age1…)'
    'all|a:+'          'Re-key every domain store, not just the current one'
    'skip-orphans|:+'  'Proceed even if some .enc files have no decrypted twin (they keep the removed recipient)'
    "${args[@]:-}"
  )
  # Before :args, which prints an argument it rejects.
  secrets::_no_private_key "${@}" || return 1
  :args "Remove an age recipient and re-key the secret store

A removal does not revoke what the key already read. Its holder can still
decrypt the older .enc files in the git history, and keeps every value it
decrypted before. Rotate those secrets after the removal." "${@}"

  command -v sops &>/dev/null || { error "sops not found — install via: b install"; return 1; }
  command -v yq &>/dev/null || { error "yq not found — install via: b install"; return 1; }
  command -v jq &>/dev/null || { error "jq not found — install via: b install"; return 1; }
  # The re-key encrypts: before the first write (the lock file), a mv that
  # takes -T.
  local mv_t=""
  secrets::_mv_t || return 1

  local age_pubkey=""
  secrets::_recipient "${key}" || return 1

  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "${sops_config} not found — run: lo secrets init"
    return 1
  }
  # The file that the lock, the reads and the write use, resolved once
  # (secrets::_config_dest).
  local dest=""
  secrets::_config_dest "${sops_config}" || return 1
  secrets::_lock "${dest}" || return 1

  local edited="" rules=0 last=0
  secrets::_drop_recipient "${dest}" "${age_pubkey}" || return 1
  if grep -qF -- "${age_pubkey}" "${dest}" && { (( rules == 0 )) || [[ "${edited}" == *"${age_pubkey}"* ]]; }; then
    error "${sops_config} lists the recipient outside a single-quoted age: list — remove it there by hand"
    error "  ${age_pubkey}"
    return 1
  fi

  # The line edit sees text. Read the YAML too: an escaped letter in a
  # double-quoted string, a YAML list, a key group, an alias or a merge key can
  # hold the recipient where the edit does not look.
  local hits=0 group_hits=0 form=""
  if ! { secrets::_rules_hits groups "${age_pubkey}" < "${dest}" && group_hits="${hits}" \
    && secrets::_rules_hits encoded "${age_pubkey}" < "${dest}" \
    && secrets::_rules_form < "${dest}"; }; then
    error "${sops_config} does not parse as YAML"
    return 1
  fi
  # Refuse, do not interpret: the YAML forms that yq and the Go twin read
  # differently.
  case "${form}" in
    tag)
      error "${sops_config} has a YAML tag under creation_rules other than !!str, !!seq or !!map — remove-key does not read tagged values; remove the tag by hand"
      return 1 ;;
    key)
      error "${sops_config} has a mapping key that is not a string — remove-key does not read such a mapping; quote the key or remove it by hand"
      return 1 ;;
  esac
  if (( group_hits > 0 )); then
    error "${sops_config} lists the recipient in key_groups — remove-key does not edit key groups; remove it there by hand"
    error "  ${age_pubkey}"
    return 1
  fi
  if (( hits > 0 )); then
    error "${sops_config} lists the recipient in an escaped string or a YAML list, which remove-key does not edit — remove it there by hand"
    error "  ${age_pubkey}"
    return 1
  fi
  if (( last > 0 )); then
    error "refusing to remove the last recipient of ${last} creation rule(s) — nothing could decrypt the files they match"
    error "  add another recipient first (lo secrets add-key), or delete the rule by hand"
    return 1
  fi
  # The file as it will be: the edit, or, when no rule listed the recipient (a
  # run that resumes), the file as it is.
  local next="${edited}"
  (( rules > 0 )) || next="$(< "${dest}")"
  secrets::_rules_hits all "${age_pubkey}" <<< "${next}" || {
    error "the edited ${sops_config} does not parse as YAML — nothing was written"
    return 1
  }
  if (( hits > 0 )); then
    error "${sops_config} still lists the recipient after the edit (through an alias or a merge key) — nothing was written; remove it there by hand"
    error "  ${age_pubkey}"
    return 1
  fi

  local -a stores=() listed=() all_encs=() unreadable=() malformed=() duplicate=() orphan_list=() other_encs=()
  secrets::_rekey_stores "${all}" || return 1
  secrets::_encs_with "${age_pubkey}" "${stores[@]}"
  secrets::_other_encs "${stores[@]}"
  local u
  if (( ${#unreadable[@]} > 0 )); then
    for u in "${unreadable[@]}"; do
      error "cannot read ${u#"${PATH_BASE}/"}"
    done
    error "  a file that is not read may still list the recipient — fix the permissions first; nothing was written"
    return 1
  fi
  if (( ${#other_encs[@]} > 0 )); then
    for u in "${other_encs[@]}"; do
      error "remove-key re-keys only the managed Secret.*.enc files; ${u#"${PATH_BASE}/"} is another .enc file: re-key or remove it by hand, then run again"
    done
    error "  an .enc file that is not re-keyed can keep the removed recipient — nothing was written"
    return 1
  fi
  if (( ${#duplicate[@]} > 0 )); then
    for u in "${duplicate[@]}"; do
      error "the sops metadata of ${u#"${PATH_BASE}/"} holds a duplicate member"
    done
    error "  a duplicate member can hide a recipient from this check — re-encrypt those files with sops from their plaintext, then run this command again; nothing was written"
    return 1
  fi
  if (( ${#malformed[@]} > 0 )); then
    for u in "${malformed[@]}"; do
      error "the sops metadata of ${u#"${PATH_BASE}/"} does not parse or lists no age recipient"
    done
    error "  remove-key reads the recipients of each .enc from its sops metadata — fix or restore those files first; nothing was written"
    return 1
  fi
  # The re-key rewrites every managed .enc, so a key in no rule and on no
  # label is not a refusal: the run that resumes a stopped re-key is such a
  # run.
  if (( rules == 0 && ${#listed[@]} == 0 )); then
    warn "${age_pubkey} is in no creation rule and in no .enc label: remove-key re-keys every managed .enc anyway, and changes no rule"
  fi
  secrets::_orphans "${stores[@]}"
  if (( ${#orphan_list[@]} > 0 )) && ! (( skip_orphans )); then
    error "${#orphan_list[@]} encrypted file(s) have no decrypted twin — they would keep the REMOVED"
    error "  recipient, so its key could still decrypt them."
    error "  Run 'lo secrets decrypt' first, or re-run with --skip-orphans to accept it."
    return 1
  fi
  # The re-key encrypts the plaintext twin of every managed .enc of the
  # stores, an orphan that --skip-orphans accepts the one exception: the
  # labels are not trusted to choose the files. The compare below
  # (secrets::_twins_match) refuses a twin that holds another value than its
  # .enc; the times of the two files do not count.
  local enc
  local -a rekey=()
  for enc in "${all_encs[@]}"; do
    [[ -f "${enc%.enc}" ]] || continue
    rekey+=("${enc}")
  done
  # The scan follows a symlink, but the re-key does not write through one.
  secrets::_enc_paths "${rekey[@]}" || return 1
  # sops picks the first creation rule whose path_regex matches the plaintext
  # path. A file with no rule, or with a rule this age-only check cannot
  # encrypt to, would stop the re-key half way.
  local -a none_list=() notage_list=() badage_list=()
  secrets::_rules_check "${all_encs[@]}" <<< "${next}" || {
    error "cannot match the .enc files against the creation rules of ${sops_config} — nothing was written"
    return 1
  }
  for enc in "${none_list[@]}"; do
    error "no creation rule matches ${enc#"${PATH_BASE}/"}"
  done
  for enc in "${notage_list[@]}"; do
    error "the creation rule for ${enc#"${PATH_BASE}/"} has a recipient that is not age (pgp, kms, …)"
  done
  for enc in "${badage_list[@]}"; do
    error "the creation rule for ${enc#"${PATH_BASE}/"} has an age recipient that does not parse"
  done
  if (( ${#none_list[@]} + ${#notage_list[@]} + ${#badage_list[@]} > 0 )); then
    error "  the re-key encrypts with age through the first matching rule: fix the creation rules first. Nothing was written."
    return 1
  fi
  # Each twin must hold the value of its .enc: the re-key encrypts the twin.
  secrets::_twins_match "${rekey[@]}" || return 1
  local own=""
  secrets::_own_identity "${age_pubkey}"
  if [[ -n "${own}" ]]; then
    warn "the recipient is your own decrypt identity (${own}): once it is removed, that identity cannot decrypt the re-keyed files, and a resume of a stopped run needs another identity that decrypts every file"
  fi
  # The scope of the check, on every run that reaches it (Go twin:
  # ownIdentityScope): a run with no match warning has not read the others.
  warn "the check for your own decrypt identity reads only SOPS_AGE_KEY_FILE (default ~/.config/sops/age/keys.txt) and the .pub of LOK8S_SSH_KEY (default ~/.ssh/id_ed25519); it does not read SOPS_AGE_KEY, SOPS_AGE_KEY_CMD or other files"

  # The first write. A run that stops after it (a failed encrypt) is resumed by
  # running the command again: the recipient is then in no rule, and every
  # managed .enc is re-keyed again.
  if (( rules > 0 )); then
    secrets::_replace "${dest}" "${edited}" || return 1
    echo "removed recipient from .sops.yaml (${rules} creation rule(s))"
  else
    echo "recipient not in .sops.yaml: .sops.yaml is not changed"
  fi
  echo "  ${age_pubkey}"

  echo "re-keying ${#rekey[@]} cache file(s) across ${#stores[@]} store(s)…"
  secrets::_rekey_files "${stores[@]}" || {
    secrets::_rerun "${age_pubkey}"
    return 1
  }

  # Check the files, not the exit codes: the same reads and walk as before the
  # first write. A managed file with a twin that this run did not re-key fails
  # it.
  local -a known=("${rekey[@]}")
  secrets::_post_check "${age_pubkey}" "${stores[@]}" || {
    secrets::_rerun "${age_pubkey}"
    return 1
  }
  secrets::_other_stores warn "${age_pubkey}" "${stores[@]}"
  secrets::_rm_summary "${rules}" "${#listed[@]}" "${#rekey[@]}" "$(( ${#all_encs[@]} - ${#rekey[@]} ))"
  warn "a removal does not revoke what the key already read (older .enc files in git history included): rotate those secrets"
}

# ── Set ──────────────────────────────────────────────────

secrets::set() {
  # value is pre-initialized (="") so argsh treats it as an OPTIONAL positional;
  # an uninitialized var would be required and reject a missing value BEFORE the
  # stdin/prompt fallback below could run (the "reads stdin if omitted" path).
  # The :~stdin type makes an explicit `-` read stdin too (argsh consumes it
  # during parsing). NOTE: the `-` form needs an argsh release with
  # arg-sh/argsh#176 (older parsers reject a bare `-`);
  # the omitted-value form works on any argsh. A literal `-` value can
  # always be stored via the pipe form: `printf %s - | lo secrets set … KEY`.
  #
  # encrypt is pre-init'd to 0 (a count flag, `:+`) so it is a proper boolean; the
  # spec's FIRST long token is canonical (--encrypt), the LAST is the short (-e),
  # and the MIDDLE token is an alias (--enc). -n is already --name, hence -e.
  local name namespace="default" key value="" encrypt=0
  local -a args=(
    'name|n'          'Secret name (metadata.name from the Secret spec)'
    'namespace|s'     'Secret namespace'
    'encrypt|enc|e:+' 'SOPS-encrypt only this file after writing (needs .sops.yaml)'
    'key'             'Cache key name (e.g. JWT_SECRET)'
    'value:~stdin'    'Value to write (omitted: tty prompt / piped stdin; a bare - reads stdin, needs argsh with arg-sh/argsh#176)'
    "${args[@]:-}"
  )
  :args "Write a literal value into the secret cache" "${@}"

  [[ -n "${name}" ]] || { error "Secret --name is required"; return 1; }
  [[ -n "${key}" ]] || { error "Key argument is required"; return 1; }
  # --encrypt: before the prompt and the first write (the store, the
  # plaintext), a mv that takes -T.
  local mv_t=""
  if (( encrypt )); then
    secrets::_mv_t || return 1
  fi

  if [[ -z "${value}" ]]; then
    if [[ -t 0 ]]; then
      echo -n "Enter value for ${name}/${key}: " >&2
      read -rs value
      echo >&2
    else
      value=$(cat)
    fi
  fi

  [[ -n "${value}" ]] || { error "Empty value"; return 1; }

  secrets::_ensure_store
  local secrets_dir
  secrets_dir=$(secrets::path)
  mkdir -p "${secrets_dir}"

  local cache_file="${secrets_dir}/Secret.${name}.${namespace}.${key}"
  printf '%s' "${value}" > "${cache_file}"
  chmod 0600 "${cache_file}"
  debug "Wrote ${cache_file}"

  local sops_config="${PATH_BASE}/.sops.yaml"

  if (( encrypt )); then
    # Encrypt ONLY this one file — never a whole-store sweep (a sweep would
    # re-encrypt every other plaintext entry, a documented staging hazard).
    # _encrypt_file errors + returns non-zero when .sops.yaml is absent.
    secrets::_encrypt_file "${cache_file}" || return 1
    secrets::_live_drift "${name}" "${namespace}" "${key}" "${value}"
    echo "Set + encrypted ${name}/${namespace}/${key}"
    return 0
  fi

  # Plaintext-only write. If encryption is configured (.sops.yaml present) the
  # freshly-written cache has no matching .enc — either none exists yet (a
  # first-time write) or the committed one is now stale. Either way it is not
  # committable as-is, so always warn (there is deliberately no quiet level to
  # gate this on). Silent when .sops.yaml is absent (encryption isn't set up).
  # The wording covers both cases (missing vs. stale) without asserting which.
  if [[ -f "${sops_config}" ]]; then
    warn "wrote plaintext cache only — no matching .enc for this value (missing or now stale); run 'lo secrets encrypt' or re-run with --encrypt/-e before committing"
  fi
  secrets::_live_drift "${name}" "${namespace}" "${key}" "${value}"
  echo "Set ${name}/${namespace}/${key}"
}

# ── Live-drift check ─────────────────────────────────────

# Warn when the LIVE cluster Secret still holds a different value than the one
# just written to the store.
#
# `lo secrets set` updates the CACHE only — the running workload keeps its old
# value until `lo build` + apply. The gap itself is by design; the SILENCE is
# the bug. An operator who sets a value and reads back `Set app/default/KEY`
# has no reason to suspect the cluster disagrees — that assumption made a real
# drift incident expensive to find (2026-06-15).
#
# Advisory ONLY — every failure path returns 0. No kubectl, no current context,
# an unreachable cluster, an absent Secret or an absent key are all ordinary
# (the value may simply not be deployed yet) and must never fail a write that
# has already succeeded. `--request-timeout` is what keeps an unreachable
# cluster from hanging the CLI instead of just declining to answer.
#
# The comparison is base64-to-base64; the live side is never decoded. That
# keeps binary values out of shell variables, and it is what makes a
# trailing-newline difference VISIBLE: decoding the live value through a
# command substitution would strip its trailing newline, match it against a
# store value that never has one, and report "no drift" for a Secret that
# `lo build` + apply would genuinely rewrite. A false negative here is the
# expensive direction — it is the original silent trap wearing a green tick.
#
# The context is NAMED in the warning deliberately. A claim about "live" that
# silently refers to whichever cluster kubectl happens to point at is worse
# than no claim: it reads as authoritative while being about somewhere else.
# Usage: secrets::_live_drift <name> <namespace> <key> <value>
secrets::_live_drift() {
  local name="${1}" namespace="${2}" key="${3}" value="${4}"

  command -v kubectl >/dev/null 2>&1 || return 0

  local ctx
  ctx=$(kubectl config current-context 2>/dev/null) || return 0
  [[ -n "${ctx}" ]] || return 0

  # Bracket form: a key like `tls.crt` reads as a nested path in the bare
  # `{.data.tls.crt}` form and would silently return empty — i.e. "no drift".
  local live
  live=$(kubectl --request-timeout=5s get secret "${name}" \
           --namespace "${namespace}" \
           -o "jsonpath={.data['${key//./\\.}']}" 2>/dev/null) || return 0
  [[ -n "${live}" ]] || {
    debug "no live ${namespace}/${name} key ${key} on ${ctx} — nothing to compare"
    return 0
  }

  # `base64 | tr -d '\n'` rather than `base64 -w0`: BSD base64 has no -w.
  local want
  want=$(printf '%s' "${value}" | base64 | tr -d '\n') || return 0

  [[ "${live}" != "${want}" ]] || {
    debug "live ${namespace}/${name} key ${key} on ${ctx} already matches the store"
    return 0
  }

  warn "live Secret ${namespace}/${name} key ${key} on context '${ctx}' still holds the PREVIOUS value — the store is updated, the workload is NOT; run 'lo build' + apply (GitOps planes: commit and let Flux reconcile)"
  return 0
}

# ── Encrypt ──────────────────────────────────────────────

# secrets::_mv_has_t [program] — true when the mv program (mv by default)
# takes -T (--no-target-directory, GNU coreutils), read from its help text.
# BSD and macOS mv have no -T.
secrets::_mv_has_t() {
  local help
  help="$("${1:-mv}" --help 2>&1)" || true
  [[ "${help}" == *--no-target-directory* ]]
}

# secrets::_mv_t — sets the caller's mv_t to a mv that takes -T: mv itself
# (GNU coreutils), else gmv (GNU coreutils on macOS) when it is on PATH and
# takes -T. Without one it prints the fixed refusal and returns 1. A mv
# without -T moves a file INTO a directory at the destination, or into the
# directory that a symlink there names, and no check after the move can undo
# that. Each command that encrypts runs this check before its first write,
# and secrets::_encrypt_file runs it again before it stages a file. The Go
# binary needs no such mv: its rename never moves a file into a directory.
secrets::_mv_t() {
  if secrets::_mv_has_t mv; then
    mv_t="mv"
  elif command -v gmv &>/dev/null && secrets::_mv_has_t gmv; then
    mv_t="gmv"
  else
    error "this mv has no -T, so the encrypt cannot rename onto the .enc safely: install GNU coreutils (gmv) or use the lo binary"
    return 1
  fi
}

# secrets::_rename_onto <mv> <from> <to> — <mv> -f -T from onto the path to
# (<mv> from secrets::_mv_t). With -T a directory at to, or a symlink to one,
# is never a target to move INTO: mv replaces a symlink and refuses a
# directory.
secrets::_rename_onto() {
  "${1}" -f -T -- "${2}" "${3}"
}

# secrets::_enc_path_ok <enc> — true when <enc> is a regular file, or when the
# lookup of the path confirms that it does not exist (secrets::_absent), read
# without following a symlink (Go twin: encDestinationOK). A symlink, another
# kind of entry and a lookup that fails for another reason (a name that is
# too long, a directory that cannot be searched) are refused.
# secrets::_encrypt_file writes an .enc only when this is true, and
# secrets::_enc_paths checks a list with it before the first write of a
# re-key.
secrets::_enc_path_ok() {
  [[ ! -L "${1}" ]] || return 1
  if [[ -e "${1}" ]]; then
    [[ -f "${1}" ]]
    return
  fi
  secrets::_absent "${1}"
}

# secrets::_absent <path> — true only when the lstat of <path> fails with
# ENOENT (Go twin: errors.Is(err, fs.ErrNotExist)). The file tests of bash
# do not show the errno: [[ -e ]] and [[ -L ]] are also false for a name
# that is too long (ENAMETOOLONG) and below a directory that cannot be
# searched (EACCES). So it runs ls -ld, which does not follow a symlink,
# under LC_ALL=C, and it takes the path as absent only when ls fails and
# its message ends in ": No such file or directory", the C-locale text of
# ENOENT (the same in glibc, musl, BSD and macOS). Any other result fails
# closed, an ls that is not found included. A test of the name length
# against NAME_MAX would find one of these errors only. It runs the ls
# command through `command`: a shell function named ls, or an alias that
# bash expands when it reads this file, could add a line of its own to the
# message (for example, the error of a second listing of a missing path).
secrets::_absent() {
  local msg
  msg="$(LC_ALL=C command ls -ld -- "${1}" 2>&1 >/dev/null)" && return 1
  [[ "${msg}" == *": No such file or directory" ]]
}

# secrets::_sweep_files <dir> <pattern> — sets the caller's sweep to the
# plaintext cache files of <dir> that the encrypt sweep reads: each regular
# file whose name matches <pattern> and does not end in .enc (Go twin:
# sweepPlaintexts). secrets::encrypt lists the store with it after the
# .gitignore write. add-key lists the store with it once, before its first
# write: it checks the .enc of each file, and its encrypt reads that same
# list (secrets::_encrypt_store ... list), so a file that the run itself
# changes is not added. Another process that writes to the store during the
# run is outside the threat model.
secrets::_sweep_files() {
  local _plain
  sweep=()
  # shellcheck disable=SC2231 # intentional glob; the pattern is Secret.* or Secret.<name>.* with a charset-checked name
  for _plain in "${1}"/${2}; do
    [[ -f "${_plain}" && "${_plain}" != *.enc ]] || continue
    sweep+=("${_plain}")
  done
}

# Encrypt a single plaintext cache file to <file>.enc with SOPS. Gated on
# ${PATH_BASE}/.sops.yaml existing (its presence = "encryption is configured");
# errors + returns non-zero when it's absent. Shared by `secrets::encrypt` (the
# whole-store sweep) and `secrets::set --encrypt` (this one file only) so both go
# through the same .sops.yaml check + sops invocation.
# Usage: secrets::_encrypt_file <plaintext_path>
secrets::_encrypt_file() {
  local plaintext="${1}"
  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "No .sops.yaml found — run: lo secrets init"
    return 1
  }
  local enc_file="${plaintext}.enc" tmp mv_t=""
  # The last guard: a mv that takes -T, before anything is staged (the
  # command that called this function checked it before its first write).
  secrets::_mv_t || return 1
  # The .enc path must be a regular file or absent before sops runs (Go twin:
  # encDestinationOK, an lstat): a symlink (to a file or to a directory), a
  # directory, a FIFO, a socket or a device is refused, and so is a path
  # whose lookup fails for a reason other than "does not exist"
  # (secrets::_absent), and nothing is written. A plain mv onto a symlink
  # to a directory moves the file INTO that directory. The
  # check reads the last part of the path only. The store directory and its
  # parent directories are trusted: they belong to the user who runs lo. A
  # symlink in a parent is followed, and a parent that another user can
  # replace could move the temp file and the rename out of the store.
  if ! secrets::_enc_path_ok "${enc_file}"; then
    error "${enc_file#"${PATH_BASE}/"} is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: the .enc was not written — remove it, then encrypt again"
    return 1
  fi
  debug "Encrypting $(basename "${plaintext}")"
  # sops writes a temp file in the same directory (mktemp: mode 0600; the dot
  # keeps it out of the Secret.* globs), and a rename puts it over the .enc:
  # an encrypt that stops half way leaves the old .enc whole, and the temp
  # file is removed (Go twin: writeReplacing). The rename is
  # secrets::_rename_onto with the mv of secrets::_mv_t (-T): it renames onto
  # the path itself, never into a directory, also when the path changes after
  # the check above.
  tmp="$(mktemp "$(dirname -- "${enc_file}")/.$(basename -- "${enc_file}").tmp-XXXXXX")" || {
    error "Failed to encrypt $(basename "${plaintext}")"
    return 1
  }
  # `--config "${sops_config}"` pins the SAME .sops.yaml the gate just checked:
  # without it sops discovers config by walking up from the FILE's path, so a
  # different .sops.yaml higher up (e.g. the repo root, or under Docker) could
  # silently supply other creation_rules/recipients than the one we validated.
  # (`--config` is a global flag, so it precedes the `encrypt` subcommand.)
  if sops --config "${sops_config}" encrypt \
    --input-type binary \
    --output-type binary \
    --output "${tmp}" \
    "${plaintext}" && secrets::_rename_onto "${mv_t}" "${tmp}" "${enc_file}"; then
    return 0
  fi
  # The old .enc is whole; the temp file holds ciphertext, or nothing.
  if ! rm -f -- "${tmp}"; then
    error "cannot remove the temp file ${tmp#"${PATH_BASE}/"}: remove it by hand"
  fi
  error "Failed to encrypt $(basename "${plaintext}")"
  return 1
}

# The command; --name is for the interactive single-Secret case. The re-key of
# add-key runs the sweep through secrets::_encrypt_store with the list that it
# checked, not through this command.
# shellcheck disable=SC2120
secrets::encrypt() {
  # --name narrows the sweep to ONE Secret's cache files.
  #
  # Without it this walks the whole store and encrypts every plaintext whose
  # .enc is older — including entries the operator was mid-edit on, or values
  # they were only trying out. That is fine as the deliberate "stage everything"
  # move and wrong as the default for "I changed one secret", which is the
  # common case; committing an .enc for a value nobody meant to publish is not
  # something the store can walk back.
  local name=""
  local -a args=(
    'name|n' "Encrypt only this Secret's cache files (metadata.name); default is the whole store"
    "${args[@]:-}"
  )
  :args "Encrypt plaintext cache files for commit" "${@}"

  # The name lands in a glob under ${secrets_dir}; a slash or .. would let it
  # address files outside the store. Same charset the domain resolver enforces.
  if [[ -n "${name}" && ! "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]]; then
    error "invalid --name '${name}' — a Secret name is [a-zA-Z0-9][a-zA-Z0-9._-]*"
    return 1
  fi
  # Before the first write (the .gitignore of the store), a mv that takes -T.
  local mv_t=""
  secrets::_mv_t || return 1

  local secrets_dir
  secrets_dir=$(secrets::path)
  secrets::_encrypt_store "${secrets_dir}" "${name}" find
}

# secrets::_encrypt_store <secrets_dir> <name> find|list [<plaintext>...] — the
# sweep of secrets::encrypt over one store (Go twin: encryptSweep): the
# .gitignore of the store, the .sops.yaml check, then each plaintext whose
# .enc is not newer. With find it lists the store after the .gitignore write
# (secrets::_sweep_files, narrowed to <name>). With list it encrypts the
# plaintexts given, the list that add-key checked before its first write, and
# it does not list the store again. <name> is for the message when nothing
# matched.
secrets::_encrypt_store() {
  local secrets_dir="${1}" name="${2}" mode="${3}"
  shift 3

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Ensure .gitignore blocks plaintext before we create .enc files
  secrets::_ensure_gitignore "${secrets_dir}" || return 1

  local sops_config="${PATH_BASE}/.sops.yaml"
  [[ -f "${sops_config}" ]] || {
    error "No .sops.yaml found — run: lo secrets init"
    return 1
  }

  local -a sweep=("${@}")
  if [[ "${mode}" == find ]]; then
    # Cache files are Secret.<name>.<namespace>.<key>, so --name anchors on
    # the second field. Unquoted on purpose: this must glob.
    local pattern="Secret.*"
    [[ -z "${name}" ]] || pattern="Secret.${name}.*"
    secrets::_sweep_files "${secrets_dir}" "${pattern}"
  fi

  local count=0 skipped=0
  local plaintext
  for plaintext in "${sweep[@]}"; do
    local enc_file="${plaintext}.enc"

    # Skip if .enc is newer than plaintext (already up to date)
    if [[ -f "${enc_file}" && "${enc_file}" -nt "${plaintext}" ]]; then
      skipped=$((skipped + 1))
      continue
    fi

    secrets::_encrypt_file "${plaintext}" || return 1
    count=$((count + 1))
  done

  if (( count > 0 )); then
    echo "Encrypted ${count} secret(s)"
  fi
  if (( skipped > 0 )); then
    debug "Skipped ${skipped} (already up to date)"
  fi
  if (( count == 0 && skipped == 0 )); then
    # A --name that matched nothing is a FAILURE, not a quiet no-op. The
    # operator asked for one specific Secret; a typo would otherwise print a
    # reassuring line, exit 0, and leave them committing whatever stale .enc is
    # already on disk. Without --name an empty store is genuinely nothing to do.
    if [[ -n "${name}" ]]; then
      error "no cache files for Secret '${name}' in ${secrets_dir}"
      error "  expected ${secrets_dir}/Secret.${name}.<namespace>.<key>; check the name or run without --name to see the store"
      return 1
    fi
    echo "No plaintext secrets found in ${secrets_dir}"
  fi
}

# ── Allow ────────────────────────────────────────────────

secrets::allow() {
  :args "Approve bash: generators after review" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Collect the per-entry hashes from existing .sha files.
  local -a sha_files=()
  local -a hashes=()
  for sha_file in "${secrets_dir}"/*.sha; do
    [[ -f "${sha_file}" ]] || continue
    sha_files+=("${sha_file}")
    local h
    h=$(cat "${sha_file}" | tr -d '[:space:]')
    hashes+=("${h}")
  done

  if (( ${#hashes[@]} == 0 )); then
    echo "No bash: entries found (no .sha files)"
    return 0
  fi

  # Write the approved SET of per-entry hashes (one per line, sorted + unique).
  # The Go plugin treats .bash-allow as a set and requires every bash entry in a
  # (per-target) build to be a member — so a subset build still matches. (Was a
  # single hash-of-all-hashes, which a per-target build's subset could never
  # match — see kustomize/plugins/secret/generator/bash.go verifyBashAllow.)
  local allow_file="${secrets_dir}/.bash-allow"
  printf '%s\n' "${hashes[@]}" | sort -u > "${allow_file}"
  chmod 0600 "${allow_file}"

  echo "Approved ${#sha_files[@]} bash: entry/entries"
  for sf in "${sha_files[@]}"; do
    echo "  $(basename "${sf}")"
  done
}

# ── Decrypt ──────────────────────────────────────────────

secrets::decrypt() {
  local ssh_key="${LOK8S_SSH_KEY}"
  local -a args=(
    'ssh-key|k'  'Path to SSH private key'
    "${args[@]:-}"
  )
  :args "Decrypt .enc files into plaintext cache" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)

  [[ -d "${secrets_dir}" ]] || { warn "No secrets directory: ${secrets_dir}"; return 0; }

  # Resolve the age private key. Checked in order:
  #   1. SOPS_AGE_KEY env var (CI, explicit)
  #   2. SOPS_AGE_KEY_FILE (~/.config/sops/age/keys.txt, SOPS standard)
  #   3. ssh-to-age from SSH private key (only works without passphrase)
  local age_key="${SOPS_AGE_KEY:-}"
  if [[ -z "${age_key}" ]]; then
    local age_key_file="${SOPS_AGE_KEY_FILE:-${HOME}/.config/sops/age/keys.txt}"
    if [[ -f "${age_key_file}" ]]; then
      age_key=$(grep -v '^#' "${age_key_file}" | grep -m1 'AGE-SECRET-KEY-' || true)
    fi
  fi
  if [[ -z "${age_key}" ]]; then
    command -v ssh-to-age &>/dev/null || {
      error "Cannot find age private key. Options:"
      error "  1. Set SOPS_AGE_KEY env var"
      error "  2. Create ${HOME}/.config/sops/age/keys.txt via:"
      error "     ssh-to-age -private-key < ${ssh_key} > \${HOME}/.config/sops/age/keys.txt"
      error "  3. Install ssh-to-age (b install)"
      return 1
    }
    [[ -f "${ssh_key}" ]] || {
      error "SSH private key not found: ${ssh_key}"
      return 1
    }
    age_key=$(ssh-to-age -private-key < "${ssh_key}" 2>/dev/null) || {
      error "Failed to derive age key from ${ssh_key}"
      error "If your SSH key is passphrase-protected, derive once:"
      error "  mkdir -p ~/.config/sops/age"
      error "  ssh-to-age -private-key -i ${ssh_key} > ~/.config/sops/age/keys.txt"
      error "  chmod 600 ~/.config/sops/age/keys.txt"
      error "(you'll be prompted for the passphrase once)"
      return 1
    }
  fi

  local count=0 skipped_equal=0 skipped_differ=0
  local enc_file enc_sum plain_sum
  for enc_file in "${secrets_dir}"/Secret.*.enc; do
    [[ -f "${enc_file}" ]] || continue

    local plaintext="${enc_file%.enc}"

    # Skip if plaintext is newer than .enc (already decrypted). The skip keeps
    # the plaintext, so compare it with the decrypted .enc: a plaintext that
    # differs holds a value the .enc does not (a local edit, or a value a build
    # generated before the decrypt). Name it, never its value. The two sums
    # stay in memory: the decrypted value never reaches a file, and no sum is
    # printed. The sops stderr is discarded here: a MAC mismatch prints two
    # unkeyed SHA-512 digests of the plaintext.
    if [[ -f "${plaintext}" && "${plaintext}" -nt "${enc_file}" ]]; then
      plain_sum=$(secrets::_sum 2>/dev/null < "${plaintext}") || {
        error "Failed to read $(basename "${plaintext}")"
        return 1
      }
      enc_sum=$(
        set -o pipefail
        SOPS_AGE_KEY="${age_key}" sops decrypt \
          --input-type binary \
          --output-type binary \
          "${enc_file}" 2>/dev/null | secrets::_sum
      ) || {
        error "Failed to decrypt $(basename "${enc_file}")"
        return 1
      }
      if [[ "${enc_sum}" == "${plain_sum}" ]]; then
        skipped_equal=$((skipped_equal + 1))
      else
        warn "$(basename "${plaintext}"): the plaintext is newer than $(basename "${enc_file}") and differs from it. Decrypt kept the plaintext."
        skipped_differ=$((skipped_differ + 1))
      fi
      continue
    fi

    # The sops stderr is discarded: a MAC mismatch prints two unkeyed SHA-512
    # digests of the plaintext. The [error] line names the file only (as Go).
    debug "Decrypting $(basename "${enc_file}")"
    SOPS_AGE_KEY="${age_key}" sops decrypt \
      --input-type binary \
      --output-type binary \
      --output "${plaintext}" \
      "${enc_file}" 2>/dev/null || {
      error "Failed to decrypt $(basename "${enc_file}")"
      return 1
    }
    chmod 0600 "${plaintext}"
    count=$((count + 1))
  done

  # A differing plaintext is not an error: `lo secrets set` without --encrypt
  # makes exactly that state on purpose. The warnings name each entry, and
  # this line gives the two ways out once.
  if (( skipped_differ > 0 )); then
    local dflag=""
    [[ -z "${domain:-}" ]] || dflag=" --domain ${domain}"
    warn "${skipped_differ} plaintext(s) differ from the .enc. To store them, run \"lo secrets encrypt${dflag}\". To use the .enc values, delete these plaintexts, then run \"lo secrets decrypt${dflag}\"."
  fi
  if (( count > 0 )); then
    echo "Decrypted ${count} secret(s)"
  fi
  # The skip count goes to stderr: piped stdout is the contract, and it carried
  # no skip line before.
  local skipped=$((skipped_equal + skipped_differ))
  if (( skipped > 0 )); then
    echo "Skipped ${skipped} secret(s) with a newer plaintext: ${skipped_equal} equal, ${skipped_differ} differ" >&2
  fi
  if (( count == 0 && skipped == 0 )); then
    echo "No encrypted secrets found in ${secrets_dir}"
  fi
}

# secrets::_sum — the sha256 of stdin: coreutils sha256sum, else shasum on
# macOS. decrypt compares two sums in memory and never prints one.
secrets::_sum() {
  if command -v sha256sum &>/dev/null; then
    sha256sum
  else
    shasum -a 256
  fi
}

# ── Helpers ──────────────────────────────────────────────

# secrets::decrypt_entry <enc_file> — print the plaintext of one encrypted
# store entry, decrypted in memory: nothing reaches the disk. The age identity
# comes from the decrypt chain (SOPS_AGE_KEY, the SOPS key file, the identity
# derived from LOK8S_SSH_KEY). Quiet (sops and ssh-to-age stderr can carry key
# material); the return code names the cause, checked in this order:
#   2 no age identity   3 the .enc cannot be read   4 sops is not installed
#   1 the .enc does not decrypt (another identity, or a damaged file)
# Go twin: secrets.DecryptEntry (no class 4: the binary links sops).
secrets::decrypt_entry() {
  local enc_file="${1}" age_key="${SOPS_AGE_KEY:-}"
  if [[ -z "${age_key}" ]]; then
    local age_key_file="${SOPS_AGE_KEY_FILE:-${HOME}/.config/sops/age/keys.txt}"
    if [[ -f "${age_key_file}" ]]; then
      age_key=$(grep -v '^#' "${age_key_file}" | grep -m1 'AGE-SECRET-KEY-' || true)
    fi
  fi
  if [[ -z "${age_key}" && -f "${LOK8S_SSH_KEY:-}" ]] && command -v ssh-to-age &>/dev/null; then
    age_key=$(ssh-to-age -private-key < "${LOK8S_SSH_KEY}" 2>/dev/null) || age_key=""
  fi
  [[ -n "${age_key}" ]] || return 2
  [[ -r "${enc_file}" ]] || return 3
  command -v sops &>/dev/null || return 4
  SOPS_AGE_KEY="${age_key}" sops decrypt --input-type binary --output-type binary "${enc_file}" 2>/dev/null || return 1
}

# Ensure the secrets dir has a .gitignore that blocks plaintext but
# allows .enc files. Creates the file if missing. A .gitignore that is a
# symlink, a directory, a FIFO, a socket or a device, or whose lookup fails,
# is refused before it is read (secrets::_enc_path_ok; Go twin:
# ensureGitignore): the write would go through a link to the file that it
# names, and git does not read a .gitignore that is a symlink. A rerun of
# init or add-key stops before the .gitignore, so the line names the
# encrypt.
secrets::_ensure_gitignore() {
  local dir="${1}"
  local gitignore="${dir}/.gitignore"
  secrets::_enc_path_ok "${gitignore}" || {
    error "${gitignore#"${PATH_BASE}/"} is not a regular file (a symlink, a directory, a FIFO, a socket or a device), or its lookup failed: the .gitignore was not written — remove it, then run lo secrets encrypt"
    return 1
  }
  if [[ -f "${gitignore}" ]] && grep -qF '!Secret.*.enc' "${gitignore}"; then
    return 0
  fi
  cat > "${gitignore}" <<'GI'
# Auto-generated by lok8s — ignore everything except SOPS-encrypted
# secret cache files. Plaintext cache entries must never be committed.
*
!.gitignore
!Secret.*.enc
GI
  debug "Created ${gitignore}"
}

# Check for unencrypted secrets (used by lint).
# Returns 0 if all secrets are encrypted or no secrets exist.
# Returns 1 if any plaintext secret lacks a corresponding .enc file.
secrets::check_unencrypted() {
  local secrets_dir
  secrets_dir=$(secrets::path)
  [[ -d "${secrets_dir}" ]] || return 0

  local found=0
  for plaintext in "${secrets_dir}"/Secret.*; do
    [[ -f "${plaintext}" ]] || continue
    [[ "${plaintext}" != *.enc ]] || continue
    if [[ ! -f "${plaintext}.enc" ]]; then
      warn "Unencrypted secret: $(basename "${plaintext}") — run: lo secrets encrypt"
      found=1
    elif [[ "${plaintext}" -nt "${plaintext}.enc" ]]; then
      warn "Secret changed since last encrypt: $(basename "${plaintext}") — run: lo secrets encrypt"
      found=1
    fi
  done
  return "${found}"
}

# Check for deprecated flat-store shadows of a domain's per-domain secrets.
# A domain with its OWN store (clusters/<domain>/secrets/) must not ALSO keep the
# same Secret.<name>.<ns>.<key> in the flat store (${PATH_SECRETS:-${PATH_BASE}/.secrets}): the two
# diverge silently and different tools read different stores (lo build/Tilt →
# per-domain; a manual PATH_SECRETS=.../.secrets kustomize → flat), which can
# re-key a live cluster from the WRONG store (this orphaned a dev IdP's etcd
# encryption once). Per-domain is authoritative; the flat store keeps ONLY
# global, non-domain material (e.g. a shared registry/expose TLS cert that no
# per-domain store mirrors).
#
# Emits one line per shadow to stdout (lint wraps each as a warning); returns 1
# if any shadow exists, 0 otherwise. An identical copy is a stale duplicate; a
# DIFFERING copy is active drift — the dangerous case.
# Usage: secrets::check_flat_shadows <domain_dir>
secrets::check_flat_shadows() {
  local domain_dir="${1}"
  # Need a store root: short-circuit when neither is configured, else `flat` would
  # be a bogus "/.secrets" that could match an unrelated host directory.
  [[ -n "${PATH_SECRETS:-}" || -n "${PATH_BASE:-}" ]] || return 0
  # Resolve the flat store exactly as secrets::path does — PATH_SECRETS overrides
  # the default ${PATH_BASE}/.secrets — so a custom PATH_SECRETS is honored (else
  # this check would inspect the wrong dir and miss the very case it targets). The
  # guard above means PATH_BASE is set whenever that default is evaluated, so the
  # bare ${PATH_BASE} is safe under `set -u`.
  local flat="${PATH_SECRETS:-${PATH_BASE}/.secrets}"
  local store="${domain_dir}/secrets"
  local dname
  dname=$(basename "${domain_dir}")

  # Only meaningful when the domain has its OWN store, distinct from the flat one.
  [[ -d "${store}" && -d "${flat}" ]] || return 0
  [[ "${store}" -ef "${flat}" ]] && return 0

  local found=0 plaintext base flat_copy
  for plaintext in "${store}"/Secret.*; do
    [[ -f "${plaintext}" ]] || continue
    case "${plaintext}" in *.enc | *.sha) continue ;; esac
    base=$(basename "${plaintext}")
    flat_copy="${flat}/${base}"
    [[ -f "${flat_copy}" ]] || continue
    if cmp -s "${flat_copy}" "${plaintext}"; then
      echo "Flat-store shadow: ${base} is duplicated in the flat .secrets/ store — flat is deprecated for domain secrets; remove the flat copy"
    else
      echo "Flat-store DRIFT: ${base} differs between the flat .secrets/ store and ${dname}/secrets/ — the stores diverged (a build from the wrong store can re-key a live cluster); reconcile to the per-domain value, then remove the flat copy"
    fi
    found=1
  done
  return "${found}"
}

# ── List / Print (preserved from original) ───────────────

secrets::list() {
  :args "List secrets" "${@}"

  local secrets_dir
  secrets_dir=$(secrets::path)
  if [[ ! -d "${secrets_dir}" ]]; then
    warn "Secrets directory not found: ${secrets_dir}"
    return 0
  fi
  for secret in "${secrets_dir}"/Secret.*; do
    [[ -f "${secret}" ]] || continue
    [[ "${secret}" != *.enc ]] || continue
    local name
    name=$(basename "${secret}")
    if [[ -f "${secret}.enc" ]]; then
      echo "${name} (encrypted)"
    else
      echo "${name} (plaintext)"
    fi
  done
  # Also list .enc files without a plaintext counterpart (need decrypt)
  for enc in "${secrets_dir}"/Secret.*.enc; do
    [[ -f "${enc}" ]] || continue
    local plaintext="${enc%.enc}"
    [[ -f "${plaintext}" ]] || echo "$(basename "${enc}") (needs decrypt)"
  done
}

secrets::print() {
  local only_one copy
  local -a find args=(
    'only-one|o:+'  'Only print one secret (error if multiple matches)'
    'copy|c:+'      'Copy secret(s) to clipboard (--only-one is implied)'
    'find'          'match all arguments (regex)'
    "${args[@]:-}"
  )
  :args "Print secret(s)" "${@}"
  if (( copy )); then only_one=1; fi

  local secrets_dir
  secrets_dir=$(secrets::path)

  local -a matches=()
  local name
  for secret in "${secrets_dir}"/Secret.*; do
    [[ -f "${secret}" ]] || continue
    [[ "${secret}" != *.enc ]] || continue
    name="$(basename "${secret}")"
    local m=1
    for f in "${find[@]}"; do
      echo "${name}" | grep -iqE ".*${f}.*" || { m=0; break; }
    done
    (( m )) && matches+=("${secret}")
  done

  if (( only_one )) && [[ ${#matches[@]} != 1 ]]; then
    error "Multiple matches found:"
    for match in "${matches[@]}"; do
      echo -e "${GREEN}${match}${NC}"
    done
    return 1
  fi

  (( ${#matches[@]} )) || { error "No matches found"; return 1; }

  if (( copy )); then
    for cp in "pbcopy" "xclip -selection clipboard" "xsel --clipboard --input" "clip.exe"; do
      command -v "$(echo "${cp}" | cut -d' ' -f1)" &>/dev/null && {
        ${cp} < "${matches[0]}"
        return
      }
    done
    error "No clipboard tool found"
    return 1
  fi

  if [[ ${#matches[@]} == 1 ]]; then
    cat "${matches[0]}"
    return
  fi

  for match in "${matches[@]}"; do
    echo -e "${GREEN}$(basename "${match}")${NC}"
    cat "${match}"
    echo
    echo
  done
}

# ── Env ──────────────────────────────────────────────────

# Emit `export KEY=value` lines for every key of a cached secret, so
# provisioning-time credentials live in the managed (SOPS-encrypted, per-domain)
# store instead of a loose plaintext env file. Each cache KEY becomes the exported
# variable name — name the keys after the vars you want (e.g. HCLOUD_TOKEN). Load
# them with:  eval "$(lo secrets --domain <domain> env --name hetzner)"
# Read-only; values are shell-quoted with %q so the eval is injection-safe.
secrets::env() {
  local name namespace="default"
  local -a args=(
    'name|n'       'Secret name whose keys to export'
    'namespace|s'  'Secret namespace'
    "${args[@]:-}"
  )
  :args "Emit export lines for a cached secret" "${@}"
  [[ -n "${name}" ]] || { error "Secret --name is required"; return 1; }

  local secrets_dir
  secrets_dir=$(secrets::path)
  local f base key found=0
  for f in "${secrets_dir}/Secret.${name}.${namespace}".*; do
    [[ -f "${f}" ]] || continue
    [[ "${f}" != *.enc && "${f}" != *.sha ]] || continue
    base="${f##*/}"
    key="${base#"Secret.${name}.${namespace}."}"
    printf 'export %s=%q\n' "${key}" "$(cat "${f}")"
    found=1
  done
  (( found )) || { error "No cached keys for ${name}/${namespace} in ${secrets_dir}"; return 1; }
}

