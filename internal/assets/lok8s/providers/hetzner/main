#!/usr/bin/env argsh
# shellcheck shell=bash disable=SC2034
# hetzner — Hetzner Cloud provider
# Declarative resource provisioning from JSON/YAML descriptors via hcloud CLI.
# Supports cloud VMs + bare metal (Robot) + per-server cloud-init.
# Adapted from github.com/lanisce/cloud-init/provider/hetzner

PATH_SCRIPTS="${PATH_LOK8S}"
import ^utils/verbose
import ^utils/types
import ^utils/template
import ^utils/credentials
import ^utils/http

: "${CLOUD_HETZNER_JSON:=""}"
: "${CLOUD_DRY_RUN:=""}"
: "${CLOUD_DRY_RUN_PATH:=""}"
# Hetzner Robot (dedicated servers) REST API base. Overridable for tests.
: "${HROBOT_API:=https://robot-ws.your-server.de}"
# Robot REST API timeouts (seconds). Every Robot curl is `--fail` + timed out so
# an HTTP 4xx/5xx or a hang can never read as success. The rescue/reset/lookup
# path uses the longer pair; doctor uses the shorter *_DOCTOR_* pair to stay fast.
: "${HROBOT_CONNECT_TIMEOUT:=10}"
: "${HROBOT_MAX_TIME:=30}"
: "${HROBOT_DOCTOR_CONNECT_TIMEOUT:=5}"
: "${HROBOT_DOCTOR_MAX_TIME:=8}"
# Marker that exists ONLY inside Hetzner's rescue system — the single source of
# truth for the read-only rescue-vs-installed SSH probe (rebuild barrier + doctor).
_HETZNER_RESCUE_MARKER="/root/.oldroot/nfs/install/installimage"

_HETZNER_DIR="${BASH_SOURCE[0]%/*}"
# shellcheck source=utils/json.sh
source "${_HETZNER_DIR}/utils/json.sh"
# shellcheck source=utils/resources.sh
source "${_HETZNER_DIR}/utils/resources.sh"

# ── Provider contract ────────────────────────────────────
#
# Implements provider::* from .lok8s/utils/provider.
# PROVIDER_CONFIG_FILE is a YAML or JSON descriptor file.
# When it's a JSON descriptor (hetzner.json format), the full
# hetzner::create loop handles all resource types with per-server
# cloud-init hooks. When it's simple YAML config fields, the
# provider reads the config and dispatches to the create loop.

_cfg() { yq -r "${1}" "${PROVIDER_CONFIG_FILE}"; }

# _validate_node_labels <labels-json> [<node-name>]
# Light k8s-label validity guard: drop any key/value that violates the
# Kubernetes label constraints and warn, so a bad label fails EARLY here
# (clear message, keeps provisioning) instead of late inside `kubeone apply`
# (opaque kubeadm/labelNodes error). Rules enforced (k8s syntax):
#   value: <=63 chars, empty OR [alnum]([alnum._-]*[alnum])?
#   key:   optional "<dns-subdomain>/" prefix (<=253) + name segment
#          <=63 chars matching [alnum]([alnum._-]*[alnum])?
# A single trailing "-" on a key is KubeOne's addRemoveKeyValues REMOVAL
# marker ("key-": "" deletes the Node label on the next apply) — the key is
# validated as if the marker were absent, so a removal entry passes through.
# Echoes the filtered labels JSON map. Proportionate: skip+warn, not fatal.
_validate_node_labels() {
  local labels_json="${1:-"{}"}" node="${2:-node}"
  local dropped
  dropped=$(echo "${labels_json}" | jq -r '
    def valid_seg: test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_value: . == "" or test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_key:
      (sub("-$"; "") | split("/")) as $p
      | (if ($p | length) == 1 then ($p[0] | valid_seg)
         elif ($p | length) == 2 then (($p[0] | length) <= 253 and ($p[0] | test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")) and ($p[1] | valid_seg))
         else false end);
    to_entries[] | select((.key | valid_key | not) or (.value | valid_value | not)) | .key' 2>/dev/null)
  if [[ -n "${dropped}" ]]; then
    local k
    while IFS= read -r k; do
      [[ -n "${k}" ]] || continue
      warn "node ${node}: dropping invalid k8s label '${k}' (violates key/value syntax or 63-char limit)"
    done <<< "${dropped}"
  fi
  echo "${labels_json}" | jq -c '
    def valid_seg: test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_value: . == "" or test("^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$");
    def valid_key:
      (sub("-$"; "") | split("/")) as $p
      | (if ($p | length) == 1 then ($p[0] | valid_seg)
         elif ($p | length) == 2 then (($p[0] | length) <= 253 and ($p[0] | test("^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$")) and ($p[1] | valid_seg))
         else false end);
    with_entries(select((.key | valid_key) and (.value | valid_value)))'
}

# shellcheck disable=SC2120 # optional config arg; the sole caller invokes it arg-less
provider::validate() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"

  command -v hcloud &>/dev/null || {
    error "hcloud CLI not found. Install: https://github.com/hetznercloud/cli"
    return 1
  }
  credentials::require hetzner || return 1
  # hcloud auth: HCLOUD_TOKEN env is sufficient (CI/automation); a CLI
  # context is the interactive alternative — require either, then prove
  # the credentials actually work with a cheap read call.
  local context
  context="$(hcloud context active 2>/dev/null || echo "")"
  if [[ -z "${HCLOUD_TOKEN:-}" && -z "${context}" ]]; then
    error "No hcloud credentials: set HCLOUD_TOKEN or run: hcloud context create <name>"
    return 1
  fi
  hcloud server-type list -o noheader &>/dev/null || {
    error "hcloud API not reachable with the provided credentials"
    return 1
  }
  debug "hetzner provider validated (${context:+context: ${context}}${context:-HCLOUD_TOKEN env})"
}

provider::credential_data() {
  [[ -n "${HCLOUD_TOKEN:-}" ]] || { error "HCLOUD_TOKEN not set"; return 1; }
  echo "hcloud-token=${HCLOUD_TOKEN}"
  [[ -z "${HROBOT_USER:-}" ]]     || echo "robot-user=${HROBOT_USER}"
  [[ -z "${HROBOT_PASSWORD:-}" ]] || echo "robot-password=${HROBOT_PASSWORD}"
}

provider::provision() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # Log all operations to a file (always, regardless of quiet mode)
  export CLOUD_LOG_FILE="${work_dir}/hetzner-provision.log"
  mkdir -p "${work_dir}"
  : > "${CLOUD_LOG_FILE}"
  _hetzner_log "provision started: config=${config_file} work_dir=${work_dir}"

  [[ -f "${config_file}" ]] || { error "config not found: ${config_file}"; return 1; }

  # Source the cloud-config generator (for per-server cloud-init)
  local cc_script="${PATH_LOK8S}/providers/hetzner/cloud-config"
  if [[ -f "${cc_script}" ]]; then
    # shellcheck source=/dev/null
    source "${cc_script}"
  fi

  # Set up cloud-init environment from config. The CLOUD_PATH / CLOUD_PATH_LIB /
  # CLOUD_USER / CLOUD_GROUP / CLOUD_PATH_PUB resolution is shared with
  # provider::rebuild (one helper, so the two can't drift). CLOUD_PATHD is
  # provision-specific: the whole-cluster module set from .cloudInit.modules
  # (rebuild overrides CLOUD_PATHD per server from each server's #cloud.d).
  hetzner::_export_cloudinit_env "${config_file}" || return 1
  local ci_modules
  ci_modules=$(_cfg '.cloudInit.modules // ""' 2>/dev/null || echo "")
  export CLOUD_PATHD="${ci_modules}"

  # Load the descriptor (JSON or YAML → JSON)
  # template::descriptor_json, not envsubst-then-reread: the old YAML branch
  # re-read the RAW file and threw the expansion away (issue #65).
  CLOUD_HETZNER_JSON="$(template::descriptor_json "${config_file}")" || return 1

  # Run the full provisioning sequence (JSON descriptor loop). Each step is
  # gated explicitly: callers invoke provision under `|| return 1`, which
  # turns errexit OFF inside this body — unguarded, a failed `hcloud create`
  # is swallowed and provision reports success.
  local rc=0
  hetzner::_run_steps || rc=1

  # Dump the state: the descriptor with the ids that this run knows. Also
  # after a failed step: it holds the ids known so far. A failed dump is an
  # error.
  hetzner::json '.' > "${work_dir}/hetzner.dump.json" || { error "hetzner state dump failed"; return 1; }
  if (( rc != 0 )); then
    error "hetzner: the ids that this run knows are in ${work_dir}/hetzner.dump.json."
    return 1
  fi
  debug "hetzner provision complete"
}

# hetzner::_destroy_cluster_name <config_file>
# The cluster name provider::destroy deletes by: the descriptor's
# cluster_name, and nothing else. A name guessed from the provision dump or a
# server name would delete by a label nobody confirmed, and `lo destroy`
# checks the other domains for the same cluster_name (one name resolution
# for both).
hetzner::_destroy_cluster_name() {
  local config_file="${1}" cluster_name=""
  cluster_name=$(_cfg '.cluster_name // ""' 2>/dev/null || echo "")
  [[ -n "${cluster_name}" ]] || {
    error "hetzner: the descriptor ${config_file} has no cluster_name. The destroy finds its resources by lok8s.dev/cluster=<cluster_name> and the owner mark, so it needs the name. The hetzner provider deleted no resource in this step. Set cluster_name in the descriptor."
    return 1
  }
  echo "${cluster_name}"
}

# The resource types provider::destroy deletes, in its delete order.
_HETZNER_DESTROY_ORDER=(load-balancer server placement-group firewall volume floating-ip ssh-key network)

# A jq def: the name of a part as the destroy plan and the warnings of the
# destroy show it (VERBOSE_JQ_SHOWN_NAME, utils/verbose.sh: each control
# character, each backslash and each bidi or zero-width format character
# becomes '?'). warn prints with `echo -e`: a newline in a name would split
# the line, an ESC would reach the terminal, and a backslash sequence would
# become a control character. The id names the part exactly.
_HETZNER_JQ_SHOWN_NAME="${VERBOSE_JQ_SHOWN_NAME}"

# hetzner::_destroy_resources <cluster_name> [<confirmed plan>]
# Sets _HETZNER_DESTROY_ROWS: one "<resource>\t<id>\t<name>" line (the name
# as shown_name gives it) per hcloud resource that carries lok8s.dev/cluster=<cluster_name> AND the owner mark
# of this cluster (hetzner::owner_mark), in the order provider::destroy
# deletes them. READ-ONLY. A resource with the cluster label and no mark, or
# the mark of another cluster, is not in it: it goes to
# _HETZNER_DESTROY_KEPT (the same line format), and a warning on stderr names
# it, says why and gives the one-time command that marks it. Two domains with
# the same cluster_name in one Hetzner project have two marks, so the destroy
# of one never lists the parts of the other. A list that fails, or a mark
# that cannot be calculated, stops it (rc 1): an empty list must mean "no
# resource", never "hcloud did not answer". hcloud applies the -l selector
# on the API side, so a part with another cluster label is normally not in
# the list at all (a part of a confirmed plan that is not listed gets the
# warning of hetzner::_confirmed_rows). The cluster label of each part is
# checked again all the same: a part that the list gives with another
# cluster label, or none, is in neither list, also when it has the mark of
# this cluster. It goes into _HETZNER_DESTROY_SKIPPED as
# "<resource>\t<id>\t<name>\t<reason>", and the last lines of the destroy
# name it (hetzner::_kept_summary). A warning names it at once too. With a
# confirmed plan (the destroy after `lo destroy` showed the plan and its
# warnings), the list does not repeat a warning that the plan showed: it
# warns only for a kept or foreign part that the plan names as a part to
# delete (the plan showed no warning for it). It does not warn for a kept
# or foreign part that the plan does not name: the plan warned for it when
# its list gave the part. A part that is new since the plan thus gets no
# warning; the last lines of the destroy name it all the same (a kept part
# in the line that counts the kept parts). For a foreign part that the
# plan names, the reason says that the plan named it: the provider knows
# the plan and the label now, not when or whether the label changed.
# Globals, not stdout: the caller needs the lists, and a command
# substitution keeps no variable.
hetzner::_destroy_resources() {
  local cluster="${1}" plan="${2:-}" key="${_HETZNER_OWNER_KEY}" selector="lok8s.dev/cluster=${1}"
  local mark resource json marked skipped foreign line rid rmark rname why
  local -A shown=()
  _HETZNER_DESTROY_ROWS="" _HETZNER_DESTROY_KEPT="" _HETZNER_DESTROY_SKIPPED=""
  # The "<resource>\t<id>" of each line of the plan (split at each tab, a
  # trailing CR dropped, as hetzner::_confirmed_rows reads it).
  while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ "${line}" == *$'\t'* ]] || continue
    rid="${line#*$'\t'}"
    shown["${line%%$'\t'*}"$'\t'"${rid%%$'\t'*}"]=1
  done <<<"${plan}"
  mark="$(hetzner::owner_mark "${cluster}")" || return 1
  for resource in "${_HETZNER_DESTROY_ORDER[@]}"; do
    # Three passes over one list: the parts with the cluster label and the
    # mark; the parts with the cluster label and another mark or none, as
    # "<id>\t<mark>\t<name>" (the mark is empty when the part has none); and
    # the parts with another cluster label or none, as
    # "<id>\t<cluster label>\t<name>". Each pass gives the name as the plan
    # and the warnings show it (shown_name): the destroy and its plan use
    # the names only to show them (a delete and the check of a confirmed
    # plan use the kind and the id).
    if ! json="$(hcloud "${resource}" list -o json -l "${selector}")" ||
       ! marked="$(jq -r --arg r "${resource}" --arg key "${key}" --arg mark "${mark}" --arg c "${cluster}" "${_HETZNER_JQ_SHOWN_NAME}"'
           (. // [])[] | select(((.labels // {})["lok8s.dev/cluster"] // "") == $c)
           | select(((.labels // {})[$key] // "") == $mark)
           | [$r, (.id | tostring), (.name // "" | shown_name)] | @tsv' <<<"${json}")" ||
       ! skipped="$(jq -r --arg key "${key}" --arg mark "${mark}" --arg c "${cluster}" "${_HETZNER_JQ_SHOWN_NAME}"'
           (. // [])[] | select(((.labels // {})["lok8s.dev/cluster"] // "") == $c)
           | ((.labels // {})[$key] // "") as $m | select($m != $mark)
           | [(.id | tostring), $m, (.name // "" | shown_name)] | @tsv' <<<"${json}")" ||
       ! foreign="$(jq -r --arg c "${cluster}" "${_HETZNER_JQ_SHOWN_NAME}"'
           (. // [])[] | ((.labels // {})["lok8s.dev/cluster"] // "") as $l | select($l != $c)
           | [(.id | tostring), $l, (.name // "" | shown_name)] | @tsv' <<<"${json}")"; then
      error "hetzner: could not list the ${resource} resources with ${selector}. The hetzner provider deleted no resource in this step. Check the hcloud token and the API, then run the destroy again."
      return 1
    fi
    while IFS= read -r line; do
      [[ -n "${line}" ]] || continue
      rid="${line%%$'\t'*}" line="${line#*$'\t'}"
      rmark="${line%%$'\t'*}" rname="${line#*$'\t'}"
      if [[ -n "${shown["${resource}"$'\t'"${rid}"]:-}" ]]; then
        why="the plan named it, and now it has lok8s.dev/cluster=${rmark:-<none>}, not ${selector}"
      else
        why="it has lok8s.dev/cluster=${rmark:-<none>}, not ${selector}"
      fi
      _HETZNER_DESTROY_SKIPPED+="${resource}"$'\t'"${rid}"$'\t'"${rname}"$'\t'"${why}"$'\n'
      [[ -z "${plan}" || -n "${shown["${resource}"$'\t'"${rid}"]:-}" ]] || continue
      warn "hetzner: skipped ${resource} ${rid} ${rname}: the list of the parts with ${selector} gave it, but it has lok8s.dev/cluster=${rmark:-<none>}. lok8s does not delete a part of another cluster."
    done <<<"${foreign}"
    [[ -z "${marked}" ]] || _HETZNER_DESTROY_ROWS+="${marked}"$'\n'
    # Split at each tab by hand: `IFS=$'\t' read` joins two tabs, and an
    # empty mark would shift the name into it.
    while IFS= read -r line; do
      [[ -n "${line}" ]] || continue
      rid="${line%%$'\t'*}" line="${line#*$'\t'}"
      rmark="${line%%$'\t'*}" rname="${line#*$'\t'}"
      _HETZNER_DESTROY_KEPT+="${resource}"$'\t'"${rid}"$'\t'"${rname}"$'\n'
      [[ -z "${plan}" || -n "${shown["${resource}"$'\t'"${rid}"]:-}" ]] || continue
      if [[ -z "${rmark}" ]]; then
        warn "hetzner: skipped ${resource} ${rid} ${rname}: it has lok8s.dev/cluster=${cluster}, but not the owner mark of this cluster (${key}=${mark}). lok8s does not delete a part that can belong to another person or cluster. If it is a part of this cluster (an older lok8s made it), first make sure that id ${rid} is yours ('hcloud ${resource} describe ${rid}'), then mark it one time: hcloud ${resource} add-label ${rid} ${key}=${mark}. Then run lo destroy again, or delete it yourself."
      else
        warn "hetzner: skipped ${resource} ${rid} ${rname}: it has lok8s.dev/cluster=${cluster}, but the owner mark of another cluster (${key}=${rmark}; this cluster: ${mark}). lok8s does not delete it. Replace the mark only when you know that the mark ${rmark} is yours (for example, the mark of this cluster under its old domain; the guide shows how to calculate it): hcloud ${resource} add-label --overwrite ${rid} ${key}=${mark}."
      fi
    done <<<"${skipped}"
  done
  _HETZNER_DESTROY_ROWS="${_HETZNER_DESTROY_ROWS%$'\n'}"
  _HETZNER_DESTROY_KEPT="${_HETZNER_DESTROY_KEPT%$'\n'}"
  _HETZNER_DESTROY_SKIPPED="${_HETZNER_DESTROY_SKIPPED%$'\n'}"
}

# hetzner::_kept_summary <cluster_name> <kept> [<skipped>]
# The last lines of a destroy. First one line for each part that the check
# of the cluster label skipped (<skipped>: the
# "<resource>\t<id>\t<name>\t<reason>" lines of _HETZNER_DESTROY_SKIPPED):
# its kind, id, name and reason. Then, last, the line of a destroy that kept
# parts: how many parts with lok8s.dev/cluster=<cluster_name> it did not
# delete because they do not have the owner mark of this cluster, of which
# kinds, and each part with its kind, id and name in single quotes (<kept>:
# the "<resource>\t<id>\t<name>" lines of _HETZNER_DESTROY_KEPT), in the
# delete order. It names at most 10 parts, then "and <n> more". That line
# names the kept parts itself: a part that is new since the plan got no
# "hetzner: skipped" warning, and the skipped lines directly above it name
# other parts. With <skipped> and <kept> both empty, it prints nothing.
# With only <kept> empty, the last skipped line is the last line. The
# destroy leaves these parts on purpose, so it still exits 0; the lines say
# that they exist. hetzner::_destroy_resources gives each name through
# shown_name, so no name can split a line, send a control character to the
# terminal or turn the text around.
hetzner::_kept_summary() {
  local cluster_name="${1}" kept="${2}" skipped="${3:-}" kind t n total=0 kinds="" names="" line rid rname
  local max=10
  local -A count=()
  # Split at each tab by hand: an empty name would shift the reason.
  while IFS= read -r line; do
    [[ -n "${line}" ]] || continue
    kind="${line%%$'\t'*}" line="${line#*$'\t'}"
    rid="${line%%$'\t'*}" line="${line#*$'\t'}"
    rname="${line%%$'\t'*}"
    warn "lo destroy: skipped ${kind} ${rid}${rname:+ ${rname}}: ${line#*$'\t'}. lok8s did not delete it."
  done <<<"${skipped}"
  # The name is the last field, so a read at the tabs cannot shift it.
  while IFS=$'\t' read -r kind rid rname; do
    [[ -n "${kind}" ]] || continue
    count["${kind}"]=$(( ${count["${kind}"]:-0} + 1 ))
    total=$(( total + 1 ))
    (( total <= max )) || continue
    names+="${names:+, }${kind} ${rid}"
    [[ -z "${rname}" ]] || names+=" '${rname}'"
  done <<<"${kept}"
  (( total > 0 )) || return 0
  (( total <= max )) || names+=", and $(( total - max )) more"
  for t in "${_HETZNER_DESTROY_ORDER[@]}"; do
    n="${count["${t}"]:-0}"
    (( n > 0 )) || continue
    kinds+="${kinds:+, }${n} ${t}"
    (( n == 1 )) || kinds+="s"
  done
  local noun="resources" verb="do" act="Delete them by hand only if they are yours and you want them gone."
  (( total > 1 )) || noun="resource" verb="does" act="Delete it by hand only if it is yours and you want it gone."
  warn "lo destroy: kept ${total} ${noun} with lok8s.dev/cluster=${cluster_name} that ${verb} not have the owner mark of this cluster (${kinds}): ${names}. ${act}"
}

# hetzner::_confirmed_rows <cluster_name> <listed> [<kept>] [<skipped>]
# Check LOK8S_DESTROY_PLAN against the live list and set
# _HETZNER_CONFIRMED_ROWS to the rows to delete: plan ∩ live list, as
# "<resource>\t<id>\t<name>" lines. A plan line is split at each tab (a
# double tab is an empty field), a trailing CR is dropped. rc 1, nothing
# set, when the plan is empty, does not start with the cluster line of
# <cluster_name>, or has a line whose type is not exactly one of
# _HETZNER_DESTROY_ORDER or whose id is not a number: one bad line refuses
# the whole plan. A plan row that is not live gets a warning, except a row
# in <kept> (the lines of _HETZNER_DESTROY_KEPT: the list warned for it) or
# in <skipped> (the lines of _HETZNER_DESTROY_SKIPPED: the last lines of the
# destroy name it, with the reason). A live row that is not in the plan
# gets the warning that it is kept, with its name from <listed>
# (hetzner::_destroy_resources gives it through shown_name).
hetzner::_confirmed_rows() {
  local cluster_name="${1}" listed="${2}" kept="${3:-}" skipped="${4:-}" line kind rid rname rest planned header=1 t known
  local -A live=() was_kept=()
  _HETZNER_CONFIRMED_ROWS=""
  while IFS=$'\t' read -r kind rid rname; do
    [[ -n "${kind}" ]] || continue
    live["${kind}"$'\t'"${rid}"]="${kind}"$'\t'"${rid}"$'\t'"${rname}"
  done <<<"${listed}"
  while IFS=$'\t' read -r kind rid _; do
    [[ -z "${kind}" ]] || was_kept["${kind}"$'\t'"${rid}"]=1
  done <<<"${kept}"$'\n'"${skipped}"

  local rows="" key
  local -A planned_keys=()
  while IFS= read -r line; do
    line="${line%$'\r'}"
    [[ -n "${line}" ]] || continue
    kind="${line%%$'\t'*}" rest="" rname=""
    [[ "${line}" != *$'\t'* ]] || rest="${line#*$'\t'}"
    rid="${rest%%$'\t'*}"
    [[ "${rest}" != *$'\t'* ]] || rname="${rest#*$'\t'}"
    if (( header )); then
      header=0
      planned="${rid}"
      if [[ "${kind}" != "cluster" ]]; then
        error "hetzner: the confirmed destroy plan does not start with its cluster line (it starts with '${line//$'\t'/ }'). The hetzner provider deleted no resource in this step. Run lo destroy again."
        return 1
      fi
      if [[ "${planned}" != "${cluster_name}" ]]; then
        error "hetzner: the confirmed destroy plan is for cluster_name '${planned}', but the descriptor has '${cluster_name}'. The hetzner provider deleted no resource in this step. Run lo destroy again."
        return 1
      fi
      continue
    fi
    known=0
    for t in "${_HETZNER_DESTROY_ORDER[@]}"; do
      [[ "${kind}" != "${t}" ]] || known=1
    done
    if (( ! known )) || [[ ! "${rid}" =~ ^[1-9][0-9]*$ ]]; then
      error "hetzner: the confirmed destroy plan has a line that lo destroy does not write: '${line//$'\t'/ }' (the type must be one of ${_HETZNER_DESTROY_ORDER[*]}, the id a number). The hetzner provider deleted no resource in this step. Run lo destroy again."
      return 1
    fi
    key="${kind}"$'\t'"${rid}"
    planned_keys["${key}"]=1
    if [[ -n "${live[${key}]:-}" ]]; then
      rows+="${live[${key}]}"$'\n'
    elif [[ -z "${was_kept[${key}]:-}" ]]; then
      warn "hetzner: skipped ${kind} ${rid} of the confirmed plan: no ${kind} with this id carries lok8s.dev/cluster=${cluster_name} and the owner mark of this cluster now. It is gone, or it is not of this cluster."
    fi
  done <<<"${LOK8S_DESTROY_PLAN}"

  if (( header )); then
    error "hetzner: the confirmed destroy plan is empty. The hetzner provider deleted no resource in this step. Run lo destroy again."
    return 1
  fi

  while IFS=$'\t' read -r kind rid rname; do
    [[ -n "${kind}" && -z "${planned_keys[${kind}$'\t'${rid}]:-}" ]] || continue
    warn "hetzner: kept ${kind} ${rid} ${rname} (lok8s.dev/cluster=${cluster_name}): it is not in the confirmed plan. Delete it by hand, or run lo destroy again."
  done <<<"${listed}"
  _HETZNER_CONFIRMED_ROWS="${rows}"
}

provider::destroy() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  local cluster_name rows listed
  cluster_name="$(hetzner::_destroy_cluster_name "${config_file}")" || return 1
  debug "destroying hetzner resources for ${cluster_name}"

  # The live list: what carries lok8s.dev/cluster=<cluster_name> and the
  # owner mark of this cluster now. Every delete below is in it. A list that
  # fails, or a mark that cannot be calculated, stops the destroy. The parts
  # with the cluster label and without this mark stay (kept); the last line
  # of the destroy counts and names them. With a confirmed plan, `lo
  # destroy` showed the plan and a warning for each such part that its list
  # gave: this list does not repeat them, and a part that is new since the
  # plan gets no warning. It warns for a part of the plan that lost its
  # mark since. A part that the list gives with another cluster label (the
  # list did not apply its selector) is skipped; the last lines of the
  # destroy name each one, with the reason. A part of the plan that the
  # list does not give (it is gone, or its cluster label changed) gets the
  # warning of hetzner::_confirmed_rows.
  local kept skipped
  hetzner::_destroy_resources "${cluster_name}" "${LOK8S_DESTROY_PLAN:-}" || return 1
  listed="${_HETZNER_DESTROY_ROWS}" kept="${_HETZNER_DESTROY_KEPT}" skipped="${_HETZNER_DESTROY_SKIPPED}"

  if [[ -n "${LOK8S_DESTROY_PLAN:-}" ]]; then
    # `lo destroy` showed this plan and the operator confirmed it: delete
    # these resources and no others. kubeone reset ran in between, so the
    # live list can differ. The plan is checked line by line, because the
    # variable comes from the environment: an allowed type and a numeric id
    # only, else nothing is deleted. A plan id that is not in the live list
    # is not deleted (it is gone, or it lost the label or the mark); a live
    # resource that is not in the plan stays.
    hetzner::_confirmed_rows "${cluster_name}" "${listed}" "${kept}" "${skipped}" || return 1
    rows="${_HETZNER_CONFIRMED_ROWS}"
  else
    rows="${listed}"
  fi

  local resource id type
  for type in "${_HETZNER_DESTROY_ORDER[@]}"; do
    while IFS=$'\t' read -r resource id _; do
      [[ "${resource}" == "${type}" && -n "${id}" ]] || continue
      debug "deleting ${resource} ${id}"
      hcloud "${resource}" delete "${id}" 2>/dev/null || true
    done <<<"${rows}"
  done

  debug "hetzner destroy complete for ${cluster_name}"
  hetzner::_kept_summary "${cluster_name}" "${kept}" "${skipped}"
}

# ── Optional hook: destroy_plan ──────────────────────────
#
# provider::destroy_plan <config_file> <work_dir>
#   READ-ONLY. What provider::destroy would delete. Line 1 is
#   "cluster<TAB><cluster_name>", then one "<resource><TAB><id><TAB><name>"
#   line per resource (the name as shown_name gives it: no control,
#   backslash, bidi or zero-width character). provider::destroy deletes each resource in the
#   token's project that carries lok8s.dev/cluster=<cluster_name> and the
#   owner mark of this cluster, so `lo destroy` shows this list, refuses a
#   cluster_name that another domain also uses, and asks for the
#   cluster_name before it deletes anything. A resource with the cluster
#   label and without this mark is not in the list: a warning on stderr
#   shows it as skipped, with the reason and the command that marks it. The
#   confirmed plan comes back to provider::destroy in LOK8S_DESTROY_PLAN.
#   Fails (rc 1) when the descriptor has no cluster_name, the mark cannot be
#   calculated or a list fails.
provider::destroy_plan() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  local cluster_name rows
  cluster_name="$(hetzner::_destroy_cluster_name "${config_file}")" || return 1
  hetzner::_destroy_resources "${cluster_name}" || return 1
  rows="${_HETZNER_DESTROY_ROWS}"
  printf 'cluster\t%s\n' "${cluster_name}"
  [[ -z "${rows}" ]] || printf '%s\n' "${rows}"
}

# ── Standard output ──────────────────────────────────────

provider::output() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # The envsubst'd descriptor: the cluster_name that the create loop used for
  # the owner mark (the raw file can hold a ${VAR}).
  local desc cluster_name ssh_user mark
  desc="$(template::descriptor_json "${config_file}")" || return 1
  cluster_name="$(jq -r '.cluster_name // ""' <<<"${desc}")"
  mark="$(hetzner::owner_mark "${cluster_name}")" || return 1
  ssh_user=$(_cfg '.sshUser // .cloudInit.user // "root"')

  # The inventory holds only the parts with the owner mark of this cluster.
  # The cluster label alone is not enough: a part of another person or
  # cluster can carry it, and it would become the API endpoint, the private
  # network of the CCM or a host. Each list is checked again in jq.
  local key="${_HETZNER_OWNER_KEY}" cluster_sel="lok8s.dev/cluster=${cluster_name}"
  local servers_json lb_json net_json declared_json
  if ! servers_json=$(hcloud server list -o json -l "${cluster_sel}") ||
     ! lb_json=$(hcloud load-balancer list -o json -l "${cluster_sel},${key}=${mark}") ||
     ! net_json=$(hcloud network list -o json -l "${key}=${mark}"); then
    error "hetzner: could not list the servers, load balancers or networks of cluster ${cluster_name}. Check the hcloud token and the API."
    return 1
  fi
  declared_json="$(jq -c '[(.server // [])[].name // empty]' <<<"${desc}")"
  # A declared server with the cluster label and without the mark: left out.
  local unmarked unmarked_id
  while IFS=$'\t' read -r unmarked unmarked_id; do
    [[ -n "${unmarked}" ]] || continue
    warn "hetzner: server ${unmarked} is left out of the inventory: it does not have the owner mark of this cluster (${key}=${mark}). If it is a server of this cluster (an older lok8s made it), mark it one time: hcloud server add-label ${unmarked_id} ${key}=${mark}"
  done < <(jq -r --arg key "${key}" --arg mark "${mark}" --argjson declared "${declared_json}" '
    (. // [])[] | select((.labels // {})[$key] != $mark)
    | select(.name as $n | any($declared[]; . == $n)) | [.name, (.id | tostring)] | @tsv' <<<"${servers_json}")
  servers_json="$(jq -c --arg key "${key}" --arg mark "${mark}" --arg c "${cluster_name}" '
    [ (. // [])[] | select((.labels // {})[$key] == $mark and (.labels // {})["lok8s.dev/cluster"] == $c) ]' <<<"${servers_json}")" || return 1
  lb_json="$(jq -c --arg key "${key}" --arg mark "${mark}" --arg c "${cluster_name}" '
    [ (. // [])[] | select((.labels // {})[$key] == $mark and (.labels // {})["lok8s.dev/cluster"] == $c) ]' <<<"${lb_json}")" || return 1
  # The network: the descriptor's network[0] by name when it names one, else
  # the one with the cluster label. Both only with the owner mark (lok8s sets
  # the mark at create; a network has no cluster label unless the descriptor
  # gives it one).
  local net_name_desc
  net_name_desc="$(jq -r '.network[0].name // ""' <<<"${desc}")"
  net_json="$(jq -c --arg key "${key}" --arg mark "${mark}" --arg n "${net_name_desc}" --arg c "${cluster_name}" '
    [ (. // [])[] | select((.labels // {})[$key] == $mark)
      | select(if $n != "" then .name == $n else (.labels // {})["lok8s.dev/cluster"] == $c end) ]' <<<"${net_json}")" || return 1

  local lb_address lb_private
  lb_address=$(echo "${lb_json}" | jq -r '.[0].public_net.ipv4.ip // empty' 2>/dev/null || echo "")
  # The LB's PRIVATE IP (on the attached network, = k8sServiceHost). The apiserver
  # serving cert must cover it as a SAN or CP (re)joins fail "apiserver cert not
  # valid for <ip>". Surfaced so _append_inventory adds it to alternativeNames
  # automatically (no manual KUBEONE_EXTRA_SANS).
  lb_private=$(echo "${lb_json}" | jq -r '.[0].private_net[0].ip // empty' 2>/dev/null || echo "")

  # Build access array from SSH key entries in the descriptor
  local access="[]"
  local ssh_private_key ssh_public_key
  ssh_private_key=$(_cfg '.sshPrivateKey // ""' 2>/dev/null || echo "")
  ssh_public_key=$(_cfg '.sshPublicKey // ""' 2>/dev/null || echo "")

  # Default access entry for cloud VMs
  access=$(jq -n \
    --arg user "${ssh_user}" \
    --arg privkey "${ssh_private_key}" \
    --arg pubkey "${ssh_public_key}" \
    '[{"id": "default", "type": "ssh", "user": $user, "port": 22, "privateKey": $privkey, "publicKey": $pubkey}]')

  # Check for bare metal servers with different access
  if [[ -f "${config_file}" ]]; then
    local desc
    # Normalize to JSON (yq reads JSON too) so bare-metal extraction works for a
    # YAML descriptor, matching how _cfg/desc are resolved elsewhere.
    desc=$(template::descriptor_json "${config_file}") || return 1
    local has_root
    has_root=$(echo "${desc}" | jq '[.server[]? | select(.["#cloud.root"] == "true")] | length')
    if (( has_root > 0 )); then
      local robot_key
      robot_key=$(echo "${desc}" | jq -r '.server[]? | select(.["#cloud.root"] == "true") | .["#ssh-private-key"] // "" | select(. != "")' | head -1)
      access=$(echo "${access}" | jq \
        --arg user "${ssh_user}" \
        --arg privkey "${robot_key:-${ssh_private_key}}" \
        '. + [{"id": "dedicated", "type": "ssh", "user": $user, "port": 22, "privateKey": $privkey}]')
    fi
  fi

  local nodes="[]"

  # Cloud VMs from hcloud
  local server
  while IFS= read -r server; do
    [[ -n "${server}" ]] || continue
    local name pub_ip priv_ip role group
    name=$(echo "${server}" | jq -r '.name')
    pub_ip=$(echo "${server}" | jq -r '.public_net.ipv4.ip')
    priv_ip=$(echo "${server}" | jq -r '.private_net[0].ip // .public_net.ipv4.ip')
    role=$(echo "${server}" | jq -r '.labels["lok8s.dev/role"] // "worker"')
    group=$(echo "${server}" | jq -r '.labels["lok8s.dev/group"] // "default"')
    # Node labels to stamp on the k8s Node (via kubeone labelNodes). Carry every
    # hcloud server label EXCEPT the lok8s.dev/{cluster,group} orchestration
    # keys (those select infra, they are not node taxonomy). This is how the
    # tier.kubehz.cloud/* + capability.* + role.kubehz.cloud/platform taxonomy
    # reaches the Node.
    # lok8s.dev/role stays: it is the role this inventory gives the node, and
    # workloads select cloud workers by it (nodeSelector lok8s.dev/role=worker).
    # A machine-controller worker carries it from its MachineDeployment; a
    # static cloud worker lost it in the 2026-10-24 rebuild, and the Pods that
    # select it stayed Pending. The bare-metal path below still drops it.
    local node_labels
    # The owner mark selects the part too; it is no Node label.
    node_labels=$(echo "${server}" | jq -c --arg key "${_HETZNER_OWNER_KEY}" '(.labels // {}) | del(.["lok8s.dev/cluster"], .["lok8s.dev/group"], .[$key])')
    node_labels=$(_validate_node_labels "${node_labels}" "${name}")

    nodes=$(echo "${nodes}" | jq \
      --arg name "${name}" --arg role "${role}" --arg group "${group}" \
      --arg pub "${pub_ip}" --arg priv "${priv_ip}" \
      --arg user "${ssh_user}" --argjson labels "${node_labels}" \
      '. + [{"name": $name, "role": $role, "group": $group, "public_ip": $pub, "private_ip": $priv, "access": "default", "ssh_user": $user, "ssh_port": 22, "labels": $labels}]')
  done < <(echo "${servers_json}" | jq -c '.[]')

  # Bare metal servers from JSON descriptor (#cloud.root with #external-ip)
  if [[ -f "${config_file}" ]]; then
    local desc
    desc="${desc:-$(template::descriptor_json "${config_file}")}"
    while IFS= read -r server; do
      [[ -n "${server}" ]] || continue
      local name pub_ip priv_ip labels role group
      name=$(echo "${server}" | jq -r '.name')
      pub_ip=$(echo "${server}" | jq -r '.["#external-ip"] // empty')
      [[ -n "${pub_ip}" ]] || continue
      priv_ip=$(echo "${server}" | jq -r '.["#internal-ip"] // .["#external-ip"]')
      labels=$(echo "${server}" | jq -r '.["#labels"] // ""')
      role="worker"
      group="dedicated"
      [[ "${labels}" != *"role=control-plane"* ]] || role="control-plane"
      # Parse the comma-separated "k=v,k=v" #labels string into a node-label map,
      # dropping the lok8s.dev/{cluster,role,group} orchestration keys (same rule
      # as the cloud-VM path). Also drop the bare `role` key: `role=control-plane`
      # is an orchestration SELECTOR consumed above to set the node role — it is
      # not node taxonomy and must not survive as a Node label. Everything else —
      # the tier.kubehz.cloud/*, capability.*, role.kubehz.cloud/platform taxonomy
      # — becomes a Node label kubeone stamps on provision AND recover.
      # split("=") then rejoin .[1:] so a value that itself contains "=" (e.g.
      # base64 padding, k=a=b) is preserved intact instead of truncated at the
      # first "=". select((.[0]|length) > 0) drops a leading "=" / empty key
      # ("=orphan") which would otherwise emit a "" label key.
      # lok8s.dev/role stays dropped here, unlike on a cloud VM: a bare-metal
      # Node never carried it, and a consumer can select cloud workers by
      # lok8s.dev/role=worker to keep a workload off bare metal. Adding it
      # would move those workloads onto the bare-metal nodes.
      local node_labels
      node_labels=$(echo "${labels}" | jq -R -c 'split(",") | map(select(length>0) | split("=") | select((.[0]|length) > 0) | {(.[0]): (.[1:]|join("="))}) | add // {}
        | del(.["lok8s.dev/cluster"], .["lok8s.dev/role"], .["lok8s.dev/group"], .["role"])')
      node_labels=$(_validate_node_labels "${node_labels}" "${name}")

      nodes=$(echo "${nodes}" | jq \
        --arg name "${name}" --arg role "${role}" --arg group "${group}" \
        --arg pub "${pub_ip}" --arg priv "${priv_ip}" \
        --arg user "${ssh_user}" --argjson labels "${node_labels}" \
        '. + [{"name": $name, "role": $role, "group": $group, "public_ip": $pub, "private_ip": $priv, "access": "dedicated", "ssh_user": $user, "ssh_port": 22, "labels": $labels}]')
    done < <(echo "${desc}" | jq -c '.server[]? | select(.["#cloud.root"] == "true")')
  fi

  local net_id net_name net_cidr
  net_id=$(echo "${net_json}" | jq -r '.[0].id // empty' 2>/dev/null || echo "")
  net_name=$(echo "${net_json}" | jq -r '.[0].name // empty' 2>/dev/null || echo "")
  net_cidr=$(echo "${net_json}" | jq -r '.[0].ip_range // empty' 2>/dev/null || echo "")

  jq -n \
    --arg ep "${lb_address}" \
    --arg eppriv "${lb_private}" \
    --argjson access "${access}" \
    --argjson nodes "${nodes}" \
    --arg net_id "${net_id}" --arg net_name "${net_name}" --arg net_cidr "${net_cidr}" \
    '{
      "api": {"endpoint": $ep, "privateEndpoint": $eppriv, "port": 6443},
      "access": $access,
      "nodes": $nodes,
      "network": {"id": $net_id, "name": $net_name, "cidr": $net_cidr}
    }'
}

# provider::status <config_file>
# Running | Partial (<n>/<total> running) | NotFound, over the servers with
# lok8s.dev/cluster=<cluster_name> (the label is checked again, not only by
# the list query). When some of them do not have the owner mark of this
# cluster, the status says how many: lo destroy keeps such a server, and
# the inventory leaves it out. When the mark cannot be calculated (no
# PROVIDER_DOMAIN), the status says that the mark is not known.
provider::status() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  local cluster_name
  cluster_name=$(_cfg '.cluster_name // ""')

  local servers_json running total mark unmarked marks=""
  servers_json=$(hcloud server list -o json -l "lok8s.dev/cluster=${cluster_name}")
  servers_json=$(jq -c --arg c "${cluster_name}" \
    '[(. // [])[] | select(((.labels // {})["lok8s.dev/cluster"] // "") == $c)]' <<<"${servers_json}")
  total=$(echo "${servers_json}" | jq 'length')
  running=$(echo "${servers_json}" | jq '[.[] | select(.status == "running")] | length')

  if (( total > 0 )); then
    if mark="$(hetzner::owner_mark "${cluster_name}" 2>/dev/null)"; then
      unmarked=$(jq --arg key "${_HETZNER_OWNER_KEY}" --arg mark "${mark}" \
        '[.[] | select(((.labels // {})[$key] // "") != $mark)] | length' <<<"${servers_json}")
      local servers="servers"
      (( total > 1 )) || servers="server"
      (( unmarked == 0 )) || marks="${unmarked} of ${total} ${servers} without the owner mark of this cluster"
    else
      marks="the owner mark of this cluster is not known"
    fi
  fi

  if (( total == 0 )); then echo "NotFound"
  elif (( running == total )); then echo "Running${marks:+ (${marks})}"
  else echo "Partial (${running}/${total} running${marks:+; ${marks}})"; fi
}

# ── Optional hook: rebuild ───────────────────────────────
#
# provider::rebuild <config_file> <work_dir>
#   Reset the descriptor's EXISTING nodes to the state provider::provision
#   expects for a fresh install — WITHOUT recreating the cloud resources
#   (IPs, network, load-balancer are preserved). Descriptor-driven: it acts
#   ONLY on the servers declared in the descriptor.
#     • Cloud VMs (no #cloud.root)  → reimaged in place via `hcloud server
#       rebuild --image <descriptor image> --user-data-from-file <fresh
#       cloud-init>` (same generator provision's create hook uses).
#     • Bare-metal (#cloud.root)    → booted into the Robot rescue system
#       (activate rescue with the descriptor key's fingerprint + hardware
#       reset), ready for installimage.
#   Barrier: waits until every cloud VM reports cloud-init done AND every
#   bare-metal node is in rescue. Returns non-zero if any node fails.
#
#   It does NOT wipe data disks: that is the descriptor's #wipe-devices
#   feature, honored by provision's installimage hook — re-adding an inline
#   wipe here would double-wipe. This hook is DESTRUCTIVE (it reimages nodes)
#   but does not prompt: the caller (a future `lo recover`) owns consent.
provider::rebuild() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  local work_dir="${2:-/tmp}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  [[ -f "${config_file}" ]] || { error "config not found: ${config_file}"; return 1; }
  mkdir -p "${work_dir}"
  export CLOUD_LOG_FILE="${work_dir}/hetzner-rebuild.log"
  : > "${CLOUD_LOG_FILE}"
  _hetzner_log "rebuild started: config=${config_file} work_dir=${work_dir}"

  # Dry-run plumbing (shared with provision's dry-run::cmd): with CLOUD_DRY_RUN
  # every destructive action is PRINTED instead of executed, so a future
  # `lo recover --dry-run` prints the full plan and reimages NOTHING. dry-run::cmd
  # needs a writable CLOUD_DRY_RUN_PATH — default it under work_dir if the caller
  # left it unset.
  [[ -z "${CLOUD_DRY_RUN:-}" || -n "${CLOUD_DRY_RUN_PATH:-}" ]] || \
    CLOUD_DRY_RUN_PATH="${work_dir}/dry-run"

  # Load the descriptor (JSON, or YAML → JSON) exactly like provision.
  local desc
  desc="$(template::descriptor_json "${config_file}")" || return 1

  # Cluster label — the scope EVERY destructive call is confined to, exactly as
  # provider::destroy / provider::output do. No cluster_name → refuse to act.
  local cluster_name selector
  cluster_name="$(echo "${desc}" | jq -r '.cluster_name // ""')"
  [[ -n "${cluster_name}" ]] || {
    error "rebuild: descriptor has no cluster_name — refusing to act"; return 1; }
  # Only a server with the owner mark of this cluster is reimaged.
  local mark
  mark="$(hetzner::owner_mark "${cluster_name}")" || return 1
  selector="lok8s.dev/cluster=${cluster_name},${_HETZNER_OWNER_KEY}=${mark}"

  # Resolved inventory (descriptor + live cloud state) → per-node public IPs.
  local inv
  inv="$(provider::output "${config_file}")" || {
    error "rebuild: could not resolve inventory (provider::output failed)"; return 1; }

  # Cloud-init generation environment (shared with provider::provision).
  local cc_script="${PATH_LOK8S}/providers/hetzner/cloud-config"
  [[ ! -f "${cc_script}" ]] || {
    # shellcheck source=/dev/null
    source "${cc_script}"
  }
  hetzner::_export_cloudinit_env "${config_file}" || return 1

  # The rebuild user-data authorizes the descriptor's sshPublicKey.
  # `hcloud server rebuild` keeps only the SSH keys the server was created
  # with: a cloud VM that lok8s did not create (a machine-controller VM the
  # descriptor adopted) came back with no key lok8s can use (2026-10-24).
  # cloud-config::generate reads CLOUD_SSH_AUTHORIZED_KEYS. It is local, so a
  # provision that runs later in the same shell does not inherit it.
  local CLOUD_SSH_AUTHORIZED_KEYS="" cloud_count pubkey
  cloud_count="$(echo "${desc}" | jq '[(.server // [])[] | select(.["#cloud.root"] != "true")] | length')"
  pubkey="$(echo "${desc}" | jq -r '.sshPublicKey // ""')"
  if (( cloud_count > 0 )); then
    if [[ -z "${pubkey}" ]]; then
      warn "rebuild: the descriptor has no sshPublicKey. A rebuilt cloud VM keeps only the SSH keys it was created with, so a VM that lok8s did not create can lose SSH access. Set sshPublicKey to the public key of sshPrivateKey."
    else
      CLOUD_SSH_AUTHORIZED_KEYS="$(hetzner::_authorized_key "${pubkey}")" || return 1
    fi
  fi

  # The readiness barrier connects with sshPrivateKey after the reimage. A
  # sshPublicKey of another pair reimages the nodes, and then the barrier
  # cannot reach them. Check the pair before anything is reimaged.
  hetzner::_check_key_pair "${pubkey}" "$(echo "${desc}" | jq -r '.sshPrivateKey // ""')" || return 1

  # Readiness-barrier SSH command (identity from the descriptor).
  local ssh_key
  ssh_key="$(echo "${desc}" | jq -r '.sshPrivateKey // ""')"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${ssh_key}" != "~/"* ]] || ssh_key="${HOME}/${ssh_key:2}"
  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=12
                 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
                 -o LogLevel=ERROR)
  [[ -z "${ssh_key}" ]] || ssh_cmd+=(-i "${ssh_key}")

  # Rescue-key fingerprint (bare-metal only) — from the descriptor public key
  # unless explicitly overridden. Derived once, reused for every worker.
  local fingerprint="${PROVIDER_ROBOT_RESCUE_FP:-}"

  local count
  count="$(echo "${desc}" | jq '(.server // []) | length')"

  # ── Phase 1 — ATOMIC PREFLIGHT (read-only) ──────────────────────────────
  # Resolve and validate EVERY node before touching anything: name sanity, a
  # resolvable public IP, and the destructive target itself — cloud VMs must
  # resolve to exactly one server with the cluster label and the owner mark
  # (its id goes into the plan: the reimage acts on that id, never on a
  # name); bare-metal nodes to exactly one Robot server whose IP equals the
  # descriptor #external-ip (NOT its non-unique free-text server_name). Any
  # failure aborts here with NOTHING reimaged/reset — no partial recovery, no
  # acting on a foreign box.
  # Each plan entry is one JSON object: its fields come back byte for byte
  # (a tab-separated line lost a tab at the end of a value).
  local -a plan=() cloud_ips=() metal_ips=()
  local -A checked_image=()
  local idx server name is_root pub image cloud_d ci num ext_ip sid
  for (( idx=0; idx<count; idx++ )); do
    server="$(echo "${desc}" | jq -c ".server[${idx}]")"
    name="$(echo "${server}" | jq -r '.name // ""')"
    [[ -n "${name}" ]] || { error "rebuild: server[${idx}] has no name — aborting"; return 1; }
    # Defense in depth: only ever act on plausible resource names.
    [[ "${name}" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || {
      error "rebuild: refusing suspicious server name '${name}'"; return 1; }
    is_root="$(echo "${server}" | jq -r '.["#cloud.root"] // ""')"
    pub="$(echo "${inv}" | jq -r --arg n "${name}" '.nodes[] | select(.name==$n) | .public_ip // empty')"
    # A node scheduled for rebuild MUST have a resolvable IP — else the barrier
    # can't confirm it reached its target state (it would be silently skipped
    # from the wait set), so we refuse rather than under-verify.
    [[ -n "${pub}" ]] || {
      error "rebuild: node '${name}' has no resolvable public IP in the inventory — aborting (touch nothing)"; return 1; }

    if [[ "${is_root}" == "true" ]]; then
      # ── Bare-metal: resolve to exactly ONE Robot server BY IP ──
      if [[ -z "${HROBOT_USER:-}" || -z "${HROBOT_PASSWORD:-}" ]]; then
        error "rebuild: bare-metal node '${name}' needs Robot creds (HROBOT_USER/HROBOT_PASSWORD)"; return 1
      fi
      # Here, not in hetzner::_robot_curl only: the Robot calls below send
      # their stderr to /dev/null, which would hide the variable's name.
      http::credential_ok HROBOT_USER HROBOT_PASSWORD || return 1
      if [[ -z "${fingerprint}" ]]; then
        fingerprint="$(hetzner::_rescue_fingerprint "$(echo "${desc}" | jq -r '.sshPublicKey // ""')")" || fingerprint=""
      fi
      [[ -n "${fingerprint}" ]] || {
        error "rebuild: cannot determine rescue key fingerprint for '${name}' (descriptor .sshPublicKey unreadable; set PROVIDER_ROBOT_RESCUE_FP)"; return 1; }
      ext_ip="$(echo "${server}" | jq -r '.["#external-ip"] // ""')"
      [[ -n "${ext_ip}" ]] || {
        error "rebuild: bare-metal node '${name}' has no #external-ip — cannot resolve it in Robot by IP"; return 1; }
      num="$(hetzner::_robot_server_number_by_ip "${ext_ip}")" || num=""
      [[ -n "${num}" ]] || {
        error "rebuild: bare-metal node '${name}' (${ext_ip}) did not resolve to exactly one Robot server by IP — refusing to rescue/reset (name/IP collision, no match, or Robot API error)"; return 1; }
      plan+=("$(jq -cn --arg name "${name}" --arg num "${num}" --arg fp "${fingerprint}" \
        '{kind: "metal", name: $name, a: $num, b: $fp}')")
      metal_ips+=("${pub}")
    else
      # ── Cloud VM: name must resolve to ONE server with the cluster label
      # and the owner mark; the plan keeps its id ──
      sid="$(hetzner::_cloud_server_id "${name}" "${selector}" "${mark}" "${cluster_name}")" || {
        error "rebuild: cloud node '${name}' does not resolve to exactly one server carrying ${selector} — refusing to reimage"; return 1; }
      # The image, checked as for a create (hetzner::_image_ok): an id must
      # be plain digits (hcloud reads "+4711" and "04711" as the id 4711), a
      # control character or a space at an end is refused, and a snapshot
      # or backup id needs the owner mark. The reimage gets the value that
      # the check passed, byte for byte (compared at the reimage).
      _HETZNER_REFUSED=()
      _HETZNER_LISTS=()
      hetzner::_image_ok server "${name}" "$(echo "${server}" | jq -c '.image // "ubuntu-24.04"')" "${mark}" || {
        hetzner::_print_refused
        error "rebuild: nothing was reimaged."; return 1; }
      image="${REPLY}"
      cloud_d="$(echo "${server}" | jq -r '.["#cloud.d"] // ""')"
      declare -F cloud-config::generate &>/dev/null || {
        error "rebuild: cloud-config generator unavailable"; return 1; }
      ci="${work_dir}/rebuild-${name}.cloud-init.yaml"
      export CLOUD_PATHD="${cloud_d}"
      cloud-config::generate > "${ci}" 2>>"${CLOUD_LOG_FILE}" || {
        error "rebuild: cloud-init generation failed for '${name}'"; return 1; }
      plan+=("$(jq -cn --arg name "${name}" --arg sid "${sid}" --arg image "${image}" --arg ci "${ci}" \
        '{kind: "cloud", name: $name, a: $sid, b: $image, c: $ci}')")
      checked_image["${sid}"]="${image}"
      cloud_ips+=("${pub}")
    fi
  done

  if (( ${#plan[@]} == 0 )); then
    warn "rebuild: descriptor declares no servers — nothing to do"
    return 0
  fi

  # ── Phase 2 — EXECUTE (destructive). Preflight validated ALL nodes. ─────
  # Under CLOUD_DRY_RUN every destructive action is PRINTED, not run: the cloud
  # reimage via dry-run::cmd (exactly as provision routes its hcloud writes), the
  # Robot rescue+reset via the dry-run branch inside each helper. A failure names
  # the offending node so the operator knows WHICH one failed (and that the
  # cluster may be left partially reimaged).
  local rc=0 entry kind pname pa pb pc
  for entry in "${plan[@]}"; do
    hetzner::_plan_field "${entry}" kind; kind="${REPLY}"
    hetzner::_plan_field "${entry}" name; pname="${REPLY}"
    hetzner::_plan_field "${entry}" a; pa="${REPLY}"
    hetzner::_plan_field "${entry}" b; pb="${REPLY}"
    hetzner::_plan_field "${entry}" c; pc="${REPLY}"
    if [[ "${kind}" == "metal" ]]; then
      _hetzner_print "🔧 rescue+reset \033[1m${pname}\033[0m (robot#${pa})"
      hetzner::_robot_rescue "${pa}" "${pb}" || {
        error "rebuild: node '${pname}' (robot#${pa}) rescue activation failed — cluster may be partially reimaged"; rc=1; continue; }
      hetzner::_robot_reset  "${pa}" || {
        error "rebuild: node '${pname}' (robot#${pa}) hardware reset failed — cluster may be partially reimaged"; rc=1; continue; }
    else
      # The checked id only. Right before the reimage, read the server by
      # that id again: a server renamed, relabelled or replaced after the
      # preflight is refused (a node before it can be reimaged already).
      _hetzner_print "📦 rebuild \033[1m${pname}\033[0m (id ${pa}, image ${pb})"
      hetzner::_still_ours server "${pa}" "${mark}" "${pname}" >/dev/null || {
        error "rebuild: node '${pname}' (id ${pa}) was not reimaged: it changed after the check (the message above) — cluster may be partially reimaged"; rc=1; continue; }
      if [[ -z "${checked_image[${pa}]+set}" || "${pb}" != "${checked_image[${pa}]}" ]]; then
        error "rebuild: node '${pname}' (id ${pa}) was not reimaged: the image of the plan is not the image that lok8s checked — cluster may be partially reimaged"; rc=1; continue
      fi
      dry-run::cmd hcloud server rebuild "${pa}" "--image=${pb}" "--user-data-from-file=${pc}" || {
        error "rebuild: node '${pname}' reimage failed ('hcloud server rebuild ${pa}') — cluster may be partially reimaged"; rc=1; continue; }
    fi
  done

  # ── Phase 3 — Barrier: all cloud VMs cloud-init-done AND all workers in rescue.
  # Under dry-run nothing was reimaged, so there is no state transition to wait
  # for — short-circuit cleanly. (A real cluster would still be "installed" /
  # never in rescue, so running the barrier here would falsely time out.)
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 dry-run: no node was reimaged — skipping readiness barrier"
    (( rc != 0 )) || _hetzner_print \
      "🧪 dry-run complete — the plan above WOULD reset the nodes; nothing was changed"
    return "${rc}"
  fi

  hetzner::_rebuild_barrier ssh_cmd cloud_ips metal_ips || rc=1

  (( rc != 0 )) || _hetzner_print \
    "✅ rebuild complete — nodes reset (data disks untouched; wipe is #wipe-devices during provision)"
  return "${rc}"
}

# hetzner::_export_cloudinit_env <config_file>
# Export the shared CLOUD_* generation environment (CLOUD_PATH / CLOUD_PATH_LIB /
# CLOUD_USER / CLOUD_GROUP / CLOUD_PATH_PUB) so cloud-config::generate produces
# the same user-data a fresh provision would. The single source of truth for
# both provider::provision and provider::rebuild (they can't drift). CLOUD_PATHD
# is intentionally NOT set here — each caller owns it (provision: whole-cluster
# .cloudInit.modules; rebuild: per-server #cloud.d).
#
# No cloudInit.path selects the framework default. A cloudInit.path that is not
# a directory is an error: the old silent fallback to the default gave the
# nodes a cloud-init the descriptor did not ask for.
hetzner::_export_cloudinit_env() {
  local config_file="${1}"
  local ci_raw ci_path ci_user ci_group ci_pub
  ci_raw="$(_cfg '.cloudInit.path // ""' 2>/dev/null || echo "")"
  ci_path="${ci_raw}"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME on the same line
  [[ "${ci_path}" != "~/"* ]] || ci_path="${HOME}/${ci_path:2}"
  if [[ -n "${ci_path}" && "${ci_path}" != /* ]]; then
    ci_path="$(dirname "${config_file}")/${ci_path}"
  fi
  if [[ -z "${ci_path}" ]]; then
    ci_path="${PATH_LOK8S}/providers/hetzner/cloud-init"
  elif [[ ! -d "${ci_path}" ]]; then
    local problem="does not exist"
    [[ ! -e "${ci_path}" ]] || problem="is not a directory"
    error "hetzner: cloudInit.path '${ci_raw}' ${problem}: ${ci_path}. A relative path resolves against the directory of ${config_file} (for an inline spec.provider.config, a temporary file: use an absolute path or spec.provider.configRef). Create the directory, correct cloudInit.path, or remove cloudInit.path to use the framework default."
    return 1
  fi
  export CLOUD_PATH="${ci_path}"
  export CLOUD_PATH_LIB="${PATH_LOK8S}/providers/hetzner/cloud-init"
  ci_user="$(_cfg '.cloudInit.user // "root"' 2>/dev/null || echo "root")"
  ci_group="$(_cfg '.cloudInit.group // "root"' 2>/dev/null || echo "root")"
  ci_pub="$(_cfg '.cloudInit.sshPubPath // ""' 2>/dev/null || echo "")"
  export CLOUD_USER="${ci_user}" CLOUD_GROUP="${ci_group}"
  export CLOUD_PATH_PUB="${ci_pub:-${HOME}/.ssh}"
  CLOUD_PATH_PUB="${CLOUD_PATH_PUB/#\~/${HOME}}"
}

# hetzner::_rebuild_barrier <ssh_arr> <cloud_ip_arr> <metal_ip_arr>
# Wait (namerefs) until every cloud VM reports `cloud-init status ... done`
# and every bare-metal node is back in the Robot rescue system. Read-only
# probes. Tunables: PROVIDER_REBUILD_WAIT_TRIES / _WAIT_INTERVAL.
#
# LIMITATION: this verifies the target STATE (cloud-init done / booted into
# rescue), NOT that a reimage actually occurred. A stale OS that never got
# reimaged could still report `cloud-init status done` from a prior boot and
# pass the cloud check; a box already sitting in rescue likewise passes the
# metal check. A robust proof would thread a per-run nonce through the reimage
# and read it back — deliberately NOT done here (over-engineering for a recovery
# flow whose caller drives the reset with explicit intent).
hetzner::_rebuild_barrier() {
  local -n _sshref="${1}" _cloudref="${2}" _metalref="${3}"
  local tries="${PROVIDER_REBUILD_WAIT_TRIES:-48}"
  local interval="${PROVIDER_REBUILD_WAIT_INTERVAL:-15}"
  local ssh_user="${CLOUD_USER:-root}"
  local nc="${#_cloudref[@]}" nm="${#_metalref[@]}"
  local i j cloud_ready metal_ready
  for (( i=0; i<tries; i++ )); do
    cloud_ready=0
    for (( j=0; j<nc; j++ )); do
      "${_sshref[@]}" "${ssh_user}@${_cloudref[j]}" \
        'cloud-init status 2>/dev/null | grep -q done' && cloud_ready=$((cloud_ready+1))
    done
    metal_ready=0
    for (( j=0; j<nm; j++ )); do
      "${_sshref[@]}" "root@${_metalref[j]}" \
        "test -x ${_HETZNER_RESCUE_MARKER}" 2>/dev/null && metal_ready=$((metal_ready+1))
    done
    _hetzner_log "barrier: cloud_ready=${cloud_ready}/${nc} metal_ready=${metal_ready}/${nm}"
    [[ "${cloud_ready}" -eq "${nc}" && "${metal_ready}" -eq "${nm}" ]] && return 0
    sleep "${interval}"
  done
  error "rebuild: nodes did not reach target state within $(( tries * interval ))s"
  return 1
}

# hetzner::_authorized_key <pubkey_path>
# Print "<type> <base64>" of the OpenSSH public key in <pubkey_path> for the
# rebuild user-data (cloud-config::key_line drops the comment). Error when the
# file cannot be read or holds no key.
hetzner::_authorized_key() {
  local path="${1}" file line key
  file="${path}"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME on the same line
  [[ "${file}" != "~/"* ]] || file="${HOME}/${file:2}"
  if [[ ! -f "${file}" || ! -r "${file}" ]]; then
    error "rebuild: cannot read sshPublicKey '${path}' (${file}). The rebuilt cloud VMs need it as an authorized key. Correct sshPublicKey in the descriptor, or create the file."
    return 1
  fi
  line="$(grep -m1 -v -e '^[[:space:]]*$' -e '^#' "${file}" || true)"
  if ! key="$(cloud-config::key_line "${line}")"; then
    error "rebuild: sshPublicKey '${path}' holds no OpenSSH public key (expected '<type> <base64>' on the first line). Set sshPublicKey to the .pub file of sshPrivateKey."
    return 1
  fi
  echo "${key}"
}

# hetzner::_check_key_pair <sshPublicKey> <sshPrivateKey>
# Error when sshPublicKey is not the public key of sshPrivateKey (`ssh-keygen
# -y` derives it), or when sshPrivateKey does not exist. Only a warning when
# ssh-keygen cannot read the private key (it has a passphrase). Nothing to
# check when one of the two is not set.
hetzner::_check_key_pair() {
  local pub="${1}" priv="${2}" file want derived got
  [[ -n "${pub}" && -n "${priv}" ]] || return 0
  file="${priv}"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME on the same line
  [[ "${file}" != "~/"* ]] || file="${HOME}/${file:2}"
  if [[ ! -f "${file}" ]]; then
    error "rebuild: sshPrivateKey '${priv}' does not exist (${file}). The readiness check connects with it after the reimage, so nothing was reimaged. Correct sshPrivateKey in the descriptor."
    return 1
  fi
  want="$(hetzner::_authorized_key "${pub}")" || return 1
  if ! derived="$(ssh-keygen -y -P '' -f "${file}" 2>&1)"; then
    warn "rebuild: cannot check that sshPublicKey '${pub}' is the public key of sshPrivateKey '${priv}': ssh-keygen -y failed (${derived%%$'\n'*}). Make sure that the two keys are one pair."
    return 0
  fi
  got="$(cloud-config::key_line "${derived%%$'\n'*}")" || got=""
  if [[ "${got}" != "${want}" ]]; then
    error "rebuild: sshPublicKey '${pub}' is not the public key of sshPrivateKey '${priv}' (ssh-keygen -y gives '${got:-no key}'). The readiness check connects with sshPrivateKey after the reimage, so nothing was reimaged. Set sshPublicKey to the .pub file of sshPrivateKey."
    return 1
  fi
}

# hetzner::_rescue_fingerprint <pubkey_path>
# MD5 fingerprint (colon-hex, the form Hetzner Robot registers) of a public key.
hetzner::_rescue_fingerprint() {
  local pub="${1:-}"
  [[ -n "${pub}" ]] || return 1
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${pub}" != "~/"* ]] || pub="${HOME}/${pub:2}"
  [[ -f "${pub}" ]] || return 1
  ssh-keygen -l -E md5 -f "${pub}" 2>/dev/null \
    | grep -oE 'MD5:[0-9a-f:]+' | sed 's/^MD5://' | head -1
}

# hetzner::_robot_curl <curl args...>
# curl with the Robot user and password in a config on stdin (`-K -`). The
# password never goes on argv, which every local user can read (ps,
# /proc/<pid>/cmdline) and audit tools store: it can boot a bare-metal
# server into rescue and reset it. A user or password with a control
# character is refused with its name (http::credential_ok), and no call runs.
hetzner::_robot_curl() {
  http::credential_ok HROBOT_USER HROBOT_PASSWORD || return 1
  http::curl_config user "${HROBOT_USER}:${HROBOT_PASSWORD}" | curl -K - "${@}"
}

# hetzner::_robot_server_number_by_ip <ip> [connect_timeout] [max_time]
#   → Robot server_number for the UNIQUE server whose main IP == <ip>.
# Robot's server_name is free-text and NOT unique, so we never match on it for a
# destructive action (a name collision would rescue+reset the wrong bare-metal
# box). Match on server_ip instead and print a number ONLY when EXACTLY ONE
# server matches; empty + non-zero on zero/multiple matches or any API error
# (`--fail` + timeouts so an HTTP 4xx/5xx / hang can't read as a hit).
hetzner::_robot_server_number_by_ip() {
  local ip="${1:-}"
  local connect_timeout="${2:-${HROBOT_CONNECT_TIMEOUT}}" max_time="${3:-${HROBOT_MAX_TIME}}"
  [[ -n "${ip}" ]] || return 1
  local json matches count
  json="$(hetzner::_robot_curl -f -sS --connect-timeout "${connect_timeout}" --max-time "${max_time}" \
            "${HROBOT_API}/server" 2>/dev/null)" || return 1
  matches="$(echo "${json}" | jq -c --arg ip "${ip}" \
              '[.[].server | select(.server_ip==$ip)]' 2>/dev/null)" || return 1
  count="$(echo "${matches}" | jq 'length' 2>/dev/null || echo 0)"
  [[ "${count}" == "1" ]] || return 1
  echo "${matches}" | jq -r '.[0].server_number'
}

# hetzner::_plan_field <entry-json> <field>
# REPLY: the string <field> of a rebuild plan entry, byte for byte (the
# command substitution does not cut a newline at its end).
hetzner::_plan_field() {
  REPLY="$(jq -j --arg f "${2}" '.[$f] // ""' <<<"${1}"; printf x)"
  REPLY="${REPLY%x}"
}

# hetzner::_cloud_server_id <name> <selector> <mark> <cluster_name>
# The id of the ONE server named <name> that carries <selector> (the cluster
# label and the owner mark), checked again in jq. rc 1 when no server or
# more than one matches. The rebuild acts on this id, never on the name: an
# all-digit name ("900") is an id to hcloud, and a name can move to another
# server after the check.
hetzner::_cloud_server_id() {
  local name="${1:-}" selector="${2:-}" mark="${3:-}" cluster="${4:-}" sid out
  [[ -n "${name}" && -n "${selector}" && -n "${mark}" && -n "${cluster}" ]] || return 1
  # The exit code of hcloud is checked on its own (not through a pipe): a
  # failed list is no answer, also when it printed a list.
  out="$(hcloud server list -o json -l "${selector}" 2>/dev/null)" || return 1
  jq -e 'type == "array" or type == "null"' >/dev/null 2>&1 <<<"${out}" || return 1
  sid="$(jq -r \
    --arg n "${name}" --arg key "${_HETZNER_OWNER_KEY}" --arg mark "${mark}" --arg c "${cluster}" '
    [ (. // [])[]
      | select(.name == $n and (.labels // {})[$key] == $mark and (.labels // {})["lok8s.dev/cluster"] == $c)
      | .id | tostring ]
    | if length == 1 then .[0] else empty end' <<<"${out}" 2>/dev/null)" || return 1
  [[ "${sid}" =~ ^[0-9]+$ ]] || return 1
  printf '%s\n' "${sid}"
}

# hetzner::_robot_rescue <number> <key_fingerprint>
hetzner::_robot_rescue() {
  local num="${1}" fingerprint="${2}"
  # Honor dry-run: PRINT the intended activation and issue no POST. Kept as an
  # explicit branch (not dry-run::cmd): the plan log gets this line, not the
  # curl call.
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 [dry-run] would activate Robot rescue on robot#${num} (POST ${HROBOT_API}/boot/${num}/rescue os=linux authorized_key=${fingerprint})"
    return 0
  fi
  hetzner::_robot_curl -f -sS --connect-timeout "${HROBOT_CONNECT_TIMEOUT}" --max-time "${HROBOT_MAX_TIME}" \
    "${HROBOT_API}/boot/${num}/rescue" \
    -d os=linux --data-urlencode "authorized_key=${fingerprint}" >/dev/null 2>&1 \
    || { error "rebuild: rescue activation failed for robot#${num}"; return 1; }
}

# hetzner::_robot_reset <number>  — hardware reset
hetzner::_robot_reset() {
  local num="${1}"
  if [[ -n "${CLOUD_DRY_RUN:-}" ]]; then
    _hetzner_print "🧪 [dry-run] would hardware-reset robot#${num} (POST ${HROBOT_API}/reset/${num} type=hw)"
    return 0
  fi
  hetzner::_robot_curl -f -sS --connect-timeout "${HROBOT_CONNECT_TIMEOUT}" --max-time "${HROBOT_MAX_TIME}" \
    "${HROBOT_API}/reset/${num}" \
    -d type=hw >/dev/null 2>&1 \
    || { error "rebuild: hardware reset failed for robot#${num}"; return 1; }
}

# ── Optional hook: doctor ────────────────────────────────
#
# provider::doctor <config_file>
#   Transparent, READ-ONLY infrastructure diagnosis. Prints one TAB-separated
#   line per check to stdout — `<status>\t<message>` where status ∈ {ok, warn}
#   — plus a final `summary\t<n> ok, <m> warn` line (the machine-usable
#   summary). Every not-ready item carries actionable advice. This hook NEVER
#   exits non-zero (always returns 0) and NEVER mutates anything. `lo doctor`
#   renders these lines as its "provider / infrastructure" section.
provider::doctor() {
  local config_file="${1:-${PROVIDER_CONFIG_FILE:-}}"
  export PROVIDER_CONFIG_FILE="${config_file}"

  # Run the checks in a subshell so nothing they do can flip our exit status.
  local report ok warn
  report="$(hetzner::_doctor_checks "${config_file}" 2>/dev/null)"
  [[ -z "${report}" ]] || printf '%s\n' "${report}"
  ok="$(printf '%s\n' "${report}" | grep -c $'^ok\t' || true)"
  warn="$(printf '%s\n' "${report}" | grep -c $'^warn\t' || true)"
  printf 'summary\t%s ok, %s warn\n' "${ok:-0}" "${warn:-0}"
  return 0
}

# hetzner::_doctor_checks <config_file>
# Emit the per-check `<status>\t<message>` lines. READ-ONLY: only hcloud/Robot
# GETs and non-mutating SSH probes (test -x, cloud-init status). No rebuild,
# reset, rescue, delete, or any write.
hetzner::_doctor_checks() {
  local config_file="${1}"

  # 1) hcloud credentials + API reachability.
  local ctx=""
  ctx="$(hcloud context active 2>/dev/null || echo "")"
  if [[ -n "${HCLOUD_TOKEN:-}" || -n "${ctx}" ]]; then
    if hcloud server-type list -o noheader >/dev/null 2>&1; then
      printf 'ok\thcloud API reachable\n'
    else
      printf 'warn\thcloud credentials set but API not reachable — check HCLOUD_TOKEN / network\n'
    fi
  else
    printf 'warn\tno hcloud credentials — export HCLOUD_TOKEN or run: hcloud context create <name>\n'
  fi

  # 2) Robot credentials + API reachability. robot_api_ok lets later checks
  #    distinguish "API unreachable/errored" from a genuine negative result
  #    (e.g. key not registered) instead of conflating the two.
  local have_robot=0 robot_api_ok=0
  if [[ -n "${HROBOT_USER:-}" && -n "${HROBOT_PASSWORD:-}" ]]; then
    have_robot=1
    if ! http::credential_ok HROBOT_USER HROBOT_PASSWORD 2>/dev/null; then
      printf 'warn\tHROBOT_USER or HROBOT_PASSWORD holds a control character (a CR from a file with CRLF line ends?) — remove it\n'
    elif hetzner::_robot_curl -f -sS --connect-timeout "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" --max-time "${HROBOT_DOCTOR_MAX_TIME}" \
         "${HROBOT_API}/server" >/dev/null 2>&1; then
      robot_api_ok=1
      printf 'ok\tRobot API reachable\n'
    else
      printf 'warn\tRobot creds set but API not reachable — verify HROBOT_USER/HROBOT_PASSWORD\n'
    fi
  else
    printf 'warn\tRobot creds unset (HROBOT_USER/HROBOT_PASSWORD) — bare-metal rescue/reset unavailable; set them to enable automatic worker reset\n'
  fi

  # Descriptor → JSON.
  [[ -f "${config_file}" ]] || { printf 'warn\tdescriptor not found: %s\n' "${config_file}"; return 0; }
  local desc
  desc="$(template::descriptor_json "${config_file}" 2>/dev/null)" || desc=""

  local metal_count
  metal_count="$(echo "${desc}" | jq '[(.server // [])[] | select(.["#cloud.root"]=="true")] | length' 2>/dev/null || echo 0)"

  # 3) Rescue SSH key registered in Robot (only with bare-metal + Robot creds).
  #    Distinguish "API errored" from "key not registered" — never report the
  #    key missing when the /key call itself failed.
  if [[ "${metal_count}" =~ ^[0-9]+$ ]] && (( metal_count > 0 )) && (( have_robot )); then
    if (( ! robot_api_ok )); then
      printf 'warn\tcannot verify rescue key — Robot API unreachable (see above); a missing rescue key would lock out a worker reinstall\n'
    else
      local fingerprint
      fingerprint="${PROVIDER_ROBOT_RESCUE_FP:-$(hetzner::_rescue_fingerprint "$(echo "${desc}" | jq -r '.sshPublicKey // ""')" 2>/dev/null)}"
      if [[ -z "${fingerprint}" ]]; then
        printf 'warn\tcannot determine rescue key fingerprint (descriptor .sshPublicKey missing/unreadable) — set PROVIDER_ROBOT_RESCUE_FP\n'
      else
        local keys
        if keys="$(hetzner::_robot_curl -f -sS --connect-timeout "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" --max-time "${HROBOT_DOCTOR_MAX_TIME}" \
                      "${HROBOT_API}/key" 2>/dev/null)"; then
          # Exact, whole-value fingerprint match (case-insensitive). A loose
          # substring grep would let a short/truncated fingerprint false-match a
          # longer registered key — compare the /key fingerprint field as a whole.
          if printf '%s' "${keys}" | jq -e --arg fingerprint "${fingerprint}" \
               'any(.[]?; ((.key.fingerprint // "") | ascii_downcase) == ($fingerprint | ascii_downcase))' \
               >/dev/null 2>&1; then
            printf 'ok\trescue SSH key registered in Robot (%s)\n' "${fingerprint}"
          else
            printf 'warn\trescue key %s NOT registered in Robot — a worker reinstall would lock out; add the key in the Robot console (Key management) or via the Robot API before recovering\n' "${fingerprint}"
          fi
        else
          printf 'warn\tcannot verify rescue key — Robot /key API errored (%s NOT confirmed registered); retry or check Robot creds/network\n' "${fingerprint}"
        fi
      fi
    fi
  fi

  # 4) Inventory sanity (control-plane count). A failed provider::output is
  #    one warn line with its reason (its first error line: for example no
  #    domain for the owner mark, or a failed list). The checks go on with
  #    an empty inventory.
  local inv inv_err="" reason="" line last=""
  inv_err="$(mktemp 2>/dev/null)" || inv_err=""
  if inv="$(provider::output "${config_file}" 2>"${inv_err:-/dev/null}")"; then
    local cp_count
    cp_count="$(echo "${inv}" | jq '[(.nodes // [])[] | select(.role=="control-plane")] | length' 2>/dev/null || echo 0)"
    if [[ "${cp_count}" =~ ^[0-9]+$ ]] && (( cp_count > 0 )); then
      printf 'ok\tinventory: %s control-plane node(s) resolved\n' "${cp_count}"
    else
      printf 'warn\tinventory: no control-plane nodes resolved — check descriptor labels / hcloud state\n'
    fi
  else
    inv='{}'
    if [[ -n "${inv_err}" ]]; then
      while IFS= read -r line || [[ -n "${line}" ]]; do
        line="${line%$'\r'}" line="${line//$'\t'/ }"
        [[ -n "${line}" ]] || continue
        last="${line}"
        [[ -n "${reason}" || "${line}" != "[error] "* ]] || reason="${line#"[error] "}"
      done < "${inv_err}"
    fi
    printf 'warn\tinventory: provider::output failed, so no node is known: %s\n' "${reason:-${last:-it printed no reason}}"
  fi
  [[ -z "${inv_err}" ]] || rm -f "${inv_err}" || true

  # SSH identity for read-only node probes.
  local key
  key="$(echo "${desc}" | jq -r '.sshPrivateKey // ""')"
  # shellcheck disable=SC2088 # literal "~/" prefix match, expanded via $HOME below
  [[ "${key}" != "~/"* ]] || key="${HOME}/${key:2}"
  local -a ssh_cmd=(ssh -o BatchMode=yes -o ConnectTimeout=6
                 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
  [[ -z "${key}" ]] || ssh_cmd+=(-i "${key}")

  # 5) Per-node: existence/reachability + bare-metal installed-vs-rescue.
  local scount idx server name is_root pub num ext_ip
  scount="$(echo "${desc}" | jq '(.server // []) | length' 2>/dev/null || echo 0)"
  for (( idx=0; idx<scount; idx++ )); do
    server="$(echo "${desc}" | jq -c ".server[${idx}]")"
    name="$(echo "${server}" | jq -r '.name // ""')"
    [[ -n "${name}" ]] || continue
    is_root="$(echo "${server}" | jq -r '.["#cloud.root"] // ""')"
    pub="$(echo "${inv}" | jq -r --arg n "${name}" '.nodes[] | select(.name==$n) | .public_ip // empty')"
    if [[ "${is_root}" == "true" ]]; then
      if (( ! have_robot )); then
        printf 'warn\tworker %s: cannot check Robot state (no Robot creds)\n' "${name}"
      elif (( ! robot_api_ok )); then
        printf 'warn\tworker %s: cannot check Robot state (Robot API unreachable)\n' "${name}"
      else
        # Resolve BY IP (like the destructive path), never by non-unique name.
        ext_ip="$(echo "${server}" | jq -r '.["#external-ip"] // ""')"
        num="$(hetzner::_robot_server_number_by_ip "${ext_ip}" "${HROBOT_DOCTOR_CONNECT_TIMEOUT}" "${HROBOT_DOCTOR_MAX_TIME}" 2>/dev/null || echo "")"
        if [[ -n "${num}" ]]; then
          printf 'ok\tworker %s resolvable in Robot (robot#%s, by IP %s)\n' "${name}" "${num}" "${ext_ip}"
        else
          printf 'warn\tworker %s did NOT uniquely resolve in Robot by IP (%s) — check the Robot server IP matches the descriptor #external-ip\n' "${name}" "${ext_ip:-unset}"
        fi
      fi
      if [[ -n "${pub}" ]]; then
        if "${ssh_cmd[@]}" "root@${pub}" "test -x ${_HETZNER_RESCUE_MARKER}" 2>/dev/null; then
          printf 'ok\tworker %s is in rescue (ready for reinstall)\n' "${name}"
        elif "${ssh_cmd[@]}" "root@${pub}" 'true' 2>/dev/null; then
          printf 'warn\tworker %s is installed, not in rescue — set HROBOT_USER/HROBOT_PASSWORD to reset it automatically (provider::rebuild), or activate rescue via the Robot console\n' "${name}"
        else
          printf 'warn\tworker %s (%s) unreachable over SSH — cannot determine rescue/installed state\n' "${name}" "${pub}"
        fi
      fi
    else
      if [[ -n "${pub}" ]]; then
        printf 'ok\tcloud node %s present (%s)\n' "${name}" "${pub}"
      else
        printf 'warn\tcloud node %s not found in live inventory — it may be missing or unlabeled\n' "${name}"
      fi
    fi
  done
}

# ── CLI entry point ──────────────────────────────────────

main::hetzner() {
  local dry_run hetzner_json
  local domain="${domain:-}"
  # One unconditional array, both ways of running. The old conditional build
  # was broken in both directions: standalone declared `domain` but no flag
  # entry (the advertised --domain was unparseable), and under `lo` it
  # REPLACED the array — silently dropping --hetzner-json. The `:^` domain
  # entry yields to lo's own non-inheritable `domain|` duplicate in the tail.
  local -a args=(
    'dry-run|:+'        'Enable dry-run mode (log commands without executing)'
    'hetzner-json|'     'Path to hetzner.json'
    'domain|:^~domain'  'Domain to use'
    "${args[@]:-}"
  )
  :args "Hetzner Cloud provisioning" "${@}"

  if [[ -n "${hetzner_json:-}" ]]; then
    CLOUD_HETZNER_JSON_PATH="${hetzner_json}"
  elif [[ -n "${domain:-}" ]]; then
    CLOUD_HETZNER_JSON_PATH="${PATH_CLUSTERS}/${domain}/hetzner.json"
  else
    error "Either --hetzner-json or --domain required"
    return 1
  fi

  # The owner mark of the parts is keyed on the domain (hetzner::owner_mark).
  # lo sets PROVIDER_DOMAIN in provider::write_config; this command takes it
  # from --domain, with the same rules (provider::_spec_domain on the path
  # of the cluster spec). A descriptor path alone does not tell the domain.
  if [[ -z "${domain:-}" ]]; then
    error "hetzner: --domain is missing. lok8s needs the domain of the cluster for the owner mark ${_HETZNER_OWNER_KEY} of its parts, and --hetzner-json does not give it. Add --domain <domain> (the directory name under clusters/). Nothing was created or changed."
    return 1
  fi
  declare -F provider::_spec_domain >/dev/null || import ^utils/provider
  PROVIDER_DOMAIN="$(provider::_spec_domain "${PATH_CLUSTERS}/${domain}/cluster.lok8s.yaml")"
  export PROVIDER_DOMAIN

  [[ -f "${CLOUD_HETZNER_JSON_PATH}" ]] || {
    error "No such file: ${CLOUD_HETZNER_JSON_PATH}"
    return 1
  }

  if (( dry_run )); then
    CLOUD_DRY_RUN=1
    CLOUD_DRY_RUN_PATH="${PATH_LOK8S}/.state/dry-run"
  fi

  # Use the provider contract
  export PROVIDER_CONFIG_FILE="${CLOUD_HETZNER_JSON_PATH}"
  provider::validate || return $?
  provider::provision "${CLOUD_HETZNER_JSON_PATH}" "$(dirname "${CLOUD_HETZNER_JSON_PATH}")"
}
