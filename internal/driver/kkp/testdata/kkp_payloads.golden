{
  "name": "pool-1",
  "spec": {
    "replicas": 3,
    "template": {
      "cloud": {
        "hetzner": {
          "type": "cpx31"
        }
      },
      "operatingSystem": {
        "ubuntu": {}
      }
    },
    "minReplicas": 1,
    "maxReplicas": 10
  }
}
